    t[1300] = 0x8e679c2f << 32 | 0x5e44ff8f;
    t[1301] = 0x570f09ea << 32 | 0xa7ea7648;
    return t;
}

// Word `i` of the table: 2*(q+342) is the high word of the power of five q, 2*(q+342)+1 the low word.
pub fn word(i: int) -> [] int {
    return pow5_128[i];
}
