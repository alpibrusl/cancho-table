edition 5;

module mcp.tools;

// Generated by scripts/mcp.py from the tool's `introspect` and the compiler's
// authority report of the server -- do not edit (docs/mcp.md §3). The
// `tools/list` result, and for tool `i` the tables a call is checked against:
// its properties as flags (`property|flag|kind`, kind `bool`, `nat` or `text`),
// its operands in order (`property|min|max`, `max` empty for unbounded), how
// standard input reaches it (none), its output (`document` or `stream`), and the
// property that chooses its format (the answer is structured content only when
// it is `json`). Then the server's bounds and the sentences it says when it
// ends a call, and `introspect`.

pub fn list_result() -> [] &static [byte] {
    return "{\"tools\":[{\"name\":\"table\",\"description\":\"A CSV or TSV file as a table, read in one bounded streaming pass over an RFC 4180 reader: its shape, some columns (--select), the rows that satisfy a condition (--where, bytewise or exact integers, decimals or doubles), or counts, sums, minima, maxima and distinct counts of groups (--group, --agg, --sort, --top), as json pages or csv. Every refusal is a rule: a ragged row, an unterminated quote, an unknown column, a cell that is not an integer, a line past the limit.\\n\\nThe file is read beneath the server's root: a path outside it, a `..` component or a link is refused with a rule (path.outside-root, path.dotdot, path.symlink). The answer is the tool's own output, byte for byte, and is bounded by the server: ask for fewer rows with `limit`, groups with `top`, columns with `select`. A refusal is an error result whose JSON names a `rule` and a `repair`; match on the rule.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"delimiter\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the field separator: a comma, the word tab (or a tab character), or a semicolon\",\"default\":\",\"},\"select\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the columns to return, named by their header separated by commas (a comma or backslash in a name is written with a backslash before it), or by position as #3, and in the order given\"},\"where\":{\"type\":\"string\",\"minLength\":1,\"description\":\"only the rows that satisfy this: conditions joined by and, each COLUMN OP VALUE with OP one of = != < <= > >= contains in (a, b), COLUMN:int for an exact integer comparison or COLUMN:dec(N) for an exact decimal one of at most N fractional digits or COLUMN:float for the nearest doubles, 'quoted' words and backslashes as docs/filter.md says\"},\"group\":{\"type\":\"string\",\"minLength\":1,\"description\":\"count the rows by these columns, named as for select, instead of returning them\"},\"agg\":{\"type\":\"string\",\"minLength\":1,\"description\":\"with --group (or alone), what to compute per group: count, sum:COL, min:COL, max:COL, distinct:COL separated by commas (default count)\"},\"sort\":{\"type\":\"string\",\"minLength\":1,\"description\":\"with --group, order the groups by this output column (count, sum:bytes, a group column), - before it for descending, ties by group\"},\"top\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"with --group or --order-by, keep only the first N groups or rows after sorting\"},\"limit\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000,\"description\":\"the most rows returned (default 1000 as json, no limit as csv, ceiling 1000000)\"},\"from\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"the 0-based row to start at, as the next of a truncated answer says\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":67108864,\"description\":\"the most json rows returned hold, past it the answer is truncated with a next (ceiling 67108864)\",\"default\":1048576},\"max-groups\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000,\"description\":\"the most groups kept, one more is limit.too-many-groups (ceiling 1000000)\",\"default\":100000},\"max-distinct\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":10000000,\"description\":\"the most distinct values kept over all groups for distinct, one more is limit.too-many-distinct (ceiling 10000000)\",\"default\":100000},\"max-state-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1073741824,\"description\":\"the most bytes of group keys, distinct values or sorted rows kept (ceiling 1073741824)\",\"default\":67108864},\"order-by\":{\"type\":\"string\",\"minLength\":1,\"description\":\"sort the rows by these keys, each NAME, -NAME for descending, NAME:int for exact integers, separated by commas, ties keep the order of the file (docs/sort.md)\"},\"max-sort-rows\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":20000000,\"description\":\"the most rows held to sort, one more is limit.too-many-sort-rows (ceiling 20000000)\",\"default\":1000000},\"threads\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":64,\"description\":\"how many threads read the file (1 to 64), for rows and groups only, on a file of at least --parallel-min-bytes of data: 1 is the sequential read and the answer of every other count is the same bytes\",\"default\":1},\"chunk-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1073741824,\"description\":\"the size of the range one thread reads at a time (with --threads), at least 1\",\"default\":4194304},\"parallel-min-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1073741824,\"description\":\"the smallest data (after the header) read by several threads, below it the read is sequential\",\"default\":1048576},\"max-rows\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000000,\"description\":\"the most data rows read, past it the answer says truncated (ceiling 1000000000)\",\"default\":10000000},\"max-line-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":16777216,\"description\":\"the longest line read and the most a kept record may hold, a longer one is limit.line-too-long (ceiling 16777216)\",\"default\":1048576},\"format\":{\"enum\":[\"json\",\"text\",\"csv\"],\"description\":\"json for a program, text for a person (the shape only), csv for rows or groups as csv\",\"default\":\"json\"},\"file\":{\"type\":\"string\",\"description\":\"the CSV file to read\"}},\"required\":[\"file\"],\"additionalProperties\":false},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}]}";
}

pub fn count() -> [] int {
    return 1;
}

pub fn name(i: int) -> [] &static [byte] {
    if i == 0 {
        return "table";
    }
    return "";
}

pub fn flags(i: int) -> [] &static [byte] {
    if i == 0 {
        return "delimiter|--delimiter|text;select|--select|text;where|--where|text;group|--group|text;agg|--agg|text;sort|--sort|text;top|--top|nat;limit|--limit|nat;from|--from|nat;max-bytes|--max-bytes|nat;max-groups|--max-groups|nat;max-distinct|--max-distinct|nat;max-state-bytes|--max-state-bytes|nat;order-by|--order-by|text;max-sort-rows|--max-sort-rows|nat;threads|--threads|nat;chunk-bytes|--chunk-bytes|nat;parallel-min-bytes|--parallel-min-bytes|nat;max-rows|--max-rows|nat;max-line-bytes|--max-line-bytes|nat;format|--format|text";
    }
    return "";
}

pub fn operands(i: int) -> [] &static [byte] {
    if i == 0 {
        return "file|1|1";
    }
    return "";
}

pub fn stdin(i: int) -> [] &static [byte] {
    if i == 0 {
        return "";
    }
    return "";
}

pub fn output(i: int) -> [] &static [byte] {
    if i == 0 {
        return "document";
    }
    return "";
}

pub fn structured(i: int) -> [] &static [byte] {
    if i == 0 {
        return "format";
    }
    return "";
}

// The binary, beneath the directory the server's `Exec` is narrowed to.
pub fn path(i: int) -> [] &static [byte] {
    if i == 0 {
        return "/opt/cancho-table/bin/table";
    }
    return "";
}

pub fn default_timeout() -> [] int {
    return 30000;
}

pub fn default_output() -> [] int {
    return 2097152;
}

pub fn longest_line() -> [] int {
    return 4194304;
}

pub fn most_errors() -> [] int {
    return 65536;
}

// What the server tells a caller whose call it had to end (the `hint` of the error).
pub fn hint_too_large() -> [] &static [byte] {
    return "ask for less: `limit` caps the rows, `top` the groups (or the first rows of an order-by), `select` the columns, `where` the rows; do not raise `max-bytes` past the server's bound";
}

pub fn hint_timeout() -> [] &static [byte] {
    return "ask for less work: add `where`, `limit` or `top`, name fewer columns with `select`, or read a large file with more `threads`; the deadline is the server's --timeout-ms";
}

// `mcp introspect`.
pub fn introspect() -> [] &static [byte] {
    return "{\"tool\":\"mcp\",\"version\":\"0.1.0\",\"compiler\":\"a4572ea3b506e4bcec1c4be43deda1043c11ba9f\",\"summary\":\"An MCP server (stdio, JSON-RPC 2.0) that serves the tool `table` under one root: its input schema is derived from the tool's `introspect`, a call is a fixed argv with no shell, the answer is the tool's stdout, stderr and exit code unchanged, bounded in size and in time.\",\"usage\":\"mcp --root DIR [--timeout-ms N] [--max-output N] | mcp introspect\",\"output\":\"stdio\",\"protocol\":{\"transport\":\"stdio, one JSON-RPC 2.0 message per line\",\"version\":\"2025-06-18\",\"methods\":[\"initialize\",\"ping\",\"tools/list\",\"tools/call\"],\"notifications\":\"accepted and not answered\",\"max_line_bytes\":4194304},\"serves\":{\"tool\":\"table\",\"version\":\"0.3.0\",\"compiler\":\"a4572ea3b506e4bcec1c4be43deda1043c11ba9f\",\"bin\":\"/opt/cancho-table/bin\"},\"tools\":[\"table\"],\"flags\":[{\"name\":\"--root\",\"kind\":\"path\",\"role\":\"root\",\"default\":null,\"help\":\"the directory the tool serves: every FILE is resolved beneath it by the tool, which refuses absolute paths, `..` and links; required, absolute, given to the tool first and once\"},{\"name\":\"--timeout-ms\",\"kind\":\"nat\",\"role\":\"none\",\"default\":30000,\"help\":\"the deadline of one call: the tool is killed past it and the call ends as mcp.timeout\"},{\"name\":\"--max-output\",\"kind\":\"nat\",\"role\":\"none\",\"default\":2097152,\"help\":\"the most standard output of one call, in bytes: the tool is killed past it and the call ends as mcp.output-too-large\"}],\"limits\":[{\"name\":\"timeout-ms\",\"default\":30000},{\"name\":\"max-output\",\"default\":2097152},{\"name\":\"stderr\",\"default\":65536,\"note\":\"fixed: the tool's standard error beyond it ends the call as mcp.output-too-large\"},{\"name\":\"line\",\"default\":4194304,\"note\":\"fixed: a request line beyond it is refused as mcp.line-too-long\"}],\"rules\":[{\"rule\":\"mcp.parse-error\",\"answer\":\"jsonrpc -32700\",\"summary\":\"the line is not one JSON value\"},{\"rule\":\"mcp.invalid-request\",\"answer\":\"jsonrpc -32600\",\"summary\":\"not a JSON-RPC 2.0 request\"},{\"rule\":\"mcp.line-too-long\",\"answer\":\"jsonrpc -32600\",\"summary\":\"a request line longer than max_line_bytes\"},{\"rule\":\"mcp.unknown-method\",\"answer\":\"jsonrpc -32601\",\"summary\":\"a method other than initialize, ping, tools/list, tools/call\"},{\"rule\":\"mcp.unknown-tool\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a tool name other than table\"},{\"rule\":\"mcp.arguments-not-object\",\"answer\":\"jsonrpc -32602\",\"summary\":\"`arguments` is not an object\"},{\"rule\":\"mcp.unknown-argument\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a property the input schema does not have (data lists the real ones)\"},{\"rule\":\"mcp.wrong-type\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a property of the wrong type; every fault is listed in data.problems\"},{\"rule\":\"mcp.nul-in-argument\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a NUL byte in a string, which would arrive as two arguments\"},{\"rule\":\"mcp.timeout\",\"answer\":\"isError result\",\"summary\":\"the call ran past --timeout-ms; ask for less work: add `where`, `limit` or `top`, name fewer columns with `select`, or read a large file with more `threads`; the deadline is the server's --timeout-ms\"},{\"rule\":\"mcp.output-too-large\",\"answer\":\"isError result\",\"summary\":\"the output passed --max-output (or the error stream passed its bound); ask for less: `limit` caps the rows, `top` the groups (or the first rows of an order-by), `select` the columns, `where` the rows; do not raise `max-bytes` past the server's bound\"},{\"rule\":\"mcp.signaled\",\"answer\":\"isError result\",\"summary\":\"the tool was ended by a signal\"},{\"rule\":\"mcp.spawn\",\"answer\":\"isError result\",\"summary\":\"the tool could not be started or watched\"}],\"confinement\":{\"root\":\"every path argument is the tool's, resolved by it beneath --root; the server passes --root first and once, flag values as one `--name=value` argument and operands after `--`, with no shell\",\"exec\":\"the binary of the directory its Exec is narrowed to (baked at build time), by one fixed name\"},\"authority\":{\"bounded\":true,\"unbounded_by\":[],\"effects\":[\"args\",\"child_signal\",\"clock\",\"err_write\",\"exec\",\"heap\",\"io_read\",\"io_write\",\"pipe_read\",\"pipe_write\",\"poll\"],\"labels\":[{\"name\":\"args\",\"argument\":null,\"bounded\":true},{\"name\":\"child_signal\",\"argument\":null,\"bounded\":true},{\"name\":\"clock\",\"argument\":null,\"bounded\":true},{\"name\":\"err_write\",\"argument\":null,\"bounded\":true},{\"name\":\"exec\",\"argument\":\"/opt/cancho-table/bin\",\"bounded\":true},{\"name\":\"heap\",\"argument\":null,\"bounded\":true},{\"name\":\"io_read\",\"argument\":null,\"bounded\":true},{\"name\":\"io_write\",\"argument\":null,\"bounded\":true},{\"name\":\"pipe_read\",\"argument\":null,\"bounded\":true},{\"name\":\"pipe_write\",\"argument\":null,\"bounded\":true},{\"name\":\"poll\",\"argument\":null,\"bounded\":true}],\"foreign_symbols\":[],\"pure\":[\"a_or_an\",\"abs\",\"at\",\"base\",\"bit_length\",\"bit_length_of\",\"bytes\",\"channels\",\"channels_with_errors\",\"child_token\",\"close\",\"compare\",\"count\",\"count\",\"count_byte\",\"decode\",\"default_output\",\"default_timeout\",\"digit_of\",\"equal\",\"err_control\",\"err_depth\",\"err_end\",\"err_escape\",\"err_full\",\"err_number\",\"err_syntax\",\"err_trailing\",\"err_utf8\",\"errors_token\",\"escape_width\",\"exact_pow10\",\"exited\",\"expected_of\",\"failed\",\"fault_at\",\"field\",\"fine\",\"finish\",\"fits_int\",\"flags\",\"get\",\"hex4\",\"hex_digit\",\"hex_value\",\"hint_timeout\",\"hint_too_large\",\"in_range\",\"input_token\",\"introspect\",\"is_array\",\"is_bool\",\"is_digit\",\"is_digit\",\"is_int\",\"is_object\",\"is_string\",\"is_tail\",\"is_ws\",\"is_zero\",\"kind\",\"kind_name\",\"kind_of\",\"known\",\"ldexp\",\"lead_bits\",\"list\",\"list_result\",\"longest_line\",\"longest_line\",\"max_depth\",\"min\",\"most_errors\",\"name\",\"nat_of\",\"next_point\",\"operands\",\"output\",\"output_token\",\"parse_int\",\"path\",\"point_width\",\"pow2\",\"read_again\",\"read_end\",\"read_too_much\",\"rule_of\",\"running\",\"second_range\",\"shut\",\"signed\",\"size\",\"skip\",\"slow_decimal\",\"stdin\",\"string_equals\",\"string_length\",\"structured\",\"tape_len\",\"timed_out\",\"to_bool\",\"to_float\",\"to_int\",\"too_much\",\"wants_json\",\"width_of\",\"wrong\"],\"folded_operators\":49,\"folded_calls\":0,\"functions\":182}}";
}
