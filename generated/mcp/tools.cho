edition 5;

module mcp.tools;

// Generated by scripts/mcp.py from the tool's `introspect` and the compiler's
// authority report of the server -- do not edit (docs/mcp.md §3). The
// `tools/list` result, and for tool `i` the tables a call is checked against:
// its properties as flags (`property|flag|kind`, kind `bool`, `nat` or `text`),
// its operands in order (`property|min|max`, `max` empty for unbounded), how
// standard input reaches it (none), its output (`document` or `stream`), and the
// property that chooses its format (the answer is structured content only when
// it is `json`). Then the server's bounds and the sentences it says when it
// ends a call, and `introspect`.

pub fn list_result() -> [] &static [byte] {
    return "{\"tools\":[{\"name\":\"table\",\"description\":\"A CSV or TSV file as a table, read in one bounded streaming pass over an RFC 4180 reader: its shape, some columns (--select), the rows that satisfy a condition (--where, bytewise or exact integers, decimals or doubles), rows in order (--order-by), or counts, sums, means, minima, maxima and distinct counts of groups (--group, --agg, --sort, --top), as json pages or csv. Every refusal is a rule, with its hint. Three forms, chosen by the flags: the shape (FILE alone: the column names and the row count), rows (--select, --where or --order-by, then --top, --limit and --from to cut and page) and groups (--group or --agg, then --where, --sort, --top, --limit and --from). A mix is refused. args.conflict: --select or --order-by with --group or --agg, and --format text with rows or groups. args.required-flag: --limit, --from or --format csv with the shape, --top with neither --order-by, --group nor --agg, and --sort without --group or --agg. A page that was cut says data.next.from: pass it as --from. FILE is one path, relative to --root when given, and its first row is the header.\\n\\nThe file is read beneath the server's root: a path outside it, a `..` component or a link is refused with a rule (path.outside-root, path.dotdot, path.symlink). The answer is the tool's own output, byte for byte, and is bounded by the server: ask for fewer rows with `limit`, groups with `top`, columns with `select`. A refusal is an error result whose JSON names a `rule` and a `repair`; match on the rule.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"delimiter\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the field separator: a comma, the word tab (or a tab character), or a semicolon\",\"default\":\",\"},\"select\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the columns to return, a list: header names separated by commas, or #N for the Nth column (1-based), in the order given, and a repeat repeats the column. A comma, a backslash or a leading # in a name is written with a backslash before it. Examples: --select host,bytes and --select '#3,a\\\\,b' (the third column, then the column called a,b)\"},\"where\":{\"type\":\"string\",\"minLength\":1,\"description\":\"only the rows that satisfy this: conditions joined by and (no or, no parentheses), each COLUMN OP VALUE with OP one of = != < <= > >= contains, or COLUMN in (V1, V2). COLUMN is a header name or #N. With no suffix the cell is compared as text, bytewise, so 10 is less than 9. COLUMN:int compares exact integers, COLUMN:dec(N) exact decimals of at most N fractional digits, COLUMN:float doubles. A cell that is not one of those refuses the whole query (value.not-integer and the like), so keep such rows out first: bytes != '' and bytes:int > 5. A name or VALUE with spaces or operators is 'quoted' (a doubled quote is one quote). Examples: --where 'status = 404 and bytes:int > 1000' and --where 'host in (a, b) and path contains x'\"},\"group\":{\"type\":\"string\",\"minLength\":1,\"description\":\"count the rows by these columns instead of returning them: a list named as for --select, one row per distinct combination, in byte order unless --sort says otherwise. Examples: --group host and --group host,status\"},\"agg\":{\"type\":\"string\",\"minLength\":1,\"description\":\"what to compute, a comma-separated list of items (default count). An item is count, or FUNCTION:COLUMN with FUNCTION one of sum, min, max, mean, distinct and COLUMN a header name or #N. With no suffix sum, min, max and mean read the cells as exact integers and distinct as text. A suffix on COLUMN says how to read it: :int, :dec(S) for exact decimals of at most S fractional digits (S is 0 to 18, never rounded) or :float for doubles (min, max, distinct, and the exact sum and mean: sum:x:float and mean:x:float give the exact sum, or the exact sum over the count, rounded once to the nearest double, the same for every --threads, and a sum beyond the largest double is agg.float-overflow. A float mean takes no @N, so mean:x:float@2 is agg.bad-spec). mean of integers or decimals is rounded half to even at @N fractional digits written after the column, as mean:bytes@2, and @N may be left out only for a :dec(S) column, whose scale is the default. The output column is the item without its suffixes, as sum:price. A column really called x:dec(2) is written sum:x\\\\:dec(2). With --group the answer has a row per group, alone one row for all the rows. Examples: --agg count,sum:bytes,max:bytes and --agg 'sum:price:dec(2),mean:bytes@1'\"},\"sort\":{\"type\":\"string\",\"minLength\":1,\"description\":\"with --group or --agg, order the groups by one output column: count, an aggregate as printed (sum:bytes, mean:price) or a group column, with - before it for descending. Aggregates compare as numbers and group columns bytewise, ties go by the group columns. Without it the groups come in byte order of their columns. Examples: --sort -count and --sort sum:bytes\"},\"top\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"keep only the first N rows or groups (N at least 1) after sorting: with --order-by the first N sorted rows, with --group or --agg the first N groups in --sort order, so it needs one of them. --limit and --from page inside it. Examples: --top 10 and --top 3\"},\"limit\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000,\"description\":\"the most rows or groups in the answer (default 1000 as json, no limit as csv, ceiling 1000000), for --select, --where, --order-by, --group or --agg. A cut answer has truncated true and data.next.from, the --from of the next page. Examples: --limit 100 and --limit 20 --from 40\"},\"from\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"the 0-based row or group to start at, as data.next.from of a truncated answer says, for --select, --where, --order-by, --group or --agg. Each call is a fresh read. Examples: --from 1000 and --from 2000\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":67108864,\"description\":\"the most json rows returned hold, past it the answer is truncated with a next (ceiling 67108864)\",\"default\":1048576},\"max-groups\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000,\"description\":\"the most groups kept, one more is limit.too-many-groups (ceiling 1000000)\",\"default\":100000},\"max-distinct\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":10000000,\"description\":\"the most distinct values kept over all groups for distinct, one more is limit.too-many-distinct (ceiling 10000000)\",\"default\":100000},\"max-state-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1073741824,\"description\":\"the most bytes of group keys, distinct values or sorted rows kept (ceiling 1073741824)\",\"default\":67108864},\"order-by\":{\"type\":\"string\",\"minLength\":1,\"description\":\"sort the rows by these keys, a comma-separated list: each key is a header name or #N, with - before it for descending and :int after it to compare exact integers (otherwise bytewise, so 10 sorts before 9 and an empty cell first). A later key breaks ties of an earlier one, and ties keep the order of the file. Under :int a cell that is not an integer refuses the query (value.not-integer). A name that starts with - or ends in :int is written \\\\-name or name\\\\:int. Rows are held up to --max-sort-rows, so keep it under with --where or --top. Not with --group or --agg. Examples: --order-by -bytes:int and --order-by status,-bytes:int\"},\"max-sort-rows\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":20000000,\"description\":\"the most rows held to sort, one more is limit.too-many-sort-rows (ceiling 20000000)\",\"default\":1000000},\"threads\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":64,\"description\":\"how many threads read the file (1 to 64), for rows and groups only, on a file of at least --parallel-min-bytes of data: 1 is the sequential read and the answer of every other count is the same bytes\",\"default\":1},\"chunk-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1073741824,\"description\":\"the size of the range one thread reads at a time (with --threads), at least 1\",\"default\":4194304},\"parallel-min-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1073741824,\"description\":\"the smallest data (after the header) read by several threads, below it the read is sequential\",\"default\":1048576},\"max-rows\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000000,\"description\":\"the most data rows read, past it the answer says truncated (ceiling 1000000000)\",\"default\":10000000},\"max-line-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":16777216,\"description\":\"the longest line read and the most a kept record may hold, a longer one is limit.line-too-long (ceiling 16777216)\",\"default\":1048576},\"format\":{\"enum\":[\"json\",\"text\",\"csv\"],\"description\":\"json for a program, one document on standard output, text for a person (the shape only, do not parse it), csv for rows or groups as csv (it needs --select, --where, --order-by, --group or --agg). csv and text are not a json document: standard output is only the csv or the lines, a refusal is one line on standard error as table: RULE: message with the exit status, and rows already written stand, so a non-zero exit means the output is a prefix\",\"default\":\"json\"},\"file\":{\"type\":\"string\",\"description\":\"the one CSV file to read, a path relative to --root when given (absolute paths, .. and symbolic links are refused), whose first row is the header that --select, --where, --group, --agg and --order-by name columns by\"}},\"required\":[\"file\"],\"additionalProperties\":false},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}]}";
}

pub fn count() -> [] int {
    return 1;
}

pub fn name(i: int) -> [] &static [byte] {
    if i == 0 {
        return "table";
    }
    return "";
}

pub fn flags(i: int) -> [] &static [byte] {
    if i == 0 {
        return "delimiter|--delimiter|text;select|--select|text;where|--where|text;group|--group|text;agg|--agg|text;sort|--sort|text;top|--top|nat;limit|--limit|nat;from|--from|nat;max-bytes|--max-bytes|nat;max-groups|--max-groups|nat;max-distinct|--max-distinct|nat;max-state-bytes|--max-state-bytes|nat;order-by|--order-by|text;max-sort-rows|--max-sort-rows|nat;threads|--threads|nat;chunk-bytes|--chunk-bytes|nat;parallel-min-bytes|--parallel-min-bytes|nat;max-rows|--max-rows|nat;max-line-bytes|--max-line-bytes|nat;format|--format|text";
    }
    return "";
}

pub fn operands(i: int) -> [] &static [byte] {
    if i == 0 {
        return "file|1|1";
    }
    return "";
}

pub fn stdin(i: int) -> [] &static [byte] {
    if i == 0 {
        return "";
    }
    return "";
}

pub fn output(i: int) -> [] &static [byte] {
    if i == 0 {
        return "document";
    }
    return "";
