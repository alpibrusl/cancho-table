// The binary, beneath the directory the server's `Exec` is narrowed to.
pub fn path(i: int) -> [] &static [byte] {
    if i == 0 {
        return "/opt/cancho-table/bin/table";
    }
    return "";
}

pub fn default_timeout() -> [] int {
    return 30000;
}

pub fn default_output() -> [] int {
    return 2097152;
}

pub fn longest_line() -> [] int {
    return 4194304;
}

pub fn most_errors() -> [] int {
    return 65536;
}

// What the server tells a caller whose call it had to end (the `hint` of the error).
pub fn hint_too_large() -> [] &static [byte] {
    return "ask for less: `limit` caps the rows, `top` the groups (or the first rows of an order-by), `select` the columns, `where` the rows; do not raise `max-bytes` past the server's bound";
}

pub fn hint_timeout() -> [] &static [byte] {
    return "ask for less work: add `where`, `limit` or `top`, name fewer columns with `select`, or read a large file with more `threads`; the deadline is the server's --timeout-ms";
}

// `mcp introspect`.
pub fn introspect() -> [] &static [byte] {
    return "{\"tool\":\"mcp\",\"version\":\"0.1.0\",\"compiler\":\"a4572ea3b506e4bcec1c4be43deda1043c11ba9f\",\"summary\":\"An MCP server (stdio, JSON-RPC 2.0) that serves the tool `table` under one root: its input schema is derived from the tool's `introspect`, a call is a fixed argv with no shell, the answer is the tool's stdout, stderr and exit code unchanged, bounded in size and in time.\",\"usage\":\"mcp --root DIR [--timeout-ms N] [--max-output N] | mcp introspect\",\"output\":\"stdio\",\"protocol\":{\"transport\":\"stdio, one JSON-RPC 2.0 message per line\",\"version\":\"2025-06-18\",\"methods\":[\"initialize\",\"ping\",\"tools/list\",\"tools/call\"],\"notifications\":\"accepted and not answered\",\"max_line_bytes\":4194304},\"serves\":{\"tool\":\"table\",\"version\":\"0.3.0\",\"compiler\":\"a4572ea3b506e4bcec1c4be43deda1043c11ba9f\",\"bin\":\"/opt/cancho-table/bin\"},\"tools\":[\"table\"],\"flags\":[{\"name\":\"--root\",\"kind\":\"path\",\"role\":\"root\",\"default\":null,\"help\":\"the directory the tool serves: every FILE is resolved beneath it by the tool, which refuses absolute paths, `..` and links; required, absolute, given to the tool first and once\"},{\"name\":\"--timeout-ms\",\"kind\":\"nat\",\"role\":\"none\",\"default\":30000,\"help\":\"the deadline of one call: the tool is killed past it and the call ends as mcp.timeout\"},{\"name\":\"--max-output\",\"kind\":\"nat\",\"role\":\"none\",\"default\":2097152,\"help\":\"the most standard output of one call, in bytes: the tool is killed past it and the call ends as mcp.output-too-large\"}],\"limits\":[{\"name\":\"timeout-ms\",\"default\":30000},{\"name\":\"max-output\",\"default\":2097152},{\"name\":\"stderr\",\"default\":65536,\"note\":\"fixed: the tool's standard error beyond it ends the call as mcp.output-too-large\"},{\"name\":\"line\",\"default\":4194304,\"note\":\"fixed: a request line beyond it is refused as mcp.line-too-long\"}],\"rules\":[{\"rule\":\"mcp.parse-error\",\"answer\":\"jsonrpc -32700\",\"summary\":\"the line is not one JSON value\"},{\"rule\":\"mcp.invalid-request\",\"answer\":\"jsonrpc -32600\",\"summary\":\"not a JSON-RPC 2.0 request\"},{\"rule\":\"mcp.line-too-long\",\"answer\":\"jsonrpc -32600\",\"summary\":\"a request line longer than max_line_bytes\"},{\"rule\":\"mcp.unknown-method\",\"answer\":\"jsonrpc -32601\",\"summary\":\"a method other than initialize, ping, tools/list, tools/call\"},{\"rule\":\"mcp.unknown-tool\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a tool name other than table\"},{\"rule\":\"mcp.arguments-not-object\",\"answer\":\"jsonrpc -32602\",\"summary\":\"`arguments` is not an object\"},{\"rule\":\"mcp.unknown-argument\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a property the input schema does not have (data lists the real ones)\"},{\"rule\":\"mcp.wrong-type\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a property of the wrong type; every fault is listed in data.problems\"},{\"rule\":\"mcp.nul-in-argument\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a NUL byte in a string, which would arrive as two arguments\"},{\"rule\":\"mcp.timeout\",\"answer\":\"isError result\",\"summary\":\"the call ran past --timeout-ms; ask for less work: add `where`, `limit` or `top`, name fewer columns with `select`, or read a large file with more `threads`; the deadline is the server's --timeout-ms\"},{\"rule\":\"mcp.output-too-large\",\"answer\":\"isError result\",\"summary\":\"the output passed --max-output (or the error stream passed its bound); ask for less: `limit` caps the rows, `top` the groups (or the first rows of an order-by), `select` the columns, `where` the rows; do not raise `max-bytes` past the server's bound\"},{\"rule\":\"mcp.signaled\",\"answer\":\"isError result\",\"summary\":\"the tool was ended by a signal\"},{\"rule\":\"mcp.spawn\",\"answer\":\"isError result\",\"summary\":\"the tool could not be started or watched\"}],\"confinement\":{\"root\":\"every path argument is the tool's, resolved by it beneath --root; the server passes --root first and once, flag values as one `--name=value` argument and operands after `--`, with no shell\",\"exec\":\"the binary of the directory its Exec is narrowed to (baked at build time), by one fixed name\"},\"authority\":{\"bounded\":true,\"unbounded_by\":[],\"effects\":[\"args\",\"child_signal\",\"clock\",\"err_write\",\"exec\",\"heap\",\"io_read\",\"io_write\",\"pipe_read\",\"pipe_write\",\"poll\"],\"labels\":[{\"name\":\"args\",\"argument\":null,\"bounded\":true},{\"name\":\"child_signal\",\"argument\":null,\"bounded\":true},{\"name\":\"clock\",\"argument\":null,\"bounded\":true},{\"name\":\"err_write\",\"argument\":null,\"bounded\":true},{\"name\":\"exec\",\"argument\":\"/opt/cancho-table/bin\",\"bounded\":true},{\"name\":\"heap\",\"argument\":null,\"bounded\":true},{\"name\":\"io_read\",\"argument\":null,\"bounded\":true},{\"name\":\"io_write\",\"argument\":null,\"bounded\":true},{\"name\":\"pipe_read\",\"argument\":null,\"bounded\":true},{\"name\":\"pipe_write\",\"argument\":null,\"bounded\":true},{\"name\":\"poll\",\"argument\":null,\"bounded\":true}],\"foreign_symbols\":[],\"pure\":[\"a_or_an\",\"abs\",\"at\",\"base\",\"bit_length\",\"bit_length_of\",\"bytes\",\"channels\",\"channels_with_errors\",\"child_token\",\"close\",\"compare\",\"count\",\"count\",\"count_byte\",\"decode\",\"default_output\",\"default_timeout\",\"digit_of\",\"equal\",\"err_control\",\"err_depth\",\"err_end\",\"err_escape\",\"err_full\",\"err_number\",\"err_syntax\",\"err_trailing\",\"err_utf8\",\"errors_token\",\"escape_width\",\"exact_pow10\",\"exited\",\"expected_of\",\"failed\",\"fault_at\",\"field\",\"fine\",\"finish\",\"fits_int\",\"flags\",\"get\",\"hex4\",\"hex_digit\",\"hex_value\",\"hint_timeout\",\"hint_too_large\",\"in_range\",\"input_token\",\"introspect\",\"is_array\",\"is_bool\",\"is_digit\",\"is_digit\",\"is_int\",\"is_object\",\"is_string\",\"is_tail\",\"is_ws\",\"is_zero\",\"kind\",\"kind_name\",\"kind_of\",\"known\",\"ldexp\",\"lead_bits\",\"list\",\"list_result\",\"longest_line\",\"longest_line\",\"max_depth\",\"min\",\"most_errors\",\"name\",\"nat_of\",\"next_point\",\"operands\",\"output\",\"output_token\",\"parse_int\",\"path\",\"point_width\",\"pow2\",\"read_again\",\"read_end\",\"read_too_much\",\"rule_of\",\"running\",\"second_range\",\"shut\",\"signed\",\"size\",\"skip\",\"slow_decimal\",\"stdin\",\"string_equals\",\"string_length\",\"structured\",\"tape_len\",\"timed_out\",\"to_bool\",\"to_float\",\"to_int\",\"too_much\",\"wants_json\",\"width_of\",\"wrong\"],\"folded_operators\":49,\"folded_calls\":0,\"functions\":182}}";
}
