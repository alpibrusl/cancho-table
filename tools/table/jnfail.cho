edition 5;

module jnfail;

// The refusals that only a join raises (docs/joins.md sections 4.1, 5.6, 6.3 and 6.5): a column of `--on` that a header lacks or has twice, the same name on both sides, the build
// past the bound, and more rows than `--max-join-rows`. Every one names which input it is about (`detail.input`, `probe` or `build`) and carries the facts the run knows.
// The other refusals of a join (a bad quote, a ragged row, a long line, a typed `--where` read) are the rules of one file and are raised by `finish.explain` as for a file, with
// that file's path.

import std.buffer;
import std.bytes;
import std.json;
import std.vec;
import dtjoin;
import finish;
import jnguard;
import jnswap;
import toolbox.cli;
import toolbox.fail;
import toolbox.text;

// The header's names as a json array in the detail: at most `most`, and whether there were more.
fn put_names[&h, &n, &d](heap: &!h Heap, w: json.Writer, key: &static [byte], names: &n buffer.Buffer, ends: &d vec.Vec[int], most: int) -> [heap] json.Writer {
    var o = json.put_key(heap, w, key);
    o = json.begin_array(heap, o);
    var j = 0;
    var start = 0;
    while j < vec.size(ends) && j < most {
        let to = vec.get(ends, j);
        o = text.put(heap, o, buffer.bytes(names)[start..to]);
        start = to;
        j = j + 1;
    }
    return json.end_array(heap, o);
}

// A name that `flag` (`--on` or `--join-where`) gave that the header of `input` does not have (status 1) or has more than once (status 2): `column.unknown` and `column.ambiguous`, as `--where` and
// `--select` refuse a name, with the header listed.
pub fn name_column[&h, &n, &d, &s, &w](heap: &!h Heap, e: fail.Errors, status: int, flag: &static [byte], input: &static [byte], shown: &s [byte], wanted: &w [byte], names: &n buffer.Buffer, ends: &d vec.Vec[int]) -> [heap] fail.Errors {
    var rule = "column.unknown";
    var what = "--on names a column that the header does not have";
    var hint = "pick from detail.available: the left name is a column of FILE and the right one a column of the --join file";
    if bytes.equal(flag, "--join-where") {
        what = "--join-where names a column that the header of the --join file does not have";
        hint = "pick from detail.available: a condition of --join-where names the columns of the --join file by their own names";
    }
    if status == 2 {
        rule = "column.ambiguous";
        what = "--on names a column that the header has more than once";
        if bytes.equal(flag, "--join-where") {
            what = "--join-where names a column that the header of the --join file has more than once";
        }
        hint = "name it by position, as #3 for the third column";
    }
    var o = fail.open_in(heap, finish.extra(), rule, what, hint);
    o = fail.repair_none(heap, o, "which column was meant is not known; detail.available lists the header");
    o = fail.detail_open(heap, o);
    o = fail.detail_str(heap, o, "flag", flag);
    o = fail.detail_str(heap, o, "input", input);
    o = fail.detail_text(heap, o, "path", shown);
    o = fail.detail_text(heap, o, "name", wanted);
    o = fail.detail_int(heap, o, "columns", vec.size(ends));
    o = put_names(heap, o, "available", names, ends, 50);
    o = fail.detail_bool(heap, o, "available_truncated", vec.size(ends) > 50);
    return fail.add(heap, e, o);
}

// A name `--on` gave that the header of `input` does not have (status 1) or has more than once (status 2).
pub fn key_column[&h, &n, &d, &s, &w](heap: &!h Heap, e: fail.Errors, status: int, input: &static [byte], shown: &s [byte], wanted: &w [byte], names: &n buffer.Buffer, ends: &d vec.Vec[int]) -> [heap] fail.Errors {
    return name_column(heap, e, status, "--on", input, shown, wanted, names, ends);
}

// Whether build column `j`, written with `prefix` before it, is the name of a column of the probe header.
fn collides[&a, &b, &x, &y, &p](pnames: &a buffer.Buffer, pends: &b vec.Vec[int], bnames: &x buffer.Buffer, bends: &y vec.Vec[int], j: int, prefix: &p [byte]) -> [] bool {
    var from = 0;
    if j > 0 {
        from = vec.get(bends, j - 1);
    }
    let name = buffer.bytes(bnames)[from..vec.get(bends, j)];
    var i = 0;
    var start = 0;
    while i < vec.size(pends) {
        let to = vec.get(pends, i);
        let other = buffer.bytes(pnames)[start..to];
        if len(other) == len(prefix) + len(name) && bytes.starts_with(other, prefix) && bytes.equal(other[len(prefix)..len(other)], name) {
            return true;
        }
        start = to;
        i = i + 1;
    }
    return false;
}

// How many build columns would collide with the probe header under `prefix`; a column `dropped` marks (the build column of a shared-name key, which the answer leaves out) cannot.
pub fn collisions[&a, &b, &x, &y, &p, &z](pnames: &a buffer.Buffer, pends: &b vec.Vec[int], bnames: &x buffer.Buffer, bends: &y vec.Vec[int], prefix: &p [byte], dropped: &z [int]) -> [] int {
    var n = 0;
    var j = 0;
    while j < vec.size(bends) {
        if dropped[j] == 0 && collides(pnames, pends, bnames, bends, j, prefix) {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

// The name of the build file without its directory and its last extension, then an underscore: the prefix the repair suggests.
fn stem_prefix[&h, &s](heap: &!h Heap, shown: &s [byte]) -> [heap] buffer.Buffer {
    var begin = 0;
    var i = 0;
    while i < len(shown) {
        if int_of(shown[i]) == '/' {
            begin = i + 1;
        }
        i = i + 1;
    }
    var end = len(shown);
    var k = begin + 1;
    while k < len(shown) {
        if int_of(shown[k]) == '.' {
            end = k;
        }
        k = k + 1;
    }
    var out = buffer.empty(heap, 32);
    if end > begin {
        out = buffer.append(heap, out, shown[begin..end]);
    } else {
        out = buffer.append(heap, out, "join");
    }
    return buffer.push(heap, out, byte_of('_'));
}

// `join.column-collision`: a name that both headers have, with the prefix given (or ""). Nothing is renamed. The repair is the invocation with `--join-prefix` and the stem of the build
// file's name, offered only when no prefix was given and the result has no collision; otherwise there is none.
pub fn collision[&h, &g, &p, &a, &b, &x, &y, &q, &s, &z](heap: &!h Heap, e: fail.Errors, args: &g Args, parsed: &p cli.Parsed, pnames: &a buffer.Buffer, pends: &b vec.Vec[int], bnames: &x buffer.Buffer, bends: &y vec.Vec[int], prefix: &q [byte], shown: &s [byte], given: bool, dropped: &z [int]) -> [heap, args] fail.Errors {
    var o = fail.open_in(heap, finish.extra(), "join.column-collision", "a column name is in both files, and the joined row would have it twice (nothing is renamed on the way)", "give the --join file's columns a prefix with --join-prefix, or select and name them by position");
    let stem = stem_prefix(heap, shown);
    var good = false;
    borrow stem as &sr in {
        good = !given && collisions(pnames, pends, bnames, bends, buffer.bytes(sr), dropped) == 0;
    }
    if good {
        var c = fail.choose_open(heap, o);
        c = fail.choose_option_open(heap, c);
        var i = 0;
        while i < arg_count(args) {
            c = fail.choose_arg(heap, c, arg(args, i));
            i = i + 1;
        }
        c = fail.choose_arg(heap, c, "--join-prefix");
        borrow stem as &sr in {
            c = fail.choose_arg(heap, c, buffer.bytes(sr));
        }
        c = fail.choose_option_close(heap, c);
        o = fail.choose_close(heap, c);
    } else if given {
        o = fail.repair_none(heap, o, "a prefix was given and the names still collide: choose another one");
    } else {
        o = fail.repair_none(heap, o, "the file name as a prefix would collide too: choose a prefix");
    }
    buffer.drop(heap, stem);
    o = fail.detail_open(heap, o);
    o = fail.detail_text(heap, o, "path", shown);
    o = json.put_key(heap, o, "columns");
    o = json.begin_array(heap, o);
    var listed = 0;
    var found = 0;
    var j = 0;
    while j < vec.size(bends) {
        if dropped[j] == 0 && collides(pnames, pends, bnames, bends, j, prefix) {
            found = found + 1;
            if listed < 32 {
                var from = 0;
                if j > 0 {
                    from = vec.get(bends, j - 1);
                }
                o = text.put(heap, o, buffer.bytes(bnames)[from..vec.get(bends, j)]);
                listed = listed + 1;
            }
        }
        j = j + 1;
    }
    o = json.end_array(heap, o);
    o = fail.detail_int(heap, o, "collisions", found);
    o = fail.detail_text(heap, o, "prefix", prefix);
    return fail.add(heap, e, o);
}

// `limit.state-too-large` for the build: the rows already held fit, the one named does not. Everything in it is exact; nothing is projected (the rest of the file is unread). The repair is the call with the two
// files exchanged when `offer` has one (docs/joins.md section 22: `jnswap`), and otherwise `none` with the reason the exchange is not offered.
pub fn build_too_large[&h, &s, &q](heap: &!h Heap, e: fail.Errors, shown: &s [byte], limit: int, held: int, rows_held: int, row: int, line: int, bytes_read: int, file_bytes: int, offer: &q jnswap.Offer) -> [heap] fail.Errors {
    var o = fail.open_in(heap, finish.extra(), "limit.state-too-large", "the --join file is held in memory and the rows held would pass --max-state-bytes", "name fewer columns of the --join file (the build holds only the columns the plan names), or make the smaller file the --join file (the repair, when there is one, is the call with the two files exchanged: it gives the same rows, in the order of the other file, and the columns as they were), or raise --max-state-bytes, up to the ceiling introspect names: it counts the bytes the join holds, and resident memory can be up to about three times that while the build grows. There is no join on disk");
    if offer.offered {
        var c = fail.choose_open(heap, o);
        c = fail.choose_option_open(heap, c);
        let all = buffer.bytes(offer.argv);
        var at = 0;
        var i = 0;
        while i < len(all) {
            if int_of(all[i]) == 0 {
                c = fail.choose_arg(heap, c, all[at..i]);
                at = i + 1;
            }
            i = i + 1;
        }
        c = fail.choose_option_close(heap, c);
        o = fail.choose_close(heap, c);
    } else {
        o = fail.repair_none(heap, o, buffer.bytes(offer.reason));
    }
    o = fail.detail_open(heap, o);
    o = fail.detail_str(heap, o, "holder", "join-build");
    o = fail.detail_str(heap, o, "input", "build");
    o = fail.detail_text(heap, o, "path", shown);
    o = fail.detail_int(heap, o, "limit", limit);
    o = fail.detail_int(heap, o, "held", held);
    o = fail.detail_int(heap, o, "rows_held", rows_held);
    o = fail.detail_int(heap, o, "build_row", row);
    o = fail.detail_int(heap, o, "build_line", line);
    o = fail.detail_int(heap, o, "build_bytes_read", bytes_read);
    o = fail.detail_int(heap, o, "build_file_bytes", file_bytes);
    return fail.add(heap, e, o);
}

// The cells of a key as a json array in the detail (docs/joins.md section 23): `shown` holds, for each of the `pairs` pairs, a byte (the bytes kept, at most 64, in the low 7 bits, and 128 when the cell was cut)
// and then those bytes. Answers whether a cell was cut.
fn put_key_cells[&h, &d](heap: &!h Heap, w: json.Writer, name: &static [byte], shown: &d [byte], pairs: int) -> [heap] (json.Writer, bool) {
    var o = json.put_key(heap, w, name);
    o = json.begin_array(heap, o);
    var at = 0;
    var cut = false;
    var j = 0;
    while j < pairs && at < len(shown) {
        let b = int_of(shown[at]);
        let n = b & 127;
        if b >= 128 {
            cut = true;
        }
        o = text.put(heap, o, shown[at + 1..at + 1 + n]);
        at = at + 1 + n;
        j = j + 1;
    }
    o = json.end_array(heap, o);
    return (o, cut);
}

// `join.not-sorted` (docs/joins.md section 23): the row `row` (at line `line`) of the file `input` has a key below the key of the row `prow` (line `pline`) before it, in a call that declared both files
// sorted. `key` and `prev` are the key cells (see `put_key_cells`).
pub fn not_sorted[&h, &s, &k, &q](heap: &!h Heap, e: fail.Errors, input: &static [byte], shown: &s [byte], row: int, line: int, prow: int, pline: int, key: &k [byte], prev: &q [byte], pairs: int) -> [heap] fail.Errors {
    var o = fail.open_in(heap, finish.extra(), "join.not-sorted", "a file given to --join-sorted is not in ascending order of the join key: this row has a key below the key of the row before it", "sort both files by the key, which table --order-by KEY --format csv does bytewise for a text key and by value for a typed one, or run the join without --join-sorted, which does not need them in order");
    o = fail.repair_none(heap, o, "the files have to be sorted by the key before they are joined, and what order was meant is not known");
    o = fail.detail_open(heap, o);
    o = fail.detail_str(heap, o, "input", input);
    o = fail.detail_text(heap, o, "path", shown);
    o = fail.detail_int(heap, o, "row", row);
    o = fail.detail_int(heap, o, "line", line);
    o = fail.detail_int(heap, o, "previous_row", prow);
    o = fail.detail_int(heap, o, "previous_line", pline);
    let (o2, cut1) = put_key_cells(heap, o, "key", key, pairs);
    let (o3, cut2) = put_key_cells(heap, o2, "previous_key", prev, pairs);
    o = fail.detail_bool(heap, o3, "key_truncated", cut1 || cut2);
    return fail.add(heap, e, o);
}

// `limit.state-too-large` for the rows of one key of the build that `--join-sorted` holds at a time: the rows of the group already held fit, the one named does not. `key` is the group's key (see `put_key_cells`).
pub fn group_too_large[&h, &s, &k](heap: &!h Heap, e: fail.Errors, shown: &s [byte], limit: int, held: int, rows_held: int, row: int, line: int, key: &k [byte], pairs: int) -> [heap] fail.Errors {
    var o = fail.open_in(heap, finish.extra(), "limit.state-too-large", "the rows of one key of the --join file, held while --join-sorted joins them, would pass --max-state-bytes", "raise --max-state-bytes, up to the ceiling introspect names, keep fewer of the rows of that key with --join-where, or join on more columns so that no key repeats so many rows");
    o = fail.repair_none(heap, o, "which rows of the key to leave out is not known");
    o = fail.detail_open(heap, o);
    o = fail.detail_str(heap, o, "holder", "join-group");
    o = fail.detail_str(heap, o, "input", "build");
    o = fail.detail_text(heap, o, "path", shown);
    o = fail.detail_int(heap, o, "limit", limit);
    o = fail.detail_int(heap, o, "held", held);
    o = fail.detail_int(heap, o, "rows_held", rows_held);
    o = fail.detail_int(heap, o, "build_row", row);
    o = fail.detail_int(heap, o, "build_line", line);
    let (o2, cut) = put_key_cells(heap, o, "group_key", key, pairs);
    return fail.add(heap, e, fail.detail_bool(heap, o2, "group_key_truncated", cut));
}

// `limit.state-too-large` for the groups or the rows held to sort, which share `--max-state-bytes` with the build (docs/joins.md section 6.3): `build_bytes` is what the build holds, `held` what the groups (their keys)
// or the sorted rows held before the one that did not fit, and the bound those were given is `limit` minus `build_bytes`.
pub fn shared_too_large[&h, &s](heap: &!h Heap, e: fail.Errors, groups: bool, shown: &s [byte], limit: int, build_bytes: int, held: int) -> [heap] fail.Errors {
    var what = "the rows kept to sort hold more than --max-state-bytes bytes, counting the bytes the --join file holds";
    var hint = "ask for the first rows only with --top N or a smaller --limit, keep fewer or narrower rows with --where, make the --join file smaller with --join-where, or raise --max-state-bytes, up to the ceiling introspect names";
    var holder = "sort";
    if groups {
        what = "the group keys and distinct values kept hold more than --max-state-bytes bytes, counting the bytes the --join file holds";
        hint = "raise --max-state-bytes, up to the ceiling introspect names, group by shorter values, or make the --join file smaller with --join-where";
        holder = "groups";
    }
    var o = fail.open_in(heap, finish.extra(), "limit.state-too-large", what, hint);
    o = fail.repair_none(heap, o, "how large the whole is was not measured past the limit");
    o = fail.detail_open(heap, o);
    o = fail.detail_str(heap, o, "holder", holder);
    o = fail.detail_text(heap, o, "path", shown);
    o = fail.detail_int(heap, o, "limit", limit);
    o = fail.detail_int(heap, o, "build_bytes", build_bytes);
    o = fail.detail_int(heap, o, "held", held);
    return fail.add(heap, e, o);
}

// `limit.too-many-join-rows`: the row that would be the one past `--max-join-rows`, of the probe row named; `matches` is the exact number of build rows its key has, and
// `max_matches` the most any probe row up to it had.
pub fn too_many_rows[&h, &s](heap: &!h Heap, e: fail.Errors, shown: &s [byte], limit: int, probe_row: int, probe_line: int, matches: int, max_matches: int) -> [heap] fail.Errors {
    var o = fail.open_in(heap, finish.extra(), "limit.too-many-join-rows", "the join would produce more rows than --max-join-rows", "if detail.matches is large the --join file repeats this key: remove the duplicates, or make the other file the --join file, otherwise raise --max-join-rows, up to the ceiling introspect names, or page with --limit");
    o = fail.repair_none(heap, o, "which of the two files should be changed is not known");
    o = fail.detail_open(heap, o);
    o = fail.detail_str(heap, o, "input", "probe");
    o = fail.detail_text(heap, o, "path", shown);
    o = fail.detail_int(heap, o, "limit", limit);
    o = fail.detail_int(heap, o, "probe_row", probe_row);
    o = fail.detail_int(heap, o, "probe_line", probe_line);
    o = fail.detail_int(heap, o, "matches", matches);
    o = fail.detail_int(heap, o, "max_matches_so_far", max_matches);
    return fail.add(heap, e, o);
}

// A key cell that is not of the type its pair was given (docs/joins.md section 5.2): the rule of the rest of the tool, with `context` "join", which file it was in (`input`), the pair of `--on`
// (counted from 1), the column by the name its own header gives it, the row and line of its own file and the cell. `status` is the answer of `query.parse_typed`: 4 not an integer, 5 past 64 bits,
// 6 not a decimal, 7 more fractional digits than the scale, 8 too wide, 9 not a float, 10 inf or nan, 11 past the range, 12 rounds to zero, 13 too long. An empty cell is not of any type.
pub fn typed_key[&h, &g, &p, &s, &n, &v, &a, &b](heap: &!h Heap, e: fail.Errors, status: int, input: &static [byte], shown: &s [byte], column: &n [byte], row: int, line: int, value: &v [byte], pair: int, scale: int, digits: int, args: &g Args, parsed: &p cli.Parsed, gnames: &a buffer.Buffer, gends: &b vec.Vec[int], gcol: int) -> [heap, args] fail.Errors {
    if status >= 14 {
        // a :date, :timestamp or :datetime key cell: the rules of the date types (dtjoin.cho)
        return dtjoin.key_refusal(heap, e, status, input, shown, column, row, line, value, pair);
    }
    var rule = "value.not-integer";
    var what = "a key cell is not an exact integer: an optional sign and digits, nothing else (an empty cell is not one)";
    if status == 5 {
        rule = "value.integer-overflow";
        what = "a key cell is an integer that does not fit 64 bits";
    } else if status == 6 {
        rule = "value.not-decimal";
        what = "a key cell is not a decimal: digits and at most one point, optionally signed, nothing else (an empty cell is not one)";
    } else if status == 7 {
        rule = "value.decimal-scale";
        what = "a key cell has more fractional digits than the scale of its pair; a decimal is never rounded";
    } else if status == 8 {
        rule = "value.decimal-too-wide";
        what = "a key cell has 18 or more significant digits once scaled to the scale of its pair";
    } else if status == 9 {
        rule = "value.not-float";
        what = "a key cell is not a number: digits, a point and an exponent, optionally signed, nothing else (an empty cell is not one)";
    } else if status == 10 {
        rule = "value.not-finite";
        what = "a key cell is inf or nan, which are not numbers here: a NaN would break equality";
    } else if status == 11 || status == 12 {
        rule = "value.float-range";
        what = "a key cell is outside the range of a double, or a non-zero number so small that it would read as zero";
    } else if status == 13 {
        rule = "limit.number-too-long";
        what = "a key cell is longer than 1,100 bytes, the longest cell that can be a double";
    }
    var o = fail.open_in(heap, finish.extra(), rule, what, "a typed key is read from every row and refused at the first cell that is not of its type; keep such rows out with a condition that runs before the key is read (for the --join file, --join-where; for FILE, a leading text condition of --where, which is applied before the key), write the pair without its type to compare the cells as text, or correct the file");
    // an empty cell has a guard: the invocation with `KEY != ''` in the filter that runs before the key is read
    var guarded = false;
    if len(value) == 0 {
        var flag = "--where";
        if bytes.equal(input, "build") {
            flag = "--join-where";
        }
        let key = jnguard.name_for(heap, gnames, gends, gcol);
        borrow key as &kr in {
            let (o2, ok) = jnguard.guarded(heap, o, args, parsed, flag, buffer.bytes(kr));
            o = o2;
            guarded = ok;
        }
        buffer.drop(heap, key);
    }
    if !guarded {
        o = fail.repair_none(heap, o, "what the cell was meant to be is not known");
    }
    o = fail.detail_open(heap, o);
    o = fail.detail_text(heap, o, "path", shown);
    o = fail.detail_str(heap, o, "context", "join");
    o = fail.detail_str(heap, o, "input", input);
    o = fail.detail_int(heap, o, "pair", pair);
    o = fail.detail_text(heap, o, "column", column);
    o = fail.detail_int(heap, o, "row", row);
    o = fail.detail_int(heap, o, "line", line);
    o = fail.detail_text(heap, o, "value", value);
    o = fail.detail_bool(heap, o, "value_truncated", len(value) >= 64);
    if status >= 6 && status <= 8 {
        o = fail.detail_int(heap, o, "scale", scale);
    }
    if status == 7 {
        o = fail.detail_int(heap, o, "digits", digits);
    }
    if status == 11 {
        o = fail.detail_str(heap, o, "direction", "overflow");
    } else if status == 12 {
        o = fail.detail_str(heap, o, "direction", "underflow");
    }
    return fail.add(heap, e, o);
}
