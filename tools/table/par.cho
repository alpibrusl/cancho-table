edition 5;

module par;

// The data records of the file read by several threads, and answered as the sequential
// read answers: the same bytes, the same refusal, the same row and line named. docs/parallel.md
// is the design and what it rests on; this is the shape of it.
//
// The file after the header is cut into ranges of about `chunk` bytes, each beginning
// where a line does (`align`). A wave of up to `threads` ranges is read at once, each by
// a thread of its own with a `File` of its own and an `Heap` forked from the parent's, and
// each *assuming* its first line begins a record, which is true unless a quoted field
// holds the newline before it. A range's records are the ones that start in it, and the
// last may run into the next range, so a range ends where its last record ends, and the
// next range's guess is right exactly when that is where the next range begins. The
// parent takes the ranges in file order, keeping a position `cur` (where the sequential
// read would be): a range whose guess is right, whose thread finished without anything
// that the sequential read would have stopped at, and whose effect on the answer can be
// added without reading the file in order (`accept`) is taken as it is; anything else the
// parent reads again itself, from `cur`, with the sequential rules and its own state. So
// the answer is the sequential one by construction, wherever the threads were
// speculating wrongly or the answer depends on order, and faster only where they were
// not.
//
// What a thread can hand back is bytes in a slot the parent owns (a `join` result is one
// leaf, and a field of a `&!` struct cannot be replaced), and each thread's frame is one
// level of a recursion (a spawn needs a function value of its own and a reference
// that lives until its join, so the number of threads is the depth of a call, not a loop).

import std.buffer;
import std.vec;
import agg;
import engine;
import query;
import report;
import scan;
import toolbox.out;
import toolbox.path;
import toolbox.place;

// The slot: a header of 36 integers, then the payload.
//   0 status (0 the range was read and nothing in it needs the parent, 1 it does, 2 not run)
//   1 where the next record starts   2 lines before it   3 the payload's length
//   4.. the tally of the range (`engine.k_*`, 32 integers)
pub fn header_bytes() -> [] int {
    return 8 * 36;
}

fn j_start() -> [] int {
    return scan.p_count();
}

fn j_until() -> [] int {
    return scan.p_count() + 1;
}

fn j_columns() -> [] int {
    return scan.p_count() + 2;
}

fn j_payload() -> [] int {
    return scan.p_count() + 3;
}

// the partitioned grouping's: how many blobs a range's groups are cut into (0: one, the old way), how many splitters, how many group fields
fn j_parts() -> [] int {
    return scan.p_count() + 4;
}

fn j_nsplit() -> [] int {
    return scan.p_count() + 5;
}

fn j_fields() -> [] int {
    return scan.p_count() + 6;
}

fn j_size() -> [] int {
    return 24;
}

res struct Job {
    heap: Heap,
    file: File,
    tree: query.Query,
    cols: Box[[int]],
    sel: Box[[int]],
    par: Box[[int]],
    out: Box[[byte]],
    split: Box[[byte]],
    soff: Box[[int]],
}

// A thread: read the range of its job, write the answer into its slot.
fn work[&r](w: &!r Job) -> [heap, file_read] int {
    let na = query.agg_count(w.tree);
    let mode = contents(w.par)[scan.p_mode()];
    var a = box_slice(w.heap, engine.k_size(), 0);
    var cells = box_slice(w.heap, 3 * (contents(w.par)[j_columns()] + 1), 0);
    var rows = buffer.empty(w.heap, 65536);
    var scratch = buffer.empty(w.heap, 256);
    var escr = buffer.empty(w.heap, 16);
    var kept = buffer.empty(w.heap, 64);
    var groups = agg.start(w.heap, w.tree);
    var next_at = 0;
    var lines_read = 0;
    var status = 0;
    var clean = 0;
    var used = 0;
    var payload = 0;
    borrow mut a as &!aw in {
        borrow mut cells as &!cw in {
            let t = contents(aw);
            t[engine.k_columns()] = contents(w.par)[j_columns()];
            let (x, l, s, r2, s2, e2, k2, g2) = scan.scan_range(w.heap, w.file, contents(w.par), w.tree, contents(w.cols), contents(w.sel), contents(cw), t, rows, scratch, escr, kept, groups, contents(w.par)[j_start()], contents(w.par)[j_until()]);
            next_at = x;
            lines_read = l;
            status = s;
            rows = r2;
            scratch = s2;
            escr = e2;
            kept = k2;
            groups = g2;
            if s == 0 && t[engine.k_abort()] == 0 && t[engine.k_stop()] == 0 && t[engine.k_capped()] == 0 && t[engine.k_more()] == 0 {
                clean = 1;
            }
            // The answer: the payload first (so that its size can be told), then the header.
            let o = contents(w.out);
            let room = len(o) - header_bytes();
            if clean == 1 && mode == 1 {
                borrow rows as &rr in {
                    let bytes_out = buffer.bytes(rr);
                    if len(bytes_out) <= room {
                        copy_into(o[header_bytes()..header_bytes() + len(bytes_out)], bytes_out);
                        payload = len(bytes_out);
                    } else {
                        clean = 0;
                    }
                }
            } else if clean == 1 {
                borrow groups as &gr in {
                    var n = 0;
                    if query.reporting(w.tree) {
                        n = report.serialize(gr, o[header_bytes()..len(o)]);
                    } else if contents(w.par)[j_parts()] > 0 {
                        let np = contents(w.par)[j_parts()];
                        var scratch_w = box_slice(w.heap, 2 * agg.groups(gr) + 6 * np + 8, 0);
                        borrow mut scratch_w as &!sw2 in {
                            n = agg.serialize_parts(gr, o[header_bytes()..len(o)], contents(w.split), contents(w.soff), contents(w.par)[j_nsplit()], np, contents(w.par)[j_fields()], contents(sw2));
                        }
                        unbox_slice(w.heap, scratch_w);
                    } else {
                        n = agg.serialize(gr, o[header_bytes()..len(o)]);
                    }
                    if n < 0 {
                        clean = 0;
                    } else {
                        payload = n;
                    }
                }
            }
            if clean == 1 {
                agg.put_i64(o, 0, 0);
            } else {
                agg.put_i64(o, 0, 1);
            }
            agg.put_i64(o, 8, next_at);
            agg.put_i64(o, 16, lines_read);
            agg.put_i64(o, 24, payload);
            var i = 0;
            while i < engine.k_size() {
                agg.put_i64(o, 32 + 8 * i, t[i]);
                i = i + 1;
            }
        }
    }
    unbox_slice(w.heap, a);
    unbox_slice(w.heap, cells);
    buffer.drop(w.heap, rows);
    buffer.drop(w.heap, scratch);
    buffer.drop(w.heap, escr);
    buffer.drop(w.heap, kept);
    agg.drop(w.heap, groups);
    return 0;
}

fn copy_ints[&h, &s](heap: &!h Heap, from: &s [int]) -> [heap] Box[[int]] {
    let out = box_slice(heap, len(from) + 1, 0);
    var o = out;
    borrow mut o as &!ow in {
        let t = contents(ow);
        var i = 0;
        while i < len(from) {
            t[i] = from[i];
            i = i + 1;
        }
    }
    return o;
}

fn copy_bytes[&h, &s](heap: &!h Heap, from: &s [byte]) -> [heap] Box[[byte]] {
    let out = box_slice(heap, len(from) + 1, byte_of(0));
    var o = out;
    borrow mut o as &!ow in {
        copy_into(contents(ow)[0..len(from)], from);
    }
    return o;
}

// One level of a wave: make job `k`, start its thread, make the rest, join it, and move its
// slot up. `plan` holds where the ranges begin (`plan[k]`, and `plan[n]` where the last ends).
fn fan[&p, &f, &x, &y, &z, &t, &c, &s, &r, &l, &u, &m, &e](parent: &!p Heap, fs: &f Fs(""), root: &x [byte], rel: &y [byte], full: &z [byte], tree: &t query.Query, cols: &c [int], sel: &s [int], par: &r [int], plan: &l [int], slots: &!u [byte], split: &m [byte], soff: &e [int], k: int, n: int, slot_bytes: int) -> [heap, conc, file_read, fs_read(""), dir_read] int {
    if k >= n {
        return 0;
    }
    match place.open_operand(fs, root, rel, full) {
        Opened::Failed(reason) => {
            return 1;
        }
        Opened::Ok(file) => {
            let forked = fork_heap(parent);
            let own = copy_ints(parent, par);
            var job = Job { heap: forked, file: file, tree: query.duplicate(parent, tree), cols: copy_ints(parent, cols), sel: copy_ints(parent, sel), par: own, out: box_slice(parent, slot_bytes, byte_of(0)), split: copy_bytes(parent, split), soff: copy_ints(parent, soff) };
            borrow mut job as &!kj in {
                contents(kj.par)[j_start()] = plan[k];
                contents(kj.par)[j_until()] = plan[k + 1];
            }
            var rest = 0;
            borrow mut job as &!kj in {
                let body = work;
                let thread = spawn(kj, body);
                rest = fan(parent, fs, root, rel, full, tree, cols, sel, par, plan, slots, split, soff, k + 1, n, slot_bytes);
                join(thread);
            }
            let Job { heap, file, tree, cols, sel, par, out, split, soff } = job;
            file_close(file);
            release(heap);
            query.drop(parent, tree);
            unbox_slice(parent, cols);
            unbox_slice(parent, sel);
            unbox_slice(parent, par);
            unbox_slice(parent, split);
            unbox_slice(parent, soff);
            var used = header_bytes();
            borrow out as &ob in {
                used = used + agg.get_i64(contents(ob), 24);
                copy_into(slots[k * slot_bytes..k * slot_bytes + used], contents(ob)[0..used]);
            }
            unbox_slice(parent, out);
            return rest;
        }
    }
}

// The first offset at or after `p` that begins a line (the byte before it is a newline), or
// `size` when there is none within a megabyte: a range that cannot be aligned is not made.
fn align[&h, &f](heap: &!h Heap, file: &!f File, p: int, size: int) -> [heap, file_read] int {
    if p >= size {
        return size;
    }
    var window = buffer.empty(heap, 65536);
    var at = p - 1;
    var found = size;
    var rounds = 0;
    var going = true;
    while going && rounds < 16 {
        var got = 0;
        borrow mut window as &!ww in {
            buffer.clear(ww);
            match file_pread(file, at, buffer.room(ww)) {
                Read::Got(n) => {
                    buffer.filled(ww, n);
                    got = n;
                }
                Read::End => {
                    got = 0;
                }
                Read::Failed(reason) => {
                    got = 0;
                }
            }
        }
        if got == 0 {
            going = false;
        } else {
            var q = -1;
            borrow window as &wr in {
                q = index_of_byte(buffer.bytes(wr), byte_of(10));
            }
            if q >= 0 {
                found = at + q + 1;
                going = false;
            } else {
                at = at + got;
                rounds = rounds + 1;
            }
        }
    }
    buffer.drop(heap, window);
    return found;
}

// Read everything from `start` (where a data record begins, after `lines0` lines) to the
// end of the file, `size`, with up to `threads` threads, in ranges of about `chunk`
// bytes. `pp` are the sequential read's parameters (`scan.p_*`), `a` its tally, the
// buffers and the groups its output so far; answered are the same, as the sequential read
// would have left them. `fs`, `root`, `rel` and `full` are what a thread needs to open the
// file again.
pub fn run_ranges[&h, &i, &f, &g, &x, &y, &z, &q, &c, &s, &w, &t, &v](heap: &!h Heap, io: &!i Io, file: &!f File, fs: &g Fs(""), root: &x [byte], rel: &y [byte], full: &z [byte], tree: &q query.Query, cols: &c [int], sel: &s [int], cells: &!w [int], a: &!t [int], pp: &!v [int], rows: buffer.Buffer, scratch: buffer.Buffer, escr: buffer.Buffer, kept: buffer.Buffer, groups: agg.Groups, start: int, lines0: int, size: int, threads: int, most_chunk: int) -> [heap, io_write, conc, file_read, fs_read(""), dir_read] (buffer.Buffer, buffer.Buffer, buffer.Buffer, buffer.Buffer, agg.Groups) {
    // A range is at most `most_chunk`, and no more than a thread's share of what is left: every
    // thread has something to read, and the memory is what the ranges are, not what the limit is.
    var chunk = most_chunk;
    let share = (size - start + threads - 1) / threads;
    if share < chunk {
        chunk = share;
    }
    if chunk < 1 {
        chunk = 1;
    }
    let mode = pp[scan.p_mode()];
    let as_csv = pp[scan.p_csv()] == 1;
    let most = pp[scan.p_most()];
    let limit = pp[scan.p_limit()];
    let budget = pp[scan.p_budget()];
    let filtering = query.count_of(tree, 1) > 0;
    // room for the exact float accumulators of 64 groups (584 bytes each, a group per float sum or mean) on top of the chunk: more groups than that, and a range's answer
    // does not fit and the parent reads the range itself (the answer is the same, only slower)
    let payload_cap = chunk + 65536 + 64 * agg.float_state(tree);
    let slot_bytes = header_bytes() + payload_cap;
    let wide = 1000000000000000;
    // What every thread is told: the parameters, except that it counts its range alone.
    var wpar = box_slice(heap, j_size(), 0);
    borrow mut wpar as &!wp in {
        let u = contents(wp);
        var k = 0;
        while k < scan.p_count() {
            u[k] = pp[k];
            k = k + 1;
        }
        u[scan.p_budget()] = wide;
        u[scan.p_limit()] = wide;
        u[scan.p_most()] = wide;
        u[scan.p_from()] = 0;
        u[scan.p_base_line()] = 0;
        u[scan.p_yield()] = payload_cap;
        u[j_columns()] = a[engine.k_columns()];
    }
    var slots = box_slice(heap, threads * slot_bytes + 1, byte_of(0));
    var plan = box_slice(heap, threads + 2, 0);
    let no_split = box_slice(heap, 1, byte_of(0));
    let no_soff = box_slice(heap, 1, 0);
    var rows2 = rows;
    var scratch2 = scratch;
    var escr2 = escr;
    var kept2 = kept;
    var groups2 = groups;
    var cur = start;
    var lines_before = lines0;
    var going = true;
    // A page that is not the whole answer may end in the first range: the waves start with one
    // range and double, so that what is read beyond the page is never more than what was needed.
    var allowed = threads;
    if mode == 1 && limit < wide {
        allowed = 1;
    }
    while going && cur < size && a[engine.k_stop()] == 0 && a[engine.k_abort()] == 0 {
        let wave_began = cur;
        var n = allowed;
        if allowed < threads {
            allowed = allowed * 2;
            if allowed > threads {
                allowed = threads;
            }
        }
        let ranges = (size - cur + chunk - 1) / chunk;
        if ranges < n {
            n = ranges;
        }
        // Where the ranges begin: `cur`, then the first line start at or after each chunk's worth.
        borrow mut plan as &!pw in {
            let pl = contents(pw);
            pl[0] = cur;
            var j = 1;
            while j <= n {
                var edge = align(heap, file, cur + j * chunk, size);
                if edge < pl[j - 1] {
                    edge = pl[j - 1];
                }
                pl[j] = edge;
                j = j + 1;
            }
            if cur + n * chunk >= size {
                pl[n] = size;
            }
        }
        borrow mut slots as &!sw in {
            var j = 0;
            while j < n {
                agg.put_i64(contents(sw), j * slot_bytes, 2);
                j = j + 1;
            }
            borrow wpar as &wr in {
                borrow plan as &pr in {
                    borrow no_split as &nsr in {
                        borrow no_soff as &nor in {
                            fan(heap, fs, root, rel, full, tree, cols, sel, contents(wr), contents(pr), contents(sw), contents(nsr), contents(nor), 0, n, slot_bytes);
                        }
                    }
                }
            }
        }
        // The ranges, in file order.
        var j = 0;
        while j < n && going {
            var until = 0;
            borrow plan as &pr in {
                until = contents(pr)[j + 1];
            }
            if cur < until {
                var accepted = false;
                borrow slots as &sr in {
                    let sl = contents(sr);
                    let at = j * slot_bytes;
                    var first = 0;
                    borrow plan as &pr in {
                        first = contents(pr)[j];
                    }
                    if agg.get_i64(sl, at) == 0 && first == cur {
                        let r = agg.get_i64(sl, at + 32 + 8 * engine.k_records());
                        let g = agg.get_i64(sl, at + 32 + 8 * engine.k_ragged());
                        let e = agg.get_i64(sl, at + 32 + 8 * engine.k_emitted());
                        let payload_len = agg.get_i64(sl, at + 24);
                        let before = a[engine.k_records()];
                        var fits = before < most && before + r <= most;
                        if mode == 1 && fits {
                            // Without a condition the page stops at the first record after its last row,
                            // ragged or not: a range that reaches the limit has to be read in order.
                            if !filtering && a[engine.k_emitted()] + e >= limit && r > 0 {
                                fits = false;
                            }
                            if a[engine.k_emitted()] + e > limit {
                                fits = false;
                            }
                            if !as_csv {
                                // Every row of the range would have passed the budget's test.
                                var have = 0;
                                borrow rows2 as &rr in {
                                    have = buffer.size(rr);
                                }
                                if have + payload_len + 2 > budget {
                                    fits = false;
                                }
                            }
                        }
                        if mode == 2 && fits {
                            var refused = 0;
                            if query.reporting(tree) {
                                let (g2, r2) = report.merge(heap, groups2, sl[at + header_bytes()..at + header_bytes() + payload_len], before, lines_before, pp[scan.p_max_state()]);
                                groups2 = g2;
                                refused = r2;
                            } else {
                                let (g2, r2) = agg.merge(heap, groups2, sl[at + header_bytes()..at + header_bytes() + payload_len], tree, pp[scan.p_max_groups()], pp[scan.p_max_distinct()], pp[scan.p_max_state()]);
                                groups2 = g2;
                                refused = r2;
                            }
                            if refused != 0 {
                                fits = false;
                            }
                        }
                        if fits {
                            accepted = true;
                            // The range's effect, added.
                            if a[engine.k_ragged()] == 0 && g > 0 {
                                a[engine.k_first_row()] = before + agg.get_i64(sl, at + 32 + 8 * engine.k_first_row());
                                a[engine.k_first_line()] = lines_before + agg.get_i64(sl, at + 32 + 8 * engine.k_first_line());
                                a[engine.k_first_found()] = agg.get_i64(sl, at + 32 + 8 * engine.k_first_found());
                            }
                            a[engine.k_records()] = before + r;
                            a[engine.k_ragged()] = a[engine.k_ragged()] + g;
                            if mode == 1 && e > 0 {
                                let body = sl[at + header_bytes()..at + header_bytes() + payload_len];
                                if !as_csv && a[engine.k_emitted()] > 0 {
                                    rows2 = buffer.push(heap, rows2, byte_of(','));
                                }
                                rows2 = buffer.append(heap, rows2, body);
                                a[engine.k_emitted()] = a[engine.k_emitted()] + e;
                            }
                            lines_before = lines_before + l_lines(sl, at);
                            cur = agg.get_i64(sl, at + 8);
                        }
                    }
                }
                if accepted {
                    if as_csv {
                        var held = 0;
                        borrow rows2 as &rr in {
                            held = buffer.size(rr);
                        }
                        if held >= 65536 {
                            let (after, ok) = engine.flush(io, rows2);
                            rows2 = after;
                            if !ok {
                                a[engine.k_abort()] = 9;
                                a[engine.k_stop()] = 1;
                            }
                        }
                    }
                } else {
                    // Read it again, here, the way the sequential read does.
                    var again = true;
                    while again {
                        pp[scan.p_base_line()] = lines_before;
                        let (x2, l2, st, r2, s2, e2, k2, g2) = scan.scan_range(heap, file, pp, tree, cols, sel, cells, a, rows2, scratch2, escr2, kept2, groups2, cur, until);
                        rows2 = r2;
                        scratch2 = s2;
                        escr2 = e2;
                        kept2 = k2;
                        groups2 = g2;
                        lines_before = lines_before + l2;
                        cur = x2;
                        again = false;
                        if st == 1 {
                            let (after, ok) = engine.flush(io, rows2);
                            rows2 = after;
                            if !ok {
                                a[engine.k_abort()] = 9;
                                a[engine.k_stop()] = 1;
                            } else {
                                again = true;
                            }
                        }
                    }
                }
            }
            if a[engine.k_stop()] == 1 || a[engine.k_abort()] != 0 {
                going = false;
            }
            j = j + 1;
        }
        // A wave always reads at least the record at its start (its first range ends after it), so
        // this does not happen; but a loop that cannot be shown to end is one more reason to say so.
        if going && cur == wave_began && cur < size {
            pp[scan.p_base_line()] = lines_before;
            let (x3, l3, st3, r3, s3, e3, k3, g3) = scan.scan_range(heap, file, pp, tree, cols, sel, cells, a, rows2, scratch2, escr2, kept2, groups2, cur, size);
            rows2 = r3;
            scratch2 = s3;
            escr2 = e3;
            kept2 = k3;
            groups2 = g3;
            lines_before = lines_before + l3;
            cur = x3;
            if st3 == 1 {
                let (after, ok) = engine.flush(io, rows2);
                rows2 = after;
                if !ok {
                    a[engine.k_abort()] = 9;
                    a[engine.k_stop()] = 1;
                }
            } else if cur >= size || a[engine.k_stop()] == 1 || a[engine.k_abort()] != 0 {
                going = false;
            }
        }
    }
    unbox_slice(heap, wpar);
    unbox_slice(heap, slots);
    unbox_slice(heap, plan);
    unbox_slice(heap, no_split);
    unbox_slice(heap, no_soff);
    return (rows2, scratch2, escr2, kept2, groups2);
}

fn l_lines[&s](sl: &s [byte], at: int) -> [] int {
    return agg.get_i64(sl, at + 16);
}

// ---------------------------------------------------------------------------------------------------------------------
// The partitioned grouping (spike gap-groups, docs/gap-groups.md). `run_groups` reads the ranges as `run` does, but a
// range's groups come back as `p` blobs cut at splitters (agg.serialize_parts), and the parent does not merge them: it hands
// blob `k` of every range to thread `k`, which merges them into groups of its own (the keys of blob `k` are in no other
// blob), and, in the last round, rounds the sums, sorts the groups and writes them as csv rows. Blob `k` sorts before blob
// `k + 1`, so the rows end to end are the answer. Between waves of ranges a round of the same threads keeps the groups, as one
// blob each (the state). Whatever the sequential read would have stopped at (a refusal, a bound, a page) is not decided here:
// the whole read is declined, and the caller reads as before.
// ---------------------------------------------------------------------------------------------------------------------

fn hdr2() -> [] int {
    return 64;
}

res struct Job2 {
    heap: Heap,
    tree: query.Query,
    par: Box[[int]],
    offs: Box[[int]],
    inp: Box[[byte]],
    out: Box[[byte]],
}

// A merge thread: the blobs of its input into groups; the groups out as a blob (mode 0), or settled, sorted and written as csv rows (mode 1).
// Header: 0 status (0 done, 3 a blob would not merge, 4 a float sum beyond a double, 5 the answer did not fit), 8 payload bytes, 16 groups, 24 pairs, 32 bytes held.
fn work2[&r](w: &!r Job2) -> [heap] int {
    let mode = contents(w.par)[0];
    let delim = contents(w.par)[1];
    let nb = contents(w.par)[2];
    // the bounds of the read: a thread holds a part of the groups, so if the part passes one the whole does (the read is declined, the old one says which refusal)
    let bound_groups = contents(w.par)[7];
    let bound_distinct = contents(w.par)[8];
    let bound_state = contents(w.par)[9];
    let inp = contents(w.inp);
    let offs = contents(w.offs);
    // the tables are made for the groups and pairs the blobs hold (the same group in two blobs is counted twice: a table too large, never too small)
    var hint_groups = 0;
    var hint_pairs = 0;
    var hb = 0;
    while hb < nb {
        hint_groups = hint_groups + agg.get_i64(inp, offs[hb]);
        hint_pairs = hint_pairs + agg.get_i64(inp, offs[hb] + 8);
        hb = hb + 1;
    }
    var groups = agg.start_sized(w.heap, w.tree, hint_groups, hint_pairs);
    var status = 0;
    var b = 0;
    while b < nb && status == 0 {
        var refused = 0;
        let (g2, r2) = agg.merge(w.heap, groups, inp[offs[b]..offs[b + 1]], w.tree, bound_groups, bound_distinct, bound_state);
        groups = g2;
        refused = r2;
        if refused != 0 {
            status = 3;
        }
        b = b + 1;
    }
    let o = contents(w.out);
    var payload = 0;
    var ng = 0;
    var np = 0;
    var held = 0;
    if status == 0 {
        borrow groups as &gr in {
            let (a1, a2, a3) = agg.totals(gr);
            ng = a1;
            np = a2;
            held = a3;
        }
        if mode == 0 {
            borrow groups as &gr in {
                let n = agg.serialize(gr, o[hdr2()..len(o)]);
                if n < 0 {
                    status = 5;
                } else {
                    payload = n;
                }
            }
        } else if mode == 2 {
            var over = 0;
            borrow mut groups as &!gm in {
                over = agg.settle(gm, w.tree);
            }
            if over != 0 {
                status = 4;
            } else {
                let kk = contents(w.par)[3];
                borrow groups as &gr in {
                    let ord = agg.order_groups(w.heap, gr, query.agg_count(w.tree), query.count_of(w.tree, 2), contents(w.par)[4], contents(w.par)[5], contents(w.par)[6] == 1);
                    borrow ord as &orr in {
                        var take = ng;
                        if kk < take {
                            take = kk;
                        }
                        let n = agg.serialize_top(gr, contents(orr), take, o[hdr2()..len(o)]);
                        if n < 0 {
                            status = 5;
                        } else {
                            payload = n;
                        }
                    }
                    unbox_slice(w.heap, ord);
                }
            }
        } else {
            var over = 0;
            borrow mut groups as &!gm in {
                over = agg.settle(gm, w.tree);
            }
            if over != 0 {
                status = 4;
            } else {
                var rows = buffer.empty(w.heap, offs[nb] + 4096);
                borrow groups as &gr in {
                    rows = agg.rows_csv(w.heap, rows, gr, w.tree, delim);
                }
                borrow rows as &rr in {
                    let text = buffer.bytes(rr);
                    if len(text) > len(o) - hdr2() {
                        status = 5;
                    } else {
                        copy_into(o[hdr2()..hdr2() + len(text)], text);
                        payload = len(text);
                    }
                }
                buffer.drop(w.heap, rows);
            }
        }
    }
    agg.put_i64(o, 0, status);
    agg.put_i64(o, 8, payload);
    agg.put_i64(o, 16, ng);
    agg.put_i64(o, 24, np);
    agg.put_i64(o, 32, held);
    agg.drop(w.heap, groups);
    return 0;
}

// The bytes of blob `k` of range `j`'s slot (or of the state), as offsets into `slots` (or `state`).
fn blob_lo[&s](table: &s [byte], at: int, k: int) -> [] int {
    return at + agg.get_i64(table, at + 8 * k);
}

fn blob_hi[&s](table: &s [byte], at: int, k: int) -> [] int {
    return at + agg.get_i64(table, at + 8 * (k + 1));
}

// One level of the merge round: make job `k` (its input is the state's blob `k` and blob `k` of every range used), start its thread, make the rest, join it, and move
// its answer up into `slots2` at `meta[np + 1 + k]`. `meta` holds the input bytes of each job, then where each job's slot starts.
fn fan2[&p, &t, &r, &l, &u, &v, &x, &m, &z](parent: &!p Heap, tree: &t query.Query, par2: &r [int], slots: &l [byte], used: &x [int], acc: &v [byte], tabs: &z [int], meta: &m [int], slots2: &!u [byte], k: int, np: int, n: int, slot_bytes: int) -> [heap, conc] int {
    if k >= np {
        return 0;
    }
    let nt = tabs[0];
    var nb = nt;
    var j = 0;
    while j < n {
        if used[j] == 1 {
            nb = nb + 1;
        }
        j = j + 1;
    }
    let inp = box_slice(parent, meta[k] + 1, byte_of(0));
    let offs = box_slice(parent, nb + 2, 0);
    var inp_w = inp;
    var offs_w = offs;
    borrow mut inp_w as &!iw in {
        borrow mut offs_w as &!ow in {
            let dst = contents(iw);
            let od = contents(ow);
            var at = 0;
            var q = 0;
            od[0] = 0;
            var ti = 0;
            while ti < nt {
                let toff = tabs[1 + ti];
                let lo = blob_lo(acc, toff, k);
                let hi = blob_hi(acc, toff, k);
                copy_into(dst[at..at + hi - lo], acc[lo..hi]);
                at = at + hi - lo;
                q = q + 1;
                od[q] = at;
                ti = ti + 1;
            }
            j = 0;
            while j < n {
                if used[j] == 1 {
                    let base = j * slot_bytes + header_bytes();
                    let slo = blob_lo(slots, base, k);
                    let shi = blob_hi(slots, base, k);
                    copy_into(dst[at..at + shi - slo], slots[slo..shi]);
                    at = at + shi - slo;
                    q = q + 1;
                    od[q] = at;
                }
                j = j + 1;
            }
        }
    }
    var par = copy_ints(parent, par2);
    borrow mut par as &!pw in {
        contents(pw)[2] = nb;
    }
    let out_bytes = meta[np + 2 + k] - meta[np + 1 + k];
    var job = Job2 { heap: fork_heap(parent), tree: query.duplicate(parent, tree), par: par, offs: offs_w, inp: inp_w, out: box_slice(parent, out_bytes, byte_of(0)) };
    var rest = 0;
    borrow mut job as &!kj in {
        let body = work2;
        let thread = spawn(kj, body);
        rest = fan2(parent, tree, par2, slots, used, acc, tabs, meta, slots2, k + 1, np, n, slot_bytes);
        join(thread);
    }
    let Job2 { heap, tree, par, offs, inp, out } = job;
    release(heap);
    query.drop(parent, tree);
    unbox_slice(parent, par);
    unbox_slice(parent, offs);
    unbox_slice(parent, inp);
    borrow out as &ob in {
        let o = contents(ob);
        let status = agg.get_i64(o, 0);
        var used_bytes = hdr2();
        if status == 0 {
            used_bytes = used_bytes + agg.get_i64(o, 8);
        }
        copy_into(slots2[meta[np + 1 + k]..meta[np + 1 + k] + used_bytes], o[0..used_bytes]);
    }
    unbox_slice(parent, out);
    return rest;
}

// Read everything from `start` to the end of the file in the partitioned way, writing the answer's rows into `rows` (and to the output, as they fill). Answers the
// buffers and the groups as `run` does, and 0, or 1 when the read was declined (nothing was changed: `a`, `rows`, the groups and the output are as they were) and
// the caller reads as before. `a[k_done]` is 1 when the answer is complete.
pub fn run_groups[&h, &i, &f, &g, &x, &y, &z, &q, &c, &s, &w, &t, &v](heap: &!h Heap, io: &!i Io, file: &!f File, fs: &g Fs(""), root: &x [byte], rel: &y [byte], full: &z [byte], tree: &q query.Query, cols: &c [int], sel: &s [int], cells: &!w [int], a: &!t [int], pp: &!v [int], rows: buffer.Buffer, scratch: buffer.Buffer, escr: buffer.Buffer, kept: buffer.Buffer, groups: agg.Groups, start: int, lines0: int, size: int, threads: int, most_chunk: int, want: int) -> [heap, io_write, conc, file_read, fs_read(""), dir_read] (buffer.Buffer, buffer.Buffer, buffer.Buffer, buffer.Buffer, agg.Groups, int) {
    if threads < 2 {
        return (rows, scratch, escr, kept, groups, 1);
    }
    let np = threads;
    let fields = query.count_of(tree, 2);
    let bound_groups = pp[scan.p_max_groups()];
    let bound_distinct = pp[scan.p_max_distinct()];
    let bound_state = pp[scan.p_max_state()];
    let base_line0 = pp[scan.p_base_line()];
    let most = pp[scan.p_most()];
    let delim = pp[scan.p_delim()];
    let wide = 1000000000000000;
    var chunk = most_chunk;
    let share = (size - start + threads - 1) / threads;
    if share < chunk {
        chunk = share;
    }
    if chunk < 1 {
        chunk = 1;
    }
    // room for a range's answer: its groups cost no more than its bytes twice over, and the exact float accumulators (584 bytes a float sum or mean, in each
    // group) are room for 512 groups more; a range with more is not taken (the read is declined: the sums are exact, and bounded, but not cheap to move)
    var allowance = 0;
    if agg.float_state(tree) > 0 {
        allowance = 512 * agg.float_state(tree);
    }
    let payload_cap = 2 * chunk + 65536 + allowance;
    let slot_bytes = header_bytes() + payload_cap;
    var declined = 0;
    var ta = box_slice(heap, engine.k_size(), 0);
    borrow mut ta as &!tw in {
        var m = 0;
        while m < engine.k_size() {
            contents(tw)[m] = a[m];
            m = m + 1;
        }
    }
    // The splitters: the keys at the quantiles of the groups in a sample of the file (16 places, 16 KiB each), cut at a line start.
    var sg = agg.start(heap, tree);
    var sa = box_slice(heap, engine.k_size(), 0);
    var sp = box_slice(heap, j_size(), 0);
    borrow mut sp as &!spw in {
        var m = 0;
        while m < scan.p_count() {
            contents(spw)[m] = pp[m];
            m = m + 1;
        }
        contents(spw)[scan.p_most()] = wide;
        contents(spw)[scan.p_limit()] = wide;
        contents(spw)[scan.p_budget()] = wide;
        contents(spw)[scan.p_max_groups()] = wide;
        contents(spw)[scan.p_max_distinct()] = wide;
        contents(spw)[scan.p_max_state()] = wide;
        contents(spw)[scan.p_from()] = 0;
        contents(spw)[scan.p_yield()] = 0;
        contents(spw)[scan.p_base_line()] = 0;
    }
    var srows = buffer.empty(heap, 16);
    var sscr = buffer.empty(heap, 256);
    var sesc = buffer.empty(heap, 16);
    var skept = buffer.empty(heap, 64);
    var wi = 0;
    while wi < 16 {
        let pos = start + (size - start) / 16 * wi;
        let edge = align(heap, file, pos, size);
        var until = edge + 16384;
        if until > size {
            until = size;
        }
        if edge < until {
            borrow mut sa as &!saw in {
                var m = 0;
                while m < engine.k_size() {
                    contents(saw)[m] = 0;
                    m = m + 1;
                }
                contents(saw)[engine.k_columns()] = a[engine.k_columns()];
                borrow sp as &spr in {
                    let (x2, l2, st, r2, s2, e2, k2, g2) = scan.scan_range(heap, file, contents(spr), tree, cols, sel, cells, contents(saw), srows, sscr, sesc, skept, sg, edge, until);
                    srows = r2;
                    sscr = s2;
                    sesc = e2;
                    skept = k2;
                    sg = g2;
                }
            }
        }
        wi = wi + 1;
    }
    buffer.drop(heap, srows);
    buffer.drop(heap, sscr);
    buffer.drop(heap, sesc);
    buffer.drop(heap, skept);
    unbox_slice(heap, sa);
    var split_room = 0;
    borrow sg as &sgr in {
        split_room = agg.parts_size(sgr, 1) + 64;
    }
    var split = box_slice(heap, split_room, byte_of(0));
    var soff = box_slice(heap, np + 2, 0);
    var nsplit = 0;
    borrow sg as &sgr in {
        borrow mut split as &!spw in {
            let used_split = agg.pick_splitters(heap, sgr, np, fields, contents(spw));
            if used_split < 0 {
                declined = 1;
            } else {
                nsplit = agg.get_i64(contents(spw), 0);
                borrow mut soff as &!sow in {
                    agg.splitter_offsets(contents(spw), 8, nsplit, contents(sow));
                }
            }
        }
    }
    agg.drop(heap, sg);
    unbox_slice(heap, sp);
    // What is kept for the round to come: tables back to back (a table is the `np` blobs of a range's groups, from its offsets), `tabs` the count and where each starts.
    // The first is the groups so far (the parent's, from the first rows).
    var acc = buffer.empty(heap, 16);
    var tabs = box_slice(heap, 72, 0);
    if declined == 0 {
        var need0 = 0;
        var ng0 = 0;
        borrow groups as &gr in {
            need0 = agg.parts_size(gr, np);
            ng0 = agg.groups(gr);
        }
        var state = box_slice(heap, need0 + 1, byte_of(0));
        var work0 = box_slice(heap, 2 * ng0 + 6 * np + 8, 0);
        var n0 = 0 - 1;
        borrow groups as &gr in {
            borrow mut state as &!stw in {
                borrow split as &spr in {
                    borrow soff as &sor in {
                        borrow mut work0 as &!w0 in {
                            n0 = agg.serialize_parts(gr, contents(stw), contents(spr), contents(sor), nsplit, np, fields, contents(w0));
                        }
                    }
                }
            }
        }
        if n0 < 0 {
            declined = 1;
        } else {
            borrow state as &str in {
                acc = buffer.append(heap, acc, contents(str)[0..n0]);
            }
            borrow mut tabs as &!tbw in {
                contents(tbw)[0] = 1;
                contents(tbw)[1] = 0;
            }
        }
        unbox_slice(heap, work0);
        unbox_slice(heap, state);
    }
    var wpar = box_slice(heap, j_size(), 0);
    borrow mut wpar as &!wp in {
        let u = contents(wp);
        var k = 0;
        while k < scan.p_count() {
            u[k] = pp[k];
            k = k + 1;
        }
        u[scan.p_budget()] = wide;
        u[scan.p_limit()] = wide;
        u[scan.p_most()] = wide;
        u[scan.p_from()] = 0;
        u[scan.p_base_line()] = 0;
        u[scan.p_yield()] = payload_cap;
        u[j_columns()] = a[engine.k_columns()];
        u[j_parts()] = np;
        u[j_nsplit()] = nsplit;
        u[j_fields()] = fields;
    }
    var slots = box_slice(heap, threads * slot_bytes + 1, byte_of(0));
    var plan = box_slice(heap, threads + 2, 0);
    var used = box_slice(heap, threads + 2, 0);
    var meta = box_slice(heap, 2 * np + 4, 0);
    var gfinal = groups;
    var rows2 = rows;
    var scratch2 = scratch;
    var escr2 = escr;
    var kept2 = kept;
    var cur = start;
    var lines_before = lines0;
    var finished = false;
    var total_groups = 0;
    while declined == 0 && !finished && cur < size {
        let wave_began = cur;
        var n = threads;
        let ranges = (size - cur + chunk - 1) / chunk;
        if ranges < n {
            n = ranges;
        }
        borrow mut plan as &!pw in {
            let pl = contents(pw);
            pl[0] = cur;
            var j = 1;
            while j <= n {
                var edge = align(heap, file, cur + j * chunk, size);
                if edge < pl[j - 1] {
                    edge = pl[j - 1];
                }
                pl[j] = edge;
                j = j + 1;
            }
            if cur + n * chunk >= size {
                pl[n] = size;
            }
        }
        borrow mut slots as &!sw in {
            var j = 0;
            while j < n {
                agg.put_i64(contents(sw), j * slot_bytes, 2);
                j = j + 1;
            }
            borrow wpar as &wr in {
                borrow plan as &pr in {
                    borrow split as &spr in {
                        borrow soff as &sor in {
                            fan(heap, fs, root, rel, full, tree, cols, sel, contents(wr), contents(pr), contents(sw), contents(spr), contents(sor), 0, n, slot_bytes);
                        }
                    }
                }
            }
        }
        // The ranges, in file order: each is taken as it is or read again here into groups of its own, or the read is declined.
        borrow mut ta as &!tw in {
            var j = 0;
            while j < n && declined == 0 {
                var until = 0;
                var first = 0;
                borrow plan as &pr in {
                    until = contents(pr)[j + 1];
                    first = contents(pr)[j];
                }
                borrow mut used as &!uw in {
                    contents(uw)[j] = 0;
                }
                if cur < until {
                    var accepted = false;
                    borrow slots as &sr in {
                        let sl = contents(sr);
                        let at = j * slot_bytes;
                        if agg.get_i64(sl, at) == 0 && first == cur {
                            let r = agg.get_i64(sl, at + 32 + 8 * engine.k_records());
                            let g1 = agg.get_i64(sl, at + 32 + 8 * engine.k_ragged());
                            let before = contents(tw)[engine.k_records()];
                            if before < most && before + r <= most {
                                accepted = true;
                                let t = contents(tw);
                                if t[engine.k_ragged()] == 0 && g1 > 0 {
                                    t[engine.k_first_row()] = before + agg.get_i64(sl, at + 32 + 8 * engine.k_first_row());
                                    t[engine.k_first_line()] = lines_before + agg.get_i64(sl, at + 32 + 8 * engine.k_first_line());
                                    t[engine.k_first_found()] = agg.get_i64(sl, at + 32 + 8 * engine.k_first_found());
                                }
                                t[engine.k_records()] = before + r;
                                t[engine.k_ragged()] = t[engine.k_ragged()] + g1;
                                lines_before = lines_before + l_lines(sl, at);
                                cur = agg.get_i64(sl, at + 8);
                            }
                        }
                    }
                    if accepted {
                        borrow mut used as &!uw in {
                            contents(uw)[j] = 1;
                        }
                    } else {
                        // A range whose guess was right and that stopped at a refusal, a bound or the row limit says what the read will say: not read again here (that would read
                        // the file in one thread to find it out), the read is declined and the old one stops where the sequential read does.
                        var worker_stopped = false;
                        borrow slots as &sr in {
                            let sl = contents(sr);
                            let at = j * slot_bytes;
                            if first == cur && agg.get_i64(sl, at) == 1 && (agg.get_i64(sl, at + 32 + 8 * engine.k_abort()) != 0 || agg.get_i64(sl, at + 32 + 8 * engine.k_capped()) != 0) {
                                worker_stopped = true;
                            }
                        }
                        if worker_stopped {
                            declined = 1;
                        } else {
                            // Read again, here, the way the sequential read does, into groups of its own.
                            var rg = agg.start(heap, tree);
                            var rscr = scratch2;
                            var resc = escr2;
                            var rkept = kept2;
                            pp[scan.p_base_line()] = lines_before;
                            pp[scan.p_max_groups()] = wide;
                            pp[scan.p_max_distinct()] = wide;
                            pp[scan.p_max_state()] = wide;
                            let (x2, l2, st, r2, s2, e2, k2, g2) = scan.scan_range(heap, file, pp, tree, cols, sel, cells, contents(tw), rows2, rscr, resc, rkept, rg, cur, until);
                            rows2 = r2;
                            rscr = s2;
                            resc = e2;
                            rkept = k2;
                            rg = g2;
                            let t = contents(tw);
                            if st != 0 || t[engine.k_abort()] != 0 || t[engine.k_stop()] != 0 || t[engine.k_capped()] != 0 || t[engine.k_more()] != 0 {
                                declined = 1;
                            } else {
                                borrow mut slots as &!sw in {
                                    borrow rg as &rgr in {
                                        borrow split as &spr in {
                                            borrow soff as &sor in {
                                                var work1 = box_slice(heap, 2 * agg.groups(rgr) + 6 * np + 8, 0);
                                                borrow mut work1 as &!w1 in {
                                                    let at = j * slot_bytes;
                                                    let nb = agg.serialize_parts(rgr, contents(sw)[at + header_bytes()..at + slot_bytes], contents(spr), contents(sor), nsplit, np, fields, contents(w1));
                                                    if nb < 0 {
                                                        declined = 1;
                                                    } else {
                                                        agg.put_i64(contents(sw), at, 0);
                                                        agg.put_i64(contents(sw), at + 8, x2);
                                                        agg.put_i64(contents(sw), at + 16, l2);
                                                        agg.put_i64(contents(sw), at + 24, nb);
                                                    }
                                                }
                                                unbox_slice(heap, work1);
                                            }
                                        }
                                    }
                                }
                                if declined == 0 {
                                    lines_before = lines_before + l2;
                                    cur = x2;
                                    borrow mut used as &!uw in {
                                        contents(uw)[j] = 1;
                                    }
                                }
                            }
                            agg.drop(heap, rg);
                            scratch2 = rscr;
                            escr2 = resc;
                            kept2 = rkept;
                        }
                    }
                }
                j = j + 1;
            }
        }
        if declined == 0 && cur == wave_began {
            declined = 1;
        }
        if declined == 0 {
            let last = cur >= size;
            // This wave's tables are kept for the round to come when it is not the last wave and what is kept is small; otherwise they are the round's.
            var wave_bytes = 0;
            var nused = 0;
            borrow slots as &sr in {
                borrow used as &ur in {
                    var j = 0;
                    while j < n {
                        if contents(ur)[j] == 1 {
                            wave_bytes = wave_bytes + agg.get_i64(contents(sr), j * slot_bytes + header_bytes() + 8 * np);
                            nused = nused + 1;
                        }
                        j = j + 1;
                    }
                }
            }
            var acc_bytes = 0;
            borrow acc as &ar in {
                acc_bytes = buffer.size(ar);
            }
            var nt = 0;
            borrow tabs as &tbr in {
                nt = contents(tbr)[0];
            }
            let keep = !last && acc_bytes + wave_bytes <= 33554432 && nt + nused <= 64;
            if keep {
                var j = 0;
                while j < n {
                    var usedj = 0;
                    borrow used as &ur in {
                        usedj = contents(ur)[j];
                    }
                    if usedj == 1 {
                        var off = 0;
                        borrow acc as &ar in {
                            off = buffer.size(ar);
                        }
                        borrow slots as &sr in {
                            let base = j * slot_bytes + header_bytes();
                            acc = buffer.append(heap, acc, contents(sr)[base..base + agg.get_i64(contents(sr), base + 8 * np)]);
                        }
                        borrow mut tabs as &!tbw in {
                            contents(tbw)[1 + nt] = off;
                            nt = nt + 1;
                            contents(tbw)[0] = nt;
                        }
                    }
                    j = j + 1;
                }
            }
            if !keep {
                // The round: the input of each merge thread and where its answer goes.
                var total_out = 0;
                borrow mut meta as &!mw in {
                    let me = contents(mw);
                    var k = 0;
                    while k < np {
                        var inl = 0;
                        borrow acc as &ar in {
                            borrow tabs as &tbr in {
                                var ti = 0;
                                while ti < contents(tbr)[0] {
                                    let toff = contents(tbr)[1 + ti];
                                    inl = inl + agg.get_i64(buffer.bytes(ar), toff + 8 * (k + 1)) - agg.get_i64(buffer.bytes(ar), toff + 8 * k);
                                    ti = ti + 1;
                                }
                            }
                        }
                        borrow slots as &sr in {
                            borrow used as &ur in {
                                var j = 0;
                                while j < n {
                                    if contents(ur)[j] == 1 {
                                        let base = j * slot_bytes + header_bytes();
                                        inl = inl + agg.get_i64(contents(sr), base + 8 * (k + 1)) - agg.get_i64(contents(sr), base + 8 * k);
                                    }
                                    j = j + 1;
                                }
                            }
                        }
                        me[k] = inl;
                        me[np + 1 + k] = total_out;
                        if last && want == 0 {
                            total_out = total_out + hdr2() + 3 * inl + 4096;
                        } else {
                            total_out = total_out + hdr2() + inl + 64;
                        }
                        k = k + 1;
                    }
                    me[np + 1 + np] = total_out;
                }
                var slots2 = box_slice(heap, total_out + 1, byte_of(0));
                var par2 = box_slice(heap, 12, 0);
                borrow mut par2 as &!p2 in {
                    contents(p2)[0] = 1;
                    if !last {
                        contents(p2)[0] = 0;
                    } else if want > 0 {
                        contents(p2)[0] = 2;
                    }
                    contents(p2)[1] = delim;
                    contents(p2)[3] = want;
                    contents(p2)[4] = a[engine.k_sort_field()];
                    contents(p2)[5] = a[engine.k_sort_slot()];
                    contents(p2)[6] = a[engine.k_sort_desc()];
                    contents(p2)[7] = bound_groups;
                    contents(p2)[8] = bound_distinct;
                    contents(p2)[9] = bound_state;
                }
                borrow mut slots2 as &!s2w in {
                    borrow par2 as &p2r in {
                        borrow slots as &sr in {
                            borrow used as &ur in {
                                borrow acc as &ar in {
                                    borrow tabs as &tbr in {
                                        borrow meta as &mr in {
                                            fan2(heap, tree, contents(p2r), contents(sr), contents(ur), buffer.bytes(ar), contents(tbr), contents(mr), contents(s2w), 0, np, n, slot_bytes);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                unbox_slice(heap, par2);
                // Their answers: all done, and within the bounds, or the read is declined.
                var ng_all = 0;
                var pairs_all = 0;
                var held_all = 0;
                var payload_all = 0;
                borrow slots2 as &s2r in {
                    borrow meta as &mr in {
                        var k = 0;
                        while k < np {
                            let at = contents(mr)[np + 1 + k];
                            if agg.get_i64(contents(s2r), at) != 0 {
                                declined = 1;
                            } else {
                                payload_all = payload_all + agg.get_i64(contents(s2r), at + 8);
                                ng_all = ng_all + agg.get_i64(contents(s2r), at + 16);
                                pairs_all = pairs_all + agg.get_i64(contents(s2r), at + 24);
                                held_all = held_all + agg.get_i64(contents(s2r), at + 32);
                            }
                            k = k + 1;
                        }
                    }
                }
                if ng_all > bound_groups || pairs_all > bound_distinct || held_all > bound_state {
                    declined = 1;
                }
                if declined == 0 && last && want > 0 {
                    // The candidates of the page, from every thread, are the groups of a fresh set: the caller finishes them as it finishes any (sort, page, rows).
                    var fg = agg.start(heap, tree);
                    borrow slots2 as &s2r in {
                        borrow meta as &mr in {
                            var k = 0;
                            while k < np && declined == 0 {
                                let at = contents(mr)[np + 1 + k];
                                let len_k = agg.get_i64(contents(s2r), at + 8);
                                let (g2, refused) = agg.merge(heap, fg, contents(s2r)[at + hdr2()..at + hdr2() + len_k], tree, wide, wide, wide);
                                fg = g2;
                                if refused != 0 {
                                    declined = 1;
                                }
                                k = k + 1;
                            }
                        }
                    }
                    if declined == 0 {
                        agg.drop(heap, gfinal);
                        gfinal = fg;
                        total_groups = ng_all;
                        finished = true;
                    } else {
                        agg.drop(heap, fg);
                    }
                } else if declined == 0 && last {
                    borrow slots2 as &s2r in {
                        borrow meta as &mr in {
                            var k = 0;
                            while k < np && declined == 0 {
                                let at = contents(mr)[np + 1 + k];
                                let len_k = agg.get_i64(contents(s2r), at + 8);
                                rows2 = buffer.append(heap, rows2, contents(s2r)[at + hdr2()..at + hdr2() + len_k]);
                                let (after, ok) = engine.flush(io, rows2);
                                rows2 = after;
                                if !ok {
                                    borrow mut ta as &!tw in {
                                        contents(tw)[engine.k_abort()] = 9;
                                        contents(tw)[engine.k_stop()] = 1;
                                    }
                                }
                                k = k + 1;
                            }
                        }
                    }
                    total_groups = ng_all;
                    finished = true;
                } else if declined == 0 {
                    // The new state: the merged groups of each, as one blob each, in one table.
                    var nacc = buffer.empty(heap, 8 * (np + 1) + payload_all + 16);
                    borrow mut nacc as &!nsw in {
                        borrow slots2 as &s2r in {
                            borrow meta as &mr in {
                                let ns = buffer.room(nsw);
                                var at = 8 * (np + 1);
                                var k = 0;
                                while k < np {
                                    agg.put_i64(ns, 8 * k, at);
                                    let from = contents(mr)[np + 1 + k];
                                    let len_k = agg.get_i64(contents(s2r), from + 8);
                                    copy_into(ns[at..at + len_k], contents(s2r)[from + hdr2()..from + hdr2() + len_k]);
                                    at = at + len_k;
                                    k = k + 1;
                                }
                                agg.put_i64(ns, 8 * np, at);
                                buffer.filled(nsw, at);
                            }
                        }
                    }
                    buffer.drop(heap, acc);
                    acc = nacc;
                    borrow mut tabs as &!tbw in {
                        contents(tbw)[0] = 1;
                        contents(tbw)[1] = 0;
                    }
                }
                unbox_slice(heap, slots2);
            }
        }
    }
    pp[scan.p_max_groups()] = bound_groups;
    pp[scan.p_max_distinct()] = bound_distinct;
    pp[scan.p_max_state()] = bound_state;
    pp[scan.p_base_line()] = base_line0;
    unbox_slice(heap, wpar);
    unbox_slice(heap, slots);
    unbox_slice(heap, plan);
    unbox_slice(heap, used);
    unbox_slice(heap, meta);
    buffer.drop(heap, acc);
    unbox_slice(heap, tabs);
    unbox_slice(heap, split);
    unbox_slice(heap, soff);
    if declined == 0 && finished {
        borrow ta as &tr in {
            var m = 0;
            while m < engine.k_size() {
                a[m] = contents(tr)[m];
                m = m + 1;
            }
        }
        if want > 0 {
            a[engine.k_total()] = total_groups;
        } else {
            a[engine.k_groups()] = total_groups;
            a[engine.k_emitted()] = total_groups;
            a[engine.k_done()] = 1;
        }
        unbox_slice(heap, ta);
        return (rows2, scratch2, escr2, kept2, gfinal, 0);
    }
    unbox_slice(heap, ta);
    return (rows2, scratch2, escr2, kept2, gfinal, 1);
}

// The rest of the file by several threads (the entry of table.cho): a grouping the partitioned way when it can (`run_groups`), the old way otherwise or when that declined.
// The whole answer as csv rows is written by the merge threads (`want` 0); a page, a top or a sort is the first `want` groups of each, finished by the
// caller as any (one past the page, so that `more` is known); more than 100,000 of them, or a read that is not a grouping, takes `run`.
pub fn run[&h, &i, &f, &g, &x, &y, &z, &q, &c, &s, &w, &t, &v](heap: &!h Heap, io: &!i Io, file: &!f File, fs: &g Fs(""), root: &x [byte], rel: &y [byte], full: &z [byte], tree: &q query.Query, cols: &c [int], sel: &s [int], cells: &!w [int], a: &!t [int], pp: &!v [int], rows: buffer.Buffer, scratch: buffer.Buffer, escr: buffer.Buffer, kept: buffer.Buffer, groups: agg.Groups, start: int, lines0: int, size: int, threads: int, most_chunk: int) -> [heap, io_write, conc, file_read, fs_read(""), dir_read] (buffer.Buffer, buffer.Buffer, buffer.Buffer, buffer.Buffer, agg.Groups) {
    let as_csv = pp[scan.p_csv()] == 1;
    let (top, from) = query.page_of(tree);
    let limit = pp[scan.p_limit()];
    var want = 0;
    if !(as_csv && a[engine.k_sort_field()] < 0 && a[engine.k_sort_slot()] < 0 && from == 0 && top == 0 && limit >= 100000000) {
        if top > 0 {
            want = top;
        } else if limit < 100000000 {
            want = from + limit + 1;
        } else {
            want = 100000001;
        }
    }
    var r = rows;
    var sc = scratch;
    var es = escr;
    var ke = kept;
    var gr = groups;
    if pp[scan.p_mode()] == 2 && !query.reporting(tree) && want <= 100000 {
        let (r1, s1, e1, k1, g1, declined) = run_groups(heap, io, file, fs, root, rel, full, tree, cols, sel, cells, a, pp, r, sc, es, ke, gr, start, lines0, size, threads, most_chunk, want);
        if declined == 0 {
            return (r1, s1, e1, k1, g1);
        }
        r = r1;
        sc = s1;
        es = e1;
        ke = k1;
        gr = g1;
    }
    return run_ranges(heap, io, file, fs, root, rel, full, tree, cols, sel, cells, a, pp, r, sc, es, ke, gr, start, lines0, size, threads, most_chunk);
}
