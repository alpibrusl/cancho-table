edition 5;

module cexpr;

// `--compute`: the definitions of docs/computed-columns.md, compiled once to a postfix program and evaluated once per row with the exact core (cmpv).
//
//     DEFS := DEF { ";" DEF }       DEF := NAME "=" EXPR       EXPR := TERM { ("+" | "-") TERM }
//     TERM := FACTOR { "*" FACTOR | "/" FACTOR "@" N }          FACTOR := "-" FACTOR | "(" EXPR ")" | OPERAND
//     OPERAND := COLUMN ":int" | COLUMN ":dec(" S ")" | NUMBER   COLUMN := WORD | "#" N         WORD := bare | 'quoted'
//
// A bare word runs to a space or one of `' ( ) + - * / ; : @ , =`; a backslash makes the next byte part of it; a quoted word is between single quotes
// with '' for a quote and is never a position. A number is digits with at most one point and at most 18 digits in all (`12` is an int, `1.25` a
// decimal of scale 2). The scale of every result is known before a row is read, so the refusals that depend on it (a product past scale 18) are the
// compiler's.
//
// The program is an `int` slice. Header: [0] the number of definitions; for definition d, five ints at 1 + 5 * d: where its instructions start, how many,
// the scale of its result, and the first and last byte of its name in the text. Instructions are four ints (op, a, b, c) from `code_base()` on.

import std.buffer;
import std.bytes;
import cellnum;
import cmpv;
import ctext;

pub fn max_defs() -> [] int {
    return 8;
}

pub fn code_base() -> [] int {
    return 5 * 8 + 1;
}

// The ints a program needs: the header and room for 8 definitions of at most 256 bytes (128 operands and operators each, four ints an instruction).
pub fn program_size() -> [] int {
    return 41 + 8 * 4 * 256;
}

pub fn work_size() -> [] int {
    return 256;
}

fn op_cell() -> [] int {
    return 1;
}

fn op_const() -> [] int {
    return 2;
}

fn op_add() -> [] int {
    return 3;
}

fn op_sub() -> [] int {
    return 4;
}

fn op_mul() -> [] int {
    return 5;
}

fn op_div() -> [] int {
    return 6;
}

fn op_neg() -> [] int {
    return 7;
}

// A call of a numeric function (docs/functions.md section 3.2): `a` the function, `b` how many operands it takes, `c` the scale literal of the rounding family.
fn op_fn() -> [] int {
    return 8;
}

// The number of bytes of a text cell (`len`): `a` the column. The text instructions are `ctext.op_col()` and the two after it, 16 to 18.
fn op_len() -> [] int {
    return 19;
}

// Statuses: the compiler's, then the evaluator's.
pub fn s_ok() -> [] int {
    return 0;
}

pub fn s_syntax() -> [] int {
    return 1;
}

pub fn s_unknown() -> [] int {
    return 2;
}

pub fn s_ambiguous() -> [] int {
    return 3;
}

pub fn s_duplicate() -> [] int {
    return 4;
}

pub fn s_untyped() -> [] int {
    return 5;
}

pub fn s_float() -> [] int {
    return 6;
}

pub fn s_scale() -> [] int {
    return 7;
}

pub fn s_needs_scale() -> [] int {
    return 8;
}

pub fn s_too_long() -> [] int {
    return 9;
}

pub fn s_divide_by_zero() -> [] int {
    return 11;
}

pub fn s_overflow() -> [] int {
    return 12;
}

// 100 + the status of `parse_int`, 200 + the status of `parse_dec`: a cell that is not what its type says (the column is the second answer).
pub fn s_type_mismatch() -> [] int {
    return 16;
}

pub fn s_unknown_function() -> [] int {
    return 13;
}

pub fn s_arity() -> [] int {
    return 14;
}

pub fn s_bad_literal() -> [] int {
    return 15;
}

pub fn s_cell_int() -> [] int {
    return 100;
}

pub fn s_cell_dec() -> [] int {
    return 200;
}

fn is_space(c: int) -> [] bool {
    return c == ' ' || c == 9;
}

fn stops_word(c: int) -> [] bool {
    return is_space(c) || c == 39 || c == '(' || c == ')' || c == '+' || c == '-' || c == '*' || c == '/' || c == ';' || c == ':' || c == '@' || c == ',' || c == '=';
}

// The numeric function a call names (`name(`): 1 abs, 2 sign, 3 greatest, 4 least, 5 round, 6 floor, 7 ceil, 8 trunc, 9 coalesce; 0 when there is none. Case matters.
fn function_id[&w](word: &w [byte]) -> [] int {
    if bytes.equal(word, "abs") {
        return 1;
    }
    if bytes.equal(word, "sign") {
        return 2;
    }
    if bytes.equal(word, "greatest") {
        return 3;
    }
    if bytes.equal(word, "least") {
        return 4;
    }
    if bytes.equal(word, "round") {
        return 5;
    }
    if bytes.equal(word, "floor") {
        return 6;
    }
    if bytes.equal(word, "ceil") {
        return 7;
    }
    if bytes.equal(word, "trunc") {
        return 8;
    }
    if bytes.equal(word, "coalesce") {
        return 9;
    }
    if bytes.equal(word, "lower") {
        return 11;
    }
    if bytes.equal(word, "upper") {
        return 12;
    }
    if bytes.equal(word, "trim") {
        return 13;
    }
    if bytes.equal(word, "ltrim") {
        return 14;
    }
    if bytes.equal(word, "rtrim") {
        return 15;
    }
    if bytes.equal(word, "substr") {
        return 16;
    }
    if bytes.equal(word, "concat") {
        return 17;
    }
    if bytes.equal(word, "replace") {
        return 18;
    }
    if bytes.equal(word, "len") {
        return 19;
    }
    return 0;
}

// How many operands a function takes, at least and at most (the scale of the rounding family and the default of coalesce count as the second).
fn arity_min(id: int) -> [] int {
    if id <= 2 {
        return 1;
    }
    return 2;
}

fn arity_max(id: int) -> [] int {
    if id <= 2 {
        return 1;
    }
    if id == 3 || id == 4 {
        return 8;
    }
    return 2;
}

fn skip_space[&t](t: &t [byte], from: int) -> [] int {
    var i = from;
    while i < len(t) && is_space(int_of(t[i])) {
        i = i + 1;
    }
    return i;
}

// The word at `from`, unescaped into `out`: answers (where it ends, whether it was quoted, status). Status 1: nothing there, or a quote not closed.
fn word_at[&h, &t](heap: &!h Heap, out: buffer.Buffer, t: &t [byte], from: int) -> [heap] (buffer.Buffer, int, bool, int) {
    var o = out;
    var i = from;
    if i >= len(t) {
        return (o, i, false, 1);
    }
    if int_of(t[i]) == 39 {
        i = i + 1;
        while i < len(t) {
            if int_of(t[i]) == 39 {
                if i + 1 < len(t) && int_of(t[i + 1]) == 39 {
                    o = buffer.push(heap, o, byte_of(39));
                    i = i + 2;
                } else {
                    return (o, i + 1, true, 0);
                }
            } else {
                o = buffer.push(heap, o, t[i]);
                i = i + 1;
            }
        }
        return (o, i, true, 1);
    }
    while i < len(t) && !stops_word(int_of(t[i])) {
        if int_of(t[i]) == 92 {
            if i + 1 >= len(t) {
                return (o, i, false, 1);
            }
            i = i + 1;
        }
        o = buffer.push(heap, o, t[i]);
        i = i + 1;
    }
    if i == from {
        return (o, i, false, 1);
    }
    return (o, i, false, 0);
}

// A name against the header: the column index, or a status (2 unknown, 3 ambiguous) with the index 0. `names` is the header's names one after the other and `ends` where each stops.
fn resolve[&n, &e, &w](names: &n [byte], ends: &e [int], ncols: int, word: &w [byte], quoted: bool) -> [] (int, int) {
    if !quoted && len(word) > 1 && int_of(word[0]) == '#' {
        var n = 0;
        var k = 1;
        var digits = true;
        while k < len(word) {
            let d = int_of(word[k]) - '0';
            if d < 0 || d > 9 || n > 100000 {
                digits = false;
                k = len(word);
            } else {
                n = n * 10 + d;
                k = k + 1;
            }
        }
        if digits {
            if n >= 1 && n <= ncols {
                return (n - 1, 0);
            }
            return (0, 2);
        }
    }
    var found = -1;
    var count = 0;
    var c = 0;
    while c < ncols {
        var start = 0;
        if c > 0 {
            start = ends[c - 1];
        }
        if bytes.equal(names[start..ends[c]], word) {
            if count == 0 {
                found = c;
            }
            count = count + 1;
        }
        c = c + 1;
    }
    if count == 0 {
        return (0, 2);
    }
    if count > 1 {
        return (0, 3);
    }
    return (found, 0);
}

// A number at `from`: digits and at most one point with a digit after it, at most 18 digits. Answers (end, value, scale, status 0 or 1).
fn number_at[&t](t: &t [byte], from: int) -> [] (int, int, int, int) {
    var end = from;
    while end < len(t) && (int_of(t[end]) >= '0' && int_of(t[end]) <= '9' || int_of(t[end]) == '.') {
        end = end + 1;
    }
    var v = 0;
    var digits = 0;
    var scale = 0;
    var point = false;
    var i = from;
    while i < end {
        let c = int_of(t[i]);
        if c == '.' {
            if point {
                return (end, 0, 0, 1);
            }
            point = true;
        } else {
            digits = digits + 1;
            if digits > 18 {
                return (end, 0, 0, 1);
            }
            v = v * 10 + (c - '0');
            if point {
                scale = scale + 1;
            }
        }
        i = i + 1;
    }
    if digits == 0 || point && scale == 0 {
        return (end, 0, 0, 1);
    }
    return (end, v, scale, 0);
}

// The scale literal of the rounding family, at `from`: spaces, then an integer from 0 to 18 written in digits only. Answers (where it ends, the value, status): status 0, or 15 with the place it was looked for.
fn scale_literal[&t](t: &t [byte], from: int) -> [] (int, int, int) {
    let p = skip_space(t, from);
    var q = p;
    var n = 0;
    var digits = 0;
    while q < len(t) && int_of(t[q]) >= '0' && int_of(t[q]) <= '9' && digits < 3 {
        n = n * 10 + (int_of(t[q]) - '0');
        digits = digits + 1;
        q = q + 1;
    }
    if digits == 0 || n > 18 {
        return (p, 0, 15);
    }
    if q < len(t) && !(is_space(int_of(t[q])) || int_of(t[q]) == ')' || int_of(t[q]) == ',') {
        return (p, 0, 15);
    }
    return (q, n, 0);
}

// The default of a `coalesce`, at `from`: spaces, an optional `-`, then a number as the expressions write one. Answers (where it ends, the value, its scale, status): status 0, or 15 with the place it was looked for.
fn default_literal[&t](t: &t [byte], from: int) -> [] (int, int, int, int) {
    let p = skip_space(t, from);
    var q = p;
    var negative = false;
    if q < len(t) && int_of(t[q]) == '-' {
        negative = true;
        q = q + 1;
    }
    if q >= len(t) || !(int_of(t[q]) >= '0' && int_of(t[q]) <= '9' || int_of(t[q]) == '.') {
        return (p, 0, 0, 15);
    }
    let (ne, v, sc, ns) = number_at(t, q);
    if ns != 0 {
        return (p, 0, 0, 15);
    }
    if ne < len(t) && !(is_space(int_of(t[ne])) || int_of(t[ne]) == ')' || int_of(t[ne]) == ',') {
        return (p, 0, 0, 15);
    }
    if negative {
        return (ne, -v, sc, 0);
    }
    return (ne, v, sc, 0);
}

fn emit[&p](prog: &!p [int], at: int, op: int, a: int, b: int, c: int) -> [] int {
    prog[at] = op;
    prog[at + 1] = a;
    prog[at + 2] = b;
    prog[at + 3] = c;
    return at + 4;
}

// Pops the operator on top of the stack of `work` (codes at 0.., scales at 32..; the depth at 64) into the program at `at`. Answers the new `at`, or -1 for a division with no scale.
fn pop_op[&p, &w](prog: &!p [int], work: &!w [int], at: int) -> [] int {
    let top = work[64] - 1;
    let code = work[top];
    let n = work[32 + top];
    work[64] = top;
    if code == 4 {
        if n < 0 {
            return -1;
        }
        return emit(prog, at, op_div(), n, 0, 0);
    }
    if code == 1 {
        return emit(prog, at, op_add(), 0, 0, 0);
    }
    if code == 2 {
        return emit(prog, at, op_sub(), 0, 0, 0);
    }
    if code == 3 {
        return emit(prog, at, op_mul(), 0, 0, 0);
    }
    return emit(prog, at, op_neg(), 0, 0, 0);
}

// Binding strength: * and / 2, + and - 1, a negation 3, a parenthesis 0.
fn prec(code: int) -> [] int {
    if code == 5 {
        return 3;
    }
    if code == 3 || code == 4 {
        return 2;
    }
    if code == 1 || code == 2 {
        return 1;
    }
    return 0;
}

// The scale and the most operands pending at once of the program from `first` to `end`: (scale, depth, status). A product past scale 18 is status 7.
fn shape[&p, &w](prog: &p [int], work: &!w [int], first: int, end: int) -> [] (int, int, int) {
    var sp = 0;
    var depth = 0;
    var at = first;
    while at < end {
        let op = prog[at];
        if op == op_cell() || op == op_const() || op == op_len() {
            if op == op_cell() {
                work[72 + sp] = prog[at + 2];
            } else {
                work[72 + sp] = prog[at + 2];
            }
            sp = sp + 1;
            if sp > depth {
                depth = sp;
            }
            if op == op_cell() && prog[at + 3] >= 2 {
                // a coalesce: the constant that follows is the default, not an operand
                at = at + 4;
            }
        } else if op == op_neg() {
            sp = sp;
        } else if op == op_fn() {
            let id = prog[at + 1];
            let n = prog[at + 2];
            var fscale = work[72 + sp - 1];
            if id == 2 {
                fscale = 0;
            } else if id == 3 || id == 4 {
                var k = 0;
                while k < n {
                    if work[72 + sp - n + k] > fscale {
                        fscale = work[72 + sp - n + k];
                    }
                    k = k + 1;
                }
            } else if id >= 5 {
                fscale = prog[at + 3];
            }
            sp = sp - n + 1;
            work[72 + sp - 1] = fscale;
        } else {
            let right = work[72 + sp - 1];
            let left = work[72 + sp - 2];
            sp = sp - 1;
            var scale = left;
            if op == op_mul() {
                scale = left + right;
                if scale > 18 {
                    return (0, 0, s_scale());
                }
            } else if op == op_div() {
                scale = prog[at + 1];
            } else if right > left {
                scale = right;
            }
            work[72 + sp - 1] = scale;
        }
        at = at + 4;
    }
    return (work[72], depth, 0);
}

// The type written after a column: `:int` or `:dec(S)`. Answers (end, scale, kind, status): kind 0 is an int and 1 a decimal; status 0, 1 (syntax), 5 (no type), 6 (`:float`).
fn type_at[&t](t: &t [byte], from: int) -> [] (int, int, int, int) {
    if from >= len(t) || int_of(t[from]) != ':' {
        return (from, 0, 0, 5);
    }
    var rest = len(t) - (from + 1);
    let r = t[from + 1..len(t)];
    if rest >= 3 && bytes.equal(r[0..3], "int") {
        return (from + 4, 0, 0, 0);
    }
    if rest >= 5 && bytes.equal(r[0..5], "float") {
        return (from + 6, 0, 0, 6);
    }
    if rest >= 5 && bytes.equal(r[0..4], "dec(") {
        var k = 4;
        var n = 0;
        var digits = 0;
        while k < rest && int_of(r[k]) >= '0' && int_of(r[k]) <= '9' && digits < 3 {
            n = n * 10 + (int_of(r[k]) - '0');
            digits = digits + 1;
            k = k + 1;
        }
        if digits > 0 && k < rest && int_of(r[k]) == ')' && n <= 18 {
            return (from + 1 + k + 1, n, 1, 0);
        }
    }
    return (from, 0, 0, 1);
}

// The index of the earlier definition (0 .. d - 1) whose name is `word`, or -1: the operand of a chained definition (docs/computed-columns.md section 11).
fn def_index[&h, &t, &p, &w](heap: &!h Heap, t: &t [byte], prog: &p [int], d: int, word: &w [byte]) -> [heap] int {
    var found = -1;
    var k = 0;
    while k < d {
        var other = buffer.empty(heap, 32);
        let (ob, oe, oq, os) = word_at(heap, other, t, prog[1 + 5 * k + 3]);
        other = ob;
        var same = false;
        borrow other as &orr in {
            same = bytes.equal(buffer.bytes(orr), word);
        }
        buffer.drop(heap, other);
        if same {
            found = k;
        }
        k = k + 1;
    }
    return found;
}

// The string literal at `from` (a double quote), `""` inside it one quote: answers (where the text between the quotes starts, where it ends, where the literal ends, status). Status 15
// for a literal that is not closed.
fn string_at[&t](t: &t [byte], from: int) -> [] (int, int, int, int) {
    var j = from + 1;
    while j < len(t) {
        if int_of(t[j]) == 34 {
            if j + 1 < len(t) && int_of(t[j + 1]) == 34 {
                j = j + 2;
            } else {
                return (from + 1, j, j + 1, 0);
            }
        } else {
            j = j + 1;
        }
    }
    return (from + 1, j, j, 15);
}

// An integer written in digits only at `from` (spaces first), from 0 to 999,999,999: answers (where it ends, its value, status). Status 15 for anything else, a sign and a point included.
fn digits_at[&t](t: &t [byte], from: int) -> [] (int, int, int) {
    let p = skip_space(t, from);
    var q = p;
    var n = 0;
    var digits = 0;
    while q < len(t) && int_of(t[q]) >= '0' && int_of(t[q]) <= '9' && digits < 10 {
        n = n * 10 + (int_of(t[q]) - '0');
        digits = digits + 1;
        q = q + 1;
    }
    if digits == 0 || digits > 9 {
        return (p, 0, 15);
    }
    if q < len(t) && !(is_space(int_of(t[q])) || int_of(t[q]) == ')' || int_of(t[q]) == ',') {
        return (p, 0, 15);
    }
    return (q, n, 0);
}

// `len(` of a column or of a string literal, the argument at `from`, in a number-valued definition: the instruction is written at `cur`. Answers (where the call ends, the new `cur`, status).
// A typed column, a call and an earlier definition are `compute.type-mismatch`; a second argument is `compute.arity`.
fn len_at[&h, &t, &n, &e, &p](heap: &!h Heap, t: &t [byte], from: int, names: &n [byte], ends: &e [int], ncols: int, prog: &!p [int], cur: int, d: int) -> [heap] (int, int, int) {
    let i = skip_space(t, from);
    if i >= len(t) {
        return (i, cur, 1);
    }
    var next = i;
    var cur2 = cur;
    if int_of(t[i]) == 34 {
        let (lf, lt, le, ls) = string_at(t, i);
        if ls != 0 {
            return (i, cur, ls);
        }
        var bytes_in = 0;
        var k = lf;
        while k < lt {
            bytes_in = bytes_in + 1;
            if int_of(t[k]) == 34 {
                k = k + 2;
            } else {
                k = k + 1;
            }
        }
        cur2 = emit(prog, cur, op_const(), bytes_in, 0, 0);
        next = le;
    } else {
        var cb = buffer.empty(heap, 32);
        let (b2, e2, q2, s2) = word_at(heap, cb, t, i);
        cb = b2;
        var status = 0;
        if s2 != 0 {
            status = 1;
        } else if e2 < len(t) && (int_of(t[e2]) == ':' || int_of(t[e2]) == '(') {
            status = 16;
        } else {
            var col = 0;
            var rs = 0;
            borrow cb as &cr in {
                let (cc, rr) = resolve(names, ends, ncols, buffer.bytes(cr), q2);
                col = cc;
                rs = rr;
            }
            if rs == 2 {
                var dk = -1;
                borrow cb as &cr in {
                    dk = def_index(heap, t, prog, d, buffer.bytes(cr));
                }
                if dk >= 0 {
                    status = 16;
                } else {
                    status = 2;
                }
            } else if rs != 0 {
                status = rs;
            } else {
                cur2 = emit(prog, cur, op_len(), col, 0, 0);
                next = e2;
            }
        }
        buffer.drop(heap, cb);
        if status != 0 {
            return (i, cur, status);
        }
    }
    let after = skip_space(t, next);
    if after >= len(t) {
        return (after, cur, 1);
    }
    if int_of(t[after]) == ',' {
        return (after, cur, 14);
    }
    if int_of(t[after]) != ')' {
        return (after, cur, 1);
    }
    return (after + 1, cur2, 0);
}

// Whether the expression at `from` (after the `=`) is a call of a text function: a word, the parenthesis next to it, and a name from 11 to 18.
fn is_text_call[&h, &t](heap: &!h Heap, t: &t [byte], from: int) -> [heap] bool {
    let p = skip_space(t, from);
    if p >= len(t) {
        return false;
    }
    var cb = buffer.empty(heap, 32);
    let (b2, e2, q2, s2) = word_at(heap, cb, t, p);
    cb = b2;
    var fid = 0;
    if s2 == 0 && !q2 && e2 < len(t) && int_of(t[e2]) == '(' {
        borrow cb as &cr in {
            fid = function_id(buffer.bytes(cr));
        }
    }
    buffer.drop(heap, cb);
    return fid >= 11 && fid <= 18;
}

// The instructions of definition `dk` written again at `cur`: answers the new `cur`.
fn copy_definition[&p](prog: &!p [int], cur: int, dk: int) -> [] int {
    let src = prog[1 + 5 * dk];
    let size = prog[1 + 5 * dk + 1] - src;
    var q = 0;
    while q < size {
        prog[cur + q] = prog[src + q];
        q = q + 1;
    }
    return cur + size;
}

// The most ints a text definition may take: 128 instructions of four.
fn text_limit() -> [] int {
    return 4 * 128;
}

// A text-valued definition (docs/functions.md section 3.3), from `from`, its first token the name of a text function. The program is written at `at`; the definition's scale is -1. Answers
// (where the definition ends, the new `at`, status, offset) as `define` does.
fn text_define[&h, &t, &n, &e, &p, &w](heap: &!h Heap, t: &t [byte], from: int, names: &n [byte], ends: &e [int], ncols: int, prog: &!p [int], work: &!w [int], d: int, at: int, name_first: int, name_last: int) -> [heap] (int, int, int, int) {
    var status = 0;
    var offset = from;
    var i = from;
    var cur = at;
    let first = at;
    var expect = true;
    var done = false;
    work[64] = 0;
    work[65] = 0;
    while status == 0 && !done {
        i = skip_space(t, i);
        offset = i;
        if cur - first > text_limit() {
            status = 9;
        } else if expect {
            if i >= len(t) {
                status = 1;
            } else if int_of(t[i]) == 34 {
                let (lf, lt, le, ls) = string_at(t, i);
                if ls != 0 {
                    status = ls;
                } else {
                    cur = emit(prog, cur, ctext.op_lit(), lf, lt, 0);
                    i = le;
                    expect = false;
                }
            } else if int_of(t[i]) >= '0' && int_of(t[i]) <= '9' || int_of(t[i]) == '.' || int_of(t[i]) == '-' {
                status = 16;
            } else {
                var cb = buffer.empty(heap, 32);
                let (b2, e2, q2, s2) = word_at(heap, cb, t, i);
                cb = b2;
                if s2 != 0 {
                    status = 1;
                } else if !q2 && e2 < len(t) && int_of(t[e2]) == '(' {
                    var fid = 0;
                    borrow cb as &cr in {
                        fid = function_id(buffer.bytes(cr));
                    }
                    if fid == 0 {
                        status = 13;
                    } else if fid < 11 || fid == 19 {
                        status = 16;
                    } else {
                        work[65] = work[65] + 1;
                        if work[64] > 28 || work[65] > 4 {
                            status = 9;
                        } else {
                            let top = work[64];
                            work[top] = 7;
                            work[32 + top] = fid * 16;
                            work[192 + top] = i;
                            work[224 + top] = 0;
                            work[64] = top + 1;
                            i = e2 + 1;
                        }
                    }
                } else if e2 < len(t) && int_of(t[e2]) == ':' {
                    status = 16;
                } else {
                    var col = 0;
                    var rs = 0;
                    borrow cb as &cr in {
                        let (cc, rr) = resolve(names, ends, ncols, buffer.bytes(cr), q2);
                        col = cc;
                        rs = rr;
                    }
                    if rs == 2 {
                        var dk = -1;
                        borrow cb as &cr in {
                            dk = def_index(heap, t, prog, d, buffer.bytes(cr));
                        }
                        if dk < 0 {
                            status = 2;
                        } else if prog[1 + 5 * dk + 2] >= 0 {
                            status = 16;
                        } else {
                            // an earlier text definition: its instructions are copied here, as one operand (as a number definition's are)
                            cur = copy_definition(prog, cur, dk);
                            i = e2;
                            expect = false;
                        }
                    } else if rs != 0 {
                        status = rs;
                    } else {
                        cur = emit(prog, cur, ctext.op_col(), col, 0, 0);
                        i = e2;
                        expect = false;
                    }
                }
                buffer.drop(heap, cb);
            }
        } else if i >= len(t) || int_of(t[i]) == ';' && work[65] == 0 {
            if work[65] != 0 {
                status = 1;
            } else {
                done = true;
            }
        } else if int_of(t[i]) == ')' {
            if work[65] == 0 {
                status = 1;
            } else {
                let top = work[64] - 1;
                let fid = work[32 + top] / 16;
                let nargs = work[32 + top] % 16 + 1;
                var lo = 1;
                var hi = 1;
                if fid == 16 || fid == 18 {
                    lo = 3;
                    hi = 3;
                } else if fid == 17 {
                    lo = 2;
                    hi = 8;
                }
                if nargs < lo || nargs > hi {
                    status = 14;
                    offset = work[192 + top];
                } else {
                    // substr takes one value off the stack: its start and count are literals of the instruction
                    var take = nargs;
                    if fid == 16 {
                        take = 1;
                    }
                    cur = emit(prog, cur, ctext.op_call(), fid, take, work[224 + top]);
                    work[64] = top;
                    work[65] = work[65] - 1;
                    i = i + 1;
                }
            }
        } else if int_of(t[i]) == ',' {
            if work[65] == 0 {
                status = 1;
            } else {
                let top = work[64] - 1;
                let fid = work[32 + top] / 16;
                let commas = work[32 + top] % 16;
                if fid == 16 {
                    // substr(s, start, count): two integer literals
                    let (e1, v1, s1) = digits_at(t, i + 1);
                    if commas != 0 {
                        status = 14;
                        offset = work[192 + top];
                    } else if s1 != 0 || v1 < 1 {
                        status = 15;
                        offset = e1;
                    } else {
                        let q1 = skip_space(t, e1);
                        if q1 >= len(t) {
                            status = 1;
                            offset = q1;
                        } else if int_of(t[q1]) == ')' {
                            status = 14;
                            offset = work[192 + top];
                        } else if int_of(t[q1]) != ',' {
                            status = 1;
                            offset = q1;
                        } else {
                            let (e2, v2, s2) = digits_at(t, q1 + 1);
                            if s2 != 0 {
                                status = 15;
                                offset = e2;
                            } else {
                                let q2 = skip_space(t, e2);
                                if q2 >= len(t) {
                                    status = 1;
                                    offset = q2;
                                } else if int_of(t[q2]) == ',' {
                                    status = 14;
                                    offset = work[192 + top];
                                } else if int_of(t[q2]) != ')' {
                                    status = 1;
                                    offset = q2;
                                } else {
                                    work[224 + top] = v1 * 2147483648 + v2;
                                    work[32 + top] = fid * 16 + 2;
                                    i = q2;
                                }
                            }
                        }
                    }
                } else if fid == 18 {
                    // replace(s, from, to): two string literals, the first not empty
                    let p1 = skip_space(t, i + 1);
                    if commas != 0 {
                        status = 14;
                        offset = work[192 + top];
                    } else if p1 >= len(t) || int_of(t[p1]) != 34 {
                        status = 15;
                        offset = p1;
                    } else {
                        let (f1, t1, l1, s1) = string_at(t, p1);
                        if s1 != 0 || t1 == f1 {
                            status = 15;
                            offset = p1;
                        } else {
                            cur = emit(prog, cur, ctext.op_lit(), f1, t1, 0);
                            let q1 = skip_space(t, l1);
                            if q1 >= len(t) {
                                status = 1;
                                offset = q1;
                            } else if int_of(t[q1]) == ')' {
                                status = 14;
                                offset = work[192 + top];
                            } else if int_of(t[q1]) != ',' {
                                status = 1;
                                offset = q1;
                            } else {
                                let p2 = skip_space(t, q1 + 1);
                                if p2 >= len(t) || int_of(t[p2]) != 34 {
                                    status = 15;
                                    offset = p2;
                                } else {
                                    let (f2, t2, l2, s2) = string_at(t, p2);
                                    if s2 != 0 {
                                        status = 15;
                                        offset = p2;
                                    } else {
                                        cur = emit(prog, cur, ctext.op_lit(), f2, t2, 0);
                                        let q2 = skip_space(t, l2);
                                        if q2 >= len(t) {
                                            status = 1;
                                            offset = q2;
                                        } else if int_of(t[q2]) == ',' {
                                            status = 14;
                                            offset = work[192 + top];
                                        } else if int_of(t[q2]) != ')' {
                                            status = 1;
                                            offset = q2;
                                        } else {
                                            work[32 + top] = fid * 16 + 2;
                                            i = q2;
                                        }
                                    }
                                }
                            }
                        }
                    }
                } else if fid == 17 {
                    if commas + 2 > 8 {
                        status = 14;
                        offset = work[192 + top];
                    } else {
                        work[32 + top] = work[32 + top] + 1;
                        expect = true;
                        i = i + 1;
                    }
                } else {
                    // a function of one argument: an empty argument is a syntax error, a second one is the wrong arity
                    let q = skip_space(t, i + 1);
                    if q < len(t) && int_of(t[q]) == ')' {
                        status = 1;
                    } else {
                        status = 14;
                        offset = work[192 + top];
                    }
                }
            }
        } else if int_of(t[i]) == '+' || int_of(t[i]) == '-' || int_of(t[i]) == '*' || int_of(t[i]) == '/' {
            status = 16;
        } else {
            status = 1;
        }
    }
    if status != 0 {
        return (i, at, status, offset);
    }
    prog[1 + 5 * d] = first;
    prog[1 + 5 * d + 1] = cur;
    prog[1 + 5 * d + 2] = -1;
    prog[1 + 5 * d + 3] = name_first;
    prog[1 + 5 * d + 4] = name_last;
    return (i, cur, 0, 0);
}

// One definition from `from` to the `;` or the end: its program is written at `prog[at ..]` and its header at slot `d`. Answers (end of the definition in the text, the new `at`, status, offset).
fn define[&h, &t, &n, &e, &p, &w](heap: &!h Heap, t: &t [byte], from: int, names: &n [byte], ends: &e [int], ncols: int, prog: &!p [int], work: &!w [int], d: int, at: int) -> [heap] (int, int, int, int) {
    var wb = buffer.empty(heap, 32);
    var i = skip_space(t, from);
    let name_first = i;
    var status = 0;
    var offset = i;
    var out_at = at;
    var i_end = i;
    let (nb, ne, nq, ns) = word_at(heap, wb, t, i);
    wb = nb;
    i = ne;
    if ns != 0 {
        status = 1;
    }
    var name_len = 0;
    borrow wb as &wr in {
        name_len = buffer.size(wr);
    }
    if status == 0 && name_len == 0 {
        status = 1;
    }
    // the name is not a column of the input nor one of the definitions before
    if status == 0 {
        borrow wb as &wr in {
            let (c0, cs) = resolve(names, ends, ncols, buffer.bytes(wr), true);
            if cs == 0 {
                status = 4;
            }
        }
    }
    let name_last = i;
    if status == 0 {
        var k = 0;
        while k < d && status == 0 {
            var other = buffer.empty(heap, 32);
            let (ob, oe, oq, os) = word_at(heap, other, t, prog[1 + 5 * k + 3]);
            other = ob;
            var same = false;
            borrow wb as &wr in {
                borrow other as &orr in {
                    same = bytes.equal(buffer.bytes(wr), buffer.bytes(orr));
                }
            }
            buffer.drop(heap, other);
            if same {
                status = 4;
            }
            k = k + 1;
        }
    }
    buffer.drop(heap, wb);
    if status == 0 {
        i = skip_space(t, i);
        if i >= len(t) || int_of(t[i]) != '=' {
            status = 1;
            offset = i;
        } else {
            i = i + 1;
        }
    } else {
        offset = name_first;
    }
    if status == 0 && is_text_call(heap, t, i) {
        return text_define(heap, t, i, names, ends, ncols, prog, work, d, at, name_first, name_last);
    }
    work[64] = 0;
    work[65] = 0;
    var expect = true;
    var done = false;
    var depth_ok = true;
    let first = at;
    var cur = at;
    while status == 0 && !done {
        i = skip_space(t, i);
        offset = i;
        if cur - first > 4 * 128 {
            status = 9;
        } else if i >= len(t) || int_of(t[i]) == ';' && work[65] == 0 {
            done = true;
        } else if expect {
            let c = int_of(t[i]);
            if c == '-' {
                work[work[64]] = 5;
                work[32 + work[64]] = -1;
                work[64] = work[64] + 1;
                i = i + 1;
            } else if c == '(' {
                work[65] = work[65] + 1;
                if work[65] > 4 || work[64] > 28 {
                    status = 9;
                } else {
                    work[work[64]] = 6;
                    work[32 + work[64]] = -1;
                    work[64] = work[64] + 1;
                    i = i + 1;
                }
            } else if c >= '0' && c <= '9' || c == '.' {
                let (ne2, v, sc, ns2) = number_at(t, i);
                if ns2 != 0 {
                    status = 1;
                } else {
                    cur = emit(prog, cur, op_const(), v, sc, 0);
                    i = ne2;
                    expect = false;
                }
            } else {
                var cb = buffer.empty(heap, 32);
                let (b2, e2, q2, s2) = word_at(heap, cb, t, i);
                cb = b2;
                if s2 != 0 {
                    status = 1;
                } else if !q2 && e2 < len(t) && int_of(t[e2]) == '(' {
                    // a call: `name(`, the parenthesis next to the name. The name is looked up, a marker goes on the operator stack, and the arguments are read as operands.
                    var fid = 0;
                    borrow cb as &cr in {
                        fid = function_id(buffer.bytes(cr));
                    }
                    if fid == 0 {
                        status = 13;
                    } else if fid >= 11 && fid <= 18 {
                        // a text function in the middle of a number expression: no conversion either way
                        status = 16;
                    } else if fid == 19 {
                        let (le, lcur, lst) = len_at(heap, t, e2 + 1, names, ends, ncols, prog, cur, d);
                        if lst != 0 {
                            status = lst;
                            offset = le;
                        } else {
                            cur = lcur;
                            i = le;
                            expect = false;
                        }
                    } else {
                        work[65] = work[65] + 1;
                        if work[64] > 28 || work[65] > 4 {
                            status = 9;
                        } else {
                            let top = work[64];
                            work[top] = 7;
                            work[32 + top] = fid * 16;
                            work[160 + top] = cur;
                            work[192 + top] = i;
                            work[224 + top] = 0;
                            work[64] = top + 1;
                            i = e2 + 1;
                        }
                    }
                } else {
                    var col = 0;
                    var rs = 0;
                    borrow cb as &cr in {
                        let (cc, rr) = resolve(names, ends, ncols, buffer.bytes(cr), q2);
                        col = cc;
                        rs = rr;
                    }
                    var dk = -1;
                    if rs == 2 {
                        borrow cb as &cr in {
                            dk = def_index(heap, t, prog, d, buffer.bytes(cr));
                        }
                    }
                    if dk >= 0 && prog[1 + 5 * dk + 2] < 0 {
                        // an earlier definition that is a text: no conversion either way
                        status = 16;
                    } else if dk >= 0 {
                        // an earlier definition: its instructions are copied here, as one operand. It takes no type: a ':' after it is met as an operator is, and is a syntax error at its own offset.
                        // The copy is not bounded here because the loop's own check (`cur - first > 4 * 128`, at the start of the next step) refuses what is too long, and the program has room for it:
                        // a definition that passed is at most 4 * 128 + 4 * 28 ints, a copy adds one, so no definition's region passes 1,140 ints and the eight end before 5,600 of `program_size()`'s 8,233.
                        let from_at = prog[1 + 5 * dk];
                        let n_ints = prog[1 + 5 * dk + 1] - from_at;
                        var q = 0;
                        while q < n_ints {
                            prog[cur + q] = prog[from_at + q];
                            q = q + 1;
                        }
                        cur = cur + n_ints;
                        i = e2;
                        expect = false;
                    } else if rs != 0 {
                        status = rs;
                    } else {
                        let (te, ts, tk, tstat) = type_at(t, e2);
                        if tstat != 0 {
                            status = tstat;
                            offset = e2;
                        } else {
                            cur = emit(prog, cur, op_cell(), col, ts, tk);
                            i = te;
                            expect = false;
                        }
                    }
                }
                buffer.drop(heap, cb);
            }
        } else {
            let c = int_of(t[i]);
            if c == ')' {
                if work[65] == 0 {
                    status = 1;
                } else {
                    while work[64] > 0 && work[work[64] - 1] != 6 && work[work[64] - 1] != 7 && status == 0 {
                        cur = pop_op(prog, work, cur);
                        if cur < 0 {
                            status = 8;
                        }
                    }
                    if status == 0 {
                        let top = work[64] - 1;
                        if work[top] == 7 {
                            let fid = work[32 + top] / 16;
                            let nargs = work[32 + top] % 16 + 1;
                            if nargs < arity_min(fid) || nargs > arity_max(fid) {
                                status = 14;
                                offset = work[192 + top];
                            } else if fid <= 4 {
                                cur = emit(prog, cur, op_fn(), fid, nargs, 0);
                            } else if fid <= 8 {
                                // the scale of the rounding family is a literal of the instruction, not an operand: one value comes off the stack
                                cur = emit(prog, cur, op_fn(), fid, 1, work[224 + top]);
                            }
                        }
                        if status == 0 {
                            work[64] = work[64] - 1;
                            work[65] = work[65] - 1;
                            i = i + 1;
                        }
                    }
                }
            } else if c == ',' {
                // the next argument of a call: the operators of this one are popped back to the call's marker
                while status == 0 && work[64] > 0 && work[work[64] - 1] != 6 && work[work[64] - 1] != 7 {
                    cur = pop_op(prog, work, cur);
                    if cur < 0 {
                        status = 8;
                    }
                }
                if status == 0 && (work[64] == 0 || work[work[64] - 1] != 7) {
                    status = 1;
                } else if status == 0 {
                    let top = work[64] - 1;
                    let fid = work[32 + top] / 16;
                    let commas = work[32 + top] % 16;
                    if fid >= 5 && fid <= 8 {
                        // round, floor, ceil, trunc: the second argument is an integer literal from 0 to 18, read here and not as an operand
                        let (le, n, ls) = scale_literal(t, i + 1);
                        if commas != 0 {
                            status = 14;
                            offset = work[192 + top];
                        } else if ls != 0 {
                            status = 15;
                            offset = le;
                        } else {
                            let after = skip_space(t, le);
                            if after < len(t) && int_of(t[after]) == ',' {
                                status = 14;
                                offset = work[192 + top];
                            } else if after >= len(t) || int_of(t[after]) != ')' {
                                status = 1;
                                offset = after;
                            } else {
                                work[224 + top] = n;
                                work[32 + top] = fid * 16 + 1;
                                i = after;
                            }
                        }
                    } else if fid == 9 {
                        // coalesce: the first argument is one plain typed column (one cell instruction, with no default yet), the second a number
                        let start = work[160 + top];
                        if commas != 0 || cur - start != 4 || prog[start] != op_cell() || prog[start + 3] >= 2 {
                            status = 1;
                        } else {
                            let (le, v, sc, ls) = default_literal(t, i + 1);
                            if ls != 0 || sc > prog[start + 2] {
                                status = 15;
                                offset = skip_space(t, i + 1);
                            } else {
                                let after = skip_space(t, le);
                                if after < len(t) && int_of(t[after]) == ',' {
                                    status = 14;
                                    offset = work[192 + top];
                                } else if after >= len(t) || int_of(t[after]) != ')' {
                                    status = 1;
                                    offset = after;
                                } else {
                                    prog[start + 3] = prog[start + 3] + 2;
                                    cur = emit(prog, cur, op_const(), v, sc, 0);
                                    work[32 + top] = fid * 16 + 1;
                                    i = after;
                                }
                            }
                        }
                    } else if commas + 2 > arity_max(fid) {
                        status = 14;
                        offset = work[192 + top];
                    } else {
                        work[32 + top] = work[32 + top] + 1;
                        expect = true;
                        i = i + 1;
                    }
                }
            } else if c == '+' || c == '-' || c == '*' || c == '/' {
                var code = 1;
                if c == '-' {
                    code = 2;
                } else if c == '*' {
                    code = 3;
                } else if c == '/' {
                    code = 4;
                }
                while status == 0 && work[64] > 0 && prec(work[work[64] - 1]) >= prec(code) {
                    cur = pop_op(prog, work, cur);
                    if cur < 0 {
                        status = 8;
                    }
                }
                if status == 0 {
                    if work[64] > 28 {
                        status = 9;
                    } else {
                        work[work[64]] = code;
                        work[32 + work[64]] = -1;
                        work[64] = work[64] + 1;
                        expect = true;
                        i = i + 1;
                    }
                }
            } else if c == '@' {
                while work[64] > 0 && work[work[64] - 1] == 5 {
                    cur = pop_op(prog, work, cur);
                }
                if work[64] == 0 || work[work[64] - 1] != 4 || work[32 + work[64] - 1] >= 0 {
                    status = 1;
                } else {
                    var k = i + 1;
                    var n = 0;
                    var digits = 0;
                    while k < len(t) && int_of(t[k]) >= '0' && int_of(t[k]) <= '9' && digits < 3 {
                        n = n * 10 + (int_of(t[k]) - '0');
                        digits = digits + 1;
                        k = k + 1;
                    }
                    if digits == 0 || n > 18 {
                        status = 1;
                        offset = i;
                    } else {
                        work[32 + work[64] - 1] = n;
                        i = k;
                    }
                }
            } else {
                status = 1;
            }
        }
    }
    if status == 0 && (expect || work[65] != 0) {
        status = 1;
    }
    while status == 0 && work[64] > 0 {
        if work[work[64] - 1] == 6 || work[work[64] - 1] == 7 {
            status = 1;
        } else {
            cur = pop_op(prog, work, cur);
            if cur < 0 {
                status = 8;
            }
        }
    }
    if status != 0 {
        return (i, at, status, offset);
    }
    let (scale, depth, shape_status) = shape(prog, work, first, cur);
    if shape_status != 0 {
        return (i, at, shape_status, name_first);
    }
    if depth > 10 {
        return (i, at, 9, name_first);
    }
    prog[1 + 5 * d] = first;
    prog[1 + 5 * d + 1] = cur;
    prog[1 + 5 * d + 2] = scale;
    prog[1 + 5 * d + 3] = name_first;
    prog[1 + 5 * d + 4] = name_last;
    return (i, cur, 0, 0);
}

// All the definitions of `t` against the header: answers (status, offset in the text, definitions compiled). `prog` is `program_size()` ints and `work` `work_size()`.
pub fn compile[&h, &t, &n, &e, &p, &w](heap: &!h Heap, t: &t [byte], names: &n [byte], ends: &e [int], ncols: int, prog: &!p [int], work: &!w [int]) -> [heap] (int, int, int) {
    if len(t) > 8 * 256 {
        return (9, 0, 0);
    }
    var at = code_base();
    var d = 0;
    var i = 0;
    var more = true;
    while more {
        if d >= 8 {
            return (9, i, d);
        }
        let (e1, at1, st, off) = define(heap, t, i, names, ends, ncols, prog, work, d, at);
        if st != 0 {
            return (st, off, d);
        }
        if e1 - i > 256 {
            return (9, i, d);
        }
        at = at1;
        d = d + 1;
        i = e1;
        if i < len(t) && int_of(t[i]) == ';' {
            i = i + 1;
        } else {
            more = false;
        }
    }
    prog[0] = d;
    return (0, 0, d);
}

pub fn count[&p](prog: &p [int]) -> [] int {
    return prog[0];
}

pub fn scale_of[&p](prog: &p [int], d: int) -> [] int {
    return prog[1 + 5 * d + 2];
}

// The name of definition `d`, unescaped, appended to `out`.
pub fn name_of[&h, &t, &p](heap: &!h Heap, out: buffer.Buffer, t: &t [byte], prog: &p [int], d: int) -> [heap] buffer.Buffer {
    let (o, e, q, s) = word_at(heap, out, t, prog[1 + 5 * d + 3]);
    return o;
}

// The size of definition `d`, in instructions.
pub fn size_of[&p](prog: &p [int], d: int) -> [] int {
    return (prog[1 + 5 * d + 1] - prog[1 + 5 * d]) / 4;
}

// Whether definition `d` has an instruction of a class: 0 an operator (+, -, * or /), 1 a division, 2 a cell read as :int, 3 a cell read as :dec(S), 4 a `substr`.
pub fn has[&p](prog: &p [int], d: int, what: int) -> [] bool {
    var at = prog[1 + 5 * d];
    let end = prog[1 + 5 * d + 1];
    while at < end {
        let op = prog[at];
        if what == 0 && (op == op_add() || op == op_sub() || op == op_mul() || op == op_div() || op == op_fn() && prog[at + 1] >= 3) {
            return true;
        }
        if what == 1 && op == op_div() {
            return true;
        }
        if what == 4 && op == ctext.op_call() && prog[at + 1] == 16 {
            return true;
        }
        if op == op_cell() {
            if what == 2 && prog[at + 3] % 2 == 0 {
                return true;
            }
            if what == 3 && prog[at + 3] % 2 == 1 {
                return true;
            }
        }
        at = at + 4;
    }
    return false;
}

// One cell of the row as a value in slot `s`: answers (status, 0). Status 0, or `s_cell_int()` / `s_cell_dec()` plus the parser's status.
fn load_cell[&d, &c, &w](record: &d [byte], cells: &c [int], col: int, scale: int, kind: int, w: &!w [int], s: int) -> [] int {
    let first = cells[3 * col];
    let last = cells[3 * col + 1];
    // A quoted cell's span is inside its quotes; a number holds no quote, so a cell with one is refused by the parser below as any other text is.
    var v = 0;
    var st = 0;
    if kind == 0 {
        let (v1, s1) = cellnum.parse_int(record[first..last]);
        v = v1;
        st = s1;
    } else {
        let (v1, s1) = cellnum.parse_dec(record[first..last], scale);
        v = v1;
        st = s1;
    }
    if st != 0 {
        if kind == 0 {
            return s_cell_int() + st;
        }
        return s_cell_dec() + st;
    }
    cmpv.set_int(w, s, v, scale);
    return 0;
}

// A call: its `n` operands are in the slots from `base`, and its value is left in slot `base`. Answers 0, or 12 when a result is 2^127 or more. Slots 10 and 11 are scratch: the program holds
// at most 10 operands at once, in slots 0 to 9.
fn apply[&w](w: &!w [int], id: int, base: int, n: int, extra: int) -> [] int {
    if id == 1 {
        cmpv.abs(w, base);
        return 0;
    }
    if id == 2 {
        var v = 1;
        if cmpv.is_zero(w, base) {
            v = 0;
        } else if cmpv.negative(w, base) {
            v = -1;
        }
        cmpv.set_int(w, base, v, 0);
        return 0;
    }
    if id == 3 || id == 4 {
        // each operand exactly at the largest scale (past 127 bits is an overflow), then the largest or the smallest
        var widest = 0;
        var k = 0;
        while k < n {
            if cmpv.scale_of(w, base + k) > widest {
                widest = cmpv.scale_of(w, base + k);
            }
            k = k + 1;
        }
        k = 0;
        while k < n {
            if !cmpv.rescale(w, base + k, widest) {
                return 12;
            }
            k = k + 1;
        }
        var best = base;
        k = 1;
        while k < n {
            let c = cmpv.cmp(w, base + k, best);
            if id == 3 && c > 0 || id == 4 && c < 0 {
                best = base + k;
            }
            k = k + 1;
        }
        if best != base {
            cmpv.copy(w, base, best);
        }
        return 0;
    }
    // round, floor, ceil and trunc: the value at scale `extra`. Divided by one at that scale, which rounds half to even (the rule of `/ @N`) and only adds zeros when the scale is not lower;
    // floor, ceil and trunc then step by one unit of the last digit if that rounding went the wrong way, which it can by one unit and no more.
    let s = cmpv.scale_of(w, base);
    cmpv.set_int(w, 10, 1, 0);
    if cmpv.div(w, 11, base, 10, extra) != 0 {
        return 12;
    }
    if id != 5 && extra < s {
        cmpv.copy(w, 10, 11);
        cmpv.mul_pow10(w, 10, s - extra);
        cmpv.set_scale(w, 10, s);
        let c = cmpv.cmp(w, 10, base);
        var down = false;
        var up = false;
        if id == 6 {
            down = c > 0;
        } else if id == 7 {
            up = c < 0;
        } else if cmpv.negative(w, base) {
            up = c < 0;
        } else {
            down = c > 0;
        }
        if down || up {
            cmpv.set_int(w, 10, 1, extra);
            var ok = true;
            if down {
                ok = cmpv.sub(w, 11, 11, 10);
            } else {
                ok = cmpv.add(w, 11, 11, 10);
            }
            if !ok {
                return 12;
            }
        }
    }
    cmpv.copy(w, base, 11);
    return 0;
}

// Definition `d` against one row: the value is left in slot 0 of the workspace `w`. Answers (status, column of the cell that was refused).
pub fn eval[&p, &dd, &c, &w](prog: &p [int], d: int, record: &dd [byte], cells: &c [int], w: &!w [int]) -> [] (int, int) {
    var at = prog[1 + 5 * d];
    let end = prog[1 + 5 * d + 1];
    var sp = 0;
    while at < end {
        let op = prog[at];
        if op == op_cell() {
            let kind = prog[at + 3];
            if kind >= 2 && cells[3 * prog[at + 1]] == cells[3 * prog[at + 1] + 1] {
                // a coalesce and an empty cell: the default that follows, at the column's scale
                cmpv.set_int(w, sp, prog[at + 5], prog[at + 6]);
                cmpv.mul_pow10(w, sp, prog[at + 2] - prog[at + 6]);
                cmpv.set_scale(w, sp, prog[at + 2]);
            } else {
                let st = load_cell(record, cells, prog[at + 1], prog[at + 2], kind % 2, w, sp);
                if st != 0 {
                    return (st, prog[at + 1]);
                }
            }
            if kind >= 2 {
                at = at + 4;
            }
            sp = sp + 1;
        } else if op == op_len() {
            let col = prog[at + 1];
            cmpv.set_int(w, sp, ctext.length(record, cells[3 * col], cells[3 * col + 1], cells[3 * col + 2]), 0);
            sp = sp + 1;
        } else if op == op_fn() {
            let base = sp - prog[at + 2];
            if apply(w, prog[at + 1], base, prog[at + 2], prog[at + 3]) != 0 {
                return (12, 0);
            }
            sp = base + 1;
        } else if op == op_const() {
            cmpv.set_int(w, sp, prog[at + 1], prog[at + 2]);
            sp = sp + 1;
        } else if op == op_neg() {
            cmpv.negate(w, sp - 1);
        } else {
            sp = sp - 1;
            var ok = true;
            if op == op_add() {
                ok = cmpv.add(w, sp - 1, sp - 1, sp);
            } else if op == op_sub() {
                ok = cmpv.sub(w, sp - 1, sp - 1, sp);
            } else if op == op_mul() {
                ok = cmpv.mul(w, sp - 1, sp - 1, sp);
            } else {
                let st = cmpv.div(w, sp - 1, sp - 1, sp, prog[at + 1]);
                if st == 1 {
                    return (11, 0);
                }
                ok = st == 0;
            }
            if !ok {
                return (12, 0);
            }
        }
        at = at + 4;
    }
    cmpv.copy(w, 0, sp - 1);
    return (0, 0);
}
