edition 5;

module qlex;

// The lexer of `--query` (docs/query.md section 2, "Lexical"): the query's bytes to tokens, written into the block `qarena` describes.
//
//     END   the end of the query                     ID    a bare word: letters, digits and underscore, not starting with a digit (ASCII)
//     STR   'single quoted', '' for a quote           QID   "double quoted", "" for a quote, never empty
//     POS   #3, a column by position                  NUM   [+-] digits [. digits] [e [+-] digits], or [+-] . digits ...
//     SYM   one of  , ( ) * = < > ;  and  != <> <= >= ::   (aux says which), and the dot of alias.column in a query that has a join word in it
//
// Space, tab, CR and LF separate tokens. There are no comments (`--` and `/*` are a syntax error) and no `+ - / % ||` (an expression: unsupported). A byte that starts nothing is
// a syntax error at that byte; bytes outside ASCII are only ever inside a string or a quoted name.

import std.bytes;
import qarena;

pub fn t_end() -> [] int {
    return 0;
}

pub fn t_id() -> [] int {
    return 1;
}

pub fn t_str() -> [] int {
    return 2;
}

pub fn t_qid() -> [] int {
    return 3;
}

pub fn t_pos() -> [] int {
    return 4;
}

pub fn t_num() -> [] int {
    return 5;
}

pub fn t_sym() -> [] int {
    return 6;
}

// the aux of a SYM
pub fn y_comma() -> [] int {
    return 1;
}

pub fn y_open() -> [] int {
    return 2;
}

pub fn y_close() -> [] int {
    return 3;
}

pub fn y_star() -> [] int {
    return 4;
}

pub fn y_eq() -> [] int {
    return 5;
}

pub fn y_lt() -> [] int {
    return 6;
}

pub fn y_gt() -> [] int {
    return 7;
}

pub fn y_semi() -> [] int {
    return 8;
}

pub fn y_ne() -> [] int {
    return 9;
}

pub fn y_ltgt() -> [] int {
    return 10;
}

pub fn y_le() -> [] int {
    return 11;
}

pub fn y_ge() -> [] int {
    return 12;
}

pub fn y_cast() -> [] int {
    return 13;
}

// the dot of alias.column, read only in a query that has a join (docs/joins.md section 20)
pub fn y_dot() -> [] int {
    return 14;
}

fn is_letter(c: int) -> [] bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_';
}

fn is_digit(c: int) -> [] bool {
    return c >= '0' && c <= '9';
}

fn at[&q](q: &q [byte], i: int) -> [] int {
    if i < len(q) {
        return int_of(q[i]);
    }
    return 0 - 1;
}

// Where the digits that begin at `i` end (`i` when there are none).
fn digits_end[&q](q: &q [byte], i: int) -> [] int {
    var j = i;
    while j < len(q) && is_digit(int_of(q[j])) {
        j = j + 1;
    }
    return j;
}

// Where the number that begins at `i` ends, or -1 when none does: [+-] digits [. digits*] or [+-] . digits, then an exponent [eE] [+-] digits when whole.
fn number_end[&q](q: &q [byte], i: int) -> [] int {
    var j = i;
    if at(q, j) == '+' || at(q, j) == '-' {
        j = j + 1;
    }
    if is_digit(at(q, j)) {
        j = digits_end(q, j);
        if at(q, j) == '.' {
            j = digits_end(q, j + 1);
        }
    } else if at(q, j) == '.' && is_digit(at(q, j + 1)) {
        j = digits_end(q, j + 1);
    } else {
        return 0 - 1;
    }
    if at(q, j) == 'e' || at(q, j) == 'E' {
        var k = j + 1;
        if at(q, k) == '+' || at(q, k) == '-' {
            k = k + 1;
        }
        if is_digit(at(q, k)) {
            j = digits_end(q, k);
        }
    }
    return j;
}

// Whether the bytes `a..b` are the word `w` in lower case, whatever their case (ASCII).
fn word_is[&q](q: &q [byte], a: int, b: int, w: &static [byte]) -> [] bool {
    if b - a != len(w) {
        return false;
    }
    var i = 0;
    while i < len(w) {
        if bytes.to_lower(int_of(q[a + i])) != int_of(w[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Whether a bare word of a join (join, inner, left, right, full, cross) is in the query outside its quotes: a `.` is read as a token only then; any other query is refused at its dot as it
// always was. It stops at a quote that never closes.
fn mentions_join[&q](q: &q [byte]) -> [] bool {
    var i = 0;
    let size = len(q);
    while i < size {
        let c = int_of(q[i]);
        if c == 39 || c == 34 {
            let j = closing(q, i, c);
            if j < 0 {
                return false;
            }
            i = j + 1;
        } else if is_letter(c) || is_digit(c) {
            var j = i;
            while j < size && (is_letter(int_of(q[j])) || is_digit(int_of(q[j]))) {
                j = j + 1;
            }
            if word_is(q, i, j, "join") || word_is(q, i, j, "inner") || word_is(q, i, j, "left") || word_is(q, i, j, "right") || word_is(q, i, j, "full") || word_is(q, i, j, "cross") {
                return true;
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    return false;
}

fn put[&m](m: &!m [int], n: int, kind: int, start: int, end: int, aux: int) -> [] int {
    let base = qarena.tokens_at() + 4 * n;
    m[base] = kind;
    m[base + 1] = start;
    m[base + 2] = end;
    m[base + 3] = aux;
    return n + 1;
}

// Where the quoted thing that opens at `i` (a quote byte) closes, the closing quote's index, or -1 when it never does. A doubled quote is one quote inside it.
fn closing[&q](q: &q [byte], i: int, quote: int) -> [] int {
    var j = i + 1;
    while j < len(q) {
        if int_of(q[j]) == quote {
            if at(q, j + 1) == quote {
                j = j + 2;
            } else {
                return j;
            }
        } else {
            j = j + 1;
        }
    }
    return 0 - 1;
}

// Whether the query mentions a join, worked out once (the slot of the state, 0 not yet, 1 yes, 2 no).
fn joined[&q, &m](q: &q [byte], m: &!m [int]) -> [] bool {
    if m[qarena.s_joined()] == 0 {
        if mentions_join(q) {
            m[qarena.s_joined()] = 1;
        } else {
            m[qarena.s_joined()] = 2;
        }
    }
    return m[qarena.s_joined()] == 1;
}

// The tokens of `q` into `m`. Answers 0, or 1 when an error was set (the tokens are then not to be used).
pub fn lex[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    var n = 0;
    var i = 0;
    let size = len(q);
    while i < size {
        let c = int_of(q[i]);
        if c == 32 || c == 9 || c == 13 || c == 10 {
            i = i + 1;
        } else if c == '-' && at(q, i + 1) == '-' || c == '/' && at(q, i + 1) == '*' {
            return qarena.fail(m, 1, 26, i);
        } else if c == 39 {
            let j = closing(q, i, 39);
            if j < 0 {
                return qarena.fail(m, 1, 22, i);
            }
            n = put(m, n, t_str(), i, j + 1, 0);
            i = j + 1;
        } else if c == 34 {
            let j = closing(q, i, 34);
            if j < 0 {
                return qarena.fail(m, 1, 23, i);
            }
            if j == i + 1 {
                return qarena.fail(m, 2, 60, i);
            }
            n = put(m, n, t_qid(), i, j + 1, 0);
            i = j + 1;
        } else if c == '#' {
            let j = digits_end(q, i + 1);
            if j == i + 1 {
                return qarena.fail(m, 1, 24, i);
            }
            n = put(m, n, t_pos(), i, j, 0);
            i = j;
        } else if is_digit(c) || (c == '+' || c == '-' || c == '.') && number_end(q, i) >= 0 {
            let j = number_end(q, i);
            n = put(m, n, t_num(), i, j, 0);
            i = j;
        } else if is_letter(c) {
            var j = i + 1;
            while j < size && (is_letter(int_of(q[j])) || is_digit(int_of(q[j]))) {
                j = j + 1;
            }
            n = put(m, n, t_id(), i, j, 0);
            i = j;
        } else if c == '!' && at(q, i + 1) == '=' {
            n = put(m, n, t_sym(), i, i + 2, y_ne());
            i = i + 2;
        } else if c == '<' && at(q, i + 1) == '>' {
            n = put(m, n, t_sym(), i, i + 2, y_ltgt());
            i = i + 2;
        } else if c == '<' && at(q, i + 1) == '=' {
            n = put(m, n, t_sym(), i, i + 2, y_le());
            i = i + 2;
        } else if c == '>' && at(q, i + 1) == '=' {
            n = put(m, n, t_sym(), i, i + 2, y_ge());
            i = i + 2;
        } else if c == ':' && at(q, i + 1) == ':' {
            n = put(m, n, t_sym(), i, i + 2, y_cast());
            i = i + 2;
        } else if c == ',' || c == '(' || c == ')' || c == '*' || c == '=' || c == '<' || c == '>' || c == ';' {
            var which = y_comma();
            if c == '(' {
                which = y_open();
            } else if c == ')' {
                which = y_close();
            } else if c == '*' {
                which = y_star();
            } else if c == '=' {
                which = y_eq();
            } else if c == '<' {
                which = y_lt();
            } else if c == '>' {
                which = y_gt();
            } else if c == ';' {
                which = y_semi();
            }
            n = put(m, n, t_sym(), i, i + 1, which);
            i = i + 1;
        } else if c == '|' || c == '+' || c == '/' || c == '%' || c == '-' {
            return qarena.fail(m, 2, 61, i);
        } else if c == '.' && joined(q, m) {
            n = put(m, n, t_sym(), i, i + 1, y_dot());
            i = i + 1;
        } else {
            return qarena.fail(m, 1, 25, i);
        }
    }
    n = put(m, n, t_end(), size, size, 0);
    m[qarena.s_tokens()] = n;
    return 0;
}
