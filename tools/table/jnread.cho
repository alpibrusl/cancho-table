edition 5;

module jnread;

// The read of a join (docs/joins.md section 6): the build file read whole into a table (`jtab`), then the probe, the operand or standard input, streamed, each probe row joined to the build
// rows that have its key, and each joined row handed to the engine as one CSV record. A join loop of its own beside `read_file`, which is not touched and does not know a join exists
// (docs/readers.md section 11: a case added to the shared loop made every read slower).
//
//     header phase   both headers are read; the key columns of `--on` are found in them; a name both have is `join.column-collision`; the plan is resolved against the joined header
//                    (the probe's names, then the build's with `--join-prefix` before each): `jnhead`
//     build phase    every record of the build file: ragged? -> key (the cell, its quotes undone) -> held in the table, or the first that passes `--max-state-bytes` is the refusal
//     probe phase    every record of the probe: ragged? -> key -> the build rows of that key in build file order -> one joined record each -> `engine.process_rows`
//
// The joined record is the probe record, the delimiter and the build record, and its cells are the probe's followed by the build's moved by the probe record's length and one, so the
// engine (`--where`, `--select`, the writers) cannot tell it from a row of a file. A probe row with no build row is not in the answer (inner), or is in it once with every build cell empty
// (left: the padded record is the probe record and a delimiter for each build cell shown). A semi join gives the probe record, once, for a row that has a match, an anti join for a row that has none:
// the engine is handed the probe record and its own cells, and the build holds the keys alone. A column of a shared-name key (USING) is left out of the cells, not out of the record.
//
// A key is one pair of text, read in place (J1's loop, which is not changed), or built by `jnkey` (typed pairs, several pairs): a cell that is not of its type ends the read as abort 72, with the
// facts in the tally (err_fn the status of the read, err_cond the pair, err_col the column in its own file, err_row, err_line, err_digits) and the cell in `kept`.
//
// The tally of the probe (`engine.k_*`) counts JOINED rows in `k_records` (what `--from` skips and `next.from` says), and the probe's own rows in `st[0]`.

import std.buffer;
import std.bytes;
import std.vec;
import bulk;
import engine;
import explain;
import finish;
import frame;
import jnfail;
import jnhead;
import jnkey;
import jtab;
import qpath;
import query;
import reader;
import scan;
import spec;
import toolbox.cli;
import toolbox.fail;
import toolbox.lines;
import toolbox.place;

// st[]: where the probe's own counters are.
fn s_probe() -> [] int {
    return 0;
}

fn s_produced() -> [] int {
    return 1;
}

fn s_max_matches() -> [] int {
    return 2;
}

fn s_jtype() -> [] int {
    return 5;
}

fn s_nk() -> [] int {
    return 6;
}

fn s_pairs() -> [] int {
    return 7;
}

fn s_simple() -> [] int {
    return 8;
}

fn s_size() -> [] int {
    return 9;
}

// What a pass counted, as `read_file` hands it to `finish.explain`.
fn counted[&a](a: &a [int], columns: int) -> [] finish.Counts {
    return finish.Counts { columns: columns, records: a[engine.k_records()], ragged: a[engine.k_ragged()], first_row: a[engine.k_first_row()], first_line: a[engine.k_first_line()], first_found: a[engine.k_first_found()], capped: a[engine.k_capped()] == 1, abort: a[engine.k_abort()], abort_line: a[engine.k_abort_line()], long_length: a[engine.k_long()], emitted: a[engine.k_emitted()], more: a[engine.k_more()] == 1, next: a[engine.k_next()], bad_name: a[engine.k_bad_name()], err_col: a[engine.k_err_col()], err_fn: a[engine.k_err_fn()], err_row: a[engine.k_err_row()], err_line: a[engine.k_err_line()], err_cond: a[engine.k_err_cond()], err_digits: a[engine.k_err_digits()], groups: a[engine.k_groups()] };
}

fn nothing() -> [] finish.Counts {
    return finish.Counts { columns: 0, records: 0, ragged: 0, first_row: 0, first_line: 0, first_found: 0, capped: false, abort: 0, abort_line: 0, long_length: 0, emitted: 0, more: false, next: 0, bad_name: 0, err_col: 0, err_fn: 0, err_row: 0, err_line: 0, err_cond: 0, err_digits: 0, groups: 0 };
}

// Hold `key` for build row `record` (the record itself for a join that shows build columns, the key alone for a semi or anti join).
fn put[&h, &k, &r](heap: &!h Heap, t: jtab.JTab, key: &k [byte], record: &r [byte], limit: int, keys_only: bool) -> [heap] (jtab.JTab, bool) {
    if keys_only {
        return jtab.add_key(heap, t, key, limit);
    }
    return jtab.add(heap, t, key, record, limit);
}

// Hold build row `record` (whose cells are `cells`) under its key: 0 when it is held, 1 when it does not fit within `limit` accounted bytes, and 16 + 16 * (the pair) + (the status of the read)
// when a typed key cell is not of its type. A key that is one pair of text is read in place (`simple`: `keys[1]` is its column), any other by `jnkey`.
fn hold_row[&h, &d, &c, &k](heap: &!h Heap, t: jtab.JTab, scratch: buffer.Buffer, kbuf: buffer.Buffer, record: &d [byte], cells: &c [int], keys: &k [int], pairs: int, simple: bool, keys_only: bool, limit: int) -> [heap] (jtab.JTab, buffer.Buffer, buffer.Buffer, int) {
    if simple {
        let key = keys[1];
        let first = cells[3 * key];
        let last = cells[3 * key + 1];
        if cells[3 * key + 2] == 0 {
            let (t2, ok) = put(heap, t, record[first..last], record, limit, keys_only);
            if ok {
                return (t2, scratch, kbuf, 0);
            }
            return (t2, scratch, kbuf, 1);
        }
        var s = scratch;
        borrow mut s as &!sw in {
            buffer.clear(sw);
        }
        s = query.unquote(heap, s, record[first..last]);
        var t3 = t;
        var ok2 = true;
        borrow s as &sr in {
            let (t4, ok3) = put(heap, t3, buffer.bytes(sr), record, limit, keys_only);
            t3 = t4;
            ok2 = ok3;
        }
        if ok2 {
            return (t3, s, kbuf, 0);
        }
        return (t3, s, kbuf, 1);
    }
    let (kb, sc, status, which) = jnkey.make(heap, kbuf, scratch, record, cells, keys, pairs, 1);
    if status != 0 {
        return (t, sc, kb, 16 + 16 * which + status);
    }
    var t5 = t;
    var ok4 = true;
    borrow kb as &kr in {
        let (t6, ok5) = put(heap, t5, buffer.bytes(kr), record, limit, keys_only);
        t5 = t6;
        ok4 = ok5;
    }
    if ok4 {
        return (t5, sc, kb, 0);
    }
    return (t5, sc, kb, 1);
}

// A typed key cell of the build that is not of its type, noted in the tally (abort 72): the answer of `hold_row` is `answer`, the record `record` and its cells `cells`.
fn note_typed[&h, &d, &c, &k, &a](heap: &!h Heap, kept: buffer.Buffer, record: &d [byte], cells: &c [int], keys: &k [int], answer: int, side: int, row: int, line: int, a: &!a [int]) -> [heap] buffer.Buffer {
    let status = (answer - 16) % 16;
    let which = (answer - 16) / 16;
    let column = keys[3 * which + side];
    a[engine.k_abort()] = 72;
    a[engine.k_abort_line()] = line;
    a[engine.k_err_fn()] = status;
    a[engine.k_err_cond()] = which;
    a[engine.k_err_col()] = column;
    a[engine.k_err_row()] = row;
    a[engine.k_err_line()] = line;
    if status == 7 {
        a[engine.k_err_digits()] = jnkey.digits_after_point(record, cells[3 * column], cells[3 * column + 1]);
    }
    return engine.keep_value(heap, kept, record, cells[3 * column], cells[3 * column + 1]);
}

// The build phase: every data record of the build file, held. Answers the reader, the table, what was counted (abort 70: the first row that did not fit; 4, 7, 1 and 2 as a file's) and the
// bytes of the file consumed when it stopped. A ragged row is counted and not held; `most` rows read and another there is `capped`.
fn build_pass[&h, &f, &k](heap: &!h Heap, r0: lines.Lines, file: &!f File, jt0: jtab.JTab, nb: int, keys: &k [int], pairs: int, simple: bool, keys_only: bool, delim: int, cap: int, most: int, limit: int) -> [heap, file_read] (lines.Lines, jtab.JTab, finish.Counts, int, buffer.Buffer) {
    var r = r0;
    var jt = jt0;
    var rec = buffer.empty(heap, 256);
    var kscr = buffer.empty(heap, 64);
    var kbuf = buffer.empty(heap, 64);
    var kept = buffer.empty(heap, 64);
    var tally = box_slice(heap, engine.k_size(), 0);
    var cellbox = box_slice(heap, 3 * (nb + 1), 0);
    var quoted = false;
    var seps = 0;
    var opened = 0;
    var consumed = 0;
    var going = true;
    var c = nothing();
    borrow mut tally as &!tw in {
        let a = contents(tw);
        a[engine.k_columns()] = nb;
        borrow mut cellbox as &!cw in {
            let cells = contents(cw);
            while going {
                var status = 9;
                borrow mut r as &!rw in {
                    status = scan.next_fast(rw);
                }
                if status == 9 {
                    let (stepped, answer) = lines.next(heap, r);
                    r = stepped;
                    status = answer;
                }
                if status == lines.need() {
                    r = lines.fill_file(r, file);
                } else if status == lines.done() {
                    going = false;
                } else if status == lines.long() {
                    a[engine.k_abort()] = 4;
                    borrow r as &rr in {
                        a[engine.k_abort_line()] = lines.number(rr);
                        a[engine.k_long()] = lines.length(rr);
                    }
                    going = false;
                } else {
                    borrow r as &rr in {
                        let number = lines.number(rr);
                        var line = lines.text(rr);
                        let whole = line;
                        if len(line) > 0 && int_of(line[len(line) - 1]) == 13 {
                            line = line[0..len(line) - 1];
                        }
                        if !quoted && len(line) == 0 {
                            // A blank line between records is not a record.
                        } else if !quoted && a[engine.k_records()] >= most {
                            a[engine.k_capped()] = 1;
                            going = false;
                        } else if !quoted {
                            let (n, open, wrong) = reader.fields(line, delim, cells, nb);
                            if wrong {
                                a[engine.k_abort()] = 1;
                                a[engine.k_abort_line()] = number;
                                going = false;
                            } else if open {
                                quoted = true;
                                opened = number;
                                borrow mut rec as &!rw2 in {
                                    buffer.clear(rw2);
                                }
                                rec = buffer.append(heap, rec, whole);
                                rec = buffer.push(heap, rec, byte_of(10));
                            } else if engine.count_row(a, n, number, 0) {
                                let (t2, k2, b2, answer) = hold_row(heap, jt, kscr, kbuf, line, cells, keys, pairs, simple, keys_only, limit);
                                jt = t2;
                                kscr = k2;
                                kbuf = b2;
                                if answer == 1 {
                                    a[engine.k_abort()] = 70;
                                    a[engine.k_abort_line()] = number;
                                    consumed = lines.consumed(rr);
                                    going = false;
                                } else if answer >= 16 {
                                    let row = a[engine.k_records()];
                                    kept = note_typed(heap, kept, line, cells, keys, answer, 1, row, number, a);
                                    going = false;
                                }
                            }
                        } else {
                            let (inside, n, bad) = reader.scan(line, delim, quoted, seps);
                            seps = n;
                            rec = buffer.append(heap, rec, whole);
                            var held = 0;
                            borrow rec as &rw2 in {
                                held = buffer.size(rw2);
                            }
                            if bad {
                                a[engine.k_abort()] = 1;
                                a[engine.k_abort_line()] = number;
                                going = false;
                            } else if inside {
                                rec = buffer.push(heap, rec, byte_of(10));
                                if held + 1 > cap {
                                    a[engine.k_abort()] = 7;
                                    a[engine.k_abort_line()] = opened;
                                    going = false;
                                }
                            } else {
                                quoted = false;
                                seps = 0;
                                borrow rec as &rw2 in {
                                    var record = buffer.bytes(rw2);
                                    if len(record) > 0 && int_of(record[len(record) - 1]) == 13 {
                                        record = record[0..len(record) - 1];
                                    }
                                    let (m, open2, bad2) = reader.fields(record, delim, cells, nb);
                                    if bad2 || open2 {
                                        a[engine.k_abort()] = 1;
                                        a[engine.k_abort_line()] = opened;
                                        going = false;
                                    } else if engine.count_row(a, m, opened, 0) {
                                        let (t2, k2, b2, answer) = hold_row(heap, jt, kscr, kbuf, record, cells, keys, pairs, simple, keys_only, limit);
                                        jt = t2;
                                        kscr = k2;
                                        kbuf = b2;
                                        if answer == 1 {
                                            a[engine.k_abort()] = 70;
                                            a[engine.k_abort_line()] = opened;
                                            consumed = lines.consumed(rr);
                                            going = false;
                                        } else if answer >= 16 {
                                            let row = a[engine.k_records()];
                                            kept = note_typed(heap, kept, record, cells, keys, answer, 1, row, opened, a);
                                            going = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if quoted && a[engine.k_abort()] == 0 {
            a[engine.k_abort()] = 2;
            a[engine.k_abort_line()] = opened;
        }
        c = counted(a, nb);
    }
    unbox_slice(heap, tally);
    unbox_slice(heap, cellbox);
    buffer.drop(heap, rec);
    buffer.drop(heap, kscr);
    buffer.drop(heap, kbuf);
    return (r, jt, c, consumed, kept);
}

// One joined row (or a semi or anti join's probe row) to the engine: counted against `--max-join-rows` (past it the abort is 71, with the facts of the refusal in the tally: `matches` is how many
// build rows the probe row's key has), counted for `--from`, and given to `engine.process_rows`. `padded` says that the build cells of `record` are the padding of a left join, so that a
// refused read of one of them (a column from `np` on) says so (`err_fn` 77: the context is still `where`, and `finish.explain` adds `padded`).
fn emit_one[&h, &i, &q, &c, &s, &w, &d, &a, &z](heap: &!h Heap, io: &!i Io, tree: &q query.Query, cols: &c [int], sel: &s [int], cells: &w [int], record: &d [byte], number: int, st: &!z [int], a: &!a [int], rows: buffer.Buffer, scratch: buffer.Buffer, escr: buffer.Buffer, kept: buffer.Buffer, delim: int, as_csv: bool, from: int, limit: int, budget: int, picked: int, max_join: int, matches: int, padded: bool, np: int) -> [heap, io_write] (buffer.Buffer, buffer.Buffer, buffer.Buffer, buffer.Buffer) {
    if st[s_produced()] >= max_join {
        a[engine.k_abort()] = 71;
        a[engine.k_stop()] = 1;
        a[engine.k_err_row()] = st[s_probe()];
        a[engine.k_err_line()] = number;
        a[engine.k_err_digits()] = matches;
        a[engine.k_err_cond()] = st[s_max_matches()];
        return (rows, scratch, escr, kept);
    }
    st[s_produced()] = st[s_produced()] + 1;
    a[engine.k_records()] = st[s_produced()];
    if st[s_produced()] <= from {
        return (rows, scratch, escr, kept);
    }
    let (r2, s2, e2, k2) = engine.process_rows(heap, io, rows, scratch, escr, kept, tree, cols, record, cells, sel, picked, delim, as_csv, budget, number, limit, a);
    if a[engine.k_abort()] != 0 {
        a[engine.k_err_row()] = st[s_probe()];
        if padded && a[engine.k_err_fn()] == 0 - 1 && a[engine.k_err_col()] >= np {
            a[engine.k_err_fn()] = 77;
        }
    }
    return (r2, s2, e2, k2);
}

// One probe record whose cells are in `cells` (its first `np`): look its key up, and give the engine what the join type says: one joined record for each build row of the key (inner, left), the
// padded record when there is none (left), the probe record once when there is a build row (semi) or none (anti). The state is in `a` (the engine's tally), `st` (this module's), and the buffers it answers.
fn probe_one[&h, &i, &t, &q, &c, &s, &w, &x, &d, &a, &z, &k, &m](heap: &!h Heap, io: &!i Io, jt: &t jtab.JTab, tree: &q query.Query, cols: &c [int], sel: &s [int], cells: &!w [int], bcells: &!x [int], prec: &d [byte], number: int, st: &!z [int], a: &!a [int], keys: &k [int], kmap: &m [int], rows: buffer.Buffer, scratch: buffer.Buffer, escr: buffer.Buffer, kept: buffer.Buffer, jrec: buffer.Buffer, kscr: buffer.Buffer, kbuf: buffer.Buffer, np: int, nb: int, delim: int, as_csv: bool, from: int, limit: int, budget: int, picked: int, max_join: int) -> [heap, io_write] (buffer.Buffer, buffer.Buffer, buffer.Buffer, buffer.Buffer, buffer.Buffer, buffer.Buffer, buffer.Buffer) {
    var rows2 = rows;
    var scratch2 = scratch;
    var escr2 = escr;
    var kept2 = kept;
    var jrec2 = jrec;
    var kscr2 = kscr;
    var kbuf2 = kbuf;
    let jtype = st[s_jtype()];
    let nk = st[s_nk()];
    var chain = 0 - 1;
    var present = false;
    if st[s_simple()] == 1 {
        let pkey = keys[0];
        let first = cells[3 * pkey];
        let last = cells[3 * pkey + 1];
        if cells[3 * pkey + 2] == 0 {
            if jtype <= 1 {
                chain = jtab.first(jt, prec[first..last]);
            } else {
                present = jtab.has(jt, prec[first..last]);
            }
        } else {
            borrow mut kscr2 as &!kw in {
                buffer.clear(kw);
            }
            kscr2 = query.unquote(heap, kscr2, prec[first..last]);
            borrow kscr2 as &kr in {
                if jtype <= 1 {
                    chain = jtab.first(jt, buffer.bytes(kr));
                } else {
                    present = jtab.has(jt, buffer.bytes(kr));
                }
            }
        }
    } else {
        let (kb, sc, status, which) = jnkey.make(heap, kbuf2, kscr2, prec, cells, keys, st[s_pairs()], 0);
        kbuf2 = kb;
        kscr2 = sc;
        if status != 0 {
            let row = st[s_probe()];
            kept2 = note_typed(heap, kept2, prec, cells, keys, 16 + 16 * which + status, 0, row, number, a);
            a[engine.k_stop()] = 1;
            return (rows2, scratch2, escr2, kept2, jrec2, kscr2, kbuf2);
        }
        borrow kbuf2 as &kr in {
            if jtype <= 1 {
                chain = jtab.first(jt, buffer.bytes(kr));
            } else {
                present = jtab.has(jt, buffer.bytes(kr));
            }
        }
    }
    if jtype >= 2 {
        // semi: the probe record once if there is a build row; anti: once if there is none
        if jtype == 2 && present || jtype == 3 && !present {
            let (r2, s2, e2, k2) = emit_one(heap, io, tree, cols, sel, cells, prec, number, st, a, rows2, scratch2, escr2, kept2, delim, as_csv, from, limit, budget, picked, max_join, 3 - jtype, false, np);
            rows2 = r2;
            scratch2 = s2;
            escr2 = e2;
            kept2 = k2;
        }
        return (rows2, scratch2, escr2, kept2, jrec2, kscr2, kbuf2);
    }
    if chain < 0 {
        if jtype == 0 {
            return (rows2, scratch2, escr2, kept2, jrec2, kscr2, kbuf2);
        }
        // left: the probe row once, every build cell empty (the padded record is the probe record and a delimiter for each build cell shown)
        borrow mut jrec2 as &!jw in {
            buffer.clear(jw);
        }
        jrec2 = buffer.append(heap, jrec2, prec);
        var k = 0;
        while k < nk {
            jrec2 = buffer.push(heap, jrec2, byte_of(delim));
            cells[3 * (np + k)] = len(prec) + 1 + k;
            cells[3 * (np + k) + 1] = len(prec) + 1 + k;
            cells[3 * (np + k) + 2] = 0;
            k = k + 1;
        }
        borrow jrec2 as &jr in {
            let (r2, s2, e2, k2) = emit_one(heap, io, tree, cols, sel, cells, buffer.bytes(jr), number, st, a, rows2, scratch2, escr2, kept2, delim, as_csv, from, limit, budget, picked, max_join, 0, true, np);
            rows2 = r2;
            scratch2 = s2;
            escr2 = e2;
            kept2 = k2;
        }
        return (rows2, scratch2, escr2, kept2, jrec2, kscr2, kbuf2);
    }
    var matches = 0;
    var x = chain;
    while x >= 0 {
        matches = matches + 1;
        x = jtab.next_row(jt, x);
    }
    if matches > st[s_max_matches()] {
        st[s_max_matches()] = matches;
    }
    borrow mut jrec2 as &!jw in {
        buffer.clear(jw);
    }
    jrec2 = buffer.append(heap, jrec2, prec);
    jrec2 = buffer.push(heap, jrec2, byte_of(delim));
    let keep = len(prec) + 1;
    x = chain;
    while x >= 0 {
        if st[s_produced()] >= max_join {
            a[engine.k_abort()] = 71;
            a[engine.k_stop()] = 1;
            a[engine.k_err_row()] = st[s_probe()];
            a[engine.k_err_line()] = number;
            a[engine.k_err_digits()] = matches;
            a[engine.k_err_cond()] = st[s_max_matches()];
            return (rows2, scratch2, escr2, kept2, jrec2, kscr2, kbuf2);
        }
        st[s_produced()] = st[s_produced()] + 1;
        let brec = jtab.record(jt, x);
        borrow mut jrec2 as &!jw in {
            jw.used = keep;
        }
        jrec2 = buffer.append(heap, jrec2, brec);
        let (m, open, bad) = reader.fields(brec, delim, bcells, nb);
        var k = 0;
        if nk == nb {
            while k < nb {
                cells[3 * (np + k)] = bcells[3 * k] + keep;
                cells[3 * (np + k) + 1] = bcells[3 * k + 1] + keep;
                cells[3 * (np + k) + 2] = bcells[3 * k + 2];
                k = k + 1;
            }
        } else {
            // a shared-name key leaves its build column out of the cells (it stays in the record)
            while k < nk {
                let col = kmap[k];
                cells[3 * (np + k)] = bcells[3 * col] + keep;
                cells[3 * (np + k) + 1] = bcells[3 * col + 1] + keep;
                cells[3 * (np + k) + 2] = bcells[3 * col + 2];
                k = k + 1;
            }
        }
        a[engine.k_records()] = st[s_produced()];
        if st[s_produced()] > from {
            borrow jrec2 as &jr in {
                let (r2, s2, e2, k2) = engine.process_rows(heap, io, rows2, scratch2, escr2, kept2, tree, cols, buffer.bytes(jr), cells, sel, picked, delim, as_csv, budget, number, limit, a);
                rows2 = r2;
                scratch2 = s2;
                escr2 = e2;
                kept2 = k2;
            }
            if a[engine.k_abort()] != 0 {
                a[engine.k_err_row()] = st[s_probe()];
            }
        }
        if a[engine.k_stop()] == 1 {
            return (rows2, scratch2, escr2, kept2, jrec2, kscr2, kbuf2);
        }
        x = jtab.next_row(jt, x);
    }
    return (rows2, scratch2, escr2, kept2, jrec2, kscr2, kbuf2);
}

// The probe phase. Answers the reader, what was counted, and the buffers: the csv or json rows pending, the scratch of the writers, the escape scratch and the first bytes of a refused cell.
fn probe_pass[&h, &f, &i, &t, &q, &c, &s, &w, &x, &k, &m](heap: &!h Heap, r0: lines.Lines, file: &!f File, io: &!i Io, stdin: bool, jt: &t jtab.JTab, tree: &q query.Query, cols: &c [int], sel: &s [int], cells: &!w [int], bcells: &!x [int], keys: &k [int], kmap: &m [int], pairs: int, simple: bool, jtype: int, nk: int, rows0: buffer.Buffer, scratch0: buffer.Buffer, np: int, nb: int, delim: int, as_csv: bool, from: int, limit: int, budget: int, picked: int, cap: int, most: int, max_join: int) -> [heap, file_read, io_read, io_write] (lines.Lines, finish.Counts, buffer.Buffer, buffer.Buffer, buffer.Buffer) {
    var r = r0;
    var rows = rows0;
    var scratch = scratch0;
    var escr = buffer.empty(heap, 16);
    var kept = buffer.empty(heap, 64);
    var jrec = buffer.empty(heap, 256);
    var kscr = buffer.empty(heap, 64);
    var kbuf = buffer.empty(heap, 64);
    var rec = buffer.empty(heap, 256);
    var tally = box_slice(heap, engine.k_size(), 0);
    var state = box_slice(heap, s_size(), 0);
    var quoted = false;
    var seps = 0;
    var opened = 0;
    var going = true;
    var c = nothing();
    borrow mut tally as &!tw in {
        let a = contents(tw);
        a[engine.k_columns()] = np + nk;
        borrow mut state as &!sw in {
            let st = contents(sw);
            st[s_jtype()] = jtype;
            st[s_nk()] = nk;
            st[s_pairs()] = pairs;
            if simple {
                st[s_simple()] = 1;
            }
            while going {
                var status = 9;
                borrow mut r as &!rw in {
                    status = scan.next_fast(rw);
                }
                if status == 9 {
                    let (stepped, answer) = lines.next(heap, r);
                    r = stepped;
                    status = answer;
                }
                if status == lines.need() {
                    if stdin {
                        var length = 0;
                        borrow r as &lr in {
                            length = lines.length(lr);
                        }
                        if length > finish.line_ceiling() {
                            r = lines.fill_file(r, file);
                        } else {
                            r = bulk.fill_stdin(r, io);
                        }
                    } else {
                        r = lines.fill_file(r, file);
                    }
                } else if status == lines.done() {
                    going = false;
                } else if status == lines.long() {
                    a[engine.k_abort()] = 4;
                    borrow r as &rr in {
                        a[engine.k_abort_line()] = lines.number(rr);
                        a[engine.k_long()] = lines.length(rr);
                    }
                    going = false;
                } else {
                    borrow r as &rr in {
                        let number = lines.number(rr);
                        var line = lines.text(rr);
                        let whole = line;
                        if len(line) > 0 && int_of(line[len(line) - 1]) == 13 {
                            line = line[0..len(line) - 1];
                        }
                        if !quoted && len(line) == 0 {
                            // A blank line between records is not a record.
                        } else if !quoted && st[s_probe()] >= most {
                            a[engine.k_capped()] = 1;
                            going = false;
                        } else if !quoted {
                            let (n, open, wrong) = reader.fields(line, delim, cells, np);
                            if wrong {
                                a[engine.k_abort()] = 1;
                                a[engine.k_abort_line()] = number;
                                going = false;
                            } else if open {
                                quoted = true;
                                opened = number;
                                borrow mut rec as &!rw2 in {
                                    buffer.clear(rw2);
                                }
                                rec = buffer.append(heap, rec, whole);
                                rec = buffer.push(heap, rec, byte_of(10));
                            } else {
                                st[s_probe()] = st[s_probe()] + 1;
                                if n != np {
                                    if a[engine.k_ragged()] == 0 {
                                        a[engine.k_first_row()] = st[s_probe()];
                                        a[engine.k_first_line()] = number;
                                        a[engine.k_first_found()] = n;
                                    }
                                    a[engine.k_ragged()] = a[engine.k_ragged()] + 1;
                                } else {
                                    let (r2, s2, e2, k2, j2, q2, b2) = probe_one(heap, io, jt, tree, cols, sel, cells, bcells, line, number, st, a, keys, kmap, rows, scratch, escr, kept, jrec, kscr, kbuf, np, nb, delim, as_csv, from, limit, budget, picked, max_join);
                                    rows = r2;
                                    scratch = s2;
                                    escr = e2;
                                    kept = k2;
                                    jrec = j2;
                                    kscr = q2;
                                    kbuf = b2;
                                }
                            }
                        } else {
                            let (inside, n, bad) = reader.scan(line, delim, quoted, seps);
                            seps = n;
                            rec = buffer.append(heap, rec, whole);
                            var held = 0;
                            borrow rec as &rw2 in {
                                held = buffer.size(rw2);
                            }
                            if bad {
                                a[engine.k_abort()] = 1;
                                a[engine.k_abort_line()] = number;
                                going = false;
                            } else if inside {
                                rec = buffer.push(heap, rec, byte_of(10));
                                if held + 1 > cap {
                                    a[engine.k_abort()] = 7;
                                    a[engine.k_abort_line()] = opened;
                                    going = false;
                                }
                            } else {
                                quoted = false;
                                seps = 0;
                                borrow rec as &rw2 in {
                                    var record = buffer.bytes(rw2);
                                    if len(record) > 0 && int_of(record[len(record) - 1]) == 13 {
                                        record = record[0..len(record) - 1];
                                    }
                                    let (m, open2, bad2) = reader.fields(record, delim, cells, np);
                                    if bad2 || open2 {
                                        a[engine.k_abort()] = 1;
                                        a[engine.k_abort_line()] = opened;
                                        going = false;
                                    } else {
                                        st[s_probe()] = st[s_probe()] + 1;
                                        if m != np {
                                            if a[engine.k_ragged()] == 0 {
                                                a[engine.k_first_row()] = st[s_probe()];
                                                a[engine.k_first_line()] = opened;
                                                a[engine.k_first_found()] = m;
                                            }
                                            a[engine.k_ragged()] = a[engine.k_ragged()] + 1;
                                        } else {
                                            let (r2, s2, e2, k2, j2, q2, b2) = probe_one(heap, io, jt, tree, cols, sel, cells, bcells, record, opened, st, a, keys, kmap, rows, scratch, escr, kept, jrec, kscr, kbuf, np, nb, delim, as_csv, from, limit, budget, picked, max_join);
                                            rows = r2;
                                            scratch = s2;
                                            escr = e2;
                                            kept = k2;
                                            jrec = j2;
                                            kscr = q2;
                                            kbuf = b2;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if a[engine.k_stop()] == 1 {
                        going = false;
                    }
                }
            }
            if quoted && a[engine.k_abort()] == 0 {
                a[engine.k_abort()] = 2;
                a[engine.k_abort_line()] = opened;
            }
            if a[engine.k_abort()] == 71 {
                // the facts of the refusal ride in the tally's error fields: the probe row, its line, its matches and the most any probe row had
                a[engine.k_groups()] = st[s_produced()];
            }
        }
        var width = np + nk;
        if a[engine.k_ragged()] > 0 {
            width = np;
        }
        c = counted(a, width);
    }
    unbox_slice(heap, tally);
    unbox_slice(heap, state);
    buffer.drop(heap, jrec);
    buffer.drop(heap, kscr);
    buffer.drop(heap, kbuf);
    buffer.drop(heap, rec);
    buffer.drop(heap, escr);
    return (r, c, rows, scratch, kept);
}

// 0 inner, 1 left, 2 semi, 3 anti: `--join-type`.
fn jtype_of[&g, &p](args: &g Args, parsed: &p cli.Parsed) -> [args] int {
    let table = spec.flag_table();
    let word = cli.text(args, parsed, table, "join-type");
    if bytes.equal(word, "left") {
        return 1;
    }
    if bytes.equal(word, "semi") {
        return 2;
    }
    if bytes.equal(word, "anti") {
        return 3;
    }
    return 0;
}

// The refusal of a typed key cell (abort 72) of the file whose header is `names`: the facts are in the tally `c` and the cell in `value`.
fn typed_refusal[&h, &k, &v, &s, &n, &d](heap: &!h Heap, e: fail.Errors, keys: &k [int], c: finish.Counts, value: &v buffer.Buffer, shown: &s [byte], input: &static [byte], names: &n buffer.Buffer, ends: &d vec.Vec[int]) -> [heap] fail.Errors {
    var from = 0;
    if c.err_col > 0 {
        from = vec.get(ends, c.err_col - 1);
    }
    let name = buffer.bytes(names)[from..vec.get(ends, c.err_col)];
    return jnfail.typed_key(heap, e, c.err_fn, input, shown, name, c.err_row, c.err_line, buffer.bytes(value), c.err_cond + 1, keys[3 * c.err_cond + 2] - 2, c.err_digits);
}

// Everything once both files are open: `bfile` is the build, `pfile` the probe (or the empty file that stands in for standard input). Answers as `read_file` does.
fn run[&h, &g, &p, &f, &b, &s, &t, &i, &q](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, bfile: &!b File, pfile: &!f File, stdin: bool, shown: &s [byte], shown_b: &t [byte], io: &!i Io, delim: int, mode: int, as_csv: bool, from: int, limit: int, budget: int, tree: &q query.Query, names_at: int, errs: fail.Errors) -> [heap, args, file_read, io_read, io_write] (finish.Counts, buffer.Buffer, buffer.Buffer, buffer.Buffer, vec.Vec[int], fail.Errors) {
    let table = spec.flag_table();
    let cap = cli.nat(args, parsed, table, "max-line-bytes");
    let most = cli.nat(args, parsed, table, "max-rows");
    let max_state = cli.nat(args, parsed, table, "max-state-bytes");
    let max_join = cli.nat(args, parsed, table, "max-join-rows");
    var sort = "";
    if cli.has(parsed, table, "sort") {
        sort = cli.text(args, parsed, table, "sort");
    }
    var e = errs;
    var rb = lines.start(heap, cap);
    let (rb1, hb) = jnhead.head_of(heap, rb, bfile, io, false, cap, delim);
    rb = rb1;
    var rp = lines.start(heap, cap);
    var hp = jnhead.no_head(heap);
    var refused = false;
    borrow hb as &hbr in {
        let (e2, bad) = jnhead.head_refusal(heap, args, parsed, tree, hbr, shown_b, budget, e);
        e = e2;
        refused = bad;
    }
    if !refused {
        let (rp1, hp1) = jnhead.head_of(heap, rp, pfile, io, stdin, cap, delim);
        rp = rp1;
        jnhead.drop_head(heap, hp);
        hp = hp1;
        borrow hp as &hpr in {
            let (e2, bad) = jnhead.head_refusal(heap, args, parsed, tree, hpr, shown, budget, e);
            e = e2;
            refused = bad;
        }
    }
    var jnames = buffer.empty(heap, 1);
    var jends = vec.empty(heap, 1, 0);
    var keys = box_slice(heap, 3, 0);
    var kmap = box_slice(heap, 1, 0);
    var pairs = 0;
    var np = 0;
    var nb = 0;
    var nk = 0;
    let jtype = jtype_of(args, parsed);
    if !refused {
        borrow hp as &hpr in {
            borrow hb as &hbr in {
                let (u, e2) = jnhead.unite(heap, args, parsed, e, hpr.names, hpr.ends, hbr.names, hbr.ends, true, shown, shown_b, jtype);
                e = e2;
                borrow u as &ur in {
                    pairs = ur.pairs;
                    np = ur.np;
                    nb = ur.nb;
                    nk = ur.nk;
                    refused = !ur.ok;
                }
                let (names, ends, k3, m3) = jnhead.take_header(u);
                buffer.drop(heap, jnames);
                vec.drop(heap, jends);
                unbox_slice(heap, keys);
                unbox_slice(heap, kmap);
                jnames = names;
                jends = ends;
                keys = k3;
                kmap = m3;
            }
        }
    }
    var simple = false;
    borrow keys as &kr0 in {
        simple = pairs == 1 && contents(kr0)[2] == 0;
    }
    let ncols = np + nk;
    // the plan against the joined header, as `read_file` resolves it against a file's
    var cols = box_slice(heap, 1, 0);
    var sel = box_slice(heap, 1, 0);
    var cellbox = box_slice(heap, 1, 0);
    var head = buffer.append(heap, buffer.empty(heap, 4), "[]");
    var labels = buffer.empty(heap, 1);
    var lends = vec.empty(heap, 1, 0);
    var lead = buffer.empty(heap, 1);
    var picked = 0;
    var jt = jtab.empty(heap);
    var out_rows = buffer.empty(heap, 1);
    var spare = buffer.empty(heap, 1);
    var kept = buffer.empty(heap, 1);
    var c = nothing();
    var errno = 0;
    var go = !refused;
    if go {
        var made = frame.none(heap);
        frame.drop(heap, made);
        borrow jnames as &nr in {
            borrow jends as &er in {
                made = frame.prepare(heap, tree, nr, er, ncols, mode, delim, sort);
            }
        }
        let frame.Frame { fcols, fsel, fcells, fhead, flead, flabels, flends, fpicked, fabort, fbad, fsort_field, fsort_slot, fdesc } = made;
        unbox_slice(heap, cols);
        unbox_slice(heap, sel);
        unbox_slice(heap, cellbox);
        buffer.drop(heap, head);
        buffer.drop(heap, labels);
        vec.drop(heap, lends);
        buffer.drop(heap, lead);
        cols = fcols;
        sel = fsel;
        cellbox = fcells;
        head = fhead;
        labels = flabels;
        lends = flends;
        lead = flead;
        picked = fpicked;
        if fabort != 0 {
            c = finish.Counts { columns: ncols, records: 0, ragged: 0, first_row: 0, first_line: 0, first_found: 0, capped: false, abort: fabort, abort_line: 0, long_length: 0, emitted: 0, more: false, next: 0, bad_name: fbad, err_col: 0, err_fn: 0, err_row: 0, err_line: 0, err_cond: 0, err_digits: 0, groups: 0 };
            go = false;
        }
    }
    var bcounts = nothing();
    var consumed = 0;
    if go {
        // the build phase
        var bkept = buffer.empty(heap, 1);
        borrow keys as &kr1 in {
            let (rb2, jt2, bc, consumed2, bk2) = build_pass(heap, rb, bfile, jt, nb, contents(kr1), pairs, simple, jtype >= 2, delim, cap, most, max_state);
            rb = rb2;
            jt = jt2;
            buffer.drop(heap, bkept);
            bkept = bk2;
            bcounts = bc;
            consumed = consumed2;
        }
        let bc = bcounts;
        var berrno = 0;
        borrow rb as &rbr in {
            berrno = lines.failed(rbr);
        }
        if bc.abort == 70 {
            var held = 0;
            var rows_held = 0;
            borrow jt as &tr in {
                held = jtab.held_of(tr);
                rows_held = jtab.rows_of(tr);
            }
            var size = 0;
            match file_size(bfile) {
                Done::Ok(n) => {
                    size = n;
                }
                Done::Failed(reason) => {
                    size = 0 - 1;
                }
            }
            e = jnfail.build_too_large(heap, e, shown_b, max_state, held, rows_held, bc.records, bc.abort_line, consumed, size);
            go = false;
        } else if bc.abort == 72 {
            borrow keys as &kr2 in {
                borrow hb as &hbr in {
                    borrow bkept as &bkr in {
                        e = typed_refusal(heap, e, contents(kr2), bc, bkr, shown_b, "build", hbr.names, hbr.ends);
                    }
                }
            }
            go = false;
        } else if bc.abort != 0 || bc.ragged > 0 || bc.capped || berrno != 0 {
            borrow jnames as &nr in {
                borrow jends as &er in {
                    borrow labels as &lr in {
                        borrow lends as &le in {
                            borrow kept as &kr in {
                                e = finish.explain(heap, args, parsed, tree, nr, er, lr, le, kr, bc, shown_b, 0 - 1, berrno, true, budget, e);
                            }
                        }
                    }
                }
            }
            go = false;
        }
        buffer.drop(heap, bkept);
    }
    var probed = false;
    if go {
        probed = true;
        if as_csv {
            out_rows = finish.start_output(heap, out_rows, lead);
            lead = buffer.empty(heap, 1);
        }
        var bcellbox = box_slice(heap, 3 * (nb + 1), 0);
        borrow jt as &tr in {
            borrow cols as &kr in {
                borrow sel as &sr in {
                    borrow keys as &ky in {
                        borrow kmap as &km in {
                            borrow mut cellbox as &!cw in {
                                borrow mut bcellbox as &!bw in {
                                    let (rp2, pc, rows2, scratch2, kept2) = probe_pass(heap, rp, pfile, io, stdin, tr, tree, contents(kr), contents(sr), contents(cw), contents(bw), contents(ky), contents(km), pairs, simple, jtype, nk, out_rows, spare, np, nb, delim, as_csv, from, limit, budget, picked, cap, most, max_join);
                                    rp = rp2;
                                    c = pc;
                                    out_rows = rows2;
                                    spare = scratch2;
                                    buffer.drop(heap, kept);
                                    kept = kept2;
                                }
                            }
                        }
                    }
                }
            }
        }
        unbox_slice(heap, bcellbox);
        borrow rp as &rpr in {
            errno = lines.failed(rpr);
        }
    }
    lines.drop(heap, rb);
    lines.drop(heap, rp);
    jtab.drop(heap, jt);
    // what csv still had pending, written now unless the stream already failed
    if probed && as_csv && c.abort != 9 {
        let (after, ok) = engine.flush_last(io, out_rows);
        out_rows = after;
        if !ok {
            c = finish.Counts { columns: c.columns, records: c.records, ragged: c.ragged, first_row: c.first_row, first_line: c.first_line, first_found: c.first_found, capped: c.capped, abort: 9, abort_line: 0, long_length: 0, emitted: c.emitted, more: c.more, next: c.next, bad_name: c.bad_name, err_col: 0, err_fn: 0, err_row: 0, err_line: 0, err_cond: 0, err_digits: 0, groups: c.groups };
        }
    }
    // the refusal of the probe (or of the plan, at the header), if there is one
    var clean = true;
    borrow e as &er0 in {
        clean = fail.count(er0) == 0;
    }
    if clean && !refused {
        if c.abort == 71 {
            e = jnfail.too_many_rows(heap, e, shown, max_join, c.err_row, c.err_line, c.err_digits, c.err_cond);
        } else if c.abort == 72 {
            borrow keys as &kr3 in {
                borrow hp as &hpr in {
                    borrow kept as &vr in {
                        e = typed_refusal(heap, e, contents(kr3), c, vr, shown, "probe", hpr.names, hpr.ends);
                    }
                }
            }
        } else {
            borrow jnames as &nr in {
                borrow jends as &er in {
                    borrow labels as &lr in {
                        borrow lends as &le in {
                            borrow kept as &kr in {
                                e = finish.explain(heap, args, parsed, tree, nr, er, lr, le, kr, c, shown, names_at, errno, as_csv, budget, e);
                            }
                        }
                    }
                }
            }
        }
    }
    unbox_slice(heap, cols);
    unbox_slice(heap, sel);
    unbox_slice(heap, cellbox);
    unbox_slice(heap, keys);
    unbox_slice(heap, kmap);
    buffer.drop(heap, lead);
    buffer.drop(heap, labels);
    vec.drop(heap, lends);
    buffer.drop(heap, spare);
    buffer.drop(heap, kept);
    jnhead.drop_head(heap, hb);
    jnhead.drop_head(heap, hp);
    return (c, head, out_rows, jnames, jends, e);
}

// The read of a join: the `--join` file is found beneath the root as a query's `from 'path'` is (`qpath.resolve`: the rules of an operand), opened the same way, and both files go to `run`.
// `file` is the probe (an empty file stands in for standard input). A path or an open that fails is the refusal of an operand, naming the path given to `--join`.
pub fn read[&h, &g, &p, &f, &s, &i, &q, &fs, &rt](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, file: &!f File, stdin: bool, shown: &s [byte], io: &!i Io, fs: &fs Fs(""), root: &rt [byte], delim: int, mode: int, as_csv: bool, from: int, limit: int, budget: int, tree: &q query.Query, names_at: int, errs: fail.Errors) -> [heap, args, file_read, io_read, io_write, fs_read(""), dir_read] (finish.Counts, buffer.Buffer, buffer.Buffer, buffer.Buffer, vec.Vec[int], fail.Errors) {
    let table = spec.flag_table();
    var e = errs;
    var c = nothing();
    var head = buffer.append(heap, buffer.empty(heap, 4), "[]");
    var rows = buffer.empty(heap, 1);
    var names = buffer.empty(heap, 1);
    var ends = vec.empty(heap, 1, 0);
    let (full, shown_at, checked) = qpath.resolve(heap, root, cli.text(args, parsed, table, "join"), e);
    e = checked;
    borrow full as &fr in {
        if shown_at >= 0 {
            let whole = buffer.bytes(fr);
            let build = whole[shown_at..len(whole)];
            match place.open_operand(fs, root, build, whole) {
                Opened::Failed(reason) => {
                    e = fail.io_error(heap, e, reason, false, build);
                }
                Opened::Ok(opened) => {
                    var bf = opened;
                    borrow mut bf as &!bh in {
                        let (c2, h2, r2, n2, d2, e2) = run(heap, args, parsed, bh, file, stdin, shown, build, io, delim, mode, as_csv, from, limit, budget, tree, names_at, e);
                        c = c2;
                        buffer.drop(heap, head);
                        head = h2;
                        buffer.drop(heap, rows);
                        rows = r2;
                        buffer.drop(heap, names);
                        names = n2;
                        vec.drop(heap, ends);
                        ends = d2;
                        e = e2;
                    }
                    file_close(bf);
                }
            }
        }
    }
    buffer.drop(heap, full);
    return (c, head, rows, names, ends, e);
}
