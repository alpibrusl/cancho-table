edition 5;

module expr;

// `--where`: conditions, and what each says of a row. This module reads a condition (`parse_cond`) and decides one against a cell (`holds`); `orparse` reads the whole expression,
//
//     EXPR  := ALL | ANY | UNIT          ALL := UNIT "and" UNIT { "and" UNIT }          ANY := UNIT "or" UNIT { "or" UNIT }          UNIT := COND | "(" EXPR ")" | "not" "(" EXPR ")"
//     COND  := COLUMN OP VALUE | COLUMN OP "(" COLUMN ")" | COLUMN "contains" VALUE | COLUMN "not" "contains" VALUE
//            | COLUMN "in" "(" VALUE { "," VALUE } ")" | COLUMN "not" "in" "(" VALUE { "," VALUE } ")"
//     OP    := "=" | "!=" | "<" | "<=" | ">" | ">="
//     COLUMN:= WORD [":int" | ":float" | ":dec(" N ")" | ":date" | ":timestamp" | ":datetime"]     a name, or #N the Nth column; N is a scale, 0 to 18
//     VALUE := WORD
//     WORD  := bare | 'quoted'
//
// A bare word runs to whitespace or one of ' ( ) , = ! < >; a backslash makes
// the next byte part of it, whatever it is (`\#3` is the name "#3", not the
// third column). A quoted word is between single quotes with '' for a quote;
// a quoted word is always a name or a value, never a position, and never has
// the keyword meaning of and, or, not, in or contains. `and`, `or`, `not`, `in` and `contains` are
// lower case. Nothing else is in the language: no expressions, no functions.
//
// `COLUMN OP ( COLUMN )` compares two columns of the row (docs/column-comparison.md): a `(` where a value is expected was a refusal before, so no expression that was valid
// changes. Both columns are read as the same type, written alike; the condition is kind 3, its right column's name in the field a literal's place holds.
//
// A condition compares text, bytewise, unless the column is written `:int`, in
// which case the cell is an exact integer and the literals are too, or `:dec(S)`, in
// which case the cell is an exact decimal of at most S fractional digits (docs/numbers.md:
// never rounded, `1.5` and `1.50` are one value) and so are the literals. Evaluation
// is left to right and stops at the first condition that decides the level it is in (a false one
// in an `and`, a true one in an `or`), so a condition that would refuse a cell (an empty one is
// not an integer) is only reached by rows that the ones before it did not decide (docs/or-and-columns.md section 5).

import std.buffer;
import std.bytes;
import flt;
import cellnum;
import dtparse;
import query;

fn is_delimiter(c: int) -> [] bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 39 || c == '(' || c == ')' || c == ',' || c == '=' || c == '!' || c == '<' || c == '>';
}

pub fn skip_space[&s](src: &s [byte], from: int) -> [] int {
    var i = from;
    while i < len(src) && (int_of(src[i]) == 32 || int_of(src[i]) == 9 || int_of(src[i]) == 10 || int_of(src[i]) == 13) {
        i = i + 1;
    }
    return i;
}

// The word at `from`, appended to `out`. Answers (out, where it ends, quoted,
// status, whether its first byte was escaped, how many bytes up to and
// including the last escaped one). Status: 0 a word, 1 none here, 9 a quote
// never closed, 10 a backslash at the end.
pub fn read_word[&h, &s](heap: &!h Heap, out: buffer.Buffer, src: &s [byte], from: int) -> [heap] (buffer.Buffer, int, int, int, int, int) {
    var o = out;
    var j = from;
    var made = 0;
    var first_escaped = 0;
    var last_escaped = 0;
    if from < len(src) && int_of(src[from]) == 39 {
        j = from + 1;
        var closed = false;
        while !closed {
            let found = index_of_byte(src[j..len(src)], byte_of(39));
            if found < 0 {
                return (o, len(src), 1, 9, 0, 0);
            }
            o = buffer.append(heap, o, src[j..j + found]);
            if j + found + 1 < len(src) && int_of(src[j + found + 1]) == 39 {
                o = buffer.push(heap, o, byte_of(39));
                j = j + found + 2;
            } else {
                j = j + found + 1;
                closed = true;
            }
        }
        return (o, j, 1, 0, 0, 0);
    }
    while j < len(src) && !is_delimiter(int_of(src[j])) {
        if int_of(src[j]) == '\\' {
            if j + 1 >= len(src) {
                return (o, j, 0, 10, 0, 0);
            }
            if made == 0 {
                first_escaped = 1;
            }
            o = buffer.push(heap, o, src[j + 1]);
            made = made + 1;
            last_escaped = made;
            j = j + 2;
        } else {
            o = buffer.push(heap, o, src[j]);
            made = made + 1;
            j = j + 1;
        }
    }
    if made == 0 {
        return (o, j, 0, 1, 0, 0);
    }
    return (o, j, 0, 0, first_escaped, last_escaped);
}

// What was expected where the expression went wrong, by code.
pub fn expected(what: int) -> [] &static [byte] {
    if what == 1 {
        return "a column: a name, 'a quoted name' or #N";
    }
    if what == 2 {
        return "an operator: = != < <= > >= contains in";
    }
    if what == 3 {
        return "a value";
    }
    if what == 4 {
        return "and, or the end of the expression";
    }
    if what == 5 {
        return "an integer, because the column is :int";
    }
    if what == 6 {
        return "= != < <= > >= or in: contains compares text, and this column is :int, :dec or :float";
    }
    if what == 7 {
        return "( after in";
    }
    if what == 8 {
        return ", or ) in a list of values";
    }
    if what == 9 {
        return "a closing quote";
    }
    if what == 10 {
        return "a byte after the backslash";
    }
    if what == 11 {
        return "fewer conditions or values: the ceiling is 64 conditions and 1024 values";
    }
    if what == 12 {
        return "an integer that fits 64 bits, because the column is :int";
    }
    if what == 13 {
        return "a decimal number: digits and at most one point, no exponent, no spaces, because the column is :dec";
    }
    if what == 14 {
        return "a decimal with no more fractional digits than the column's scale (write :dec(N) with a larger N to compare finer values)";
    }
    if what == 15 {
        return "a decimal below 10^18 once scaled to the column's scale (a smaller scale, or fewer digits)";
    }
    if what == 16 {
        return "a scale in parentheses after :dec, as :dec(2)";
    }
    if what == 17 {
        return "a scale from 0 to 18";
    }
    if what == 18 {
        return "a number: digits, a point, an exponent (the nearest double), because the column is :float";
    }
    if what == 19 {
        return "a finite number: inf and nan are not numbers here";
    }
    if what == 20 {
        return "a number within the range of a double (between 5e-324 and 1.7976931348623157e308 in size), of at most 1,100 bytes";
    }
    if what == 21 {
        return "fewer nested parentheses: the ceiling is 8";
    }
    if what == 22 {
        return "and, or, or the ) that closes the group";
    }
    if what == 23 {
        return "( after not";
    }
    if what == 24 {
        return "in or contains after not";
    }
    if what == 25 {
        return "a date: YYYY-MM-DD";
    }
    if what == 26 {
        return "a timestamp with an offset: 2026-01-02T00:00:00Z";
    }
    if what == 27 {
        return "a date and a time without an offset: 2026-01-02 12:00:00";
    }
    if what == 28 {
        return "= != < <= > >= or in: contains compares text, and this column is :date, :timestamp or :datetime";
    }
    if what == 29 {
        return "the same type on both columns of a comparison, written alike: (name:int) against name:int";
    }
    if what == 32 {
        return "a value: --join-where compares a column with a value; a comparison of two columns goes in --where, after the join";
    }
    if what == 31 {
        return ") after the column compared with";
    }
    return "a complete expression";
}

// The scale of a `:dec(N)` suffix: `p` is where the `(` must be. Answers the type (2 + N), where the suffix ends, and what / where
// when it is not whole (16 a scale in parentheses was expected, 17 the scale is not 0 to 18).
fn dec_suffix[&s](src: &s [byte], p: int) -> [] (int, int, int, int) {
    if p >= len(src) || int_of(src[p]) != '(' {
        return (0, p, 16, p);
    }
    var i = p + 1;
    var value = 0;
    var digits = 0;
    while i < len(src) && int_of(src[i]) >= '0' && int_of(src[i]) <= '9' && digits < 3 {
        value = value * 10 + int_of(src[i]) - '0';
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 {
        return (0, p, 16, p + 1);
    }
    if digits > 2 || value > 18 {
        return (0, p, 17, p + 1);
    }
    if i >= len(src) || int_of(src[i]) != ')' {
        return (0, p, 16, i);
    }
    return (2 + value, i + 1, 0, 0);
}

// A column at `from`: added to the plan as a name or a position. Answers the plan, where it ends, the name's index, its type (0 text,
// 1 :int, 2 + S for :dec(S)), and what / where when it is not a column.
fn parse_column[&h, &s](heap: &!h Heap, q: query.Query, src: &s [byte], from: int) -> [heap] (query.Query, int, int, int, int, int) {
    var plan = q;
    let (word, after, quoted, status, escaped_first, escaped_last) = read_word(heap, buffer.empty(heap, 16), src, from);
    var next = after;
    var typed = 0;
    var index = 0;
    var what = 0;
    var at = from;
    if status == 1 && quoted == 0 {
        what = 1;
    } else if status != 0 {
        what = status;
    } else {
        var length = 0;
        var is_dec = false;
        borrow word as &wr in {
            length = buffer.size(wr);
        }
        if quoted == 1 {
            if after + 4 <= len(src) && bytes.equal(src[after..after + 4], ":int") && (after + 4 == len(src) || is_delimiter(int_of(src[after + 4]))) {
                typed = 1;
                next = after + 4;
            } else if after + 4 <= len(src) && bytes.equal(src[after..after + 4], ":dec") {
                is_dec = true;
                next = after + 4;
            } else if after + 6 <= len(src) && bytes.equal(src[after..after + 6], ":float") && (after + 6 == len(src) || is_delimiter(int_of(src[after + 6]))) {
                typed = 21;
                next = after + 6;
            } else {
                // :date, :timestamp, :datetime (docs/datetime.md)
                let (dl, dk) = dtparse.suffix_at(src, after);
                if dk != 0 && (after + dl == len(src) || is_delimiter(int_of(src[after + dl]))) {
                    typed = dk;
                    next = after + dl;
                }
            }
        } else if length >= 4 && escaped_last <= length - 4 {
            borrow word as &wr in {
                if bytes.equal(buffer.bytes(wr)[length - 4..length], ":int") {
                    typed = 1;
                    length = length - 4;
                } else if bytes.equal(buffer.bytes(wr)[length - 4..length], ":dec") {
                    is_dec = true;
                    length = length - 4;
                }
            }
            if length >= 6 && escaped_last <= length - 6 {
                borrow word as &wr in {
                    if bytes.equal(buffer.bytes(wr)[length - 6..length], ":float") {
                        typed = 21;
                        length = length - 6;
                    }
                }
            }
        }
        if quoted == 0 && typed == 0 && !is_dec {
            borrow word as &wr in {
                let (dl, dk) = dtparse.suffix_in(buffer.bytes(wr)[0..length], escaped_last);
                if dk != 0 {
                    typed = dk;
                    length = length - dl;
                }
            }
        }
        if is_dec {
            let (t, nx, w, a) = dec_suffix(src, next);
            typed = t;
            next = nx;
            what = w;
            at = a;
        }
        if what == 0 {
            borrow word as &wr in {
                var position = -1;
                if quoted == 0 && escaped_first == 0 {
                    position = query.position_of(buffer.bytes(wr)[0..length]);
                }
                let (p2, ix) = query.add_name(heap, plan, buffer.bytes(wr)[0..length], position);
                plan = p2;
                index = ix;
            }
        }
    }
    buffer.drop(heap, word);
    return (plan, next, index, typed, what, at);
}

// The operator at `from`: answers its kind (0 compare, 1 contains, 2 in), its code, where it ends, what / where on an error, and whether it was written `not in` or `not contains` (the
// condition is then the `in` or the `contains`, and its caller swaps the two exits: docs/or-and-columns.md section 17).
fn parse_operator[&h, &s](heap: &!h Heap, src: &s [byte], from: int, typed: int) -> [heap] (int, int, int, int, int, bool) {
    if from >= len(src) {
        return (0, 0, from, 2, from, false);
    }
    let c = int_of(src[from]);
    if c == '=' {
        return (0, 0, from + 1, 0, 0, false);
    }
    if c == '!' {
        if from + 1 < len(src) && int_of(src[from + 1]) == '=' {
            return (0, 1, from + 2, 0, 0, false);
        }
        return (0, 0, from, 2, from, false);
    }
    if c == '<' || c == '>' {
        var base = 2;
        if c == '>' {
            base = 4;
        }
        if from + 1 < len(src) && int_of(src[from + 1]) == '=' {
            return (0, base + 1, from + 2, 0, 0, false);
        }
        return (0, base, from + 1, 0, 0, false);
    }
    let (word, after, quoted, status, e1, e2) = read_word(heap, buffer.empty(heap, 16), src, from);
    var is_contains = false;
    var is_in = false;
    var is_not = false;
    borrow word as &wr in {
        is_contains = status == 0 && quoted == 0 && bytes.equal(buffer.bytes(wr), "contains");
        is_in = status == 0 && quoted == 0 && bytes.equal(buffer.bytes(wr), "in");
        is_not = status == 0 && quoted == 0 && bytes.equal(buffer.bytes(wr), "not");
    }
    buffer.drop(heap, word);
    if is_not {
        // `not in` and `not contains`: the word after `not` is the operator, and what is not one is refused where it stands
        let at = skip_space(src, after);
        let (w2, after2, quoted2, status2, f1, f2) = read_word(heap, buffer.empty(heap, 16), src, at);
        var not_contains = false;
        var not_in = false;
        borrow w2 as &wr in {
            not_contains = status2 == 0 && quoted2 == 0 && bytes.equal(buffer.bytes(wr), "contains");
            not_in = status2 == 0 && quoted2 == 0 && bytes.equal(buffer.bytes(wr), "in");
        }
        buffer.drop(heap, w2);
        if not_contains && typed != 0 {
            return (0, 0, at, 6, at, false);
        }
        if not_contains {
            return (1, 0, after2, 0, 0, true);
        }
        if not_in {
            return (2, 0, after2, 0, 0, true);
        }
        return (0, 0, at, 24, at, false);
    }
    if is_contains && typed != 0 {
        return (0, 0, from, 6, from, false);
    }
    if is_contains {
        return (1, 0, after, 0, 0, false);
    }
    if is_in {
        return (2, 0, after, 0, 0, false);
    }
    return (0, 0, from, 2, from, false);
}

// One literal at `from`, added to the plan. Answers the plan, where it ends,
// and what / where on an error.
fn parse_value[&h, &s](heap: &!h Heap, q: query.Query, src: &s [byte], from: int, typed: int) -> [heap] (query.Query, int, int, int) {
    var plan = q;
    let (word, after, quoted, status, e1, e2) = read_word(heap, buffer.empty(heap, 16), src, from);
    var what = 0;
    if status == 1 && quoted == 0 {
        what = 3;
    } else if status != 0 {
        what = status;
    } else {
        var value = 0;
        if typed == 1 {
            borrow word as &wr in {
                let (v, bad) = cellnum.parse_int(buffer.bytes(wr));
                value = v;
                if bad == 1 {
                    what = 5;
                } else if bad == 2 {
                    what = 12;
                }
            }
        } else if typed == 21 {
            borrow word as &wr in {
                let (key, bad) = flt.parse_float(buffer.bytes(wr));
                value = key;
                if bad == 9 {
                    what = 18;
                } else if bad == 10 {
                    what = 19;
                } else if bad != 0 {
                    what = 20;
                }
            }
        } else if typed >= 22 {
            // a date, a timestamp or a datetime is read by the reader of the cells (25, 26, 27: which of them it was meant to be)
            borrow word as &wr in {
                let (v, bad) = dtparse.parse(buffer.bytes(wr), typed);
                value = v;
                if bad != 0 {
                    what = 3 + typed;
                }
            }
        } else if typed >= 2 {
            borrow word as &wr in {
                let (v, bad) = cellnum.parse_dec(buffer.bytes(wr), typed - 2);
                value = v;
                if bad == 1 {
                    what = 13;
                } else if bad == 3 {
                    what = 14;
                } else if bad == 2 {
                    what = 15;
                }
            }
        }
        if what == 0 {
            borrow word as &wr in {
                plan = query.add_lit(heap, plan, buffer.bytes(wr), value);
            }
        }
    }
    buffer.drop(heap, word);
    return (plan, after, what, from);
}

// One condition at `from`, added to the plan: a column, an operator, and a value or a list of values. Answers the plan, where the condition ends (just after its last byte), and what /
// where when it is not whole (`expected`), and whether the condition was written `not in` or `not contains`. It is the one reader of a condition: `parse` reads a conjunction of them and
// `orparse.parse` the whole grammar.
pub fn parse_cond[&h, &s](heap: &!h Heap, q: query.Query, src: &s [byte], from: int) -> [heap] (query.Query, int, int, int, bool) {
    var plan = q;
    var i = from;
    var what = 0;
    var at = 0;
    var negative = false;
    let begins = from;
    let (p1, after_column, index, typed, w1, a1) = parse_column(heap, plan, src, i);
    plan = p1;
    what = w1;
    at = a1;
    if what == 0 {
        i = skip_space(src, after_column);
        let (kind, op, after_op, w2, a2, negated) = parse_operator(heap, src, i, typed);
        negative = negated;
        what = w2;
        if what == 6 && typed >= 22 {
            // `contains` on a date type: the sentence names the date types, not the numbers
            what = 28;
        }
        at = a2;
        i = after_op;
        var first = 0;
        borrow plan as &pr in {
            first = query.lit_count(pr);
        }
        var values = 0;
        var between = false;
        if what == 0 && kind == 2 {
            i = skip_space(src, i);
            if i < len(src) && int_of(src[i]) == '(' {
                i = i + 1;
                var listing = true;
                while listing && what == 0 {
                    i = skip_space(src, i);
                    let (p3, after_value, w3, a3) = parse_value(heap, plan, src, i, typed);
                    plan = p3;
                    what = w3;
                    at = a3;
                    if what == 0 {
                        values = values + 1;
                        i = skip_space(src, after_value);
                        if i < len(src) && int_of(src[i]) == ',' {
                            i = i + 1;
                        } else if i < len(src) && int_of(src[i]) == ')' {
                            i = i + 1;
                            listing = false;
                        } else {
                            what = 8;
                            at = i;
                        }
                        if values > 1024 {
                            what = 11;
                            at = i;
                        }
                    }
                }
            } else {
                what = 7;
                at = i;
            }
        } else if what == 0 && kind == 0 && skip_space(src, i) < len(src) && int_of(src[skip_space(src, i)]) == '(' {
            // a column on the right: `COLUMN OP ( COLUMN )`, a condition of kind 3 whose field of the first literal is the right column's name
            let open = skip_space(src, i);
            let (p3, after_right, index2, typed2, w3, a3) = parse_column(heap, plan, src, skip_space(src, open + 1));
            plan = p3;
            what = w3;
            at = a3;
            i = after_right;
            if what == 0 && typed2 != typed {
                what = 29;
                at = open + 1;
            }
            if what == 0 {
                i = skip_space(src, i);
                if i < len(src) && int_of(src[i]) == ')' {
                    i = i + 1;
                    between = true;
                    plan = query.add_cond(heap, plan, 3, typed, op, index, index2, 0, begins);
                } else {
                    what = 31;
                    at = i;
                }
            }
        } else if what == 0 {
            i = skip_space(src, i);
            let (p3, after_value, w3, a3) = parse_value(heap, plan, src, i, typed);
            plan = p3;
            what = w3;
            at = a3;
            values = 1;
            i = after_value;
        }
        if what == 0 && !between {
            plan = query.add_cond(heap, plan, kind, typed, op, index, first, values, begins);
        }
    }
    return (plan, i, what, at, negative);
}

// The exact complement of the condition at `from`, as text (docs/or-and-columns.md section 3.1, the repair of `not COND`): the same column and value, the operator that is true for the cells
// the condition is false for: `=` and `!=`, `<` and `>=`, `>` and `<=`, `in` and `not in`, `contains` and `not contains`, and `not in` and `not contains` back to their plain spelling. The
// complement is exact for text (a total order, bytewise) and for the typed comparisons (the cell is read the same way whichever operator follows it, so a bad cell is refused in both).
// Answers the text, where the condition ends, and whether `from` is a condition (a refusal of the condition itself is no complement).
pub fn complement[&h, &s](heap: &!h Heap, src: &s [byte], from: int) -> [heap] (buffer.Buffer, int, bool) {
    let none = buffer.empty(heap, 1);
    let (p0, end, w0, a0, negated) = parse_cond(heap, query.empty(heap), src, from);
    query.drop(heap, p0);
    if w0 != 0 {
        return (none, from, false);
    }
    let (p1, after_column, index, typed, w1, a1) = parse_column(heap, query.empty(heap), src, from);
    query.drop(heap, p1);
    let at = skip_space(src, after_column);
    var op_end = at;
    var instead = "";
    let c = int_of(src[at]);
    if c == '=' {
        instead = "!=";
        op_end = at + 1;
    } else if c == '!' {
        instead = "=";
        op_end = at + 2;
    } else if c == '<' || c == '>' {
        let or_equal = at + 1 < len(src) && int_of(src[at + 1]) == '=';
        if c == '<' && or_equal {
            instead = ">";
        } else if c == '<' {
            instead = ">=";
        } else if or_equal {
            instead = "<";
        } else {
            instead = "<=";
        }
        op_end = at + 1;
        if or_equal {
            op_end = at + 2;
        }
    } else {
        let (word, after, quoted, status, e1, e2) = read_word(heap, buffer.empty(heap, 16), src, at);
        var first_in = false;
        borrow word as &wr in {
            first_in = bytes.equal(buffer.bytes(wr), "in");
        }
        buffer.drop(heap, word);
        op_end = after;
        if negated {
            // `not in` or `not contains`: the operator runs to the end of the word after `not`
            let at2 = skip_space(src, after);
            let (w2, after2, q2, s2, f1, f2) = read_word(heap, buffer.empty(heap, 16), src, at2);
            var second_in = false;
            borrow w2 as &wr in {
                second_in = bytes.equal(buffer.bytes(wr), "in");
            }
            buffer.drop(heap, w2);
            op_end = after2;
            if second_in {
                instead = "in";
            } else {
                instead = "contains";
            }
        } else if first_in {
            instead = "not in";
        } else {
            instead = "not contains";
        }
    }
    var out = buffer.append(heap, buffer.empty(heap, end - from + 16), src[from..at]);
    out = buffer.append(heap, out, instead);
    out = buffer.append(heap, out, src[op_end..end]);
    buffer.drop(heap, none);
    return (out, end, true);
}

// Read EXPR into the plan. Answers the plan, and 0 for what and the offset
// when it is whole, else what was expected (`expected`) and where, as a byte
// offset into the expression.
pub fn parse[&h, &s](heap: &!h Heap, q: query.Query, src: &s [byte]) -> [heap] (query.Query, int, int) {
    var plan = q;
    var i = skip_space(src, 0);
    var what = 0;
    var at = 0;
    var many = 0;
    var more = true;
    while more && what == 0 {
        if many >= 64 {
            what = 11;
            at = i;
        } else {
            let (p1, after, w1, a1, negative) = parse_cond(heap, plan, src, i);
            plan = p1;
            what = w1;
            at = a1;
            i = after;
            if what == 0 && negative {
                // the conjunction reader of slice A0 has no `not`: a condition that is negated is not one of its conditions
                what = 24;
                at = i;
            }
            if what == 0 {
                many = many + 1;
                i = skip_space(src, i);
                if i >= len(src) {
                    more = false;
                } else {
                    let (word, after_and, quoted, status, e1, e2) = read_word(heap, buffer.empty(heap, 4), src, i);
                    var is_and = false;
                    borrow word as &wr in {
                        is_and = status == 0 && quoted == 0 && bytes.equal(buffer.bytes(wr), "and");
                    }
                    buffer.drop(heap, word);
                    if is_and {
                        i = skip_space(src, after_and);
                    } else {
                        what = 4;
                        at = i;
                    }
                }
            }
        }
    }
    plan = query.bump(plan, 1, many);
    return (plan, what, at);
}

// The repair of an `or` (docs/or-and-columns.md section 7, slice A0): `COND or COND { or COND }`, every COND `COLUMN = VALUE` or `COLUMN in (V { , V })`, the column written
// the same each time (the same bytes, so the same name or position and the same type suffix), is the one question `COLUMN in (V1, V2, ...)`, the values as written and in order,
// duplicates kept. Answers that expression and true; else an empty buffer and false: the operators differ (`!=` makes `a != 1 or a != 2` always true, an `in` would be wrong),
// a leaf is `contains`, the columns or the types differ, another connective or a parenthesis is there, a literal does not fit its type, or the list passes 1,024 values (the ceiling is `parse`'s: the result is parsed again, and
// must be one condition, before it is offered). No engine is touched: this reads the text with the readers `parse` uses.
pub fn or_in[&h, &s](heap: &!h Heap, src: &s [byte]) -> [heap] (buffer.Buffer, bool) {
    var plan = query.empty(heap);
    var list = buffer.empty(heap, len(src) + 16);
    var col_a = 0;
    var col_b = 0;
    var leaves = 0;
    var values = 0;
    var ok = true;
    var more = true;
    var i = skip_space(src, 0);
    while ok && more {
        let begins = i;
        let (p1, after_column, index, typed, w1, a1) = parse_column(heap, plan, src, i);
        plan = p1;
        if w1 != 0 {
            ok = false;
        } else if leaves == 0 {
            col_a = begins;
            col_b = after_column;
        } else if after_column - begins != col_b - col_a || !bytes.equal(src[begins..after_column], src[col_a..col_b]) {
            ok = false;
        }
        if ok {
            i = skip_space(src, after_column);
            let (kind, op, after_op, w2, a2, negated) = parse_operator(heap, src, i, typed);
            if w2 != 0 || kind == 1 || kind == 0 && op != 0 || negated {
                ok = false;
            } else {
                i = skip_space(src, after_op);
                var listing = kind == 2;
                if kind == 2 {
                    if i < len(src) && int_of(src[i]) == '(' {
                        i = i + 1;
                    } else {
                        ok = false;
                    }
                }
                var one = true;
                while ok && (listing || one) {
                    one = false;
                    i = skip_space(src, i);
                    let (p3, after_value, w3, a3) = parse_value(heap, plan, src, i, typed);
                    plan = p3;
                    if w3 != 0 {
                        ok = false;
                    } else {
                        if values > 0 {
                            list = buffer.append(heap, list, ", ");
                        }
                        list = buffer.append(heap, list, src[i..after_value]);
                        values = values + 1;
                        i = after_value;
                        if listing {
                            i = skip_space(src, i);
                            if i < len(src) && int_of(src[i]) == ',' {
                                i = i + 1;
                            } else if i < len(src) && int_of(src[i]) == ')' {
                                i = i + 1;
                                listing = false;
                            } else {
                                ok = false;
                            }
                        }
                    }
                }
            }
        }
        if ok {
            leaves = leaves + 1;
            i = skip_space(src, i);
            if i >= len(src) {
                more = false;
            } else {
                let (word, after_or, quoted, status, e1, e2) = read_word(heap, buffer.empty(heap, 4), src, i);
                var is_or = false;
                borrow word as &wr in {
                    is_or = status == 0 && quoted == 0 && bytes.equal(buffer.bytes(wr), "or");
                }
                buffer.drop(heap, word);
                if is_or {
                    i = skip_space(src, after_or);
                } else {
                    ok = false;
                }
            }
        }
    }
    query.drop(heap, plan);
    var out = buffer.empty(heap, len(src) + 16);
    if ok && leaves >= 2 {
        out = buffer.append(heap, out, src[col_a..col_b]);
        out = buffer.append(heap, out, " in (");
        borrow list as &lr in {
            out = buffer.append(heap, out, buffer.bytes(lr));
        }
        out = buffer.push(heap, out, byte_of(41));
        // the repair is only offered whole: the corrected expression must be one the grammar takes (a column, `in`, a list: one condition, within the ceiling of 1,024 values)
        var what = 1;
        borrow out as &orr in {
            let (p4, w4, a4) = parse(heap, query.empty(heap), buffer.bytes(orr));
            query.drop(heap, p4);
            what = w4;
        }
        if what == 0 {
            buffer.drop(heap, list);
            return (out, true);
        }
    }
    buffer.drop(heap, list);
    buffer.drop(heap, out);
    return (buffer.empty(heap, 1), false);
}

// The same for a :dec(scale) column: the cell is read as the exact scaled integer, and compared with the literals' (read at the
// same scale when the expression was parsed).
fn holds_dec[&q, &c](plan: &q query.Query, kind: int, op: int, first: int, many: int, scale: int, cell: &c [byte]) -> [] int {
    var v = 0;
    if scale == 19 {
        // :float (the type is 21, so the "scale" is 19): the cell's key; the verdicts are the statuses of `flt.parse_float` less two, 7 to 11
        let (key, bad) = flt.parse_float(cell);
        if bad != 0 {
            return bad - 2;
        }
        v = key;
    } else {
        let (d, bad) = cellnum.parse_dec(cell, scale);
        if bad == 1 {
            return 4;
        }
        if bad == 3 {
            return 5;
        }
        if bad == 2 {
            return 6;
        }
        v = d;
    }
    var l = 0;
    while l < many {
        let w = query.lit_at(plan, first + l, 2);
        var yes = false;
        if kind == 2 || op == 0 {
            yes = v == w;
        } else if op == 1 {
            yes = v != w;
        } else if op == 2 {
            yes = v < w;
        } else if op == 3 {
            yes = v <= w;
        } else if op == 4 {
            yes = v > w;
        } else {
            yes = v >= w;
        }
        if yes {
            return 1;
        }
        l = l + 1;
    }
    return 0;
}

// The same for a :date, :timestamp or :datetime column (`typed` 22, 23, 24): the cell is read by `dtparse.parse` and compared with the literals' (read the same way when the expression was
// parsed). A cell that is not one answers its status, 14 or more (dtparse.cho).
fn holds_date[&q, &c](plan: &q query.Query, kind: int, op: int, first: int, many: int, typed: int, cell: &c [byte]) -> [] int {
    let (x, bad) = dtparse.parse(cell, typed);
    if bad != 0 {
        return bad;
    }
    var l = 0;
    while l < many {
        let w = query.lit_at(plan, first + l, 2);
        var yes = false;
        if kind == 2 || op == 0 {
            yes = x == w;
        } else if op == 1 {
            yes = x != w;
        } else if op == 2 {
            yes = x < w;
        } else if op == 3 {
            yes = x <= w;
        } else if op == 4 {
            yes = x > w;
        } else {
            yes = x >= w;
        }
        if yes {
            return 1;
        }
        l = l + 1;
    }
    return 0;
}

// Whether `cell` satisfies condition `k`: 1 yes, 0 no, 2 the column is :int
// and the cell is not an integer, 3 it is one that does not fit 64 bits; for a
// :dec column 4 the cell is not a decimal, 5 it has more fractional digits than
// the scale, 6 it is too wide (`cellnum.parse_dec`); for a :float column 7 to 11 (`flt.parse_float`'s statuses less two).
pub fn holds[&q, &c](plan: &q query.Query, k: int, cell: &c [byte]) -> [] int {
    let kind = query.cond_at(plan, k, 0);
    let op = query.cond_at(plan, k, 2);
    let first = query.cond_at(plan, k, 4);
    let many = query.cond_at(plan, k, 5);
    let typed = query.cond_at(plan, k, 1);
    if typed >= 2 {
        if typed >= 22 {
            return holds_date(plan, kind, op, first, many, typed, cell);
        }
        return holds_dec(plan, kind, op, first, many, typed - 2, cell);
    }
    if typed == 1 {
        let (v, bad) = cellnum.parse_int(cell);
        if bad == 1 {
            return 2;
        }
        if bad == 2 {
            return 3;
        }
        var l = 0;
        while l < many {
            let w = query.lit_at(plan, first + l, 2);
            var yes = false;
            if kind == 2 || op == 0 {
                yes = v == w;
            } else if op == 1 {
                yes = v != w;
            } else if op == 2 {
                yes = v < w;
            } else if op == 3 {
                yes = v <= w;
            } else if op == 4 {
                yes = v > w;
            } else {
                yes = v >= w;
            }
            if yes {
                return 1;
            }
            l = l + 1;
        }
        return 0;
    }
    if kind == 1 {
        let needle = query.lit_bytes(plan, first);
        if len(needle) == 0 || bytes.find(cell, needle) >= 0 {
            return 1;
        }
        return 0;
    }
    var l = 0;
    while l < many {
        let c = bytes.compare(cell, query.lit_bytes(plan, first + l));
        var yes = false;
        if kind == 2 || op == 0 {
            yes = c == 0;
        } else if op == 1 {
            yes = c != 0;
        } else if op == 2 {
            yes = c < 0;
        } else if op == 3 {
            yes = c <= 0;
        } else if op == 4 {
            yes = c > 0;
        } else {
            yes = c >= 0;
        }
        if yes {
            return 1;
        }
        l = l + 1;
    }
    return 0;
}

// The key a cell has when it is read as `typed` (1 :int, 2 + S :dec(S), 21 :float, 22 and more the dates), and 0, or the verdict `holds` answers for a cell that is not one (2 to 11, 14 and more).
fn key_of[&c](typed: int, cell: &c [byte]) -> [] (int, int) {
    if typed == 1 {
        let (v, bad) = cellnum.parse_int(cell);
        if bad == 1 {
            return (0, 2);
        }
        if bad == 2 {
            return (0, 3);
        }
        return (v, 0);
    }
    if typed >= 22 {
        let (x, bad) = dtparse.parse(cell, typed);
        return (x, bad);
    }
    if typed == 21 {
        let (key, bad) = flt.parse_float(cell);
        if bad != 0 {
            return (0, bad - 2);
        }
        return (key, 0);
    }
    let (d, bad) = cellnum.parse_dec(cell, typed - 2);
    if bad == 1 {
        return (0, 4);
    }
    if bad == 3 {
        return (0, 5);
    }
    if bad == 2 {
        return (0, 6);
    }
    return (d, 0);
}

// Whether `a` OP `b` for the order `c` (-1, 0 or 1) of the two.
fn ordered(op: int, c: int) -> [] bool {
    if op == 0 {
        return c == 0;
    }
    if op == 1 {
        return c != 0;
    }
    if op == 2 {
        return c < 0;
    }
    if op == 3 {
        return c <= 0;
    }
    if op == 4 {
        return c > 0;
    }
    return c >= 0;
}

// Condition `k`, of kind 3, against the cells of its two columns: answers the verdict as `holds` does and which cell was refused (0 the left, 1 the right). The left is read first, so a
// bad left cell is the refusal whatever the right one holds. Both are read as the one type, and compared as the values they are.
pub fn holds_columns[&q, &c, &d](plan: &q query.Query, k: int, a: &c [byte], b: &d [byte]) -> [] (int, int) {
    let op = query.cond_at(plan, k, 2);
    let typed = query.cond_at(plan, k, 1);
    if typed == 0 {
        return (bool_int(ordered(op, bytes.compare(a, b))), 0);
    }
    let (x, bad_a) = key_of(typed, a);
    if bad_a != 0 {
        return (bad_a, 0);
    }
    let (y, bad_b) = key_of(typed, b);
    if bad_b != 0 {
        return (bad_b, 1);
    }
    var c = 0;
    if x < y {
        c = 0 - 1;
    } else if x > y {
        c = 1;
    }
    return (bool_int(ordered(op, c)), 0);
}

fn bool_int(b: bool) -> [] int {
    if b {
        return 1;
    }
    return 0;
}

// Whether the record satisfies every condition. `cols` are the resolved
// column numbers of the plan's names and `cells` the record's fields (see
// `reader.fields`). Answers (verdict, which condition, scratch): verdict 1
// the row is wanted, 0 it is not, 2 or 3 a condition refused a cell (see
// `holds`).
pub fn eval[&h, &q, &c, &d, &e](heap: &!h Heap, plan: &q query.Query, cols: &c [int], record: &d [byte], cells: &e [int], scratch: buffer.Buffer) -> [heap] (int, int, buffer.Buffer) {
    if query.flowed(plan) {
        if query.has_columns(plan) {
            return eval_program_columns(heap, plan, cols, record, cells, scratch);
        }
        return eval_program(heap, plan, cols, record, cells, scratch);
    }
    var scr = scratch;
    var k = 0;
    let total = query.count_of(plan, 1);
    while k < total {
        let column = cols[query.cond_at(plan, k, 3)];
        let first = cells[3 * column];
        let last = cells[3 * column + 1];
        var verdict = 0;
        if cells[3 * column + 2] == 1 && index_of_byte(record[first..last], byte_of(34)) >= 0 {
            borrow mut scr as &!sw in {
                buffer.clear(sw);
            }
            scr = query.unquote(heap, scr, record[first..last]);
            borrow scr as &sr in {
                verdict = holds(plan, k, buffer.bytes(sr));
            }
        } else {
            verdict = holds(plan, k, record[first..last]);
        }
        if verdict != 1 {
            return (verdict, k, scr);
        }
        k = k + 1;
    }
    return (1, 0, scr);
}

// Condition `k` of kind 3 against the row: the cell of each column, unquoted if it holds a quote. Answers as `holds_columns` does. The left cell is unquoted into `scratch`, the right into a
// buffer of its own, only when it has a quote.
fn between_columns[&h, &q, &c, &d, &e](heap: &!h Heap, plan: &q query.Query, k: int, cols: &c [int], record: &d [byte], cells: &e [int], scratch: buffer.Buffer) -> [heap] (int, int, buffer.Buffer) {
    var scr = scratch;
    let left = cols[query.cond_at(plan, k, 3)];
    let right = cols[query.cond_at(plan, k, 4)];
    var verdict = 0;
    var side = 0;
    if cells[3 * left + 2] == 1 && index_of_byte(record[cells[3 * left]..cells[3 * left + 1]], byte_of(34)) >= 0 {
        borrow mut scr as &!sw in {
            buffer.clear(sw);
        }
        scr = query.unquote(heap, scr, record[cells[3 * left]..cells[3 * left + 1]]);
        borrow scr as &sr in {
            let (v, s) = against_right(heap, plan, k, buffer.bytes(sr), right, record, cells);
            verdict = v;
            side = s;
        }
    } else {
        let (v, s) = against_right(heap, plan, k, record[cells[3 * left]..cells[3 * left + 1]], right, record, cells);
        verdict = v;
        side = s;
    }
    return (verdict, side, scr);
}

fn against_right[&h, &q, &a, &d, &e](heap: &!h Heap, plan: &q query.Query, k: int, a: &a [byte], right: int, record: &d [byte], cells: &e [int]) -> [heap] (int, int) {
    if cells[3 * right + 2] == 1 && index_of_byte(record[cells[3 * right]..cells[3 * right + 1]], byte_of(34)) >= 0 {
        var own = query.unquote(heap, buffer.empty(heap, 16), record[cells[3 * right]..cells[3 * right + 1]]);
        var v = 0;
        var s = 0;
        borrow own as &orr in {
            let (v2, s2) = holds_columns(plan, k, a, buffer.bytes(orr));
            v = v2;
            s = s2;
        }
        buffer.drop(heap, own);
        return (v, s);
    }
    return holds_columns(plan, k, a, record[cells[3 * right]..cells[3 * right + 1]]);
}

// The evaluation of a plan that has an `or` (docs/or-and-columns.md section 4): the branch program of `query.flow`. A program counter starts at the first condition; the condition it names
// is tried, its cell read as the condition's type only now; the counter becomes the condition's exit for the verdict, a condition after it, or the row is kept (-1) or dropped (-2). Exits only
// go forward, so it ends in at most as many steps as there are conditions, and a cell that no path reaches is never read, as a cell to the right of a false `and` never was. Answers as `eval` does.
// A function of its own, reached by one test at the head of `eval` and not by a case in the loop of `eval` or in `engine.screen`: a test in `screen` cost every filtered row 15 instructions
// (measured, docs/or-and-columns.md section 16), and this one 3 to 5.
fn eval_program[&h, &q, &c, &d, &e](heap: &!h Heap, plan: &q query.Query, cols: &c [int], record: &d [byte], cells: &e [int], scratch: buffer.Buffer) -> [heap] (int, int, buffer.Buffer) {
    var scr = scratch;
    var k = 0;
    while k >= 0 {
        let column = cols[query.cond_at(plan, k, 3)];
        let first = cells[3 * column];
        let last = cells[3 * column + 1];
        var verdict = 0;
        if cells[3 * column + 2] == 1 && index_of_byte(record[first..last], byte_of(34)) >= 0 {
            borrow mut scr as &!sw in {
                buffer.clear(sw);
            }
            scr = query.unquote(heap, scr, record[first..last]);
            borrow scr as &sr in {
                verdict = holds(plan, k, buffer.bytes(sr));
            }
        } else {
            verdict = holds(plan, k, record[first..last]);
        }
        if verdict >= 2 {
            return (verdict, k, scr);
        }
        let next = query.flow_at(plan, k, 1 - verdict);
        if next == 0 - 1 {
            return (1, 0, scr);
        }
        if next == 0 - 2 {
            return (0, 0, scr);
        }
        k = next;
    }
    return (0, 0, scr);
}

// The same for a plan that holds a comparison of two columns (docs/column-comparison.md), which has its own function so that the program of a plan without one is the loop it was, with no test of
// the kind of each condition. A refusal of the right cell answers a negative `which` (-1 less the condition).
fn eval_program_columns[&h, &q, &c, &d, &e](heap: &!h Heap, plan: &q query.Query, cols: &c [int], record: &d [byte], cells: &e [int], scratch: buffer.Buffer) -> [heap] (int, int, buffer.Buffer) {
    var scr = scratch;
    var k = 0;
    while k >= 0 {
        let column = cols[query.cond_at(plan, k, 3)];
        let first = cells[3 * column];
        let last = cells[3 * column + 1];
        var said = 0;
        if query.cond_at(plan, k, 0) == 3 {
            // two columns of the row (docs/column-comparison.md): a plan that has one always has a program, so the loop of `eval` never meets it
            let (v3, side, s3) = between_columns(heap, plan, k, cols, record, cells, scr);
            scr = s3;
            if v3 >= 2 {
                if side == 1 {
                    return (v3, 0 - 1 - k, scr);
                }
                return (v3, k, scr);
            }
            said = v3;
        } else if cells[3 * column + 2] == 1 && index_of_byte(record[first..last], byte_of(34)) >= 0 {
            borrow mut scr as &!sw in {
                buffer.clear(sw);
            }
            scr = query.unquote(heap, scr, record[first..last]);
            borrow scr as &sr in {
                said = holds(plan, k, buffer.bytes(sr));
            }
        } else {
            said = holds(plan, k, record[first..last]);
        }
        if said >= 2 {
            return (said, k, scr);
        }
        let after = query.flow_at(plan, k, 1 - said);
        if after == 0 - 1 {
            return (1, 0, scr);
        }
        if after == 0 - 2 {
            return (0, 0, scr);
        }
        k = after;
    }
    return (0, 0, scr);
}
