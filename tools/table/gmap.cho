edition 5;

module gmap;

// A hash table from byte strings to entry numbers, for the groups (agg.cho): `std.map` without what the groups do not use
// (values, removal), and with what they do need: the hash is taken once, by the caller, and handed to `find_h` and
// `put_new` (the std map hashes a key three times when a group is new: `find`, then `put`, which finds again and then
// hashes to place), a slot holds a 31-bit tag of the hash beside the entry number so that a probe that does not match is
// told so without reading the entry, the entry is three integers (where its key starts, how long it is, its hash), and a
// new entry can be put in place (`put_inplace`) when the storage has room, without moving the table.
//
// Open addressing, linear probing, at most half full. An entry's number is the order in which it was put.

import std.buffer;
import std.bytes;

pub res struct Tab {
    // 0 empty, else tag << 32 | (entry number + 1); the length is a power of two
    slots: Box[[int]],
    // three integers an entry: where its key starts in `keys`, its length, its full hash
    meta: Box[[int]],
    keys: buffer.Buffer,
    entries: int,
}

fn slot_count(cap: int) -> [] int {
    var n = 8;
    while n < cap * 2 {
        n = n * 2;
    }
    return n;
}

pub fn empty[&h](heap: &!h Heap, capacity: int) -> [heap] Tab {
    var cap = capacity;
    if cap < 4 {
        cap = 4;
    }
    return Tab { slots: box_slice(heap, slot_count(cap), 0), meta: box_slice(heap, cap * 3, 0), keys: buffer.empty(heap, cap * 16), entries: 0 };
}

pub fn drop[&h](heap: &!h Heap, t: Tab) -> [heap] int {
    let Tab { slots, meta, keys, entries } = t;
    unbox_slice(heap, slots);
    unbox_slice(heap, meta);
    buffer.drop(heap, keys);
    return entries;
}

pub fn size[&t](t: &t Tab) -> [] int {
    return t.entries;
}

pub fn key_at[&t](t: &t Tab, e: int) -> [] &t [byte] {
    let meta = contents(t.meta);
    let text = buffer.bytes(t.keys);
    let start = meta[e * 3];
    return text[start..start + meta[e * 3 + 1]];
}

fn shr33(x: int) -> [] int {
    return x >> 33 & 0x7fffffff;
}

// A 64-bit hash of `key`: eight bytes at a time, one multiply for each, and a murmur3 finalizer so that the low bits (the place) and the
// high ones (the tag) depend on every byte.
pub fn hash[&k](key: &k [byte]) -> [] int {
    let n = len(key);
    var h = wrapping_mul(n + 1, 0x9e3779b9 << 32 | 0x7f4a7c15);
    var i = 0;
    while i + 8 <= n {
        let w = int_of(key[i]) | int_of(key[i + 1]) << 8 | int_of(key[i + 2]) << 16 | int_of(key[i + 3]) << 24 | int_of(key[i + 4]) << 32 | int_of(key[i + 5]) << 40 | int_of(key[i + 6]) << 48 | int_of(key[i + 7]) << 56;
        h = wrapping_mul(h ^ w, 0xff51afd7 << 32 | 0xed558ccd);
        h = h ^ shr33(h);
        i = i + 8;
    }
    var w = 0;
    var s = 0;
    while i < n {
        w = w | int_of(key[i]) << s;
        s = s + 8;
        i = i + 1;
    }
    h = wrapping_mul(h ^ w, 0xff51afd7 << 32 | 0xed558ccd);
    h = h ^ shr33(h);
    h = wrapping_mul(h, 0xc4ceb9fe << 32 | 0x1a85ec53);
    h = h ^ shr33(h);
    return h;
}

// The entry number of `key` (whose hash is `h`), or -1.
pub fn find_h[&t, &k](t: &t Tab, key: &k [byte], h: int) -> [] int {
    let slots = contents(t.slots);
    let meta = contents(t.meta);
    let text = buffer.bytes(t.keys);
    let mask = len(slots) - 1;
    let tag = shr33(h);
    let n = len(key);
    var at = h & mask;
    var found = 0 - 1;
    var going = true;
    while going {
        let s = slots[at];
        if s == 0 {
            going = false;
        } else if s >> 32 == tag {
            let e = (s & 0xffffffff) - 1;
            if meta[e * 3 + 1] == n {
                let start = meta[e * 3];
                if bytes.equal(text[start..start + n], key) {
                    found = e;
                    going = false;
                }
            }
        }
        at = at + 1 & mask;
    }
    return found;
}

pub fn find[&t, &k](t: &t Tab, key: &k [byte]) -> [] int {
    return find_h(t, key, hash(key));
}

fn place[&s](slots: &!s [int], h: int, entry: int) -> [] int {
    let mask = len(slots) - 1;
    var at = h & mask;
    while slots[at] != 0 {
        at = at + 1 & mask;
    }
    slots[at] = shr33(h) << 32 | entry + 1;
    return at;
}

// The same entries in storage twice as large.
fn grow[&h](heap: &!h Heap, t: Tab) -> [heap] Tab {
    let Tab { slots, meta, keys, entries } = t;
    var cap = 0;
    borrow meta as &mr in {
        cap = len(contents(mr)) / 3 * 2;
    }
    let new_slots = box_slice(heap, slot_count(cap), 0);
    let new_meta = box_slice(heap, cap * 3, 0);
    borrow mut new_slots as &!sw in {
        borrow mut new_meta as &!mw in {
            borrow meta as &om in {
                let ns = contents(sw);
                let nm = contents(mw);
                let old = contents(om);
                var e = 0;
                while e < entries {
                    nm[e * 3] = old[e * 3];
                    nm[e * 3 + 1] = old[e * 3 + 1];
                    nm[e * 3 + 2] = old[e * 3 + 2];
                    place(ns, old[e * 3 + 2], e);
                    e = e + 1;
                }
            }
        }
    }
    unbox_slice(heap, slots);
    unbox_slice(heap, meta);
    return Tab { slots: new_slots, meta: new_meta, keys: keys, entries: entries };
}

// Whether a key of `n` bytes can be put in place: room in the entries, the slots and the key bytes.
pub fn has_room[&t](t: &!t Tab, n: int) -> [] bool {
    return (t.entries + 1) * 3 <= len(contents(t.meta)) && len(buffer.room(t.keys)) >= n;
}

// Put `key` (absent, whose hash is `h`) in place; `has_room` said yes. Answers its entry number.
pub fn put_inplace[&t, &k](t: &!t Tab, key: &k [byte], h: int) -> [] int {
    let e = t.entries;
    let meta = contents(t.meta);
    let start = buffer.size(t.keys);
    let n = len(key);
    meta[e * 3] = start;
    meta[e * 3 + 1] = n;
    meta[e * 3 + 2] = h;
    let room = buffer.room(t.keys);
    copy_into(room[0..n], key);
    buffer.filled(t.keys, n);
    place(contents(t.slots), h, e);
    t.entries = e + 1;
    return e;
}

// Put `key` (absent, whose hash is `h`) as the next entry, growing the storage when it is full.
pub fn put_new[&h, &k](heap: &!h Heap, t: Tab, key: &k [byte], hash_of: int) -> [heap] Tab {
    var cur = t;
    var full = false;
    borrow cur as &r in {
        full = (r.entries + 1) * 3 > len(contents(r.meta));
    }
    if full {
        cur = grow(heap, cur);
    }
    let Tab { slots, meta, keys, entries } = cur;
    var start = 0;
    borrow keys as &ok in {
        start = buffer.size(ok);
    }
    let grown = buffer.append(heap, keys, key);
    borrow mut slots as &!sw in {
        borrow mut meta as &!mw in {
            let nm = contents(mw);
            nm[entries * 3] = start;
            nm[entries * 3 + 1] = len(key);
            nm[entries * 3 + 2] = hash_of;
            place(contents(sw), hash_of, entries);
        }
    }
    return Tab { slots: slots, meta: meta, keys: grown, entries: entries + 1 };
}
