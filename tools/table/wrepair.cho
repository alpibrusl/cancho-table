edition 5;

module wrepair;

// The refusal of `and` mixed with `or` at one level of `--where` (docs/or-and-columns.md section 3.3): `where.mixed-and-or`, at the connective that changes the level, with a repair that
// offers the two ways to read it as whole invocations: by precedence (`and` before `or`, as SQL does) and left to right. A reading is offered only if `--where` takes it whole.

import std.buffer;
import std.bytes;
import std.json;
import expr;
import orparse;
import query;
import toolbox.fail;
import finish;

pub fn hint() -> [] &static [byte] {
    return "put parentheses round what goes first: (a = 1 or b = 2) and c = 3 is one question and a = 1 or (b = 2 and c = 3) another, and the tool does not choose between them, the repair offers both";
}

// The refusal for `given`, the text of `--where` (at argument `where_at` of the call, a value of its own when `whole`, else `--where=text`), added to `errs`; `at` is the connective.
pub fn refuse[&h, &g, &w](heap: &!h Heap, errs: fail.Errors, given: &w [byte], at: int, args: &g Args, where_at: int, whole: bool) -> [heap, args] fail.Errors {
    return refuse_for(heap, errs, given, at, args, where_at, whole, "--where");
}

// The same for the expression of `flag` (`--where` or `--join-where`), whose value is at argument `where_at`.
pub fn refuse_for[&h, &g, &w](heap: &!h Heap, errs: fail.Errors, given: &w [byte], at: int, args: &g Args, where_at: int, whole: bool, flag: &static [byte]) -> [heap, args] fail.Errors {
    var message = "--where uses and and or at one level: which of them goes first is not guessed";
    if bytes.equal(flag, "--join-where") {
        message = "--join-where uses and and or at one level: which of them goes first is not guessed";
    }
    var w = fail.open_in(heap, finish.extra(), "where.mixed-and-or", message, hint());
    let (r0, ok0, r1, ok1) = orparse.readings(heap, given);
    if where_at >= 0 && (ok0 || ok1) {
        var o = fail.choose_open(heap, w);
        if ok0 {
            borrow r0 as &rr in {
                o = option(heap, o, args, where_at, whole, buffer.bytes(rr), flag);
            }
        }
        if ok1 {
            borrow r1 as &rr in {
                o = option(heap, o, args, where_at, whole, buffer.bytes(rr), flag);
            }
        }
        w = fail.choose_close(heap, o);
    } else {
        w = fail.repair_none(heap, w, "which of the two readings was meant is not known, and neither can be written in the grammar");
    }
    buffer.drop(heap, r0);
    buffer.drop(heap, r1);
    w = fail.detail_open(heap, w);
    if bytes.equal(flag, "--join-where") {
        w = fail.detail_str(heap, w, "flag", flag);
    }
    w = fail.detail_int(heap, w, "offset", at);
    w = fail.detail_text(heap, w, "expression", given);
    return fail.add(heap, errs, w);
}

fn option[&h, &g, &t](heap: &!h Heap, w: json.Writer, args: &g Args, where_at: int, whole: bool, text: &t [byte], flag: &static [byte]) -> [heap, args] json.Writer {
    var o = w;
    if whole {
        o = fail.choose_option_replacing(heap, o, args, where_at, text);
    } else {
        var joined = buffer.append(heap, buffer.empty(heap, 64), flag);
        joined = buffer.push(heap, joined, byte_of('='));
        joined = buffer.append(heap, joined, text);
        borrow joined as &jr in {
            o = fail.choose_option_replacing(heap, o, args, where_at, buffer.bytes(jr));
        }
        buffer.drop(heap, joined);
    }
    return o;
}

// ---- `not COND`: the repair of the refusal where.syntax says "( after not" (docs/or-and-columns.md section 3.1) ----------------------------------------------------------

// The expression with every `not COND` that the grammar refuses rewritten as the condition's exact complement (`not a < 1` is `a >= 1`, `not a in (1, 2)` is `a not in (1, 2)`; `expr.complement`),
// one at a time, each time where the grammar's refusal is. Answers it and true when the grammar then takes it whole; else an empty buffer and false (another fault is in the text, or
// the `not` is not the bare word the grammar read).
pub fn not_repair[&h, &s](heap: &!h Heap, src: &s [byte]) -> [heap] (buffer.Buffer, bool) {
    var cur = buffer.append(heap, buffer.empty(heap, len(src) + 16), src);
    var rounds = 0;
    var state = 0;
    while state == 0 && rounds < 70 {
        var next = buffer.empty(heap, 1);
        borrow cur as &cr in {
            let text = buffer.bytes(cr);
            let (p, w, at) = orparse.parse(heap, query.empty(heap), text);
            query.drop(heap, p);
            if w == 0 {
                state = 1;
            } else if w != 23 {
                state = 2;
            } else {
                // the `not` is the word before the one the refusal is at
                var k = at;
                while k > 0 && (int_of(text[k - 1]) == 32 || int_of(text[k - 1]) == 9 || int_of(text[k - 1]) == 10 || int_of(text[k - 1]) == 13) {
                    k = k - 1;
                }
                if k < 3 || !bytes.equal(text[k - 3..k], "not") || k >= 4 && int_of(text[k - 4]) == '\\' {
                    state = 2;
                } else {
                    let (comp, end, ok) = expr.complement(heap, text, at);
                    if ok {
                        next = buffer.append(heap, next, text[0..k - 3]);
                        borrow comp as &kr in {
                            next = buffer.append(heap, next, buffer.bytes(kr));
                        }
                        next = buffer.append(heap, next, text[end..len(text)]);
                    } else {
                        state = 2;
                    }
                    buffer.drop(heap, comp);
                }
            }
        }
        if state == 0 {
            buffer.drop(heap, cur);
            cur = next;
        } else {
            buffer.drop(heap, next);
        }
        rounds = rounds + 1;
    }
    if state == 1 && rounds > 1 {
        return (cur, true);
    }
    buffer.drop(heap, cur);
    return (buffer.empty(heap, 1), false);
}

// The invocation with `--where` replaced by `fixed`, as the one option of a choice.
pub fn offer[&h, &g, &f](heap: &!h Heap, w: json.Writer, args: &g Args, where_at: int, whole: bool, fixed: &f [byte]) -> [heap, args] json.Writer {
    var o = fail.choose_open(heap, w);
    o = option(heap, o, args, where_at, whole, fixed, "--where");
    return fail.choose_close(heap, o);
}
