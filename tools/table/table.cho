edition 5;

// `table` -- a CSV or TSV file as a table: its shape, some of its columns, the
// rows that satisfy a condition, or counts and sums of groups of rows.
//
//     table [--root DIR] [--delimiter ,|tab|;] [--max-rows N] [--max-line-bytes N]
//           [--format json|text] FILE                                the shape
//     table [--select NAMES] [--where EXPR] [--order-by KEYS] [--top N] [--max-sort-rows N] [--limit N] [--from N] [--max-bytes N]
//           [--format json|csv|jsonl] [the same] FILE                      rows
//     table --group NAMES [--agg LIST] [--where EXPR] [--sort KEY] [--top N]
//           [--limit N] [--from N] [--max-groups N] [--max-distinct N]
//           [--max-state-bytes N] [--format json|csv|jsonl] [the same] FILE   groups
//
// Design and measurements: `docs/select.md`, `docs/filter.md`. The reader is
// `reader.cho` (RFC 4180, one line at a time), what is written for a field
// `writer.cho`, the plan `query.cho` (filled by `plan.cho` for column lists,
// `expr.cho` for `--where`, `agg.cho` for `--agg`), and what the header lets the
// plan become `frame.cho`; this file drives them and says what went wrong.
//
// * The input is FILE, or standard input when FILE is `-` or there is none (docs/readers.md, R1): the same answer, read in one pass on one core and in blocks
//   (`bulk.fill_stdin`, `read_bytes`: `io_read`), by `read_stream`, which `scripts/stream.py` makes from `read_file` (the loop of a file is not edited to serve a pipe: see
//   the script for what that costs).
// * The first record is the header; every later non-blank record is a row.
// * RFC 4180: a field may be quoted, a quote inside it is doubled, a quoted
//   field may hold the delimiter, a newline or a CRLF; a leading UTF-8 byte
//   order mark is dropped. A quote that opens in the middle of an unquoted
//   field is text, as in most readers. A closing quote followed by anything
//   but the delimiter or the end of the record is `parse.csv-bad-quote`.
// * A blank line (nothing but an optional CR) between records is skipped.
//   A lone CR is not a line break.
// * A row with a number of fields other than the header's is
//   `parse.csv-ragged-row`, one error for the file naming the first such row;
//   the rest of the file is still read and counted, and a ragged row is never
//   among the rows a selection returns or a grouping counts. A quote left open
//   at the end of the input is `parse.csv-unterminated-quote`.
// * One plan, one engine: the flags fill a `Query` (query.cho); a row is
//   counted, then tested by `--where`, then either emitted or added to its
//   group. `--where` is applied before grouping.
// * `--max-rows` is a bound on work, not memory: reading stops at it. In JSON
//   the answer says `truncated: true`; as CSV there is nowhere to say it, so it
//   is `limit.too-many-rows`. `--max-line-bytes` is a bound on memory: a
//   physical line longer than it is `limit.line-too-long`, and the header, and
//   with `--select`, `--where` or `--group` every record, which are kept while
//   they are used, may not hold more than that many bytes in all
//   (`limit.header-too-large`, `limit.record-too-large`).
//
// Memory is one 64 KiB chunk, the longest record, the header, one row of
// output and, as JSON, the page asked for (`--limit`, within `--max-bytes`);
// for a grouping, also its groups, bounded three ways (agg.cho).

import std.buffer;
import std.bytes;
import std.json;
import std.vec;
import agg;
import bulk;
import engine;
import explain;
import expr;
import finish;
import flags;
import spec;
import frame;
import inputs;
import jdisc;
import jflags;
import jnexplain;
import jnflags;
import jnread;
import jsonl;
import par;
import plan;
import qpath;
import orparse;
import qrefuse;
import qtrans;
import query;
import reader;
import report;
import scan;
import sorter;
import toolbox.built;
import toolbox.cli;
import toolbox.describe;
import toolbox.fail;
import toolbox.limit;
import toolbox.lines;
import toolbox.out;
import toolbox.path;
import toolbox.place;
import toolbox.text;
import writer;
import wrepair;
import jout;

fn flag_table() -> [] &static [byte] {
    return spec.flag_table();
}

fn tool() -> [] describe.Tool {
    return describe.Tool { name: "table", version: "0.3.0", summary: "A CSV or TSV file as a table, read in one bounded streaming pass over an RFC 4180 reader: its shape, some columns (--select), the rows that satisfy a condition (--where, bytewise or exact integers, decimals or doubles), rows in order (--order-by), or counts, sums, means, minima, maxima and distinct counts of groups (--group, --agg, --sort, --top), as json pages, as csv, or as JSON lines (--format jsonl: one object per row, keys the output columns, every value a string but the aggregates, which are numbers). Every refusal is a rule, with its hint. Four forms, chosen by the flags: the shape (FILE alone: the column names and the row count), rows (--select, --where or --order-by, then --top, --limit and --from to cut and page), groups (--group or --agg, then --where, --sort, --top, --limit and --from) and the type report (--report types, then --select, --where, --limit and --from: one row per column, saying what its cells are and which declaration would read it). A mix is refused. args.conflict: --select or --order-by with --group or --agg, --report with --group, --agg, --order-by, --sort or --top, and --format text with rows, groups or the report. The type report is not written as JSON lines (args.conflict). A column twice in the answer is output.duplicate-column for --format jsonl, and a column name that is not UTF-8 is output.not-representable. args.required-flag: --limit, --from or --format csv with the shape, --top with neither --order-by, --group nor --agg, and --sort without --group or --agg. --rows is every row with every column and no condition, and conflicts with --select, --where, --group, --agg, --order-by and --report. A join (--join FILE --on PROBE=BUILD) is a fifth form, rows only in this version: FILE or standard input is the probe side, streamed, and the --join file is the build side, read whole into memory before the first probe row and counted in --max-state-bytes by a stated formula (record bytes + 16 for each row held, key bytes + 60 for each distinct key), which is not resident memory: that can be up to about three times as much while the build grows. The answer is the inner join, as csv or json or JSON lines: for each probe row, in the probe's order, one row for each row of the --join file with an equal key, in that file's order, the probe row's cells and then the build row's cells (a probe row with no match is not in it, and fan-out is bounded by --max-join-rows). A key is compared as text, byte for byte: 007 is not 7, a quoted cell is the text inside its quotes, and an empty cell matches an empty cell (there is no null). A column name that both files have is join.column-collision, nothing is renamed on the way, unless --join-prefix gives the build file's columns a prefix; --select, --where, --limit, --from and --format work on the joined row. The build past --max-state-bytes is limit.state-too-large (detail.holder join-build), and one more joined row than --max-join-rows is limit.too-many-join-rows. A join reads on one core whatever --threads says, with the same bytes, and writes nothing. args.conflict also: --group, --agg, --order-by, --sort, --top or --report with --join (write the join as --format csv and pipe it into a second call), and --join with --input-format jsonl. --query asks one of the forms in a small subset of SQL (select, from, where, group by, order by, limit, offset) and is translated to the flags it stands for, so it gives the same bytes: it conflicts with --select, --where, --group, --agg, --sort, --order-by, --rows and --report, with --limit, --from or --top when the query has its own limit or offset, and with a FILE when it has a from. A query that is not in the grammar is refused as query.syntax at a byte offset with what was expected (and the corrected command when the correction is certain), and and or at one level of its where, with no parentheses, as query.mixed-and-or (and the repair offers the two readings), what the language leaves out (like, null, an alias, an expression, a join) as query.unsupported with what to write instead, a select list that is not the group by columns then at least one aggregate as query.group-mismatch, and a query over 4096 bytes as query.too-long. The report reads every row once and changes nothing: its suggestions (:int, :dec(S), :float or none) are applied by no flag. --explain prints the plan that the other flags (or --query) resolve to, as one JSON line (data.explain: the source and its header, each condition, group, aggregate and order with its type, the output columns, the work and its bounds, the threads it would use and why, the rules the data could still refuse it with, notes), and does not run it: a file is opened and its first 64 KiB read for the header and nothing after it, standard input is not read, and a plan the run would refuse before it read a row is refused as the run refuses it. A page that was cut says data.next.from: pass it as --from. FILE is one path, relative to --root when given, and its first row is the header. With no FILE, or with - for FILE, the table is read from standard input in one pass on one core: the same answer as the file's, byte for byte (but that detail.path is -), whatever --threads says; a pipe is read in blocks on one core, so a large file is better named when --threads should help, and a read that fails is a refusal naming -. With --input-format jsonl (or ndjson) the input is JSON lines, one JSON object per line, and its columns are declared with --fields as paths (id, user.name, items.0.sku): every form above works on them unchanged, from a file or from standard input, with the same answers, the exact text of a number as the cell, a refusal for a line that is not strict JSON (parse.jsonl-syntax, with its offset), is not an object (parse.jsonl-not-object), has no value for a declared path (parse.jsonl-missing-field, or --absent empty), holds an object or an array there (parse.jsonl-not-scalar) or a key twice (parse.jsonl-duplicate-key), and --discover reports the paths and kinds the first lines hold when the columns are not known. The format is never guessed.", usage: "shape:  table [--root DIR] [--delimiter ,|tab|;] [--max-rows N] [--max-line-bytes N] [--format json|text] [FILE|-]\nrows:   table [--root DIR] [--delimiter ,|tab|;] [--max-rows N] [--max-line-bytes N] [--select NAMES] [--where EXPR] [--order-by KEYS] [--top N] [--limit N] [--from N] [--max-bytes N] [--max-sort-rows N] [--max-state-bytes N] [--threads N] [--chunk-bytes N] [--parallel-min-bytes N] [--format json|csv|jsonl] [FILE|-]\ngroups: table [--root DIR] [--delimiter ,|tab|;] [--max-rows N] [--max-line-bytes N] --group NAMES [--agg ITEMS] [--where EXPR] [--sort KEY] [--top N] [--limit N] [--from N] [--max-bytes N] [--max-groups N] [--max-distinct N] [--max-state-bytes N] [--threads N] [--chunk-bytes N] [--parallel-min-bytes N] [--format json|csv|jsonl] [FILE|-]\n        (--agg alone, without --group, is one group of all the rows)\nall:    table [--root DIR] [--delimiter ,|tab|;] [--max-rows N] [--max-line-bytes N] --rows [--limit N] [--from N] [--max-bytes N] [--threads N] [--chunk-bytes N] [--parallel-min-bytes N] [--format json|csv|jsonl] [FILE|-]\nquery:  table [--root DIR] [--delimiter ,|tab|;] [--max-rows N] [--max-line-bytes N] --query TEXT [--top N] [--limit N] [--from N] [--max-bytes N] [--max-sort-rows N] [--max-groups N] [--max-distinct N] [--max-state-bytes N] [--threads N] [--chunk-bytes N] [--parallel-min-bytes N] [--format json|csv|jsonl] [FILE|-]\n        (a query says select, from, where, group by, order by, limit and offset; its from names the FILE)\njoin:   table [--root DIR] [--delimiter ,|tab|;] [--max-rows N] [--max-line-bytes N] --join FILE --on PROBE=BUILD [--join-type inner] [--join-prefix P] [--max-join-rows N] [--select NAMES] [--where EXPR] [--limit N] [--from N] [--max-bytes N] [--max-state-bytes N] [--threads N] [--format json|csv|jsonl] [FILE|-]\n        (the inner join of FILE or standard input, streamed, with the --join file, held in memory: the probe row's cells then the build row's, in the probe's order; --on PROBE=BUILD names a column of each, compared as text)\nexplain: table [--root DIR] [--delimiter ,|tab|;] [--max-rows N] [--max-line-bytes N] --explain [the flags or --query of any form above] [FILE|-]\n        (the plan as one JSON line, data.explain; nothing after the header of a file is read, standard input is not read)\njsonl:  table [--root DIR] [--max-rows N] [--max-line-bytes N] --input-format jsonl --fields PATHS [--absent refuse|empty] [--max-json-nodes N] [the flags of any form above] [FILE|-]\n        (one JSON object per line; PATHS are the columns, as id,user.name,items.0.sku)\ndiscover: table [--root DIR] [--max-line-bytes N] --input-format jsonl --discover [--discover-lines N] [--max-fields N] [FILE|-]\n        (what the first lines hold: the paths and the kinds of their values, to choose --fields from)\nreport: table [--root DIR] [--delimiter ,|tab|;] [--max-rows N] [--max-line-bytes N] --report types [--select NAMES] [--where EXPR] [--limit N] [--from N] [--max-bytes N] [--max-state-bytes N] [--threads N] [--chunk-bytes N] [--parallel-min-bytes N] [--format json|csv|jsonl] [FILE|-]\n\nFILE: at most one, a CSV file (--delimiter tab for TSV) whose first row is the header, or - (or no FILE) for standard input, read in one pass on one core: --root, --threads, --chunk-bytes and --parallel-min-bytes do not apply to it, and a refusal names the input as -. With --root a FILE is relative to that directory (absolute paths, .. and symbolic links are refused); a file called - is ./-.\nNAMES, KEYS and ITEMS are comma-separated lists, and in a name a comma or backslash is written with a backslash before it. A column is its header name or #N, the Nth (1-based).\nRows and groups come as data.columns, data.rows (every cell a string, numbers too), data.row_count, data.truncated, data.next ({\"from\": N} or null) and, for groups, data.group_count.\n\nExamples, on the file sales.csv (a refusal is shown as its rule, exit status, hint and repair kind):\nhost,status,bytes,price\na,200,512,1.50\nb,404,0,2.25\na,200,1024,1.5\nc,500,2048,10.00\nb,200,64,0.75\n\n$ table sales.csv\n{\"ok\":true,\"command\":\"table\",\"schema\":\"table.v2\",\"data\":{\"headers\":[\"host\",\"status\",\"bytes\",\"price\"],\"column_count\":4,\"row_count\":5,\"truncated\":false},\"meta\":{\"version\":\"0.3.0\"}}\n$ table --select host,bytes --where 'status = 200' --order-by -bytes:int --limit 2 sales.csv\n{\"ok\":true,\"command\":\"table\",\"schema\":\"table.v2\",\"data\":{\"columns\":[\"host\",\"bytes\"],\"rows\":[[\"a\",\"1024\"],[\"a\",\"512\"]],\"row_count\":2,\"truncated\":true,\"next\":{\"from\":2}},\"meta\":{\"version\":\"0.3.0\"}}\n$ table --group host --agg count,sum:bytes --sort -sum:bytes --top 2 sales.csv\n{\"ok\":true,\"command\":\"table\",\"schema\":\"table.v2\",\"data\":{\"columns\":[\"host\",\"count\",\"sum:bytes\"],\"rows\":[[\"c\",\"1\",\"2048\"],[\"a\",\"2\",\"1536\"]],\"row_count\":2,\"truncated\":false,\"next\":null,\"group_count\":3},\"meta\":{\"version\":\"0.3.0\"}}\n$ table --query \"select host, count(*) from 'sales.csv' group by host order by count(*) desc limit 1\"\n{\"ok\":true,\"command\":\"table\",\"schema\":\"table.v2\",\"data\":{\"columns\":[\"host\",\"count\"],\"rows\":[[\"a\",\"2\"]],\"row_count\":1,\"truncated\":true,\"next\":{\"from\":1},\"group_count\":3},\"meta\":{\"version\":\"0.3.0\"}}\n$ table --agg 'sum:price:dec(2),mean:bytes@1' sales.csv\n{\"ok\":true,\"command\":\"table\",\"schema\":\"table.v2\",\"data\":{\"columns\":[\"sum:price\",\"mean:bytes\"],\"rows\":[[\"16.00\",\"729.6\"]],\"row_count\":1,\"truncated\":false,\"next\":null,\"group_count\":1},\"meta\":{\"version\":\"0.3.0\"}}\n$ table --join sales.csv --on host=host --join-prefix r_ --select host,bytes,r_bytes --where 'status = 404' sales.csv\n{\"ok\":true,\"command\":\"table\",\"schema\":\"table.v2\",\"data\":{\"columns\":[\"host\",\"bytes\",\"r_bytes\"],\"rows\":[[\"b\",\"0\",\"0\"],[\"b\",\"0\",\"64\"]],\"row_count\":2,\"truncated\":false,\"next\":null},\"meta\":{\"version\":\"0.3.0\"}}\n$ table --select host --group host sales.csv\nrefused: exit 2, rule args.conflict, hint \"drop --select\", repair none", output: "document", schema: "table.v2", flags: flag_table(), operands: "FILE|path-read|0|1|the CSV file to read, a path relative to --root when given (absolute paths, .. and symbolic links are refused), or - or nothing for standard input (a file called - is ./-), and its first row is the header that --select, --where, --group, --agg and --order-by name columns by (with --input-format jsonl: the JSON-lines file, whose columns --fields declares)", rules: "args.unknown-flag;args.missing-value;args.bad-value;args.duplicate-flag;args.conflict;args.required-flag;args.too-many-operands;path.empty;path.dotdot;path.absolute;path.outside-root;path.too-long;path.symlink;io.not-found;io.not-a-directory;io.is-a-directory;io.permission-denied;io.read-failed;io.write-failed;limit.line-too-long;limit.header-too-large;limit.record-too-large;limit.output-too-large;limit.too-many-rows;limit.too-many-sort-rows;limit.too-many-groups;limit.too-many-distinct;limit.state-too-large;parse.csv-ragged-row;parse.csv-bad-quote;parse.csv-unterminated-quote;select.unknown-column;select.ambiguous-column;column.unknown;column.ambiguous;where.syntax;where.mixed-and-or;agg.bad-spec;sort.unknown-key;value.not-integer;value.integer-overflow;value.not-decimal;value.decimal-scale;value.decimal-too-wide;column.type-conflict;value.not-float;value.not-finite;value.float-range;limit.number-too-long;agg.float-overflow;query.syntax;query.mixed-and-or;query.unsupported;query.group-mismatch;query.too-long;input.fields-required;input.bad-fields;parse.jsonl-syntax;parse.jsonl-not-object;parse.jsonl-missing-field;parse.jsonl-not-scalar;parse.jsonl-duplicate-key;limit.json-too-many-nodes;output.duplicate-column;output.not-representable;join.column-collision;limit.too-many-join-rows", extra_rules: finish.extra(), limits: "threads|1|64;chunk-bytes|4194304|1073741824;parallel-min-bytes|1048576|1073741824;limit|1000|1000000;max-bytes|1048576|67108864;max-groups|100000|1000000;max-distinct|100000|10000000;max-state-bytes|67108864|1073741824;max-sort-rows|1000000|20000000;max-rows|10000000|1000000000;max-line-bytes|1048576|16777216;max-json-nodes|4096|1048576;discover-lines|1000|1000000;max-fields|256|4096;max-join-rows|10000000|1000000000", reversibility: "reversible-cheap", stdin: "when FILE is - or absent", guarantees: "deterministic;idempotent;bounded_memory" };
}

fn built() -> [] describe.Built {
    return describe.Built { authority: built.authority(), schema: built.schema(), compiler: built.compiler() };
}

fn row_ceiling() -> [] int {
    return 1000000000;
}

// The delimiter byte `--delimiter` names, or -1.
fn delimiter_of[&t](given: &t [byte]) -> [] int {
    if bytes.equal(given, "tab") || len(given) == 1 && int_of(given[0]) == 9 {
        return 9;
    }
    if len(given) == 1 && (int_of(given[0]) == ',' || int_of(given[0]) == ';') {
        return int_of(given[0]);
    }
    return 0 - 1;
}

// Read the open file. Mode 0 counts (the shape); mode 1 writes the rows the plan
// selects and keeps, mode 2 counts them into groups and writes the groups: as
// csv straight to standard output, as json into the buffer answered third (the
// second is the answer's `columns` array text). Answers what was counted, those
// two buffers, the header's names and where each ends, and the errors.
fn read_file[&h, &g, &p, &f, &s, &i, &q, &fs, &rt, &rl, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, file: &!f File, shown: &s [byte], io: &!i Io, fs: &fs Fs(""), root: &rt [byte], rel: &rl [byte], full: &fu [byte], delim: int, mode: int, as_csv: bool, from: int, limit: int, budget: int, top: int, tree: &q query.Query, names_at: int, errs: fail.Errors) -> [heap, args, file_read, io_write, conc, fs_read(""), dir_read] (finish.Counts, buffer.Buffer, buffer.Buffer, buffer.Buffer, vec.Vec[int], fail.Errors) {
    let table = flag_table();
    let cap = cli.nat(args, parsed, table, "max-line-bytes");
    let most = cli.nat(args, parsed, table, "max-rows");
    var max_groups = cli.nat(args, parsed, table, "max-groups");
    let max_distinct = cli.nat(args, parsed, table, "max-distinct");
    let max_state = cli.nat(args, parsed, table, "max-state-bytes");
    let threads = cli.nat(args, parsed, table, "threads");
    let chunk = cli.nat(args, parsed, table, "chunk-bytes");
    let chunk_given = cli.has(parsed, table, "chunk-bytes");
    let min_bytes = cli.nat(args, parsed, table, "parallel-min-bytes");
    var sort = "";
    if cli.has(parsed, table, "sort") {
        sort = cli.text(args, parsed, table, "sort");
    }
    let filtering = query.count_of(tree, 1) > 0;
    let fast_ok = engine.fast_ok(tree);
    let ordering = query.count_of(tree, 4) > 0;
    let max_sort_rows = cli.nat(args, parsed, table, "max-sort-rows");
    // `--order-by` goes where the grouping goes: the rows are held in the groups' place (sorter.cho), and the bound on the groups is
    // the bound on the rows. The loop below is not told: a third thing to do with a row, there, made it 15 percent slower for the other two.
    var row_mode = mode;
    if ordering {
        row_mode = 2;
        max_groups = max_sort_rows;
    }
    // The rows of the answer that are wanted, when they are not all of them: a page (the one past it says there is
    // more) or `--top`. 0 is all of them, and also when twice that and one is past `--max-sort-rows`.
    var wanted = 0;
    if ordering {
        if limit < 100000000 {
            wanted = from + limit + 1;
        }
        if top > 0 && (wanted == 0 || top < wanted) {
            wanted = top;
        }
        if wanted > 0 && 2 * wanted + 1 > max_sort_rows {
            wanted = 0;
        }
    }
    // `--order-by` read by several threads (psort.cho): a whole sort written as csv. A page, `--top` or json is the sequential sort's (the rows it
    // wants are few, or it counts a budget in the order of the answer).
    let psortable = ordering && !query.reporting(tree) && as_csv && wanted == 0 && top == 0 && from == 0 && limit >= 100000000;
    // `from` pages the rows of a selection; for a grouping it pages the groups, after all
    // the rows have been counted, and must not skip any.
    var row_from = from;
    if mode == 2 || ordering {
        row_from = 0;
    }
    var e = errs;
    var names = buffer.empty(heap, 1);
    var hends = vec.empty(heap, 1, 0);
    var head = buffer.empty(heap, 1);
    var rows = buffer.empty(heap, 1);
    var scratch = buffer.empty(heap, 1);
    var escr = buffer.empty(heap, 16);
    var kept = buffer.empty(heap, 64);
    var groups = agg.start(heap, tree);
    var rec = buffer.empty(heap, 256);
    var cols = box_slice(heap, 1, 0);
    var cells = box_slice(heap, 3, 0);
    var sel = box_slice(heap, 1, 0);
    var labels = buffer.empty(heap, 1);
    var lends = vec.empty(heap, 1, 0);
    var tally = box_slice(heap, engine.k_size(), 0);
    var out_rows = buffer.empty(heap, 1);
    var out_kept = buffer.empty(heap, 1);
    var picked = 0;
    var header = false;
    var quoted = false;
    var seps = 0;
    var opened = 0;
    var r = lines.start(heap, cap);
    var going = true;
    var c = finish.Counts { columns: 0, records: 0, ragged: 0, first_row: 0, first_line: 0, first_found: 0, capped: false, abort: 0, abort_line: 0, long_length: 0, emitted: 0, more: false, next: 0, bad_name: 0, err_col: 0, err_fn: 0, err_row: 0, err_line: 0, err_cond: 0, err_digits: 0, groups: 0 };
    borrow mut tally as &!tw in {
        let a = contents(tw);
        while going {
            var status = 9;
            borrow mut r as &!rw in {
                status = scan.next_fast(rw);
            }
            if status == 9 {
                let (stepped, answer) = lines.next(heap, r);
                r = stepped;
                status = answer;
            }
            if status == lines.need() {
                r = lines.fill_file(r, file);
            } else if status == lines.done() {
                going = false;
            } else if status == lines.long() {
                a[engine.k_abort()] = 4;
                borrow r as &rr in {
                    a[engine.k_abort_line()] = lines.number(rr);
                    a[engine.k_long()] = lines.length(rr);
                }
                going = false;
            } else {
                borrow r as &rr in {
                    let number = lines.number(rr);
                    var line = lines.text(rr);
                    // A byte order mark belongs to the file, not to the first name.
                    if number == 1 && len(line) >= 3 && int_of(line[0]) == 239 && int_of(line[1]) == 187 && int_of(line[2]) == 191 {
                        line = line[3..len(line)];
                    }
                    let whole = line;
                    if len(line) > 0 && int_of(line[len(line) - 1]) == 13 {
                        line = line[0..len(line) - 1];
                    }
                    if !quoted && len(line) == 0 {
                        // A blank line between records is not a record.
                    } else if header && !quoted && a[engine.k_records()] >= most {
                        // A record past the bound: not read, so not judged.
                        a[engine.k_capped()] = 1;
                        going = false;
                    } else if header && !quoted && mode == 1 && !filtering && a[engine.k_records()] >= from && a[engine.k_emitted()] >= limit {
                        // The page is full and there is another record.
                        a[engine.k_more()] = 1;
                        a[engine.k_next()] = a[engine.k_records()];
                        going = false;
                    } else if header && !quoted {
                        // A data record begins; most are whole on this line.
                        var inside = false;
                        var found = 0;
                        var bad = false;
                        if mode != 0 {
                            borrow mut cells as &!cw in {
                                let (n, open, wrong) = reader.fields(line, delim, contents(cw), a[engine.k_columns()]);
                                found = n;
                                inside = open;
                                bad = wrong;
                            }
                        } else {
                            let (open, n, wrong) = reader.scan(line, delim, false, 0);
                            found = n + 1;
                            inside = open;
                            seps = n;
                            bad = wrong;
                        }
                        if bad {
                            a[engine.k_abort()] = 1;
                            a[engine.k_abort_line()] = number;
                            going = false;
                        } else if inside {
                            quoted = true;
                            opened = number;
                            borrow mut rec as &!rw in {
                                buffer.clear(rw);
                            }
                            if mode != 0 {
                                rec = buffer.append(heap, rec, whole);
                                rec = buffer.push(heap, rec, byte_of(10));
                            }
                        } else if engine.count_row(a, found, number, row_from) && mode != 0 {
                            borrow cells as &cr in {
                                borrow sel as &sr in {
                                    borrow cols as &kr in {
                                        if row_mode == 1 {
                                            let (r2, s2, e2, k2) = engine.process_rows(heap, io, rows, scratch, escr, kept, tree, contents(kr), line, contents(cr), contents(sr), picked, delim, as_csv, budget, number, limit, a);
                                            rows = r2;
                                            scratch = s2;
                                            escr = e2;
                                            kept = k2;
                                        } else {
                                            var hot = 1;
                                            if !fast_ok {
                                                // a distinct count is not added in place: `process_groups`
                                            } else if !filtering {
                                                var got = 1;
                                                borrow mut groups as &!gw in {
                                                    got = engine.group_plain(gw, tree, contents(kr), line, contents(cr));
                                                }
                                                if got >= 16 {
                                                    kept = engine.group_refused(heap, kept, tree, contents(kr), line, contents(cr), number, got, a);
                                                    hot = 0;
                                                } else {
                                                    hot = got;
                                                }
                                            } else {
                                                borrow mut groups as &!gw in {
                                                    let (f2, e2, k2) = engine.group_fast(heap, gw, escr, kept, tree, contents(kr), line, contents(cr), number, a);
                                                    hot = f2;
                                                    escr = e2;
                                                    kept = k2;
                                                }
                                            }
                                            if hot == 1 || hot == 3 {
                                                let (g2, e2, k2) = engine.process_groups(heap, groups, escr, kept, tree, contents(kr), line, contents(cr), number, max_groups, max_distinct, max_state, hot == 3, a);
                                                groups = g2;
                                                escr = e2;
                                                kept = k2;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        // The header, or the rest of a record that has quotes open: kept.
                        if !quoted {
                            opened = number;
                            borrow mut rec as &!rw in {
                                buffer.clear(rw);
                            }
                            seps = 0;
                        }
                        let (inside, n, bad) = reader.scan(line, delim, quoted, seps);
                        seps = n;
                        if !header || mode != 0 {
                            rec = buffer.append(heap, rec, whole);
                        }
                        var held = 0;
                        borrow rec as &rw in {
                            held = buffer.size(rw);
                        }
                        if bad {
                            a[engine.k_abort()] = 1;
                            a[engine.k_abort_line()] = number;
                            going = false;
                        } else if inside {
                            quoted = true;
                            if !header || mode != 0 {
                                rec = buffer.push(heap, rec, byte_of(10));
                            }
                            if held + 1 > cap {
                                a[engine.k_abort()] = 3;
                                if header {
                                    a[engine.k_abort()] = 7;
                                }
                                a[engine.k_abort_line()] = opened;
                                going = false;
                            }
                        } else {
                            quoted = false;
                            seps = 0;
                            if !header {
                                buffer.drop(heap, names);
                                vec.drop(heap, hends);
                                borrow rec as &rw in {
                                    let (nm, en) = reader.split_header(heap, buffer.bytes(rw), delim);
                                    names = nm;
                                    hends = en;
                                }
                                header = true;
                                borrow hends as &er in {
                                    a[engine.k_columns()] = vec.size(er);
                                }
                                if mode != 0 {
                                    var made = frame.none(heap);
                                    frame.drop(heap, made);
                                    borrow names as &nr in {
                                        borrow hends as &er in {
                                            made = frame.prepare(heap, tree, nr, er, a[engine.k_columns()], mode, delim, sort);
                                        }
                                    }
                                    let frame.Frame { fcols, fsel, fcells, fhead, flead, flabels, flends, fpicked, fabort, fbad, fsort_field, fsort_slot, fdesc } = made;
                                    unbox_slice(heap, cols);
                                    unbox_slice(heap, sel);
                                    unbox_slice(heap, cells);
                                    buffer.drop(heap, head);
                                    buffer.drop(heap, labels);
                                    vec.drop(heap, lends);
                                    cols = fcols;
                                    sel = fsel;
                                    cells = fcells;
                                    head = finish.report_head(heap, query.reporting(tree), fhead);
                                    labels = flabels;
                                    lends = flends;
                                    picked = fpicked;
                                    a[engine.k_sort_field()] = fsort_field;
                                    a[engine.k_sort_slot()] = fsort_slot;
                                    a[engine.k_sort_desc()] = fdesc;
                                    if ordering && !query.reporting(tree) && fabort == 0 {
                                        let nk = query.order_count(tree);
                                        var okeys = box_slice(heap, 3 * nk + 1, 0);
                                        borrow mut okeys as &!ow in {
                                            borrow cols as &cr in {
                                                var j = 0;
                                                while j < nk {
                                                    contents(ow)[3 * j] = contents(cr)[query.order_name(tree, j)];
                                                    contents(ow)[3 * j + 1] = query.order_flags(tree, j) % 2;
                                                    contents(ow)[3 * j + 2] = query.order_flags(tree, j) / 2;
                                                    j = j + 1;
                                                }
                                            }
                                        }
                                        borrow okeys as &okr in {
                                            groups = sorter.configure(groups, nk, wanted, max_sort_rows, max_state, contents(okr));
                                        }
                                        unbox_slice(heap, okeys);
                                    }
                                    if fabort != 0 {
                                        a[engine.k_abort()] = fabort;
                                        a[engine.k_bad_name()] = fbad;
                                        going = false;
                                    }
                                    if as_csv && fabort == 0 {
                                        rows = finish.start_output(heap, rows, finish.report_lead(heap, query.reporting(tree), flead, delim));
                                    } else {
                                        buffer.drop(heap, flead);
                                    }
                                }
                                // The rest of the file, by several threads, when that is asked for and
                                // worth it (par.cho): it leaves the tally, the output and the groups as
                                // this loop would have.
                                if mode != 0 && a[engine.k_abort()] == 0 && threads > 1 && (!ordering || query.reporting(tree) || psortable) && (mode == 2 || row_from == 0) {
                                    var size = 0;
                                    match file_size(file) {
                                        Done::Ok(n) => {
                                            size = n;
                                        }
                                        Done::Failed(reason) => {
                                            size = 0;
                                        }
                                    }
                                    var at = 0;
                                    var lines_so_far = 0;
                                    borrow r as &rr in {
                                        at = lines.consumed(rr);
                                        lines_so_far = lines.number(rr);
                                    }
                                    if size - at >= min_bytes && size - at > 0 {
                                        var pp = box_slice(heap, scan.p_count(), 0);
                                        borrow mut pp as &!pw in {
                                            let u = contents(pw);
                                            u[scan.p_delim()] = delim;
                                            u[scan.p_mode()] = mode;
                                            if query.reporting(tree) || ordering {
                                                u[scan.p_mode()] = 2;
                                            }
                                            if as_csv {
                                                u[scan.p_csv()] = 1;
                                                u[scan.p_yield()] = 65536;
                                            }
                                            u[scan.p_picked()] = picked;
                                            u[scan.p_budget()] = budget;
                                            u[scan.p_limit()] = limit;
                                            u[scan.p_most()] = most;
                                            u[scan.p_from()] = row_from;
                                            u[scan.p_max_groups()] = max_groups;
                                            u[scan.p_max_distinct()] = max_distinct;
                                            u[scan.p_max_state()] = max_state;
                                            u[scan.p_cap()] = cap;
                                            u[scan.p_base_line()] = lines_so_far;
                                            u[scan.p_size()] = size;
                                            borrow mut cells as &!cw in {
                                                borrow cols as &kr in {
                                                    borrow sel as &sr in {
                                                        let (r2, s2, e2, k2, g2) = par.run(heap, io, file, fs, root, rel, full, tree, contents(kr), contents(sr), contents(cw), a, u, rows, scratch, escr, kept, groups, at, lines_so_far, size, threads, chunk, chunk_given);
                                                        rows = r2;
                                                        scratch = s2;
                                                        escr = e2;
                                                        kept = k2;
                                                        groups = g2;
                                                    }
                                                }
                                            }
                                        }
                                        unbox_slice(heap, pp);
                                        going = false;
                                    }
                                }
                            } else {
                                // A data record that spanned lines, whole in `rec`.
                                var record_len = 0;
                                borrow rec as &rw in {
                                    record_len = buffer.size(rw);
                                    var record = buffer.bytes(rw);
                                    if record_len > 0 && int_of(record[record_len - 1]) == 13 {
                                        record = record[0..record_len - 1];
                                    }
                                    var found = n + 1;
                                    var wrong = false;
                                    if mode != 0 {
                                        borrow mut cells as &!cw in {
                                            let (n, open, bad_quote) = reader.fields(record, delim, contents(cw), a[engine.k_columns()]);
                                            found = n;
                                            wrong = bad_quote || open;
                                        }
                                    }
                                    if wrong {
                                        a[engine.k_abort()] = 1;
                                        a[engine.k_abort_line()] = opened;
                                        going = false;
                                    } else if engine.count_row(a, found, opened, row_from) && mode != 0 {
                                        borrow cells as &cr in {
                                            borrow sel as &sr in {
                                                borrow cols as &kr in {
                                                    if row_mode == 1 {
                                                        let (r2, s2, e2, k2) = engine.process_rows(heap, io, rows, scratch, escr, kept, tree, contents(kr), record, contents(cr), contents(sr), picked, delim, as_csv, budget, opened, limit, a);
                                                        rows = r2;
                                                        scratch = s2;
                                                        escr = e2;
                                                        kept = k2;
                                                    } else {
                                                        var hot = 1;
                                                        if !fast_ok {
                                                            // a distinct count is not added in place: `process_groups`
                                                        } else if !filtering {
                                                            var got = 1;
                                                            borrow mut groups as &!gw in {
                                                                got = engine.group_plain(gw, tree, contents(kr), record, contents(cr));
                                                            }
                                                            if got >= 16 {
                                                                kept = engine.group_refused(heap, kept, tree, contents(kr), record, contents(cr), opened, got, a);
                                                                hot = 0;
                                                            } else {
                                                                hot = got;
                                                            }
                                                        } else {
                                                            borrow mut groups as &!gw in {
                                                                let (f2, e2, k2) = engine.group_fast(heap, gw, escr, kept, tree, contents(kr), record, contents(cr), opened, a);
                                                                hot = f2;
                                                                escr = e2;
                                                                kept = k2;
                                                            }
                                                        }
                                                        if hot == 1 || hot == 3 {
                                                            let (g2, e2, k2) = engine.process_groups(heap, groups, escr, kept, tree, contents(kr), record, contents(cr), opened, max_groups, max_distinct, max_state, hot == 3, a);
                                                            groups = g2;
                                                            escr = e2;
                                                            kept = k2;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if a[engine.k_stop()] == 1 {
                    going = false;
                }
            }
        }
        // No header at all: no column to name.
        if mode != 0 && !header && a[engine.k_abort()] == 0 {
            a[engine.k_abort()] = 5;
        }
        // The end of the input with a quote open: not a record.
        if quoted && a[engine.k_abort()] == 0 {
            a[engine.k_abort()] = 2;
            a[engine.k_abort_line()] = opened;
        }
        var finished = rows;
        var spare = scratch;
        if mode == 2 && a[engine.k_abort()] == 0 && a[engine.k_done()] == 0 {
            borrow cols as &kr in {
                let (g2, k2) = finish.settle_groups(heap, groups, kept, tree, contents(kr), a);
                groups = g2;
                kept = k2;
            }
            if a[engine.k_abort()] == 0 {
                borrow groups as &gr in {
                    borrow sel as &sr0 in {
                        let (r2, s2) = finish.finish_groups(heap, io, finished, spare, gr, tree, contents(sr0), as_csv, delim, from, limit, top, budget, a);
                        finished = r2;
                        spare = s2;
                    }
                    if a[engine.k_total()] > 0 {
                        a[engine.k_groups()] = a[engine.k_total()];
                    }
                }
            }
        }
        if query.reporting(tree) && a[engine.k_abort()] == 0 {
            borrow names as &nr in {
                borrow hends as &er3 in {
                    borrow cols as &kr in {
                        let (r2, s2, g2) = finish.finish_report(heap, io, finished, spare, groups, tree, nr, er3, contents(kr), max_state, as_csv, delim, from, limit, budget, a);
                        finished = r2;
                        spare = s2;
                        groups = g2;
                    }
                }
            }
        } else if ordering && a[engine.k_abort()] == 0 && a[engine.k_psorted()] == 0 {
            borrow groups as &hr in {
                borrow mut cells as &!cw in {
                    borrow sel as &sr in {
                        let (r2, s2) = finish.finish_sort(heap, io, finished, spare, hr, contents(sr), contents(cw), picked, as_csv, delim, from, limit, top, budget, a);
                        finished = r2;
                        spare = s2;
                    }
                }
            }
        }
        agg.drop(heap, groups);
        buffer.drop(heap, escr);
        buffer.drop(heap, spare);
        buffer.drop(heap, out_rows);
        buffer.drop(heap, out_kept);
        out_rows = finished;
        out_kept = kept;
        c = finish.Counts { columns: a[engine.k_columns()], records: a[engine.k_records()], ragged: a[engine.k_ragged()], first_row: a[engine.k_first_row()], first_line: a[engine.k_first_line()], first_found: a[engine.k_first_found()], capped: a[engine.k_capped()] == 1, abort: a[engine.k_abort()], abort_line: a[engine.k_abort_line()], long_length: a[engine.k_long()], emitted: a[engine.k_emitted()], more: a[engine.k_more()] == 1, next: a[engine.k_next()], bad_name: a[engine.k_bad_name()], err_col: a[engine.k_err_col()], err_fn: a[engine.k_err_fn()], err_row: a[engine.k_err_row()], err_line: a[engine.k_err_line()], err_cond: a[engine.k_err_cond()], err_digits: a[engine.k_err_digits()], groups: a[engine.k_groups()] };
    }
    unbox_slice(heap, tally);
    unbox_slice(heap, cells);
    unbox_slice(heap, sel);
    unbox_slice(heap, cols);
    buffer.drop(heap, rec);
    var errno = 0;
    borrow r as &rr in {
        errno = lines.failed(rr);
    }
    lines.drop(heap, r);
    // What csv still had pending, written now unless the stream already failed.
    if as_csv && c.abort != 9 {
        let (after, ok) = engine.flush_last(io, out_rows);
        out_rows = after;
        if !ok {
            c = finish.Counts { columns: c.columns, records: c.records, ragged: c.ragged, first_row: c.first_row, first_line: c.first_line, first_found: c.first_found, capped: c.capped, abort: 9, abort_line: 0, long_length: 0, emitted: c.emitted, more: c.more, next: c.next, bad_name: c.bad_name, err_col: 0, err_fn: 0, err_row: 0, err_line: 0, err_cond: 0, err_digits: 0, groups: c.groups };
        }
    }
    borrow names as &nr in {
        borrow hends as &er3 in {
            borrow labels as &lr in {
                borrow lends as &le in {
                    borrow out_kept as &kr in {
                        e = finish.explain(heap, args, parsed, tree, nr, er3, lr, le, kr, c, shown, names_at, errno, as_csv, budget, e);
                    }
                }
            }
        }
    }
    buffer.drop(heap, labels);
    vec.drop(heap, lends);
    buffer.drop(heap, out_kept);
    return (c, head, out_rows, names, hends, e);
}

// BEGIN read_stream: made from read_file by scripts/stream.py, do not edit (python3 scripts/stream.py --check)
// The read loop for standard input: `read_file` (above) with the refill from `bulk.fill_stdin`, the partitioned read cut out and the row of a pipe. Called for the input `-`
// or none (`read_any`); `file` is the empty file that stands in for the input, and is read only to say that the input has ended.
fn read_stream[&h, &g, &p, &f, &s, &i, &q, &fs, &rt, &rl, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, file: &!f File, shown: &s [byte], io: &!i Io, fs: &fs Fs(""), root: &rt [byte], rel: &rl [byte], full: &fu [byte], delim: int, mode: int, as_csv: bool, from: int, limit: int, budget: int, top: int, tree: &q query.Query, names_at: int, errs: fail.Errors) -> [heap, args, file_read, io_read, io_write] (finish.Counts, buffer.Buffer, buffer.Buffer, buffer.Buffer, vec.Vec[int], fail.Errors) {
    let table = flag_table();
    let cap = cli.nat(args, parsed, table, "max-line-bytes");
    let most = cli.nat(args, parsed, table, "max-rows");
    var max_groups = cli.nat(args, parsed, table, "max-groups");
    let max_distinct = cli.nat(args, parsed, table, "max-distinct");
    let max_state = cli.nat(args, parsed, table, "max-state-bytes");
    let threads = cli.nat(args, parsed, table, "threads");
    let chunk = cli.nat(args, parsed, table, "chunk-bytes");
    let chunk_given = cli.has(parsed, table, "chunk-bytes");
    let min_bytes = cli.nat(args, parsed, table, "parallel-min-bytes");
    var sort = "";
    if cli.has(parsed, table, "sort") {
        sort = cli.text(args, parsed, table, "sort");
    }
    let filtering = query.count_of(tree, 1) > 0;
    let fast_ok = engine.fast_ok(tree);
    let ordering = query.count_of(tree, 4) > 0;
    let max_sort_rows = cli.nat(args, parsed, table, "max-sort-rows");
    // `--order-by` goes where the grouping goes: the rows are held in the groups' place (sorter.cho), and the bound on the groups is
    // the bound on the rows. The loop below is not told: a third thing to do with a row, there, made it 15 percent slower for the other two.
    var row_mode = mode;
    if ordering {
        row_mode = 2;
        max_groups = max_sort_rows;
    }
    // The rows of the answer that are wanted, when they are not all of them: a page (the one past it says there is
    // more) or `--top`. 0 is all of them, and also when twice that and one is past `--max-sort-rows`.
    var wanted = 0;
    if ordering {
        if limit < 100000000 {
            wanted = from + limit + 1;
        }
        if top > 0 && (wanted == 0 || top < wanted) {
            wanted = top;
        }
        if wanted > 0 && 2 * wanted + 1 > max_sort_rows {
            wanted = 0;
        }
    }
    // `--order-by` read by several threads (psort.cho): a whole sort written as csv. A page, `--top` or json is the sequential sort's (the rows it
    // wants are few, or it counts a budget in the order of the answer).
    let psortable = ordering && !query.reporting(tree) && as_csv && wanted == 0 && top == 0 && from == 0 && limit >= 100000000;
    // `from` pages the rows of a selection; for a grouping it pages the groups, after all
    // the rows have been counted, and must not skip any.
    var row_from = from;
    if mode == 2 || ordering {
        row_from = 0;
    }
    var e = errs;
    var names = buffer.empty(heap, 1);
    var hends = vec.empty(heap, 1, 0);
    var head = buffer.empty(heap, 1);
    var rows = buffer.empty(heap, 1);
    var scratch = buffer.empty(heap, 1);
    var escr = buffer.empty(heap, 16);
    var kept = buffer.empty(heap, 64);
    var groups = agg.start(heap, tree);
    var rec = buffer.empty(heap, 256);
    var cols = box_slice(heap, 1, 0);
    var cells = box_slice(heap, 3, 0);
    var sel = box_slice(heap, 1, 0);
    var labels = buffer.empty(heap, 1);
    var lends = vec.empty(heap, 1, 0);
    var tally = box_slice(heap, engine.k_size(), 0);
    var out_rows = buffer.empty(heap, 1);
    var out_kept = buffer.empty(heap, 1);
    var picked = 0;
    var header = false;
    var quoted = false;
    var seps = 0;
    var opened = 0;
    var r = lines.start(heap, cap);
    var going = true;
    var c = finish.Counts { columns: 0, records: 0, ragged: 0, first_row: 0, first_line: 0, first_found: 0, capped: false, abort: 0, abort_line: 0, long_length: 0, emitted: 0, more: false, next: 0, bad_name: 0, err_col: 0, err_fn: 0, err_row: 0, err_line: 0, err_cond: 0, err_digits: 0, groups: 0 };
    borrow mut tally as &!tw in {
        let a = contents(tw);
        while going {
            var status = 9;
            borrow mut r as &!rw in {
                status = scan.next_fast(rw);
            }
            if status == 9 {
                let (stepped, answer) = lines.next(heap, r);
                r = stepped;
                status = answer;
            }
            if status == lines.need() {
                var length = 0;
                borrow r as &rr in {
                    length = lines.length(rr);
                }
                if length > finish.line_ceiling() {
                    r = lines.fill_file(r, file);
                } else {
                    r = bulk.fill_stdin(r, io);
                }
            } else if status == lines.done() {
                going = false;
            } else if status == lines.long() {
                a[engine.k_abort()] = 4;
                borrow r as &rr in {
                    a[engine.k_abort_line()] = lines.number(rr);
                    a[engine.k_long()] = lines.length(rr);
                }
                going = false;
            } else {
                borrow r as &rr in {
                    let number = lines.number(rr);
                    var line = lines.text(rr);
                    // A byte order mark belongs to the file, not to the first name.
                    if number == 1 && len(line) >= 3 && int_of(line[0]) == 239 && int_of(line[1]) == 187 && int_of(line[2]) == 191 {
                        line = line[3..len(line)];
                    }
                    let whole = line;
                    if len(line) > 0 && int_of(line[len(line) - 1]) == 13 {
                        line = line[0..len(line) - 1];
                    }
                    if !quoted && len(line) == 0 {
                        // A blank line between records is not a record.
                    } else if header && !quoted && a[engine.k_records()] >= most {
                        // A record past the bound: not read, so not judged.
                        a[engine.k_capped()] = 1;
                        going = false;
                    } else if header && !quoted && mode == 1 && !filtering && a[engine.k_records()] >= from && a[engine.k_emitted()] >= limit {
                        // The page is full and there is another record.
                        a[engine.k_more()] = 1;
                        a[engine.k_next()] = a[engine.k_records()];
                        going = false;
                    } else if header && !quoted {
                        // A data record begins; most are whole on this line.
                        var inside = false;
                        var found = 0;
                        var bad = false;
                        if mode != 0 {
                            borrow mut cells as &!cw in {
                                let (n, open, wrong) = reader.fields(line, delim, contents(cw), a[engine.k_columns()]);
                                found = n;
                                inside = open;
                                bad = wrong;
                            }
                        } else {
                            let (open, n, wrong) = reader.scan(line, delim, false, 0);
                            found = n + 1;
                            inside = open;
                            seps = n;
                            bad = wrong;
                        }
                        if bad {
                            a[engine.k_abort()] = 1;
                            a[engine.k_abort_line()] = number;
                            going = false;
                        } else if inside {
                            quoted = true;
                            opened = number;
                            borrow mut rec as &!rw in {
                                buffer.clear(rw);
                            }
                            if mode != 0 {
                                rec = buffer.append(heap, rec, whole);
                                rec = buffer.push(heap, rec, byte_of(10));
                            }
                        } else if engine.count_row(a, found, number, row_from) && mode != 0 {
                            borrow cells as &cr in {
                                borrow sel as &sr in {
                                    borrow cols as &kr in {
                                        if row_mode == 1 {
                                            let (r2, s2, e2, k2) = engine.process_rows(heap, io, rows, scratch, escr, kept, tree, contents(kr), line, contents(cr), contents(sr), picked, delim, as_csv, budget, number, limit, a);
                                            rows = r2;
                                            scratch = s2;
                                            escr = e2;
                                            kept = k2;
                                        } else {
                                            var hot = 1;
                                            if !fast_ok {
                                                // a distinct count is not added in place: `process_groups`
                                            } else if !filtering {
                                                var got = 1;
                                                borrow mut groups as &!gw in {
                                                    got = engine.group_plain(gw, tree, contents(kr), line, contents(cr));
                                                }
                                                if got >= 16 {
                                                    kept = engine.group_refused(heap, kept, tree, contents(kr), line, contents(cr), number, got, a);
                                                    hot = 0;
                                                } else {
                                                    hot = got;
                                                }
                                            } else {
                                                borrow mut groups as &!gw in {
                                                    let (f2, e2, k2) = engine.group_fast(heap, gw, escr, kept, tree, contents(kr), line, contents(cr), number, a);
                                                    hot = f2;
                                                    escr = e2;
                                                    kept = k2;
                                                }
                                            }
                                            if hot == 1 || hot == 3 {
                                                let (g2, e2, k2) = engine.process_groups(heap, groups, escr, kept, tree, contents(kr), line, contents(cr), number, max_groups, max_distinct, max_state, hot == 3, a);
                                                groups = g2;
                                                escr = e2;
                                                kept = k2;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        // The header, or the rest of a record that has quotes open: kept.
                        if !quoted {
                            opened = number;
                            borrow mut rec as &!rw in {
                                buffer.clear(rw);
                            }
                            seps = 0;
                        }
                        let (inside, n, bad) = reader.scan(line, delim, quoted, seps);
                        seps = n;
                        if !header || mode != 0 {
                            rec = buffer.append(heap, rec, whole);
                        }
                        var held = 0;
                        borrow rec as &rw in {
                            held = buffer.size(rw);
                        }
                        if bad {
                            a[engine.k_abort()] = 1;
                            a[engine.k_abort_line()] = number;
                            going = false;
                        } else if inside {
                            quoted = true;
                            if !header || mode != 0 {
                                rec = buffer.push(heap, rec, byte_of(10));
                            }
                            if held + 1 > cap {
                                a[engine.k_abort()] = 3;
                                if header {
                                    a[engine.k_abort()] = 7;
                                }
                                a[engine.k_abort_line()] = opened;
                                going = false;
                            }
                        } else {
                            quoted = false;
                            seps = 0;
                            if !header {
                                buffer.drop(heap, names);
                                vec.drop(heap, hends);
                                borrow rec as &rw in {
                                    let (nm, en) = reader.split_header(heap, buffer.bytes(rw), delim);
                                    names = nm;
                                    hends = en;
                                }
                                header = true;
                                borrow hends as &er in {
                                    a[engine.k_columns()] = vec.size(er);
                                }
                                if mode != 0 {
                                    var made = frame.none(heap);
                                    frame.drop(heap, made);
                                    borrow names as &nr in {
                                        borrow hends as &er in {
                                            made = frame.prepare(heap, tree, nr, er, a[engine.k_columns()], mode, delim, sort);
                                        }
                                    }
                                    let frame.Frame { fcols, fsel, fcells, fhead, flead, flabels, flends, fpicked, fabort, fbad, fsort_field, fsort_slot, fdesc } = made;
                                    unbox_slice(heap, cols);
                                    unbox_slice(heap, sel);
                                    unbox_slice(heap, cells);
                                    buffer.drop(heap, head);
                                    buffer.drop(heap, labels);
                                    vec.drop(heap, lends);
                                    cols = fcols;
                                    sel = fsel;
                                    cells = fcells;
                                    head = finish.report_head(heap, query.reporting(tree), fhead);
                                    labels = flabels;
                                    lends = flends;
                                    picked = fpicked;
                                    a[engine.k_sort_field()] = fsort_field;
                                    a[engine.k_sort_slot()] = fsort_slot;
                                    a[engine.k_sort_desc()] = fdesc;
                                    if ordering && !query.reporting(tree) && fabort == 0 {
                                        let nk = query.order_count(tree);
                                        var okeys = box_slice(heap, 3 * nk + 1, 0);
                                        borrow mut okeys as &!ow in {
                                            borrow cols as &cr in {
                                                var j = 0;
                                                while j < nk {
                                                    contents(ow)[3 * j] = contents(cr)[query.order_name(tree, j)];
                                                    contents(ow)[3 * j + 1] = query.order_flags(tree, j) % 2;
                                                    contents(ow)[3 * j + 2] = query.order_flags(tree, j) / 2;
                                                    j = j + 1;
                                                }
                                            }
                                        }
                                        borrow okeys as &okr in {
                                            groups = sorter.configure(groups, nk, wanted, max_sort_rows, max_state, contents(okr));
                                        }
                                        unbox_slice(heap, okeys);
                                    }
                                    if fabort != 0 {
                                        a[engine.k_abort()] = fabort;
                                        a[engine.k_bad_name()] = fbad;
                                        going = false;
                                    }
                                    if as_csv && fabort == 0 {
                                        rows = finish.start_output(heap, rows, finish.report_lead(heap, query.reporting(tree), flead, delim));
                                    } else {
                                        buffer.drop(heap, flead);
                                    }
                                }
                            } else {
                                // A data record that spanned lines, whole in `rec`.
                                var record_len = 0;
                                borrow rec as &rw in {
                                    record_len = buffer.size(rw);
                                    var record = buffer.bytes(rw);
                                    if record_len > 0 && int_of(record[record_len - 1]) == 13 {
                                        record = record[0..record_len - 1];
                                    }
                                    var found = n + 1;
                                    var wrong = false;
                                    if mode != 0 {
                                        borrow mut cells as &!cw in {
                                            let (n, open, bad_quote) = reader.fields(record, delim, contents(cw), a[engine.k_columns()]);
                                            found = n;
                                            wrong = bad_quote || open;
                                        }
                                    }
                                    if wrong {
                                        a[engine.k_abort()] = 1;
                                        a[engine.k_abort_line()] = opened;
                                        going = false;
                                    } else if engine.count_row(a, found, opened, row_from) && mode != 0 {
                                        borrow cells as &cr in {
                                            borrow sel as &sr in {
                                                borrow cols as &kr in {
                                                    if row_mode == 1 {
                                                        let (r2, s2, e2, k2) = engine.process_rows(heap, io, rows, scratch, escr, kept, tree, contents(kr), record, contents(cr), contents(sr), picked, delim, as_csv, budget, opened, limit, a);
                                                        rows = r2;
                                                        scratch = s2;
                                                        escr = e2;
                                                        kept = k2;
                                                    } else {
                                                        var hot = 1;
                                                        if !fast_ok {
                                                            // a distinct count is not added in place: `process_groups`
                                                        } else if !filtering {
                                                            var got = 1;
                                                            borrow mut groups as &!gw in {
                                                                got = engine.group_plain(gw, tree, contents(kr), record, contents(cr));
                                                            }
                                                            if got >= 16 {
                                                                kept = engine.group_refused(heap, kept, tree, contents(kr), record, contents(cr), opened, got, a);
                                                                hot = 0;
                                                            } else {
                                                                hot = got;
                                                            }
                                                        } else {
                                                            borrow mut groups as &!gw in {
                                                                let (f2, e2, k2) = engine.group_fast(heap, gw, escr, kept, tree, contents(kr), record, contents(cr), opened, a);
                                                                hot = f2;
                                                                escr = e2;
                                                                kept = k2;
                                                            }
                                                        }
                                                        if hot == 1 || hot == 3 {
                                                            let (g2, e2, k2) = engine.process_groups(heap, groups, escr, kept, tree, contents(kr), record, contents(cr), opened, max_groups, max_distinct, max_state, hot == 3, a);
                                                            groups = g2;
                                                            escr = e2;
                                                            kept = k2;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if a[engine.k_stop()] == 1 {
                    going = false;
                }
            }
        }
        // No header at all: no column to name.
        if mode != 0 && !header && a[engine.k_abort()] == 0 {
            a[engine.k_abort()] = 5;
        }
        // The end of the input with a quote open: not a record.
        if quoted && a[engine.k_abort()] == 0 {
            a[engine.k_abort()] = 2;
            a[engine.k_abort_line()] = opened;
        }
        var finished = rows;
        var spare = scratch;
        if mode == 2 && a[engine.k_abort()] == 0 && a[engine.k_done()] == 0 {
            borrow cols as &kr in {
                let (g2, k2) = finish.settle_groups(heap, groups, kept, tree, contents(kr), a);
                groups = g2;
                kept = k2;
            }
            if a[engine.k_abort()] == 0 {
                borrow groups as &gr in {
                    borrow sel as &sr0 in {
                        let (r2, s2) = finish.finish_groups(heap, io, finished, spare, gr, tree, contents(sr0), as_csv, delim, from, limit, top, budget, a);
                        finished = r2;
                        spare = s2;
                    }
                    if a[engine.k_total()] > 0 {
                        a[engine.k_groups()] = a[engine.k_total()];
                    }
                }
            }
        }
        if query.reporting(tree) && a[engine.k_abort()] == 0 {
            borrow names as &nr in {
                borrow hends as &er3 in {
                    borrow cols as &kr in {
                        let (r2, s2, g2) = finish.finish_report(heap, io, finished, spare, groups, tree, nr, er3, contents(kr), max_state, as_csv, delim, from, limit, budget, a);
                        finished = r2;
                        spare = s2;
                        groups = g2;
                    }
                }
            }
        } else if ordering && a[engine.k_abort()] == 0 && a[engine.k_psorted()] == 0 {
            borrow groups as &hr in {
                borrow mut cells as &!cw in {
                    borrow sel as &sr in {
                        let (r2, s2) = finish.finish_sort(heap, io, finished, spare, hr, contents(sr), contents(cw), picked, as_csv, delim, from, limit, top, budget, a);
                        finished = r2;
                        spare = s2;
                    }
                }
            }
        }
        agg.drop(heap, groups);
        buffer.drop(heap, escr);
        buffer.drop(heap, spare);
        buffer.drop(heap, out_rows);
        buffer.drop(heap, out_kept);
        out_rows = finished;
        out_kept = kept;
        c = finish.Counts { columns: a[engine.k_columns()], records: a[engine.k_records()], ragged: a[engine.k_ragged()], first_row: a[engine.k_first_row()], first_line: a[engine.k_first_line()], first_found: a[engine.k_first_found()], capped: a[engine.k_capped()] == 1, abort: a[engine.k_abort()], abort_line: a[engine.k_abort_line()], long_length: a[engine.k_long()], emitted: a[engine.k_emitted()], more: a[engine.k_more()] == 1, next: a[engine.k_next()], bad_name: a[engine.k_bad_name()], err_col: a[engine.k_err_col()], err_fn: a[engine.k_err_fn()], err_row: a[engine.k_err_row()], err_line: a[engine.k_err_line()], err_cond: a[engine.k_err_cond()], err_digits: a[engine.k_err_digits()], groups: a[engine.k_groups()] };
    }
    unbox_slice(heap, tally);
    unbox_slice(heap, cells);
    unbox_slice(heap, sel);
    unbox_slice(heap, cols);
    buffer.drop(heap, rec);
    var errno = 0;
    borrow r as &rr in {
        errno = lines.failed(rr);
    }
    lines.drop(heap, r);
    // What csv still had pending, written now unless the stream already failed.
    if as_csv && c.abort != 9 {
        let (after, ok) = engine.flush_last(io, out_rows);
        out_rows = after;
        if !ok {
            c = finish.Counts { columns: c.columns, records: c.records, ragged: c.ragged, first_row: c.first_row, first_line: c.first_line, first_found: c.first_found, capped: c.capped, abort: 9, abort_line: 0, long_length: 0, emitted: c.emitted, more: c.more, next: c.next, bad_name: c.bad_name, err_col: 0, err_fn: 0, err_row: 0, err_line: 0, err_cond: 0, err_digits: 0, groups: c.groups };
        }
    }
    borrow names as &nr in {
        borrow hends as &er3 in {
            borrow labels as &lr in {
                borrow lends as &le in {
                    borrow out_kept as &kr in {
                        e = finish.explain(heap, args, parsed, tree, nr, er3, lr, le, kr, c, shown, names_at, errno, as_csv, budget, e);
                    }
                }
            }
        }
    }
    buffer.drop(heap, labels);
    vec.drop(heap, lends);
    buffer.drop(heap, out_kept);
    return (c, head, out_rows, names, hends, e);
}

// END read_stream

// The answer for the shape: `{"headers", "column_count", "row_count",
// "truncated"}` and its text form.
fn report_shape[&h, &n, &d](heap: &!h Heap, c: finish.Counts, names: &n buffer.Buffer, ends: &d vec.Vec[int]) -> [heap] (buffer.Buffer, buffer.Buffer) {
    var plain = buffer.empty(heap, 256 + buffer.size(names));
    var o = buffer.empty(heap, 256 + buffer.size(names) * 2);
    o = buffer.append(heap, o, "{\"headers\":[");
    plain = buffer.append(heap, plain, "rows\t");
    plain = buffer.push_nat(heap, plain, c.records);
    plain = buffer.append(heap, plain, "\ncolumns\t");
    plain = buffer.push_nat(heap, plain, c.columns);
    plain = buffer.append(heap, plain, "\ntruncated\t");
    if c.capped {
        plain = buffer.append(heap, plain, "true");
    } else {
        plain = buffer.append(heap, plain, "false");
    }
    plain = buffer.append(heap, plain, "\nheader");
    var i = 0;
    var from = 0;
    while i < vec.size(ends) && c.columns > 0 {
        let to = vec.get(ends, i);
        let name = buffer.bytes(names)[from..to];
        if i > 0 {
            o = buffer.push(heap, o, byte_of(','));
        }
        o = text.append_json(heap, o, name);
        plain = buffer.push(heap, plain, byte_of(9));
        plain = buffer.append(heap, plain, name);
        from = to;
        i = i + 1;
    }
    plain = buffer.push(heap, plain, byte_of(10));
    o = buffer.append(heap, o, "],\"column_count\":");
    o = buffer.push_nat(heap, o, c.columns);
    o = buffer.append(heap, o, ",\"row_count\":");
    o = buffer.push_nat(heap, o, c.records);
    if c.capped {
        o = buffer.append(heap, o, ",\"truncated\":true}");
    } else {
        o = buffer.append(heap, o, ",\"truncated\":false}");
    }
    return (o, plain);
}

// The answer for rows or groups as json: `{"columns", "rows", "row_count",
// "truncated", "next"}`, and for groups also `"group_count"`.
fn report_select[&h, &a, &b](heap: &!h Heap, c: finish.Counts, head: &a buffer.Buffer, rows: &b buffer.Buffer, grouped: bool) -> [heap] buffer.Buffer {
    var o = buffer.empty(heap, 128 + buffer.size(head) + buffer.size(rows));
    o = buffer.append(heap, o, "{\"columns\":");
    o = buffer.append(heap, o, buffer.bytes(head));
    o = buffer.append(heap, o, ",\"rows\":[");
    o = buffer.append(heap, o, buffer.bytes(rows));
    o = buffer.append(heap, o, "],\"row_count\":");
    o = buffer.push_nat(heap, o, c.emitted);
    if c.more || c.capped {
        o = buffer.append(heap, o, ",\"truncated\":true,\"next\":");
    } else {
        o = buffer.append(heap, o, ",\"truncated\":false,\"next\":");
    }
    if c.more {
        o = buffer.append(heap, o, "{\"from\":");
        o = buffer.push_nat(heap, o, c.next);
        o = buffer.append(heap, o, "}");
    } else {
        o = buffer.append(heap, o, "null");
    }
    if grouped {
        o = buffer.append(heap, o, ",\"group_count\":");
        o = buffer.push_nat(heap, o, c.groups);
    }
    return buffer.push(heap, o, byte_of('}'));
}

// The loop that reads the input: for a join `jnread.read`, for JSON lines `jsonl.read`, for standard input `read_stream`, otherwise `read_file`.
fn read_any[&h, &g, &p, &f, &s, &i, &q, &fs, &rt, &rl, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, file: &!f File, stdin: bool, as_json: bool, joining: bool, shown: &s [byte], io: &!i Io, fs: &fs Fs(""), root: &rt [byte], rel: &rl [byte], full: &fu [byte], delim: int, mode: int, as_csv: bool, from: int, limit: int, budget: int, top: int, tree: &q query.Query, names_at: int, errs: fail.Errors) -> [heap, args, file_read, io_read, io_write, conc, fs_read(""), dir_read] (finish.Counts, buffer.Buffer, buffer.Buffer, buffer.Buffer, vec.Vec[int], fail.Errors) {
    if joining {
        return jnread.read(heap, args, parsed, file, stdin, shown, io, fs, root, delim, mode, as_csv, from, limit, budget, tree, names_at, errs);
    }
    if as_json {
        return jsonl.read(heap, args, parsed, file, stdin, shown, io, fs, root, rel, full, delim, mode, as_csv, from, limit, budget, top, tree, names_at, errs);
    }
    if stdin {
        return read_stream(heap, args, parsed, file, shown, io, fs, root, rel, full, delim, mode, as_csv, from, limit, budget, top, tree, names_at, errs);
    }
    return read_file(heap, args, parsed, file, shown, io, fs, root, rel, full, delim, mode, as_csv, from, limit, budget, top, tree, names_at, errs);
}

// Read the open input and make the answer of it: the page or the shape as a document (`payload`, `plain`), or, as csv, what `read_file` already wrote to
// standard output. `file` is closed here. With `stdin` the bytes come from standard input and `file` is an empty one, never read.
fn settle[&h, &g, &p, &s, &rt, &fu, &i, &fs, &q](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, explaining: bool, opened: File, stdin: bool, as_json: bool, joining: bool, shown: &s [byte], root: &rt [byte], full: &fu [byte], io: &!i Io, fs: &fs Fs(""), delim: int, mode: int, as_csv: bool, from: int, limit: int, budget: int, top: int, tree0: query.Query, names_at: int, errs: fail.Errors, payload0: buffer.Buffer, plain0: buffer.Buffer) -> [heap, args, io_read, io_write, conc, fs_read(""), dir_read] (query.Query, fail.Errors, buffer.Buffer, buffer.Buffer, bool) {
    if explaining {
        // `--explain`: the header is read and the plan resolved, and nothing else (explain.cho)
        if joining {
            let (t4, e4, d4) = jnexplain.settle(heap, args, parsed, fs, root, opened, stdin, shown, delim, mode, as_csv, from, limit, budget, top, tree0, names_at, errs, payload0);
            return (t4, e4, d4, plain0, false);
        }
        let (t3, e3, d3) = explain.settle(heap, args, parsed, opened, stdin, as_json, shown, delim, mode, as_csv, from, limit, budget, top, tree0, names_at, errs, payload0);
        return (t3, e3, d3, plain0, false);
    }
    if as_json && cli.has(parsed, flag_table(), "discover") {
        // `--discover`: what the first lines hold, as a report (jdisc.cho)
        var found = opened;
        var report = payload0;
        var refusals = errs;
        borrow mut found as &!handle in {
            let (after, doc) = jdisc.run(heap, args, parsed, handle, stdin, shown, io, refusals);
            refusals = after;
            buffer.drop(heap, report);
            report = doc;
        }
        file_close(found);
        return (tree0, refusals, report, plain0, false);
    }
    var e = errs;
    var tree = tree0;
    var payload = payload0;
    var plain = plain0;
    var streamed = false;
    var file = opened;
    borrow mut file as &!handle in {
        var wrote = 0;
        tree = query.with_page(heap, tree, top, from);
        borrow tree as &tq in {
            let (c, head, rows, names, hends, after) = read_any(heap, args, parsed, handle, stdin, as_json, joining, shown, io, fs, root, shown, full, delim, mode, as_csv, from, limit, budget, top, tq, names_at, e);
            e = after;
            // What was read is the answer unless the read had to
            // stop short of the end: a ragged row is an error
            // about rows that were all counted.
            streamed = as_csv;
            wrote = c.abort;
            if c.abort == 60 || c.abort == 61 {
                // the keys of a JSON-lines answer (finish.output_refusal): the plan is resolved again to name them
                var sort = "";
                if cli.has(parsed, flag_table(), "sort") {
                    sort = cli.text(args, parsed, flag_table(), "sort");
                }
                borrow names as &nr in {
                    borrow hends as &er2 in {
                        e = finish.output_refusal_run(heap, e, tq, nr, er2, c.columns, mode, delim, sort, c.abort);
                    }
                }
            }
            if c.abort == 0 && !as_csv {
                buffer.drop(heap, payload);
                buffer.drop(heap, plain);
                if mode != 0 {
                    borrow head as &hr in {
                        borrow rows as &wr in {
                            payload = report_select(heap, c, hr, wr, mode == 2);
                        }
                    }
                    plain = buffer.empty(heap, 1);
                } else {
                    borrow names as &nr in {
                        borrow hends as &er2 in {
                            let (d, t) = report_shape(heap, c, nr, er2);
                            payload = d;
                            plain = t;
                        }
                    }
                }
            }
            buffer.drop(heap, head);
            buffer.drop(heap, rows);
            buffer.drop(heap, names);
            vec.drop(heap, hends);
        }
        if wrote == 9 {
            streamed = false;
            e = fail.io_error(heap, e, 5, true, "standard output");
        }
    }
    file_close(file);
    return (tree, e, payload, plain, streamed);
}

// The plan, from the plan's values (`inp`, and the text of each list as the flags or a query's translation gave it), run: the checks of the flags, the `Query` they fill, the
// source, the read and the answer. It does not know where the values came from (docs/query.md, Q0): `body` hands it the flags' own, `query_body` a translation's.
fn plan_body[&h, &g, &p, &f, &i, &s1, &s2, &s3, &s4, &s5, &s6, &s7](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), io: &!i Io, errs: fail.Errors, inp: inputs.Inputs, select_t: &s1 [byte], where_t: &s2 [byte], group_t: &s3 [byte], agg_t: &s4 [byte], order_t: &s5 [byte], sort_t: &s6 [byte], source_t: &s7 [byte]) -> [heap, args, fs_read(""), dir_read, io_read, io_write, err_write, conc] int {
    let table = flag_table();
    var e = errs;
    let form = inp.format_text;
    let text_mode = bytes.equal(form, "text");
    let jsonl_out = bytes.equal(form, "jsonl");
    let as_csv = bytes.equal(form, "csv") || jsonl_out;
    let has_select = inp.has_select;
    let has_where = inp.has_where;
    let has_group = inp.has_group;
    let has_agg = inp.has_agg;
    let has_order = inp.has_order;
    let has_report = inp.has_report;
    let grouped = has_group || has_agg;
    var mode = 0;
    if grouped {
        mode = 2;
    } else if has_select || has_where || has_order || has_report || inp.has_rows || inp.has_join {
        mode = 1;
    }
    let delim = delimiter_of(cli.text(args, parsed, table, "delimiter"));
    if delim < 0 {
        e = flags.problem(heap, e, "args.bad-value", "--delimiter is a comma, tab or a semicolon", "--delimiter tab", "--delimiter");
    }
    if inp.jmention {
        e = jflags.check(heap, args, parsed, inp.jsonl, has_select || has_where || has_group || has_agg || has_order || has_report || inp.has_rows || inp.has_query || inp.has_explain || inp.has_sort || inp.has_top || inp.has_limit || inp.has_from, as_csv || text_mode, e);
    }
    if inp.join_mention {
        e = jnflags.check(heap, args, parsed, inp, grouped, e);
    }
    if inp.rows_n > row_ceiling() {
        e = flags.problem(heap, e, "args.bad-value", "--max-rows is above the ceiling", "1000000000 is the most this tool counts", "--max-rows");
    }
    if cli.nat(args, parsed, table, "max-line-bytes") > finish.line_ceiling() {
        e = flags.problem(heap, e, "args.bad-value", "--max-line-bytes is above the ceiling", "16777216 is the most this tool holds", "--max-line-bytes");
    }
    let groups_most = cli.nat(args, parsed, table, "max-groups");
    if groups_most < 1 || groups_most > 1000000 {
        e = flags.problem(heap, e, "args.bad-value", "--max-groups is from 1 to 1000000", "--max-groups 100000", "--max-groups");
    }
    let distinct_most = cli.nat(args, parsed, table, "max-distinct");
    if distinct_most < 1 || distinct_most > 10000000 {
        e = flags.problem(heap, e, "args.bad-value", "--max-distinct is from 1 to 10000000", "--max-distinct 100000", "--max-distinct");
    }
    let state_most = cli.nat(args, parsed, table, "max-state-bytes");
    if state_most < 1 || state_most > 1073741824 {
        e = flags.problem(heap, e, "args.bad-value", "--max-state-bytes is from 1 to 1073741824", "--max-state-bytes 67108864", "--max-state-bytes");
    }
    let sort_rows_most = cli.nat(args, parsed, table, "max-sort-rows");
    if sort_rows_most < 1 || sort_rows_most > 20000000 {
        e = flags.problem(heap, e, "args.bad-value", "--max-sort-rows is from 1 to 20000000", "--max-sort-rows 1000000", "--max-sort-rows");
    }
    let thread_count = cli.nat(args, parsed, table, "threads");
    if thread_count < 1 || thread_count > 64 {
        e = flags.problem(heap, e, "args.bad-value", "--threads is from 1 to 64", "--threads 4", "--threads");
    }
    let chunk_size = cli.nat(args, parsed, table, "chunk-bytes");
    if chunk_size < 1 || chunk_size > 1073741824 {
        e = flags.problem(heap, e, "args.bad-value", "--chunk-bytes is from 1 to 1073741824", "--chunk-bytes 4194304", "--chunk-bytes");
    }
    if cli.nat(args, parsed, table, "parallel-min-bytes") > 1073741824 {
        e = flags.problem(heap, e, "args.bad-value", "--parallel-min-bytes is at most 1073741824", "--parallel-min-bytes 1048576", "--parallel-min-bytes");
    }
    var budget = cli.nat(args, parsed, table, "max-bytes");
    if budget < 1 || budget > 67108864 {
        e = flags.problem(heap, e, "args.bad-value", "--max-bytes is from 1 to the ceiling", "67108864 is the most a page holds", "--max-bytes");
    }
    if jsonl_out {
        // JSON lines out (docs/readers.md section 13.2): a budget below 0 is how `emit_buf` is told, in the read and in every thread, with no parameter added to anything (a page budget is never
        // below 1, and csv never reads it)
        budget = -1;
    }
    var limit = 1000000000000000;
    if !as_csv {
        limit = 1000;
    }
    var from = 0;
    var top = 0;
    if inp.has_limit {
        limit = inp.limit_n;
        if limit < 1 || limit > 1000000 {
            e = flags.problem(heap, e, "args.bad-value", "--limit is from 1 to 1000000", "--limit 1000", "--limit");
        }
    }
    if inp.has_from {
        from = inp.from_n;
    }
    if inp.has_top {
        top = inp.top_n;
        if top < 1 {
            e = flags.problem(heap, e, "args.bad-value", "--top is at least 1", "--top 10", "--top");
        }
    }
    if mode == 0 {
        if jsonl_out {
            e = flags.problem(heap, e, "args.required-flag", "--format jsonl writes rows or groups, so it needs --select, --where or --group", "--select NAMES", "--format --select --where --group");
        } else if as_csv {
            e = flags.problem(heap, e, "args.required-flag", "--format csv writes rows or groups, so it needs --select, --where or --group", "--select NAMES", "--format --select --where --group");
        }
        if inp.has_limit || inp.has_from {
            e = flags.problem(heap, e, "args.required-flag", "--limit and --from page rows or groups, so they need --select, --where or --group", "--select NAMES", "--limit --from --select");
        }
    } else if text_mode {
        e = flags.problem(heap, e, "args.conflict", "--format text is for the shape; rows and groups are json or csv", "--format csv", "--format --select --where --group");
    }
    if grouped && has_select {
        e = flags.problem(heap, e, "args.conflict", "--select picks columns, and with --group or --agg the columns are the groups and the aggregates", "drop --select", "--select --group --agg");
    }
    if grouped && has_order {
        e = flags.problem(heap, e, "args.conflict", "--order-by sorts rows, and with --group or --agg the rows are counted into groups: order those with --sort and --top", "drop --order-by", "--order-by --group --agg");
    }
    if has_report {
        if !bytes.equal(inp.report_text, "types") {
            e = flags.problem(heap, e, "args.bad-value", "--report is types: the only report there is", "--report types", "--report");
        }
        if jsonl_out {
            e = flags.problem(heap, e, "args.conflict", "--report types is a table of its own, with the counts and the suggestions as strings: write it as --format json or csv", "--format csv", "--report --format");
        }
        if grouped || has_order || inp.has_sort || inp.has_top {
            e = flags.problem(heap, e, "args.conflict", "--report types describes the columns of the whole table: it is not a grouping, a sort or a cut of rows", "drop --group, --agg, --order-by, --sort or --top", "--report --group --agg --order-by --sort --top");
        }
    }
    if inp.has_rows && (has_select || has_where || grouped || has_order || has_report) {
        e = flags.problem(heap, e, "args.conflict", "--rows is every row and every column, with no condition, selection, grouping or order", "drop --rows, or drop the flags that say more", "--rows --select --where --group --agg --order-by --report");
    }
    if !has_report && !grouped && (inp.has_sort || inp.has_top && !has_order) {
        e = flags.problem(heap, e, "args.required-flag", "--sort orders groups and --top cuts groups or sorted rows, so they need --group, --agg or --order-by", "--group NAMES", "--sort --top --group");
    }
    // The plan.
    var tree = query.empty(heap);
    if has_select {
        let (t2, e2) = flags.add_names(heap, tree, e, select_t, 0, "--select");
        tree = t2;
        e = e2;
    }
    if has_where {
        let given = where_t;
        let (t2, what, at) = orparse.parse(heap, tree, given);
        tree = t2;
        if what == orparse.mixed() {
            e = wrepair.refuse(heap, e, given, at, args, inp.where_at, inp.where_whole);
        } else if what != 0 && inp.has_query {
            // a literal of the query that does not fit the type its column is read as: refused at the literal of the query
            e = qrefuse.literal_refusal(heap, e, inp.query_text, what, at);
        } else if what != 0 {
            var w = fail.open_in(heap, finish.extra(), "where.syntax", "--where is not an expression", "the grammar is in the help of --where: COLUMN OP VALUE joined by and");
            // an `or` of `=` and `in` on one column is one `in` (docs/or-and-columns.md section 7, slice A0): the same invocation with --where rewritten, offered only whole
            var offered = false;
            let where_at = inp.where_at;
            if what == 4 && where_at >= 0 {
                let (fixed, found) = expr.or_in(heap, given);
                if found {
                    var o = fail.choose_open(heap, w);
                    if inp.where_whole {
                        borrow fixed as &fr in {
                            o = fail.choose_option_replacing(heap, o, args, where_at, buffer.bytes(fr));
                        }
                    } else {
                        var joined = buffer.append(heap, buffer.empty(heap, 64), "--where=");
                        borrow fixed as &fr in {
                            joined = buffer.append(heap, joined, buffer.bytes(fr));
                        }
                        borrow joined as &jr in {
                            o = fail.choose_option_replacing(heap, o, args, where_at, buffer.bytes(jr));
                        }
                        buffer.drop(heap, joined);
                    }
                    w = fail.choose_close(heap, o);
                    offered = true;
                }
                buffer.drop(heap, fixed);
            }
            if !offered {
                w = fail.repair_none(heap, w, "what the expression was meant to say is not known");
            }
            w = fail.detail_open(heap, w);
            w = fail.detail_int(heap, w, "offset", at);
            w = fail.detail_str(heap, w, "expected", expr.expected(what));
            w = fail.detail_text(heap, w, "expression", given);
            e = fail.add(heap, e, w);
        }
    }
    if has_group {
        let (t2, e2) = flags.add_names(heap, tree, e, group_t, 2, "--group");
        tree = t2;
        e = e2;
    }
    if grouped {
        if has_agg {
            let given = agg_t;
            let (t2, bad) = agg.parse_aggs(heap, tree, given);
            tree = t2;
            if bad == -2 {
                e = flags.problem(heap, e, "args.bad-value", "--agg is items separated by commas, and a backslash escapes only a comma, a backslash or a #", "--agg count,sum:bytes", "--agg");
            } else if bad >= 0 {
                var w = fail.open_in(heap, finish.extra(), "agg.bad-spec", "an item of --agg is not count, sum:COL, min:COL, max:COL, mean:COL or distinct:COL, or its :int, :dec(S) or @N is not one that item takes", "--agg count,sum:bytes,max:bytes,distinct:status; a mean of an integer column needs its scale, mean:bytes@2; a decimal column is declared sum:price:dec(2)");
                w = fail.no_repair(heap, w);
                w = fail.detail_open(heap, w);
                w = fail.detail_int(heap, w, "item", bad);
                w = fail.detail_str(heap, w, "agg", given);
                e = fail.add(heap, e, w);
            }
        } else {
            tree = query.add_agg(heap, tree, 0, -1, 0, 0);
        }
    }
    if has_report {
        tree = query.set_reporting(heap, tree);
    }
    if has_order && !grouped && !has_report {
        let (t2, e2) = flags.add_order_keys(heap, tree, e, order_t);
        tree = t2;
        e = e2;
    }
    if inp.has_sort && inp.has_query {
        tree = query.set_sort(heap, tree, sort_t);
    }
    if jsonl_out {
        // JSON lines out (docs/readers.md section 13): the plan says so, to the frame and the writers (query.jsonl)
        tree = jout.set_jsonl(heap, tree);
    }
    let (root, after_root) = path.root(heap, args, inp.root_text, inp.root_at, e);
    e = after_root;
    if inp.operands > 1 {
        e = flags.problem(heap, e, "args.too-many-operands", "table takes one FILE", "read one file per call", "FILE");
    }
    var payload = buffer.empty(heap, 1);
    var plain = buffer.empty(heap, 1);
    var streamed = false;
    var refused = false;
    borrow e as &er in {
        refused = fail.count(er) > 0;
    }
    var names_at = -1;
    if inp.select_whole {
        names_at = inp.select_at;
    }
    if !refused {
        if inp.stdin {
            // Standard input: no path, no root (the MCP server always passes one). The descriptor is read in blocks (bulk.cho); the `File` that `read_file` is
            // typed with is an empty one (/dev/null), never read, and the answer names the input as `-`.
            match open_read(fs, "/dev/null") {
                Opened::Failed(reason) => {
                    e = fail.io_error(heap, e, reason, false, "-");
                }
                Opened::Ok(opened) => {
                    // (a join's build file is found beneath the root, so a pipe is given it too)
                    borrow root as &rr in {
                        let (t2, e2, d2, l2, s2) = settle(heap, args, parsed, inp.has_explain, opened, true, inp.jsonl, inp.has_join, "-", buffer.bytes(rr), "-", io, fs, delim, mode, as_csv, from, limit, budget, top, tree, names_at, e, payload, plain);
                        tree = t2;
                        e = e2;
                        payload = d2;
                        plain = l2;
                        streamed = s2;
                    }
                }
            }
        } else if inp.src_file {
            // A query's `from 'path'`: the path is checked as an operand is (qpath.cho), and opened beneath the root the same way.
            borrow root as &rr in {
                let (full, shown_at, checked) = qpath.resolve(heap, buffer.bytes(rr), source_t, e);
                e = checked;
                borrow full as &fr in {
                    if shown_at >= 0 {
                        let whole = buffer.bytes(fr);
                        let shown = whole[shown_at..len(whole)];
                        match place.open_operand(fs, buffer.bytes(rr), shown, whole) {
                            Opened::Failed(reason) => {
                                e = fail.io_error(heap, e, reason, false, shown);
                            }
                            Opened::Ok(opened) => {
                                let (t2, e2, d2, l2, s2) = settle(heap, args, parsed, inp.has_explain, opened, false, inp.jsonl, inp.has_join, shown, buffer.bytes(rr), whole, io, fs, delim, mode, as_csv, from, limit, budget, top, tree, names_at, e, payload, plain);
                                tree = t2;
                                e = e2;
                                payload = d2;
                                plain = l2;
                                streamed = s2;
                            }
                        }
                    }
                }
                buffer.drop(heap, full);
            }
        } else {
            borrow root as &rr in {
                let (target, checked) = path.operand(heap, args, buffer.bytes(rr), inp.source_at, e);
                e = checked;
                borrow target as &tp in {
                    if path.ok(tp) {
                        match place.open_operand(fs, buffer.bytes(rr), path.shown(tp), path.full(tp)) {
                            Opened::Failed(reason) => {
                                e = fail.io_error(heap, e, reason, false, path.shown(tp));
                            }
                            Opened::Ok(opened) => {
                                let (t2, e2, d2, l2, s2) = settle(heap, args, parsed, inp.has_explain, opened, false, inp.jsonl, inp.has_join, path.shown(tp), buffer.bytes(rr), path.full(tp), io, fs, delim, mode, as_csv, from, limit, budget, top, tree, names_at, e, payload, plain);
                                tree = t2;
                                e = e2;
                                payload = d2;
                                plain = l2;
                                streamed = s2;
                            }
                        }
                    }
                }
                path.drop(heap, target);
            }
        }
    }
    buffer.drop(heap, root);
    query.drop(heap, tree);
    var status = 0;
    // an explained plan is one JSON document whatever its format; its refusals are the run's (sentences for csv)
    var explained = false;
    if inp.has_explain {
        borrow e as &er in {
            explained = fail.count(er) == 0;
        }
    }
    if (streamed || as_csv) && !explained {
        // csv has no document: its errors are sentences on standard error and
        // the exit status says whether it is whole.
        borrow e as &er in {
            if fail.count(er) > 0 {
                out.say_errors(io, "table", er);
                status = fail.exit_code(er);
            }
        }
        if status == 0 && !out.flushed(io) {
            out.write_failed(io, "table");
            status = 1;
        }
    } else {
        borrow e as &er in {
            borrow payload as &d in {
                borrow plain as &t in {
                    status = out.respond(heap, io, "table", "table.v2", "0.3.0", buffer.bytes(d), "", er, text_mode && !explained, buffer.bytes(t), 0);
                }
            }
        }
    }
    buffer.drop(heap, payload);
    buffer.drop(heap, plain);
    fail.drop(heap, e);
    return status;
}

// The answer to a call that is refused before any plan is built: its errors, as the end of `plan_body` writes them.
fn refused_with[&h, &i](heap: &!h Heap, io: &!i Io, e: fail.Errors, as_csv: bool, text_mode: bool) -> [heap, io_write, err_write] int {
    var status = 0;
    if as_csv {
        borrow e as &er in {
            if fail.count(er) > 0 {
                out.say_errors(io, "table", er);
                status = fail.exit_code(er);
            }
        }
        if status == 0 && !out.flushed(io) {
            out.write_failed(io, "table");
            status = 1;
        }
    } else {
        let payload = buffer.empty(heap, 1);
        let plain = buffer.empty(heap, 1);
        borrow e as &er in {
            borrow payload as &d in {
                borrow plain as &t in {
                    status = out.respond(heap, io, "table", "table.v2", "0.3.0", buffer.bytes(d), "", er, text_mode, buffer.bytes(t), 0);
                }
            }
        }
        buffer.drop(heap, payload);
        buffer.drop(heap, plain);
    }
    fail.drop(heap, e);
    return status;
}

// `--query`: translated to the flags it stands for (docs/query.md), then run as `plan_body` runs the flags. A query says the plan, and the flags that say it too are refused.
fn query_body[&h, &g, &p, &f, &i](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), io: &!i Io, errs: fail.Errors, inp: inputs.Inputs) -> [heap, args, fs_read(""), dir_read, io_read, io_write, err_write, conc] int {
    let table = flag_table();
    var e = errs;
    let form = inp.format_text;
    let text_mode = bytes.equal(form, "text");
    let jsonl_out = bytes.equal(form, "jsonl");
    let as_csv = bytes.equal(form, "csv") || jsonl_out;
    let tr = qtrans.translate(heap, inp.query_text, false);
    var translated = 0;
    var limit_given = false;
    var from_given = false;
    var source = 0;
    borrow tr as &t in {
        translated = qtrans.status(t);
        limit_given = qtrans.info_at(t, qtrans.i_limit_given()) == 1;
        from_given = qtrans.info_at(t, qtrans.i_from_given()) == 1;
        source = qtrans.info_at(t, qtrans.i_source());
    }
    if translated != 0 {
        borrow tr as &t in {
            let (query_at, query_whole) = inputs.query_place(parsed, table);
            e = qrefuse.refuse(heap, e, inp.query_text, t, args, query_at, query_whole, inp.operands);
        }
        qtrans.drop(heap, tr);
        return refused_with(heap, io, e, as_csv, text_mode);
    }
    var clash = buffer.append(heap, buffer.empty(heap, 64), "--query");
    var clashed = false;
    if inp.has_select {
        clash = buffer.append(heap, clash, " --select");
        clashed = true;
    }
    if inp.has_where {
        clash = buffer.append(heap, clash, " --where");
        clashed = true;
    }
    if inp.has_group {
        clash = buffer.append(heap, clash, " --group");
        clashed = true;
    }
    if inp.has_agg {
        clash = buffer.append(heap, clash, " --agg");
        clashed = true;
    }
    if inp.has_sort {
        clash = buffer.append(heap, clash, " --sort");
        clashed = true;
    }
    if inp.has_order {
        clash = buffer.append(heap, clash, " --order-by");
        clashed = true;
    }
    if inp.has_rows {
        clash = buffer.append(heap, clash, " --rows");
        clashed = true;
    }
    if inp.has_report {
        clash = buffer.append(heap, clash, " --report");
        clashed = true;
    }
    if inp.has_join {
        clash = buffer.append(heap, clash, " --join");
        clashed = true;
    }
    if inp.has_limit && limit_given {
        clash = buffer.append(heap, clash, " --limit");
        clashed = true;
    }
    if inp.has_from && from_given {
        clash = buffer.append(heap, clash, " --from");
        clashed = true;
    }
    if inp.has_top && limit_given {
        clash = buffer.append(heap, clash, " --top");
        clashed = true;
    }
    if source != 0 && inp.operands > 0 {
        clash = buffer.append(heap, clash, " FILE");
        clashed = true;
    }
    if clashed {
        var w = fail.open(heap, "args.conflict", "--query says the plan: a flag or a FILE that says it too is another plan", "say it once, in the query (from 'FILE' is its file) or in the flags");
        w = fail.no_repair(heap, w);
        w = fail.detail_open(heap, w);
        borrow clash as &cr in {
            w = fail.detail_text(heap, w, "flags", buffer.bytes(cr));
        }
        e = fail.add(heap, e, w);
        buffer.drop(heap, clash);
        qtrans.drop(heap, tr);
        return refused_with(heap, io, e, as_csv, text_mode);
    }
    buffer.drop(heap, clash);
    var status = 0;
    borrow tr as &t in {
        let planned = inputs.for_query(inp, t);
        status = plan_body(heap, args, parsed, fs, io, e, planned, qtrans.section(t, 0), qtrans.section(t, 1), qtrans.section(t, 2), qtrans.section(t, 3), qtrans.section(t, 4), qtrans.section(t, 5), qtrans.section(t, 6));
    }
    qtrans.drop(heap, tr);
    return status;
}

fn body[&h, &g, &p, &f, &i](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), io: &!i Io, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, io_read, io_write, err_write, conc] int {
    let table = flag_table();
    let inp = inputs.from_flags(args, parsed, table);
    if inp.has_query {
        return query_body(heap, args, parsed, fs, io, errs, inp);
    }
    return plan_body(heap, args, parsed, fs, io, errs, inp, inp.select_text, inp.where_text, inp.group_text, inp.agg_text, inp.order_text, inp.sort_text, "");
}

fn run[&h, &g, &f, &i](heap: &!h Heap, args: &g Args, fs: &f Fs(""), io: &!i Io) -> [heap, args, fs_read(""), dir_read, io_read, io_write, err_write, conc] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, tool(), built());
    }
    let (parsed, e) = cli.parse(heap, args, flag_table(), fail.empty_in(heap, finish.extra()));
    var status = 0;
    borrow parsed as &p in {
        status = body(heap, args, p, fs, io, e);
    }
    cli.drop(heap, parsed);
    return status;
}

fn main(world: World) -> [conc] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    // No foreign code, no network, no clock.
    release(ffi);
    release(net);
    release(clock);
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow fs as &f in {
                borrow mut io as &!i in {
                    status = run(h, g, f, i);
                }
            }
        }
    }
    release(heap);
    release(args);
    release(fs);
    release(io);
    return status;
}
