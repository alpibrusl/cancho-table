edition 5;

module jnflags;

// The flags of a join (docs/joins.md section 2) and what is wrong with them before any byte is read: `--join` and `--on`, `--join-type`, `--join-prefix`, `--max-join-rows`. Looked up only
// when an argument could be one of them (`Inputs.join_mention`).
//
// What these slices take of the design (docs/joins.md section 11): J1 one key pair compared as text and the inner join; J2 the left, semi and anti joins, typed keys, a list of up to 8 pairs, the shared-name
// form `--on NAME`; J3 `--join-where` and the groups, sorts and pages over the joined row. The rest is refused here with a rule and a hint, never ignored: `--report` over a join.

import std.buffer;
import std.bytes;
import std.vec;
import expr;
import finish;
import flags;
import inputs;
import jnfmt;
import jxsrc;
import orparse;
import qrefuse;
import qtrans;
import query;
import spec;
import wrepair;
import toolbox.cli;
import toolbox.fail;

// `--on` read: a comma list of 1 to 8 pairs, `LEFT=RIGHT` or the shared-name form `NAME` (USING), each with an optional type at the end (`:int`, `:dec(S)`, `:float`).
// `status` is 0 when it is a list of pairs, else why not (1 no pair, 3 a type before the equals sign, 4 a backslash that escapes nothing it may, 5 two equals signs in a pair,
// 6 an empty name or an empty pair, 7 a type that is not one, 8 two types in a pair, 9 a position alone (`#2` is not a name shared by two files), 10 more than 8 pairs).
// The names are in `names`, two for each pair (left, right; the right one is the left one again for a shared name), `ends` their ends; `kinds` has for each name -1 for a
// name and N for `#N`; `types` has for each pair 0 for text, 1 for :int, 2 + S for :dec(S), 21 for :float; `using` has 1 for a shared-name pair.
pub res struct On {
    status: int,
    pairs: int,
    names: buffer.Buffer,
    ends: vec.Vec[int],
    kinds: vec.Vec[int],
    types: vec.Vec[int],
    using: vec.Vec[int],
}

pub fn drop_on[&h](heap: &!h Heap, o: On) -> [heap] int {
    let On { status, pairs, names, ends, kinds, types, using } = o;
    buffer.drop(heap, names);
    vec.drop(heap, ends);
    vec.drop(heap, kinds);
    vec.drop(heap, types);
    vec.drop(heap, using);
    return status;
}

// The name `i` of the list (`2 * pair` is the left one, `2 * pair + 1` the right one).
pub fn name_at[&o](o: &o On, i: int) -> [] &o [byte] {
    var from = 0;
    if i > 0 {
        from = vec.get(o.ends, i - 1);
    }
    return buffer.bytes(o.names)[from..vec.get(o.ends, i)];
}

// A type written after the colon: 1 for `int`, 21 for `float`, 2 + S for `dec(S)` with S from 0 to 18, and 0 for anything else.
pub fn type_of[&w](word: &w [byte]) -> [] int {
    if bytes.equal(word, "int") {
        return 1;
    }
    if bytes.equal(word, "float") {
        return 21;
    }
    if len(word) >= 6 && len(word) <= 7 && bytes.starts_with(word, "dec(") && int_of(word[len(word) - 1]) == ')' {
        let digits = word[4..len(word) - 1];
        var n = 0;
        var i = 0;
        while i < len(digits) {
            if !bytes.is_digit(int_of(digits[i])) {
                return 0;
            }
            n = n * 10 + bytes.digit_of(int_of(digits[i]));
            i = i + 1;
        }
        if len(digits) == 2 && int_of(digits[0]) == '0' {
            return 0;
        }
        if n <= 18 {
            return 2 + n;
        }
    }
    return 0;
}

// `--on` as the call says it: the flag's, or the query's.
pub fn on_of[&h, &g, &p, &x](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, jxs: &x [byte]) -> [heap, args] On {
    let onb = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_on(), "on");
    var on = parse_on(heap, "");
    borrow onb as &obr in {
        drop_on(heap, on);
        on = parse_on(heap, buffer.bytes(obr));
    }
    buffer.drop(heap, onb);
    return on;
}

pub fn parse_on[&h, &g](heap: &!h Heap, given: &g [byte]) -> [heap] On {
    var names = buffer.empty(heap, 64);
    var ends = vec.empty(heap, 16, 0);
    var kinds = vec.empty(heap, 16, 0);
    var types = vec.empty(heap, 8, 0);
    var using = vec.empty(heap, 8, 0);
    var left = buffer.empty(heap, 32);
    var right = buffer.empty(heap, 32);
    var suffix = buffer.empty(heap, 16);
    var pairs = 0;
    var status = 0;
    var side = 0;
    var insuffix = false;
    var lesc = false;
    var resc = false;
    var lsize = 0;
    var rsize = 0;
    var i = 0;
    let n = len(given);
    // position n is a comma that is not written: it ends the last pair
    while status == 0 && i <= n {
        var literal = -1;
        var step = 1;
        var cut = false;
        if i == n {
            cut = true;
        } else {
            let c = int_of(given[i]);
            if c == 92 {
                if i + 1 < n {
                    let d = int_of(given[i + 1]);
                    if d == ',' || d == 92 || d == '=' || d == ':' || d == '#' {
                        literal = d;
                        step = 2;
                        if d == '#' && !insuffix && side == 0 && lsize == 0 {
                            lesc = true;
                        }
                        if d == '#' && !insuffix && side == 1 && rsize == 0 {
                            resc = true;
                        }
                    } else {
                        status = 4;
                    }
                } else {
                    status = 4;
                }
            } else if c == '=' {
                if insuffix {
                    status = 3;
                } else if side == 0 {
                    side = 1;
                } else {
                    status = 5;
                }
            } else if c == ',' {
                cut = true;
            } else if c == ':' {
                if insuffix {
                    status = 8;
                } else {
                    insuffix = true;
                }
            } else {
                literal = c;
            }
        }
        if literal >= 0 {
            if insuffix {
                suffix = buffer.push(heap, suffix, byte_of(literal));
            } else if side == 0 {
                left = buffer.push(heap, left, byte_of(literal));
                lsize = lsize + 1;
            } else {
                right = buffer.push(heap, right, byte_of(literal));
                rsize = rsize + 1;
            }
        }
        if cut && status == 0 {
            // the end of a pair
            var lkind = 0 - 1;
            var rkind = 0 - 1;
            var t = 0;
            if lsize == 0 || side == 1 && rsize == 0 {
                status = 6;
            }
            if status == 0 {
                if !lesc {
                    borrow left as &lr in {
                        lkind = query.position_of(buffer.bytes(lr));
                    }
                }
                if !resc {
                    borrow right as &rr in {
                        rkind = query.position_of(buffer.bytes(rr));
                    }
                }
                if side == 0 {
                    if lkind >= 1 {
                        status = 9;
                    } else {
                        borrow left as &lr in {
                            right = buffer.append(heap, right, buffer.bytes(lr));
                        }
                        rkind = 0 - 1;
                    }
                }
            }
            if status == 0 && insuffix {
                borrow suffix as &sr in {
                    t = type_of(buffer.bytes(sr));
                }
                if t == 0 {
                    status = 7;
                }
            }
            if status == 0 && pairs == 8 {
                status = 10;
            }
            if status == 0 {
                borrow left as &lr in {
                    names = buffer.append(heap, names, buffer.bytes(lr));
                }
                var total = 0;
                borrow names as &nr in {
                    total = buffer.size(nr);
                }
                ends = vec.push(heap, ends, total);
                kinds = vec.push(heap, kinds, lkind);
                borrow right as &rr in {
                    names = buffer.append(heap, names, buffer.bytes(rr));
                }
                borrow names as &nr2 in {
                    total = buffer.size(nr2);
                }
                ends = vec.push(heap, ends, total);
                kinds = vec.push(heap, kinds, rkind);
                types = vec.push(heap, types, t);
                if side == 0 {
                    using = vec.push(heap, using, 1);
                } else {
                    using = vec.push(heap, using, 0);
                }
                pairs = pairs + 1;
                borrow mut left as &!lw in {
                    buffer.clear(lw);
                }
                borrow mut right as &!rw in {
                    buffer.clear(rw);
                }
                borrow mut suffix as &!sw in {
                    buffer.clear(sw);
                }
                side = 0;
                insuffix = false;
                lesc = false;
                resc = false;
                lsize = 0;
                rsize = 0;
            }
        }
        i = i + step;
    }
    buffer.drop(heap, left);
    buffer.drop(heap, right);
    buffer.drop(heap, suffix);
    if status == 0 && pairs == 0 {
        status = 1;
    }
    return On { status: status, pairs: pairs, names: names, ends: ends, kinds: kinds, types: types, using: using };
}

// What is wrong with the flags of a join, added to `errs`. `jxs` is the text of the join of a `--query` (empty for the flags, which are then read from the arguments).
pub fn check[&h, &g, &p, &x](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, inp: inputs.Inputs, jxs: &x [byte], errs: fail.Errors) -> [heap, args] fail.Errors {
    let table = spec.flag_table();
    var e = errs;
    if !inp.has_join {
        if cli.has(parsed, table, "on") || cli.has(parsed, table, "join-prefix") || cli.has(parsed, table, "join-type") || cli.has(parsed, table, "max-join-rows") || cli.has(parsed, table, "join-where") || cli.has(parsed, table, "join-input-format") || cli.has(parsed, table, "join-fields") || cli.has(parsed, table, "join-delimiter") {
            e = flags.problem(heap, e, "args.required-flag", "--on, --join-type, --join-prefix, --join-where, --max-join-rows, --join-input-format, --join-fields and --join-delimiter are for a join, so they need --join", "--join FILE --on PROBE=BUILD", "--join --on --join-type --join-prefix --join-where --max-join-rows --join-input-format --join-fields --join-delimiter");
        }
        return e;
    }
    let path = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_join(), "join");
    borrow path as &pr in {
        if bytes.equal(buffer.bytes(pr), "-") {
            e = flags.problem(heap, e, "args.bad-value", "the --join file is read whole before the first probe row, so it cannot be standard input", "name the file in --join and pipe the other one into FILE", "--join");
        }
    }
    buffer.drop(heap, path);
    if !jxsrc.has(parsed, jxs, jxsrc.s_on(), "on") {
        e = flags.problem(heap, e, "args.required-flag", "--join needs --on: the column of FILE and the column of the --join file whose cells are equal", "--on user=id", "--join --on");
    } else {
        let onb = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_on(), "on");
        borrow onb as &obr in {
            let on = parse_on(heap, buffer.bytes(obr));
            var ostatus = 0;
            borrow on as &onr in {
                ostatus = onr.status;
            }
            var why = "";
            var hint = "--on user=id";
            if ostatus == 1 {
                why = "--on is a list of pairs: PROBE=BUILD, a column of FILE, an equals sign and a column of the --join file, or one name that both files have";
            } else if ostatus == 3 {
                why = "a type goes at the end of a pair, after the build column: --on user=id:int, and never after the probe column; a colon in a name is written with a backslash before it";
                hint = "--on user=id:int, or --on 'a\\:b=c' for a column called a:b";
            } else if ostatus == 4 {
                why = "a backslash in --on escapes only a comma, a backslash, an equals sign, a colon or a leading #";
            } else if ostatus == 5 {
                why = "--on has two equals signs in a pair: write a backslash before one that is part of a name";
                hint = "--on 'a\\=b=c'";
            } else if ostatus == 6 {
                why = "a name in --on is empty, or a pair is: a list is PROBE=BUILD,PROBE=BUILD with a comma between pairs and none at the end";
            } else if ostatus == 7 {
                why = "the type of a pair is :int, :float or :dec(S) with S from 0 to 18";
                hint = "--on user=id:int, --on price=cost:dec(2)";
            } else if ostatus == 8 {
                why = "a pair has one type, at its end: --on user=id:int, and not --on user=id:int:int";
            } else if ostatus == 9 {
                why = "a position alone is not a name that both files share: write both sides, --on '#2=#2', or the name";
                hint = "--on '#2=#2' or --on user";
            } else if ostatus == 10 {
                why = "--on takes 1 to 8 pairs";
                hint = "join on fewer columns, or pipe a first join as csv into a second call";
            }
            if ostatus != 0 {
                e = flags.problem(heap, e, "args.bad-value", why, hint, "--on");
            }
            drop_on(heap, on);
        }
        buffer.drop(heap, onb);
    }
    if jxsrc.has(parsed, jxs, jxsrc.s_prefix(), "join-prefix") {
        // (one lookup of the flag table for the type, not two: a lookup scans the table, and it is most of what a small call costs)
        let kindb = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_type(), "join-type");
        var semi = false;
        borrow kindb as &kr in {
            semi = bytes.equal(buffer.bytes(kr), "semi") || bytes.equal(buffer.bytes(kr), "anti");
        }
        buffer.drop(heap, kindb);
        if semi {
            e = flags.problem(heap, e, "args.conflict", "a semi or anti join gives the probe columns only, so there is no column of the --join file for --join-prefix to name", "drop --join-prefix", "--join-type --join-prefix");
        }
    }
    if inp.has_report {
        e = flags.problem(heap, e, "args.conflict", "--report types describes the columns of one file, and the joined row has padded cells and a key with two spellings: it does not take a join", "write the join as --format csv and pipe it into a second call that reports", "--join --report");
    }
    if jxsrc.has(parsed, jxs, jxsrc.s_join_where(), "join-where") {
        // the expression is read here, before any file is opened; the names in it are resolved against the --join file's header with the key columns
        let gb = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_join_where(), "join-where");
        borrow gb as &gr in {
            let given = buffer.bytes(gr);
            let (t, what, at) = orparse.parse(heap, query.empty(heap), given);
            query.drop(heap, t);
            if what == orparse.mixed() {
                var flag_at = 0 - 1;
                var whole = false;
                if !jxsrc.queried(jxs) {
                    flag_at = cli.value_index(parsed, table, "join-where");
                    whole = cli.value_is_whole(parsed, table, "join-where");
                }
                e = wrepair.refuse_for(heap, e, given, at, args, flag_at, whole, "--join-where");
            } else if what != 0 && jxsrc.queried(jxs) {
                // a literal of the query's on that does not fit the type its column is read as: refused at the literal of the query
                e = qrefuse.literal_refusal(heap, e, inp.query_text, what, at + qtrans.jw_base());
            } else if what != 0 {
                var w = fail.open_in(heap, finish.extra(), "where.syntax", "--join-where is not an expression", "the grammar is in the help of --where: COLUMN OP VALUE joined by and or by or, with parentheses and not");
                w = fail.repair_none(heap, w, "what the expression was meant to say is not known");
                w = fail.detail_open(heap, w);
                w = fail.detail_str(heap, w, "flag", "--join-where");
                w = fail.detail_int(heap, w, "offset", at);
                w = fail.detail_str(heap, w, "expected", expr.expected(what));
                w = fail.detail_text(heap, w, "expression", given);
                e = fail.add(heap, e, w);
            }
        }
        buffer.drop(heap, gb);
    }
    // the formats of the two files (docs/joins.md section 21): JSON lines on either side, and the build's delimiter
    e = jnfmt.check(heap, args, parsed, inp.jmention, e);
    if cli.has(parsed, table, "max-join-rows") {
        let n = cli.nat(args, parsed, table, "max-join-rows");
        if n < 1 || n > 1000000000 {
            e = flags.problem(heap, e, "args.bad-value", "--max-join-rows is from 1 to 1000000000", "--max-join-rows 10000000", "--max-join-rows");
        }
    }
    return e;
}
