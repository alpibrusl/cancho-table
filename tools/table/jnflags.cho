edition 5;

module jnflags;

// The flags of a join (docs/joins.md section 2) and what is wrong with them before any byte is read: `--join` and `--on`, `--join-type`, `--join-prefix`, `--max-join-rows`. Looked up only
// when an argument could be one of them (`Inputs.join_mention`).
//
// What this slice takes of the design (docs/joins.md section 11, J1): one key pair, `PROBE=BUILD`, compared as text; the inner join; rows out. The rest is refused here with a rule and
// a hint, never ignored: the shared-name form `--on NAME`, a type suffix and a second pair (J2), `--group`, `--agg`, `--order-by`, `--sort`, `--top` and `--report` over a join (J3).

import std.buffer;
import std.bytes;
import flags;
import inputs;
import query;
import spec;
import toolbox.cli;
import toolbox.fail;

// `--on` read: `status` is 0 when it is one pair, else why not (1 no equals sign, 2 more than one pair, 3 a type suffix or an unescaped colon, 4 a backslash that escapes nothing it may,
// 5 two equals signs in a pair, 6 an empty name). `left` and `right` are the names unescaped; `lkind` and `rkind` are -1 for a name or N for `#N`.
pub res struct On {
    status: int,
    left: buffer.Buffer,
    lkind: int,
    right: buffer.Buffer,
    rkind: int,
}

pub fn drop_on[&h](heap: &!h Heap, o: On) -> [heap] int {
    let On { status, left, lkind, right, rkind } = o;
    buffer.drop(heap, left);
    buffer.drop(heap, right);
    return status;
}

pub fn parse_on[&h, &g](heap: &!h Heap, given: &g [byte]) -> [heap] On {
    var left = buffer.empty(heap, 32);
    var right = buffer.empty(heap, 32);
    var side = 0;
    var status = 0;
    var lesc = false;
    var resc = false;
    var lsize = 0;
    var rsize = 0;
    var i = 0;
    let n = len(given);
    while i < n && status == 0 {
        let c = int_of(given[i]);
        var literal = -1;
        var step = 1;
        if c == 92 {
            if i + 1 < n {
                let d = int_of(given[i + 1]);
                if d == ',' || d == 92 || d == '=' || d == ':' || d == '#' {
                    literal = d;
                    step = 2;
                    if d == '#' && side == 0 && lsize == 0 {
                        lesc = true;
                    }
                    if d == '#' && side == 1 && rsize == 0 {
                        resc = true;
                    }
                } else {
                    status = 4;
                }
            } else {
                status = 4;
            }
        } else if c == '=' {
            if side == 0 {
                side = 1;
            } else {
                status = 5;
            }
        } else if c == ',' {
            status = 2;
        } else if c == ':' {
            status = 3;
        } else {
            literal = c;
        }
        if literal >= 0 {
            if side == 0 {
                left = buffer.push(heap, left, byte_of(literal));
                lsize = lsize + 1;
            } else {
                right = buffer.push(heap, right, byte_of(literal));
                rsize = rsize + 1;
            }
        }
        i = i + step;
    }
    if status == 0 {
        if side == 0 {
            status = 1;
        } else if lsize == 0 || rsize == 0 {
            status = 6;
        }
    }
    var lkind = 0 - 1;
    var rkind = 0 - 1;
    if status == 0 {
        if !lesc {
            borrow left as &lr in {
                lkind = query.position_of(buffer.bytes(lr));
            }
        }
        if !resc {
            borrow right as &rr in {
                rkind = query.position_of(buffer.bytes(rr));
            }
        }
    }
    return On { status: status, left: left, lkind: lkind, right: right, rkind: rkind };
}

// What is wrong with the flags of a join, added to `errs`.
pub fn check[&h, &g, &p](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, inp: inputs.Inputs, grouped: bool, errs: fail.Errors) -> [heap, args] fail.Errors {
    let table = spec.flag_table();
    var e = errs;
    if !inp.has_join {
        if cli.has(parsed, table, "on") || cli.has(parsed, table, "join-prefix") || cli.has(parsed, table, "join-type") || cli.has(parsed, table, "max-join-rows") {
            e = flags.problem(heap, e, "args.required-flag", "--on, --join-type, --join-prefix and --max-join-rows are for a join, so they need --join", "--join FILE --on PROBE=BUILD", "--join --on --join-type --join-prefix --max-join-rows");
        }
        return e;
    }
    if bytes.equal(cli.text(args, parsed, table, "join"), "-") {
        e = flags.problem(heap, e, "args.bad-value", "the --join file is read whole before the first probe row, so it cannot be standard input", "name the file in --join and pipe the other one into FILE", "--join");
    }
    if !cli.has(parsed, table, "on") {
        e = flags.problem(heap, e, "args.required-flag", "--join needs --on: the column of FILE and the column of the --join file whose cells are equal", "--on user=id", "--join --on");
    } else {
        let on = parse_on(heap, cli.text(args, parsed, table, "on"));
        let On { status, left, lkind, right, rkind } = on;
        let ostatus = status;
        buffer.drop(heap, left);
        buffer.drop(heap, right);
        var why = "";
        var hint = "--on user=id";
        if ostatus == 1 {
            why = "--on is PROBE=BUILD: a column of FILE, an equals sign and a column of the --join file (the shared-name form --on NAME comes in a later version)";
        } else if ostatus == 2 {
            why = "--on takes one pair in this version: a join on several columns comes in a later version";
        } else if ostatus == 3 {
            why = "--on takes no type suffix in this version: keys are compared as text, byte for byte; a colon in a name is written with a backslash before it";
            hint = "--on user=id, or --on 'a\\:b=c' for a column called a:b";
        } else if ostatus == 4 {
            why = "a backslash in --on escapes only a comma, a backslash, an equals sign, a colon or a leading #";
        } else if ostatus == 5 {
            why = "--on has two equals signs in a pair: write a backslash before one that is part of a name";
            hint = "--on 'a\\=b=c'";
        } else if ostatus == 6 {
            why = "a name in --on is empty";
        }
        if ostatus != 0 {
            e = flags.problem(heap, e, "args.bad-value", why, hint, "--on");
        }
    }
    if grouped || inp.has_order || inp.has_sort || inp.has_top || inp.has_report {
        e = flags.problem(heap, e, "args.conflict", "a join gives rows in this version: --group, --agg, --order-by, --sort, --top and --report do not take one yet", "write the join as --format csv and pipe it into a second call that groups, sorts or reports", "--join --group --agg --order-by --sort --top --report");
    }
    if inp.jsonl {
        e = flags.problem(heap, e, "args.conflict", "a join reads csv or tsv on both sides in this version", "drop --input-format, or convert the input to csv", "--join --input-format");
    }
    if cli.has(parsed, table, "max-join-rows") {
        let n = cli.nat(args, parsed, table, "max-join-rows");
        if n < 1 || n > 1000000000 {
            e = flags.problem(heap, e, "args.bad-value", "--max-join-rows is from 1 to 1000000000", "--max-join-rows 10000000", "--max-join-rows");
        }
    }
    return e;
}
