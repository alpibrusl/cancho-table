edition 5;

module qparse;

// The parser of `--query` (docs/query.md section 2): recursive descent over the tokens `qlex` wrote, one pass, no look-back, each production a function that answers 0 or
// sets the one error (`qarena.fail`) and answers 1. What it reads it keeps as records in the block (`qarena`), in the order of the text; `qtrans` turns the records into the
// flags. A column is a token (a name, a quoted name or a position), a value is a token, and a type is a code: 0 text, 1 int, 2 + S for dec(S), 21 for float
// (the codes of query.cho).
//
//     select item      [0 column | 1 aggregate, function, column token, type, scale or -1, start, end, the token of its `as` name plus one or 0]       functions: 0 count, 1 sum, 2 min, 3 max, 4 distinct, 5 mean
//     condition        [column token, type, operator, how many values, start, 0, 0, 0] then the values' tokens   operators: 0 = 1 != 2 < 3 <= 4 > 5 >= 6 contains 7 in 8 not in 9 not contains
//     order key        [0 column | 1 aggregate, function, column token, type, scale or -1, 1 when descending, start, end of an aggregate]
//     group column     the column's token

import std.bytes;
import qarena;
import qlex;

fn lower_eq[&q](q: &q [byte], start: int, end: int, word: &static [byte]) -> [] bool {
    if end - start != len(word) {
        return false;
    }
    var i = 0;
    while i < len(word) {
        if bytes.to_lower(int_of(q[start + i])) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Whether the bytes are one of the words of `list` (lower case, separated by spaces), whatever their case.
fn in_list[&q](q: &q [byte], start: int, end: int, list: &static [byte]) -> [] bool {
    var i = 0;
    while i < len(list) {
        var j = i;
        while j < len(list) && int_of(list[j]) != 32 {
            j = j + 1;
        }
        if lower_eq(q, start, end, list[i..j]) {
            return true;
        }
        i = j + 1;
    }
    return false;
}

pub fn reserved() -> [] &static [byte] {
    return "select from where group order limit offset by and in contains asc desc as cast";
}

// Words the grammar will need later (docs/query.md section 2): refused as bare names now, so that a query that is valid today stays valid.
pub fn reserved_later() -> [] &static [byte] {
    return "join inner left right full cross on using having union intersect except like ilike between is not or case when then else end null true false distinct over with all any exists";
}

pub fn functions() -> [] &static [byte] {
    return "count sum min max mean";
}

fn keyword[&q, &m](q: &q [byte], m: &m [int], i: int) -> [] bool {
    if qarena.tok_kind(m, i) != qlex.t_id() {
        return false;
    }
    let a = qarena.tok_start(m, i);
    let b = qarena.tok_end(m, i);
    return in_list(q, a, b, reserved()) || in_list(q, a, b, reserved_later());
}

// The token `d` ahead of the cursor (the end token when that is past it).
fn tk[&m](m: &m [int], d: int) -> [] int {
    var i = m[qarena.s_k()] + d;
    if i > m[qarena.s_tokens()] - 1 {
        i = m[qarena.s_tokens()] - 1;
    }
    return i;
}

fn start_of[&m](m: &m [int], d: int) -> [] int {
    return qarena.tok_start(m, tk(m, d));
}

fn is_word[&q, &m](q: &q [byte], m: &m [int], d: int, word: &static [byte]) -> [] bool {
    let i = tk(m, d);
    return qarena.tok_kind(m, i) == qlex.t_id() && lower_eq(q, qarena.tok_start(m, i), qarena.tok_end(m, i), word);
}

fn is_sym[&m](m: &m [int], d: int, which: int) -> [] bool {
    let i = tk(m, d);
    return qarena.tok_kind(m, i) == qlex.t_sym() && qarena.tok_aux(m, i) == which;
}

fn step[&m](m: &!m [int]) -> [] int {
    m[qarena.s_k()] = m[qarena.s_k()] + 1;
    return 0;
}

fn eat_word[&q, &m](q: &q [byte], m: &!m [int], word: &static [byte]) -> [] bool {
    if is_word(q, m, 0, word) {
        step(m);
        return true;
    }
    return false;
}

fn eat_sym[&m](m: &!m [int], which: int) -> [] bool {
    if is_sym(m, 0, which) {
        step(m);
        return true;
    }
    return false;
}

// Expect a symbol; the error is `code` at the token that is there.
fn expect_sym[&m](m: &!m [int], which: int, code: int) -> [] int {
    if eat_sym(m, which) {
        return 0;
    }
    return qarena.fail(m, 1, code, start_of(m, 0));
}

// A new record of eight integers; answers where it begins.
fn record[&m](m: &!m [int]) -> [] int {
    let at = m[qarena.s_rec_base()];
    var i = 0;
    while i < 8 {
        m[at + i] = 0;
        i = i + 1;
    }
    m[qarena.s_rec_base()] = at + 8;
    return at;
}

// ---- the join (docs/joins.md sections 2.3 and 20)

// The token `i`, or the end token when `i` is past the last.
fn tok_at[&m](m: &m [int], i: int) -> [] int {
    if i > m[qarena.s_tokens()] - 1 {
        return m[qarena.s_tokens()] - 1;
    }
    return i;
}

fn word_at[&q, &m](q: &q [byte], m: &m [int], i: int, word: &static [byte]) -> [] bool {
    let j = tok_at(m, i);
    return qarena.tok_kind(m, j) == qlex.t_id() && lower_eq(q, qarena.tok_start(m, j), qarena.tok_end(m, j), word);
}

fn sym_at[&m](m: &m [int], i: int, which: int) -> [] bool {
    let j = tok_at(m, i);
    return qarena.tok_kind(m, j) == qlex.t_sym() && qarena.tok_aux(m, j) == which;
}

// A name a table of a join may have: a bare word that is no keyword, or a "quoted" one.
fn alias_at[&q, &m](q: &q [byte], m: &m [int], i: int) -> [] bool {
    let j = tok_at(m, i);
    return qarena.tok_kind(m, j) == qlex.t_qid() || qarena.tok_kind(m, j) == qlex.t_id() && !keyword(q, m, j);
}

// Whether two name tokens (a bare word or a "quoted" name) are the same name: a doubled quote in a quoted one is one quote.
pub fn name_eq[&q, &m](q: &q [byte], m: &m [int], x: int, y: int) -> [] bool {
    var i = qarena.tok_start(m, x);
    var e1 = qarena.tok_end(m, x);
    let qx = qarena.tok_kind(m, x) == qlex.t_qid();
    if qx {
        i = i + 1;
        e1 = e1 - 1;
    }
    var j = qarena.tok_start(m, y);
    var e2 = qarena.tok_end(m, y);
    let qy = qarena.tok_kind(m, y) == qlex.t_qid();
    if qy {
        j = j + 1;
        e2 = e2 - 1;
    }
    while i < e1 && j < e2 {
        let cx = int_of(q[i]);
        let cy = int_of(q[j]);
        if cx != cy {
            return false;
        }
        if qx && cx == 34 {
            i = i + 2;
        } else {
            i = i + 1;
        }
        if qy && cy == 34 {
            j = j + 2;
        } else {
            j = j + 1;
        }
    }
    return i >= e1 && j >= e2;
}

// The refusal that does not stop the parse: only the first is kept, and not in a look-ahead.
fn note[&m](m: &!m [int], kind: int, code: int, at: int) -> [] int {
    if m[qarena.s_dry()] == 0 && m[qarena.s_pend_code()] == 0 {
        m[qarena.s_pend_kind()] = kind;
        m[qarena.s_pend_code()] = code;
        m[qarena.s_pend_offset()] = at;
    }
    return 0;
}

// At the end of the parse: the earliest of the refusal that stopped it and the first one noted (a tie is the noted one). Answers 1 when there is a refusal.
pub fn settle_pending[&m](m: &!m [int]) -> [] int {
    if m[qarena.s_pend_code()] != 0 {
        if m[qarena.s_code()] == 0 || m[qarena.s_pend_offset()] <= m[qarena.s_offset()] {
            m[qarena.s_kind()] = m[qarena.s_pend_kind()];
            m[qarena.s_code()] = m[qarena.s_pend_code()];
            m[qarena.s_offset()] = m[qarena.s_pend_offset()];
        }
    }
    return m[qarena.s_code()];
}

// Whether the name token `n` is the second half of alias.column (a dot before it, in a join).
pub fn qualified[&m](m: &m [int], n: int) -> [] bool {
    return m[qarena.s_join()] == 1 && n >= 2 && sym_at(m, n - 1, qlex.y_dot());
}

// Which table the qualified name token `n` is the column of: 1 the first, 2 the second, 0 neither (and for a name that is not qualified).
fn side_of[&q, &m](q: &q [byte], m: &m [int], n: int) -> [] int {
    if !qualified(m, n) {
        return 0;
    }
    if name_eq(q, m, n - 2, m[qarena.s_alias_a()]) {
        return 1;
    }
    let b = m[qarena.s_alias_b()];
    if b >= 0 && name_eq(q, m, n - 2, b) {
        return 2;
    }
    return 0;
}

// The head of a join statement, worked out from the tokens before the parse reads the select list: `from SRC as A` and then a join word (join, inner, left, right, full, cross, or semi or anti
// before join). Sets the slots; a statement that has not that shape is not a join statement, and is read as it always was.
fn scan_head[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    m[qarena.s_join()] = 0;
    m[qarena.s_alias_b()] = 0 - 1;
    let n = m[qarena.s_tokens()];
    var from = 0 - 1;
    var i = 0;
    while i < n && from < 0 {
        if word_at(q, m, i, "from") {
            from = i;
        }
        i = i + 1;
    }
    if from < 0 {
        return 0;
    }
    let src = from + 1;
    if !(qarena.tok_kind(m, tok_at(m, src)) == qlex.t_str() || word_at(q, m, src, "stdin")) {
        return 0;
    }
    if !word_at(q, m, from + 2, "as") || !alias_at(q, m, from + 3) {
        return 0;
    }
    let k = from + 4;
    var jt = 0 - 1;
    var jpos = 0 - 1;
    if word_at(q, m, k, "join") {
        jt = 0;
        jpos = k;
    } else if word_at(q, m, k, "inner") || word_at(q, m, k, "left") || word_at(q, m, k, "right") || word_at(q, m, k, "full") || word_at(q, m, k, "cross") {
        jt = 0;
        if word_at(q, m, k, "left") {
            jt = 1;
        } else if word_at(q, m, k, "right") {
            jt = 4;
        } else if word_at(q, m, k, "full") {
            jt = 5;
        } else if word_at(q, m, k, "cross") {
            jt = 6;
        }
        if word_at(q, m, k + 1, "join") {
            jpos = k + 1;
        } else if word_at(q, m, k, "left") && word_at(q, m, k + 1, "outer") && word_at(q, m, k + 2, "join") {
            jpos = k + 2;
        }
    } else if (word_at(q, m, k, "semi") || word_at(q, m, k, "anti")) && word_at(q, m, k + 1, "join") {
        jt = 2;
        if word_at(q, m, k, "anti") {
            jt = 3;
        }
        jpos = k + 1;
    } else {
        return 0;
    }
    m[qarena.s_join()] = 1;
    m[qarena.s_alias_a()] = from + 3;
    m[qarena.s_jtype()] = jt;
    if jpos >= 0 && qarena.tok_kind(m, tok_at(m, jpos + 1)) == qlex.t_str() && word_at(q, m, jpos + 2, "as") && alias_at(q, m, jpos + 3) {
        m[qarena.s_alias_b()] = jpos + 3;
    }
    return 0;
}

// The name after the dot of alias.column, the cursor being at the dot; the qualified name's token. The checks of the table: it is one of the two (else noted), the on's conditions name the second only,
// and a semi or anti join gives no column of the second table to the rest of the statement.
fn after_dot[&q, &m](q: &q [byte], m: &!m [int], first: int, what_keyword: int) -> [] int {
    step(m);
    let n = tk(m, 0);
    let nk = qarena.tok_kind(m, n);
    if nk == qlex.t_id() {
        if keyword(q, m, n) {
            qarena.fail(m, 1, what_keyword, qarena.tok_start(m, n));
            return 0 - 1;
        }
    } else if nk == qlex.t_pos() {
        step(m);
        note(m, 2, 117, qarena.tok_start(m, n));
        return n;
    } else if nk == qlex.t_sym() && qarena.tok_aux(m, n) == qlex.y_star() {
        qarena.fail(m, 2, 119, qarena.tok_start(m, n));
        return 0 - 1;
    } else if nk != qlex.t_qid() {
        qarena.fail(m, 1, 103, qarena.tok_start(m, n));
        return 0 - 1;
    }
    step(m);
    let side = side_of(q, m, n);
    if side == 0 && m[qarena.s_alias_b()] >= 0 {
        note(m, 1, 100, qarena.tok_start(m, first));
    }
    if side == 1 && m[qarena.s_in_conds()] == 1 {
        note(m, 2, 115, qarena.tok_start(m, first));
    }
    if side == 2 && m[qarena.s_jtype()] >= 2 && m[qarena.s_jtype()] <= 3 && m[qarena.s_in_on()] == 0 {
        note(m, 2, 118, qarena.tok_start(m, first));
    }
    return n;
}

// A column: a name (bare, and not a keyword), a quoted name, or a position; in a join, alias.column. Answers its token (the name's, for alias.column), or -1 with the error `what` (or `what_keyword` when a
// keyword is there). In a join a column that is not written alias.column is noted (code 99) and the parse goes on.
fn column[&q, &m](q: &q [byte], m: &!m [int], what: int, what_keyword: int) -> [] int {
    let i = tk(m, 0);
    let kind = qarena.tok_kind(m, i);
    if kind == qlex.t_id() || kind == qlex.t_qid() {
        if kind == qlex.t_id() && keyword(q, m, i) {
            qarena.fail(m, 1, what_keyword, qarena.tok_start(m, i));
            return 0 - 1;
        }
        step(m);
        if m[qarena.s_join()] == 1 {
            if is_sym(m, 0, qlex.y_dot()) {
                return after_dot(q, m, i, what_keyword);
            }
            note(m, 1, 99, qarena.tok_start(m, i));
        }
        return i;
    }
    if kind == qlex.t_pos() {
        step(m);
        if m[qarena.s_join()] == 1 {
            note(m, 2, 117, qarena.tok_start(m, i));
        }
        return i;
    }
    qarena.fail(m, 1, what, qarena.tok_start(m, i));
    return 0 - 1;
}

// A scale or a count: digits and nothing else. Answers the number, or -1 with the error `what` (a scale has at most three digits and is at most `most`; a count, `most` of -1,
// has at most 18, and the error is 12 when it has more).
fn natural[&q, &m](q: &q [byte], m: &!m [int], what: int, most: int) -> [] int {
    let i = tk(m, 0);
    step(m);
    let a = qarena.tok_start(m, i);
    let b = qarena.tok_end(m, i);
    var digits = qarena.tok_kind(m, i) == qlex.t_num();
    var j = a;
    while digits && j < b {
        if !bytes.is_digit(int_of(q[j])) {
            digits = false;
        }
        j = j + 1;
    }
    if !digits {
        qarena.fail(m, 1, what, a);
        return 0 - 1;
    }
    if most >= 0 && b - a > 3 {
        // a scale: not a number of this tool's size at all
        qarena.fail(m, 1, what, a);
        return 0 - 1;
    }
    if b - a > 18 {
        qarena.fail(m, 1, 12, a);
        return 0 - 1;
    }
    var value = 0;
    j = a;
    while j < b {
        value = value * 10 + bytes.digit_of(int_of(q[j]));
        j = j + 1;
    }
    if most >= 0 && value > most {
        qarena.fail(m, 1, what, a);
        return 0 - 1;
    }
    return value;
}

// A type after `::` or `as`: int, float or dec(S). Answers its code, or -1 with the error.
fn type_code[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    if is_word(q, m, 0, "int") {
        step(m);
        return 1;
    }
    if is_word(q, m, 0, "float") {
        step(m);
        return 21;
    }
    if is_word(q, m, 0, "dec") {
        step(m);
        if expect_sym(m, qlex.y_open(), 17) != 0 {
            return 0 - 1;
        }
        let scale = natural(q, m, 10, 18);
        if scale < 0 {
            return 0 - 1;
        }
        if expect_sym(m, qlex.y_close(), 8) != 0 {
            return 0 - 1;
        }
        return 2 + scale;
    }
    qarena.fail(m, 1, 16, start_of(m, 0));
    return 0 - 1;
}

// A column as a condition, a sort, an aggregate or a group reads it: `c`, `c::type` or `cast(c as type)`. Answers the column's token (-1 with the error) and the type.
fn typed[&q, &m](q: &q [byte], m: &!m [int], what: int, what_keyword: int) -> [] (int, int) {
    if is_word(q, m, 0, "cast") && is_sym(m, 1, qlex.y_open()) {
        step(m);
        step(m);
        let c = column(q, m, 4, 5);
        if c < 0 {
            return (0 - 1, 0);
        }
        if !eat_word(q, m, "as") {
            qarena.fail(m, 1, 18, start_of(m, 0));
            return (0 - 1, 0);
        }
        let t = type_code(q, m);
        if t < 0 {
            return (0 - 1, 0);
        }
        if expect_sym(m, qlex.y_close(), 8) != 0 {
            return (0 - 1, 0);
        }
        return (c, t);
    }
    let c = column(q, m, what, what_keyword);
    if c < 0 {
        return (0 - 1, 0);
    }
    if eat_sym(m, qlex.y_cast()) {
        let t = type_code(q, m);
        if t < 0 {
            return (0 - 1, 0);
        }
        return (c, t);
    }
    return (c, 0);
}

fn is_call[&q, &m](q: &q [byte], m: &m [int]) -> [] bool {
    if !is_sym(m, 1, qlex.y_open()) {
        return false;
    }
    return is_word(q, m, 0, "count") || is_word(q, m, 0, "sum") || is_word(q, m, 0, "min") || is_word(q, m, 0, "max") || is_word(q, m, 0, "mean");
}

// An aggregate call at the cursor into the record at `r` (kind 1): count(*), count(distinct c), sum, min, max (c), mean(c [, N]). `r + 7` is left alone.
fn agg_call[&q, &m](q: &q [byte], m: &!m [int], r: int) -> [] int {
    var f = 0;
    if is_word(q, m, 0, "sum") {
        f = 1;
    } else if is_word(q, m, 0, "min") {
        f = 2;
    } else if is_word(q, m, 0, "max") {
        f = 3;
    } else if is_word(q, m, 0, "mean") {
        f = 5;
    }
    let at = start_of(m, 0);
    step(m);
    step(m);
    m[r] = 1;
    m[r + 2] = 0 - 1;
    m[r + 4] = 0 - 1;
    m[r + 5] = at;
    if f == 0 {
        if eat_sym(m, qlex.y_star()) {
            if expect_sym(m, qlex.y_close(), 8) != 0 {
                return 1;
            }
        } else if eat_word(q, m, "distinct") {
            let (c, t) = typed(q, m, 4, 5);
            if c < 0 {
                return 1;
            }
            if expect_sym(m, qlex.y_close(), 8) != 0 {
                return 1;
            }
            m[r + 1] = 4;
            m[r + 2] = c;
            m[r + 3] = t;
        } else {
            return qarena.fail(m, 2, 62, start_of(m, 0));
        }
    } else {
        let (c, t) = typed(q, m, 4, 5);
        if c < 0 {
            return 1;
        }
        m[r + 1] = f;
        m[r + 2] = c;
        m[r + 3] = t;
        if f == 5 && eat_sym(m, qlex.y_comma()) {
            let scale = natural(q, m, 10, 18);
            if scale < 0 {
                return 1;
            }
            m[r + 4] = scale;
        }
        var closing = 8;
        if f == 5 {
            closing = 9;
        }
        if expect_sym(m, qlex.y_close(), closing) != 0 {
            return 1;
        }
    }
    m[r + 6] = qarena.tok_end(m, tk(m, 0 - 1));
    return 0;
}

// The select list: `*`, or items (a column, or an aggregate), the first record at s_items.
fn items[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    m[qarena.s_items()] = m[qarena.s_rec_base()];
    if eat_sym(m, qlex.y_star()) {
        m[qarena.s_star()] = 1;
        let r = record(m);
        m[r + 1] = 0;
        m[r + 5] = start_of(m, 0 - 1);
        m[qarena.s_item_count()] = 1;
        return 0;
    }
    var n = 0;
    var more = true;
    while more {
        let r = record(m);
        n = n + 1;
        if is_call(q, m) {
            if agg_call(q, m, r) != 0 {
                return 1;
            }
        } else {
            let at = start_of(m, 0);
            let (c, t) = typed(q, m, 2, 3);
            if c < 0 {
                return 1;
            }
            if t != 0 {
                return qarena.fail(m, 2, 63, at);
            }
            m[r] = 0;
            m[r + 2] = c;
            m[r + 3] = 0;
            m[r + 4] = 0 - 1;
            m[r + 5] = at;
            m[r + 6] = qarena.tok_end(m, tk(m, 0 - 1));
        }
        if is_word(q, m, 0, "as") {
            // `as NAME` (docs/or-and-columns.md section 8.2): a bare name that is not a keyword, or a "quoted" one; the record keeps its token, plus one (0 is none)
            step(m);
            let i = tk(m, 0);
            let kind = qarena.tok_kind(m, i);
            if kind == qlex.t_id() && !keyword(q, m, i) || kind == qlex.t_qid() {
                step(m);
                m[r + 7] = i + 1;
            } else {
                return qarena.fail(m, 1, 31, qarena.tok_start(m, i));
            }
        }
        more = eat_sym(m, qlex.y_comma());
    }
    m[qarena.s_item_count()] = n;
    return 0;
}

// A value: a string or a number.
fn literal[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    let i = tk(m, 0);
    let kind = qarena.tok_kind(m, i);
    if kind == qlex.t_str() || kind == qlex.t_num() {
        step(m);
        return i;
    }
    if kind == qlex.t_id() {
        let a = qarena.tok_start(m, i);
        let b = qarena.tok_end(m, i);
        if lower_eq(q, a, b, "null") {
            qarena.fail(m, 2, 69, a);
            return 0 - 1;
        }
        if lower_eq(q, a, b, "true") || lower_eq(q, a, b, "false") {
            qarena.fail(m, 2, 70, a);
            return 0 - 1;
        }
    }
    qarena.fail(m, 1, 14, qarena.tok_start(m, i));
    return 0 - 1;
}

fn op_of(m_aux: int) -> [] int {
    if m_aux == qlex.y_eq() {
        return 0;
    }
    if m_aux == qlex.y_ne() || m_aux == qlex.y_ltgt() {
        return 1;
    }
    if m_aux == qlex.y_lt() {
        return 2;
    }
    if m_aux == qlex.y_le() {
        return 3;
    }
    if m_aux == qlex.y_gt() {
        return 4;
    }
    if m_aux == qlex.y_ge() {
        return 5;
    }
    return 0 - 1;
}

fn comparison[&m](m: &m [int]) -> [] int {
    let i = tk(m, 0);
    if qarena.tok_kind(m, i) != qlex.t_sym() {
        return 0 - 1;
    }
    return op_of(qarena.tok_aux(m, i));
}

// The values of `in (...)`, the cursor being after `in`: each value's token is kept in the records after the condition's. Answers how many values, or -1 with the error set.
fn in_values[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    if expect_sym(m, qlex.y_open(), 19) != 0 {
        return 0 - 1;
    }
    var values = 0;
    var listing = true;
    while listing {
        if values >= 1024 {
            qarena.fail(m, 1, 27, start_of(m, 0));
            return 0 - 1;
        }
        let v = literal(q, m);
        if v < 0 {
            return 0 - 1;
        }
        m[m[qarena.s_rec_base()]] = v;
        m[qarena.s_rec_base()] = m[qarena.s_rec_base()] + 1;
        values = values + 1;
        listing = eat_sym(m, qlex.y_comma());
    }
    if expect_sym(m, qlex.y_close(), 20) != 0 {
        return 0 - 1;
    }
    return values;
}

// The value of `contains` (operator 6) or `not contains` (operator 9) for the condition at record `r` of type `t`, the cursor being after `contains`, whose token is `word`: a typed column
// cannot be searched (that is refused at the word). Answers 0, or 1 with the error set.
fn contains_value[&q, &m](q: &q [byte], m: &!m [int], r: int, t: int, word: int, op: int) -> [] int {
    if t != 0 {
        return qarena.fail(m, 1, 15, qarena.tok_start(m, word));
    }
    let v = literal(q, m);
    if v < 0 {
        return 1;
    }
    m[r + 2] = op;
    m[r + 3] = 1;
    m[m[qarena.s_rec_base()]] = v;
    m[qarena.s_rec_base()] = m[qarena.s_rec_base()] + 1;
    return 0;
}

// WHERE: conditions joined by `and` or by `or`, and parentheses (docs/or-and-columns.md section 3.4): `orlist = andlist { or andlist }`, here read as a level that is all `and` or all `or`, a
// unit being a condition or a parenthesised level. At most 64 conditions, 8 levels of parentheses and, in one `in`, 1,024 values. What it reads it keeps as records, in the order of the text:
// a condition's record (and its values after it), and for the structure a record of eight integers whose first is -1 an opening parenthesis, -2 a closing one, -3 `and`, -4 `or`, -5 `not` (the fifth
// is its offset). A level that mixes `and` and `or` is read to the end, as the flags' parser would read it with a repair in mind, and the offset of the first connective that changed it is kept
// (`s_mix`, plus one): the translation turns that into `query.mixed-and-or`, which comes before anything the rest of the statement says.
fn condition[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    let at = start_of(m, 0);
    if m[qarena.s_cond_count()] >= 64 {
        return qarena.fail(m, 1, 27, at);
    }
    let (c, t) = typed(q, m, 4, 5);
    if c < 0 {
        return 1;
    }
    let r = record(m);
    m[r] = c;
    m[r + 1] = t;
    m[r + 4] = at;
    let op = comparison(m);
    let here = tk(m, 0);
    if op >= 0 {
        step(m);
        let next = tk(m, 0);
        let nk = qarena.tok_kind(m, next);
        if nk == qlex.t_qid() || nk == qlex.t_pos() {
            return qarena.fail(m, 2, 68, qarena.tok_start(m, next));
        }
        if nk == qlex.t_id() && !is_word(q, m, 0, "null") && !is_word(q, m, 0, "true") && !is_word(q, m, 0, "false") {
            return qarena.fail(m, 2, 68, qarena.tok_start(m, next));
        }
        let v = literal(q, m);
        if v < 0 {
            return 1;
        }
        m[r + 2] = op;
        m[r + 3] = 1;
        m[m[qarena.s_rec_base()]] = v;
        m[qarena.s_rec_base()] = m[qarena.s_rec_base()] + 1;
    } else if is_word(q, m, 0, "contains") {
        step(m);
        if contains_value(q, m, r, t, here, 6) != 0 {
            return 1;
        }
    } else if is_word(q, m, 0, "in") {
        step(m);
        let values = in_values(q, m);
        if values < 0 {
            return 1;
        }
        m[r + 2] = 7;
        m[r + 3] = values;
    } else if is_word(q, m, 0, "like") || is_word(q, m, 0, "ilike") {
        return qarena.fail(m, 2, 73, qarena.tok_start(m, here));
    } else if is_word(q, m, 0, "between") {
        return qarena.fail(m, 2, 74, qarena.tok_start(m, here));
    } else if is_word(q, m, 0, "is") {
        return qarena.fail(m, 2, 75, qarena.tok_start(m, here));
    } else if is_word(q, m, 0, "not") {
        // `not in (...)` and `not contains V`; anything else after `not` is refused at the word after it (docs/or-and-columns.md section 3.4)
        step(m);
        let word = tk(m, 0);
        if is_word(q, m, 0, "in") {
            step(m);
            let values = in_values(q, m);
            if values < 0 {
                return 1;
            }
            m[r + 2] = 8;
            m[r + 3] = values;
        } else if is_word(q, m, 0, "contains") {
            step(m);
            if contains_value(q, m, r, t, word, 9) != 0 {
                return 1;
            }
        } else if is_word(q, m, 0, "like") || is_word(q, m, 0, "ilike") {
            return qarena.fail(m, 2, 73, qarena.tok_start(m, word));
        } else if is_word(q, m, 0, "between") {
            return qarena.fail(m, 2, 74, qarena.tok_start(m, word));
        } else {
            return qarena.fail(m, 1, 30, qarena.tok_start(m, word));
        }
    } else {
        return qarena.fail(m, 1, 13, qarena.tok_start(m, here));
    }
    m[qarena.s_cond_count()] = m[qarena.s_cond_count()] + 1;
    return 0;
}

// One structure record: `what` (-1 to -4, see above) at the byte `at`.
fn structure[&m](m: &!m [int], what: int, at: int) -> [] int {
    let r = record(m);
    m[r] = what;
    m[r + 4] = at;
    return 0;
}

// A unit: a condition, a group `( ... )`, or `not` and a unit (docs/or-and-columns.md section 3.4, where `not` binds the unit that follows: a comparison, a group or another `not`). The flag
// form has `not (` only, so the translation writes the parenthesis a `not` before a condition needs: that parenthesis is a level of the ceiling of 8 like one the query wrote, and is refused at
// the `not` when it would be the 9th. A `not` before a group is written as it stands. Structure records: -5 `not`, and for the parenthesis of a `not` before a condition -1 and -2.
fn unit[&q, &m](q: &q [byte], m: &!m [int], depth: int) -> [] int {
    let at = start_of(m, 0);
    if m[qarena.s_cond_count()] >= 64 {
        return qarena.fail(m, 1, 27, at);
    }
    if is_word(q, m, 0, "not") {
        step(m);
        structure(m, 0 - 5, at);
        if is_sym(m, 0, qlex.y_open()) {
            return unit(q, m, depth);
        }
        if depth >= 8 {
            return qarena.fail(m, 1, 29, at);
        }
        structure(m, 0 - 1, at);
        if unit(q, m, depth + 1) != 0 {
            return 1;
        }
        structure(m, 0 - 2, start_of(m, 0));
        return 0;
    }
    if is_sym(m, 0, qlex.y_open()) {
        if depth >= 8 {
            return qarena.fail(m, 1, 29, at);
        }
        step(m);
        structure(m, 0 - 1, at);
        if level(q, m, depth + 1) != 0 {
            return 1;
        }
        let close = start_of(m, 0);
        if expect_sym(m, qlex.y_close(), 8) != 0 {
            return 1;
        }
        structure(m, 0 - 2, close);
        return 0;
    }
    return condition(q, m);
}

// A level: unit { connective unit } at `depth` parentheses deep. Stops before a `)` that closes it, or at anything that is not a connective.
fn level[&q, &m](q: &q [byte], m: &!m [int], depth: int) -> [] int {
    var kind = 0;
    var more = true;
    while more {
        if unit(q, m, depth) != 0 {
            return 1;
        }
        var connective = 0;
        let here = start_of(m, 0);
        if is_word(q, m, 0, "and") {
            connective = 1;
        } else if is_word(q, m, 0, "or") {
            connective = 2;
        }
        if connective == 0 {
            more = false;
        } else {
            step(m);
            if kind == 0 {
                kind = connective;
            } else if kind != connective && m[qarena.s_mix()] == 0 {
                m[qarena.s_mix()] = here + 1;
            }
            structure(m, 0 - 2 - connective, here);
        }
    }
    return 0;
}

// WHERE: the whole clause.
fn conditions[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    m[qarena.s_conds()] = m[qarena.s_rec_base()];
    m[qarena.s_cond_count()] = 0;
    if level(q, m, 0) != 0 {
        return 1;
    }
    m[qarena.s_conds_end()] = m[qarena.s_rec_base()];
    return 0;
}

// The repair of an `or` (docs/or-and-columns.md section 7, slice A0): the where clause of a refused query read again from its first condition as `COND or COND { or COND }`, every COND
// `column = value` or `column in (value { , value })` with the column written by the same bytes each time (so the same name or position and the same cast), and no `and` after it.
// It reads with the functions the parser reads with, and writes nothing a plan keeps. Answers the number of conditions (0 when the clause is not that shape), the column's span in
// the query, the offset where the chain ends, and the number of values; the tokens of the values, in order, are left in the block from `s_rec_base`. The ceiling of 1,024 values is
// not checked here: the caller offers the corrected query only if `--where` takes what it translates to.
pub fn or_chain[&q, &m](q: &q [byte], m: &!m [int]) -> [] (int, int, int, int, int) {
    let none = (0, 0, 0, 0, 0);
    if m[qarena.s_conds()] == 0 {
        return none;
    }
    let begins = m[m[qarena.s_conds()] + 4];
    var first = 0 - 1;
    var t = 0;
    while t < m[qarena.s_tokens()] && first < 0 {
        if qarena.tok_start(m, t) == begins {
            first = t;
        }
        t = t + 1;
    }
    if first < 0 {
        return none;
    }
    m[qarena.s_k()] = first;
    let base = m[qarena.s_rec_base()];
    var values = 0;
    var leaves = 0;
    var col_a = 0;
    var col_b = 0;
    var more = true;
    while more {
        let a = start_of(m, 0);
        let (c, ty) = typed(q, m, 4, 5);
        if c < 0 {
            return none;
        }
        let b = qarena.tok_end(m, tk(m, 0 - 1));
        if leaves == 0 {
            col_a = a;
            col_b = b;
        } else if b - a != col_b - col_a || !bytes.equal(q[a..b], q[col_a..col_b]) {
            return none;
        }
        let op = comparison(m);
        if op == 0 {
            step(m);
            let v = literal(q, m);
            if v < 0 {
                return none;
            }
            m[base + values] = v;
            values = values + 1;
        } else if op < 0 && is_word(q, m, 0, "in") {
            step(m);
            if !eat_sym(m, qlex.y_open()) {
                return none;
            }
            var listing = true;
            while listing {
                let v = literal(q, m);
                if v < 0 {
                    return none;
                }
                m[base + values] = v;
                values = values + 1;
                listing = eat_sym(m, qlex.y_comma());
            }
            if !eat_sym(m, qlex.y_close()) {
                return none;
            }
        } else {
            return none;
        }
        leaves = leaves + 1;
        if is_word(q, m, 0, "or") {
            step(m);
        } else {
            more = false;
        }
    }
    if leaves < 2 || is_word(q, m, 0, "and") {
        return none;
    }
    return (leaves, col_a, col_b, qarena.tok_end(m, tk(m, 0 - 1)), values);
}

// GROUP BY: columns (the grammar groups by the text of a column).
fn group_columns[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    m[qarena.s_groups()] = m[qarena.s_rec_base()];
    m[qarena.s_group_at()] = start_of(m, 0);
    var n = 0;
    var more = true;
    while more {
        let at = start_of(m, 0);
        let (c, t) = typed(q, m, 4, 5);
        if c < 0 {
            return 1;
        }
        if t != 0 {
            return qarena.fail(m, 2, 64, at);
        }
        m[m[qarena.s_rec_base()]] = c;
        m[qarena.s_rec_base()] = m[qarena.s_rec_base()] + 1;
        n = n + 1;
        more = eat_sym(m, qlex.y_comma());
    }
    m[qarena.s_group_count()] = n;
    m[qarena.s_group_end()] = start_of(m, 0);
    return 0;
}

// Whether the cursor is at a bare name that is the `as` name of an item of the select list, in a join (not followed by a dot or a `::`).
fn bare_as_name[&q, &m](q: &q [byte], m: &m [int]) -> [] bool {
    if m[qarena.s_join()] != 1 {
        return false;
    }
    let t0 = tk(m, 0);
    if !(qarena.tok_kind(m, t0) == qlex.t_qid() || qarena.tok_kind(m, t0) == qlex.t_id() && !keyword(q, m, t0)) {
        return false;
    }
    if is_sym(m, 1, qlex.y_dot()) || is_sym(m, 1, qlex.y_cast()) {
        return false;
    }
    var k = 0;
    while k < m[qarena.s_item_count()] {
        let a = m[m[qarena.s_items()] + 8 * k + 7] - 1;
        if a >= 0 && name_eq(q, m, t0, a) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// ORDER BY: keys, each a column (with a type) or an aggregate, then asc or desc.
fn order_keys[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    m[qarena.s_orders()] = m[qarena.s_rec_base()];
    var n = 0;
    var more = true;
    while more {
        let r = record(m);
        n = n + 1;
        let at = start_of(m, 0);
        if is_call(q, m) {
            if agg_call(q, m, r) != 0 {
                return 1;
            }
            // where the call ends, for a repair that copies it (agg_call left it in the slot the order key keeps its start in)
            m[r + 7] = m[r + 6];
        } else {
            var c = 0 - 1;
            var t = 0;
            if bare_as_name(q, m) {
                // a bare name in a join is an `as` name of the select list (the only unqualified name a join query has)
                c = tk(m, 0);
                step(m);
            } else {
                let (c2, t2) = typed(q, m, 4, 5);
                c = c2;
                t = t2;
            }
            if c < 0 {
                return 1;
            }
            m[r] = 0;
            m[r + 2] = c;
            m[r + 3] = t;
            m[r + 4] = 0 - 1;
        }
        m[r + 5] = 0;
        m[r + 6] = at;
        if eat_word(q, m, "desc") {
            m[r + 5] = 1;
        } else {
            eat_word(q, m, "asc");
        }
        more = eat_sym(m, qlex.y_comma());
    }
    m[qarena.s_order_count()] = n;
    return 0;
}

// Whether the tokens from the cursor are `column = column`, the second one written alias.column or a cast of one: a look-ahead, after which the cursor, the error and the notes are as they were.
fn looks_eq[&q, &m](q: &q [byte], m: &!m [int]) -> [] bool {
    let k0 = m[qarena.s_k()];
    let ek = m[qarena.s_kind()];
    let ec = m[qarena.s_code()];
    let eo = m[qarena.s_offset()];
    let d0 = m[qarena.s_dry()];
    m[qarena.s_dry()] = 1;
    var ok = false;
    let (c, t) = typed(q, m, 4, 5);
    if c >= 0 && eat_sym(m, qlex.y_eq()) {
        let n1 = tk(m, 0);
        let k1 = qarena.tok_kind(m, n1);
        ok = (k1 == qlex.t_id() || k1 == qlex.t_qid()) && is_sym(m, 1, qlex.y_dot()) || is_word(q, m, 0, "cast") && is_sym(m, 1, qlex.y_open());
    }
    m[qarena.s_k()] = k0;
    m[qarena.s_kind()] = ek;
    m[qarena.s_code()] = ec;
    m[qarena.s_offset()] = eo;
    m[qarena.s_dry()] = d0;
    return ok;
}

// One key equality of the on: `column = column`, one column of each table and both read as the same type. Its record: the probe column's name token, the build column's, the type.
fn key_pair[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    let (l, lt) = typed(q, m, 4, 5);
    if l < 0 {
        return 1;
    }
    if expect_sym(m, qlex.y_eq(), 13) != 0 {
        return 1;
    }
    let at2 = start_of(m, 0);
    let (r, rt) = typed(q, m, 4, 5);
    if r < 0 {
        return 1;
    }
    let ls = side_of(q, m, l);
    let rs = side_of(q, m, r);
    if ls != 0 && ls == rs {
        return qarena.fail(m, 1, 95, at2);
    }
    if lt != rt {
        return qarena.fail(m, 1, 96, at2);
    }
    var p = l;
    var b = r;
    if rs == 1 || ls == 2 {
        p = r;
        b = l;
    }
    if m[qarena.s_pair_count()] == 0 {
        m[qarena.s_pairs()] = m[qarena.s_rec_base()];
    }
    let rec = record(m);
    m[rec] = p;
    m[rec + 1] = b;
    m[rec + 2] = lt;
    m[qarena.s_pair_count()] = m[qarena.s_pair_count()] + 1;
    return 0;
}

// The on clause: key equalities joined by `and`, then conditions on the second table joined by `and` (a level of a parenthesis may hold an `or`; the top level may not).
fn on_clause[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    m[qarena.s_in_on()] = 1;
    m[qarena.s_cond_count()] = 0;
    var eqs = true;
    var started = false;
    var last_and = 0;
    var more = true;
    while more {
        let start = start_of(m, 0);
        if eqs && looks_eq(q, m) {
            if m[qarena.s_pair_count()] >= 8 {
                return qarena.fail(m, 1, 97, start);
            }
            if key_pair(q, m) != 0 {
                return 1;
            }
        } else if !eqs && looks_eq(q, m) {
            return qarena.fail(m, 1, 98, start);
        } else {
            if m[qarena.s_pair_count()] == 0 {
                return qarena.fail(m, 1, 94, start);
            }
            if eqs {
                eqs = false;
                m[qarena.s_jconds()] = m[qarena.s_rec_base()];
            }
            if started {
                structure(m, 0 - 3, last_and);
            }
            m[qarena.s_in_conds()] = 1;
            let before = m[qarena.s_mix()];
            if unit(q, m, 0) != 0 {
                return 1;
            }
            m[qarena.s_in_conds()] = 0;
            if before == 0 && m[qarena.s_mix()] != 0 {
                m[qarena.s_mix_on()] = 1;
            }
            started = true;
        }
        let here = start_of(m, 0);
        if is_word(q, m, 0, "and") {
            step(m);
            last_and = here;
        } else if is_word(q, m, 0, "or") {
            return qarena.fail(m, 2, 120, here);
        } else {
            more = false;
        }
    }
    if !eqs {
        m[qarena.s_jconds_end()] = m[qarena.s_rec_base()];
        m[qarena.s_jcond_count()] = m[qarena.s_cond_count()];
    }
    m[qarena.s_cond_count()] = 0;
    m[qarena.s_in_on()] = 0;
    return 0;
}

// After the first source of a join statement: `as A [jtype] join 'path' as B on ...`. The scan found the shape; this reads it and says what is wrong with the rest of it.
fn join_head[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    step(m);
    step(m);
    let at = start_of(m, 0);
    if is_word(q, m, 0, "right") {
        return qarena.fail(m, 2, 110, at);
    }
    if is_word(q, m, 0, "full") {
        return qarena.fail(m, 2, 111, at);
    }
    if is_word(q, m, 0, "cross") {
        return qarena.fail(m, 2, 112, at);
    }
    if is_word(q, m, 0, "inner") || is_word(q, m, 0, "left") || is_word(q, m, 0, "semi") || is_word(q, m, 0, "anti") {
        let left = is_word(q, m, 0, "left");
        step(m);
        if left && is_word(q, m, 0, "outer") {
            return qarena.fail(m, 2, 113, start_of(m, 0));
        }
    }
    if !eat_word(q, m, "join") {
        return qarena.fail(m, 1, 102, start_of(m, 0));
    }
    let t = tk(m, 0);
    step(m);
    if qarena.tok_kind(m, t) == qlex.t_str() {
        m[qarena.s_join_path()] = t;
    } else if qarena.tok_kind(m, t) == qlex.t_id() && lower_eq(q, qarena.tok_start(m, t), qarena.tok_end(m, t), "stdin") {
        return qarena.fail(m, 2, 116, qarena.tok_start(m, t));
    } else {
        return qarena.fail(m, 1, 90, qarena.tok_start(m, t));
    }
    if !eat_word(q, m, "as") {
        return qarena.fail(m, 1, 91, start_of(m, 0));
    }
    let tb = tk(m, 0);
    if !alias_at(q, m, tb) {
        return qarena.fail(m, 1, 31, qarena.tok_start(m, tb));
    }
    step(m);
    if name_eq(q, m, tb, m[qarena.s_alias_a()]) {
        return qarena.fail(m, 1, 92, qarena.tok_start(m, tb));
    }
    if !eat_word(q, m, "on") {
        return qarena.fail(m, 1, 93, start_of(m, 0));
    }
    if on_clause(q, m) != 0 {
        return 1;
    }
    if is_word(q, m, 0, "join") || is_word(q, m, 0, "inner") || is_word(q, m, 0, "left") || is_word(q, m, 0, "right") || is_word(q, m, 0, "full") || is_word(q, m, 0, "cross") {
        return qarena.fail(m, 2, 114, start_of(m, 0));
    }
    if (is_word(q, m, 0, "semi") || is_word(q, m, 0, "anti")) && word_at(q, m, m[qarena.s_k()] + 1, "join") {
        return qarena.fail(m, 2, 114, start_of(m, 0));
    }
    return 0;
}

// The whole statement. Answers 0, or 1 with the error set.
pub fn statement[&q, &m](q: &q [byte], m: &!m [int]) -> [] int {
    m[qarena.s_limit()] = 0 - 1;
    m[qarena.s_offset_value()] = 0 - 1;
    m[qarena.s_clause()] = 0;
    scan_head(q, m);
    if m[qarena.s_join()] == 0 {
        // a dot is read only in a join: a query that is not the head of one is refused at its first dot, as it always was
        var d = 0;
        while d < m[qarena.s_tokens()] {
            if qarena.tok_kind(m, d) == qlex.t_sym() && qarena.tok_aux(m, d) == qlex.y_dot() {
                return qarena.fail(m, 1, 25, qarena.tok_start(m, d));
            }
            d = d + 1;
        }
    }
    if !eat_word(q, m, "select") {
        return qarena.fail(m, 1, 1, start_of(m, 0));
    }
    m[qarena.s_items_at()] = start_of(m, 0);
    if items(q, m) != 0 {
        return 1;
    }
    m[qarena.s_items_end()] = start_of(m, 0);
    m[qarena.s_clause()] = 1;
    if eat_word(q, m, "from") {
        let i = tk(m, 0);
        step(m);
        let a = qarena.tok_start(m, i);
        let b = qarena.tok_end(m, i);
        if qarena.tok_kind(m, i) == qlex.t_str() {
            m[qarena.s_source()] = 1;
            m[qarena.s_source_tok()] = i;
        } else if qarena.tok_kind(m, i) == qlex.t_id() && lower_eq(q, a, b, "stdin") {
            m[qarena.s_source()] = 2;
        } else if qarena.tok_kind(m, i) == qlex.t_id() && lower_eq(q, a, b, "select") {
            return qarena.fail(m, 2, 66, a);
        } else if qarena.tok_kind(m, i) == qlex.t_id() && in_list(q, a, b, "join left inner cross") {
            return qarena.fail(m, 2, 67, a);
        } else {
            return qarena.fail(m, 1, 6, a);
        }
        if m[qarena.s_join()] == 1 {
            if join_head(q, m) != 0 {
                return 1;
            }
        } else if is_word(q, m, 0, "join") || is_word(q, m, 0, "left") || is_word(q, m, 0, "inner") || is_word(q, m, 0, "cross") || is_word(q, m, 0, "full") {
            return qarena.fail(m, 2, 67, start_of(m, 0));
        }
        m[qarena.s_clause()] = 2;
    }
    if eat_word(q, m, "where") {
        if conditions(q, m) != 0 {
            return 1;
        }
        m[qarena.s_clause()] = 3;
    }
    if eat_word(q, m, "group") {
        if !eat_word(q, m, "by") {
            return qarena.fail(m, 1, 21, start_of(m, 0));
        }
        if group_columns(q, m) != 0 {
            return 1;
        }
        m[qarena.s_clause()] = 4;
    }
    if is_word(q, m, 0, "having") {
        return qarena.fail(m, 2, 77, start_of(m, 0));
    }
    if eat_word(q, m, "order") {
        if !eat_word(q, m, "by") {
            return qarena.fail(m, 1, 21, start_of(m, 0));
        }
        if order_keys(q, m) != 0 {
            return 1;
        }
        m[qarena.s_clause()] = 5;
    }
    if eat_word(q, m, "limit") {
        let n = natural(q, m, 11, 0 - 1);
        if n < 0 {
            return 1;
        }
        m[qarena.s_limit()] = n;
        if eat_word(q, m, "offset") {
            let o = natural(q, m, 11, 0 - 1);
            if o < 0 {
                return 1;
            }
            m[qarena.s_offset_value()] = o;
        }
        m[qarena.s_clause()] = 6;
    } else if eat_word(q, m, "offset") {
        let o = natural(q, m, 11, 0 - 1);
        if o < 0 {
            return 1;
        }
        m[qarena.s_offset_value()] = o;
        m[qarena.s_clause()] = 6;
    }
    eat_sym(m, qlex.y_semi());
    let i = tk(m, 0);
    if qarena.tok_kind(m, i) != qlex.t_end() {
        let a = qarena.tok_start(m, i);
        if qarena.tok_kind(m, i) == qlex.t_id() && in_list(q, a, qarena.tok_end(m, i), "union intersect except") {
            return qarena.fail(m, 2, 78, a);
        }
        m[qarena.s_bad_tok()] = i;
        return qarena.fail(m, 1, 7, a);
    }
    return 0;
}
