edition 7;

module flt;

// `:float` (docs/numbers.md, section 4): a cell read as the nearest double, kept as an `int` whose order is the order of the doubles, and written back
// as the shortest decimal that reads back to the same double.
//
// **Reading.** `[+-]? digits? [. digits?] ([eE] [+-]? digits)?` with at least one digit in the mantissa, ASCII only, no space, no separator, no `inf`, no
// `nan`, at most 1,100 bytes (a decimal exactly halfway between two doubles has at most 767 significant digits). Two ways to the double, both correctly rounded:
// Clinger's fast path inline when the mantissa has at most 15 digits and the power of ten is within 10^-22..10^22 (both are doubles, so one multiplication or
// one division rounds once), and otherwise the exact reader of `std.json` (`to_float`: bignum arithmetic with the remainder as the sticky bit), fed the same number
// rewritten in the grammar of JSON (digits without leading zeros, `e`, the exponent): about a microsecond a cell, the cost of an exact answer until a reader that
// does not go through the tape exists (stage N3b, docs/numbers.md 4.2).
//
// **The key.** There is no negative zero (`-0` is `0`) and no NaN, so the doubles are totally ordered, and the 64 bits of a double, with the low 63 flipped when
// the sign bit is set, are an `int` whose signed order is the numeric order. min, max, the comparisons of `--where` and the distinct set all work on that `int`.
//
// **Writing.** `float_of_key` builds the double back with `float_of_bits` (edition 7; the file was edition 5 and rebuilt the mantissa times a power of two with `std.math.ldexp`, for want of it), and
// `put_float` lays out the digits of `std.fmt.float_into` positionally from 1e-6 to 1e21 (always with a point: `3.0`) and leaves them scientific outside (`1e21`).

import std.buffer;
import std.fmt;
import std.json;
import pow5;

static pow10_float: [float] {
    let t = alloc_slice[static](23, 1.0);
    var k = 1;
    while k < 23 {
        t[k] = t[k - 1] * 10.0;
        k = k + 1;
    }
    return t;
}

// The `int` that stands for the double `x` (finite, and not zero: a zero cell is answered as key 0 before this is called, which is how -0 is 0): its
// bits with the low 63 flipped when negative.
pub fn key_of(x: float) -> [] int {
    let bits = bits_of(x);
    if bits < 0 {
        return bits ^ 0x7fffffffffffffff;
    }
    return bits;
}

// The double a key stands for: the bits back (the low 63 flipped again when the key is negative), as a double.
pub fn float_of_key(key: int) -> [] float {
    var bits = key;
    if key < 0 {
        bits = key ^ 0x7fffffffffffffff;
    }
    return float_of_bits(bits);
}

// Whether `data` is `inf`, `infinity` or `nan` in any case, with an optional sign: the words that are refused as not finite, not as not numbers.
fn is_word[&d](data: &d [byte]) -> [] bool {
    var at = 0;
    if len(data) > 0 && (int_of(data[0]) == '-' || int_of(data[0]) == '+') {
        at = 1;
    }
    let n = len(data) - at;
    if n == 3 {
        return word_is(data, at, "inf") || word_is(data, at, "nan");
    }
    return n == 8 && word_is(data, at, "infinity");
}

// Whether the bytes of `data` from `at` are `word` (lower case), in any case. Byte by byte: a number built from the bytes overflows when the first one is 128 or more.
fn word_is[&d](data: &d [byte], at: int, word: &static [byte]) -> [] bool {
    var i = 0;
    while i < len(word) {
        var c = int_of(data[at + i]);
        if c >= 'A' && c <= 'Z' {
            c = c + 32;
        }
        if c != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ---- the exact way, for what Eisel-Lemire cannot decide (more than 19 significant digits whose window and window + 1 round differently) ----

// The bits (exponent field and fraction, no sign; 0 when it rounds to zero, 0x7ff0000000000000 past the range) of the double nearest to the decimal in `data`,
// ties to even, by the exact reader of `std.json` (`to_float`): the cell is rewritten in the grammar of JSON, the digits of the mantissa without leading zeros,
// `e`, and the decimal exponent that goes with them (`exponent` - `fraction`), parsed into a tape of one number, and read. `to_float` rounds every case
// correctly since alpibrusl/cancho#361 (the exact subnormal ties, a digit cap of 768 where it was 767); the differential of scripts/float_edge.py and
// scripts/float_bulk.py is what says so for this tool. One region of a few words per call, a cost only for the cells that get here.
fn exact_bits[&d](data: &d [byte], fraction: int, exponent: int) -> [] int {
    var answer = 0;
    region r {
        let text = alloc_slice[r](len(data) + 16, byte_of(0));
        let tape = alloc_slice[r](12, 0);
        var n = 0;
        var started = false;
        var i = 0;
        // the mantissa digits, skipping the sign and the point and the leading zeros, up to the exponent
        while i < len(data) && int_of(data[i]) != 'e' && int_of(data[i]) != 'E' {
            let c = int_of(data[i]);
            if c >= '0' && c <= '9' && (started || c != '0') {
                started = true;
                text[n] = data[i];
                n = n + 1;
            }
            i = i + 1;
        }
        if !started {
            text[n] = byte_of('0');
            n = n + 1;
        }
        text[n] = byte_of('e');
        n = n + 1;
        var x10 = exponent - fraction;
        if x10 < 0 {
            text[n] = byte_of('-');
            n = n + 1;
            x10 = 0 - x10;
        }
        // the exponent's digits, most significant first
        var p = 1;
        while p * 10 <= x10 {
            p = p * 10;
        }
        while p > 0 {
            text[n] = byte_of('0' + x10 / p % 10);
            n = n + 1;
            p = p / 10;
        }
        let nodes = json.parse(text[0..n], tape);
        if nodes > 0 {
            answer = bits_of(json.to_float(text[0..n], tape, 0));
        }
    }
    return answer;
}

// ---- Eisel-Lemire (docs/gap-float.md): the nearest double of w * 10^q, w an unsigned 64-bit number (kept as the bit pattern of an `int`), without a bignum ----

// The 128-bit product of two unsigned 64-bit numbers (bit patterns in `int`), as (low, high). cancho has no multiply-high: four 32x32 products by
// `wrapping_mul` (each is below 2^64, so it is exact as a bit pattern) and carries by hand.
fn mul128(a: int, b: int) -> [] (int, int) {
    let a0 = a & 0xffffffff;
    let a1 = a >> 32 & 0xffffffff;
    let b0 = b & 0xffffffff;
    let b1 = b >> 32 & 0xffffffff;
    let p00 = wrapping_mul(a0, b0);
    let u = wrapping_add(wrapping_mul(a0, b1), p00 >> 32 & 0xffffffff);
    let v = wrapping_add(wrapping_mul(a1, b0), u & 0xffffffff);
    let hi = wrapping_add(wrapping_add(wrapping_mul(a1, b1), u >> 32 & 0xffffffff), v >> 32 & 0xffffffff);
    return (v << 32 | p00 & 0xffffffff, hi);
}

// The number of leading zero bits of a non-zero 64-bit pattern.
fn clz64(w: int) -> [] int {
    var n = 0;
    var x = w;
    if x >> 32 & 0xffffffff == 0 {
        n = 32;
        x = x << 32;
    }
    if x >> 48 & 0xffff == 0 {
        n = n + 16;
        x = x << 16;
    }
    if x >> 56 & 0xff == 0 {
        n = n + 8;
        x = x << 8;
    }
    if x >> 60 & 0xf == 0 {
        n = n + 4;
        x = x << 4;
    }
    if x >> 62 & 3 == 0 {
        n = n + 2;
        x = x << 2;
    }
    if x >= 0 {
        n = n + 1;
    }
    return n;
}

// The bits (exponent field and fraction, no sign) of the double nearest to w * 10^q, ties to even, for w != 0: 0 when it rounds to zero, 0x7ff0000000000000
// when it rounds past the largest double. The rules of Lemire's `compute_float` (fast_float): w is shifted up until its top bit is set, multiplied by the
// 128-bit approximation of 5^q (a second multiplication by the low word when the first product's low bits (9) could still change under it), and the 55
// top bits are rounded; with at most 19 digits it is always right (Mushtak and Lemire, "Fast number parsing without fallback", 2023), including the exact
// halfway cases (the `lo <= 1` test), so there is no "undecided" answer.
fn eisel_lemire(q: int, w0: int) -> [] int {
    if q < 0 - 342 {
        return 0;
    }
    if q > 308 {
        return 9218868437227405312;
    }
    let lz = clz64(w0);
    let w = w0 << lz;
    let index = 2 * (q + 342);
    let (l0, h0) = mul128(w, pow5.word(index));
    var lo = l0;
    var hi = h0;
    if hi & 511 == 511 {
        let (sl, sh) = mul128(w, pow5.word(index + 1));
        let nl = wrapping_add(lo, sh);
        // an unsigned compare: flip the top bit of both
        if sh ^ 1 << 63 > nl ^ 1 << 63 {
            hi = wrapping_add(hi, 1);
        }
        lo = nl;
    }
    var upper = 0;
    if hi < 0 {
        upper = 1;
    }
    var mant = hi >> upper + 9 & (1 << 55 - upper) - 1;
    var power2 = (217706 * q >> 16) + 63 + upper - lz + 1023;
    if power2 <= 0 {
        if 1 - power2 >= 64 {
            return 0;
        }
        mant = mant >> 1 - power2;
        mant = mant + (mant & 1);
        return mant >> 1;
    }
    if lo >= 0 && lo <= 1 && q >= 0 - 4 && q <= 23 && mant & 3 == 1 {
        if mant << upper + 9 == hi {
            mant = mant - 1;
        }
    }
    mant = mant + (mant & 1);
    mant = mant >> 1;
    if mant >= 9007199254740992 {
        mant = 4503599627370496;
        power2 = power2 + 1;
    }
    if power2 >= 2047 {
        return 9218868437227405312;
    }
    return (mant & 4503599627370495) + (power2 << 52);
}

// `data` as a float: (key, status). 0 it is; 9 not a number, 10 `inf` or `nan`, 11 past the range of a double, 12 a non-zero cell that is smaller than the
// smallest subnormal (it would read as zero), 13 longer than 1,100 bytes. The length is checked first, then the grammar of the whole cell.
//
// The value is read in three tiers, each correctly rounded: Clinger's fast path (at most 2^53 as the mantissa and a power of ten within 10^-22..10^22: one
// multiplication or division of two exact doubles), then Eisel-Lemire on the first 19 significant digits (no double is built: the answer is the bits),
// and, only for a cell with more than 19 significant digits whose 19-digit window and the window plus one round to different doubles, the exact reader of
// `std.json`.
pub fn parse_float[&d](data: &d [byte]) -> [] (int, int) {
    let n = len(data);
    if n > 1100 {
        return (0, 13);
    }
    var at = 0;
    var negative = false;
    if n > 0 && (int_of(data[0]) == '-' || int_of(data[0]) == '+') {
        negative = int_of(data[0]) == '-';
        at = 1;
    }
    // m: the first 19 significant digits (an unsigned 64-bit pattern); nd how many; q the power of ten of m's last digit; dropped: a digit after those
    // is not zero
    var m = 0;
    var nd = 0;
    var q = 0;
    var digits = 0;
    var point_at = 0 - 1;
    var dropped = false;
    var nonzero = false;
    var scanning = true;
    while at < n && scanning {
        let c = int_of(data[at]);
        if c >= '0' && c <= '9' {
            if c != '0' {
                nonzero = true;
            }
            if nd < 19 {
                if nd > 0 || c != '0' {
                    m = wrapping_add(wrapping_mul(m, 10), c - '0');
                    nd = nd + 1;
                }
                if point_at >= 0 {
                    q = q - 1;
                }
            } else {
                if c != '0' {
                    dropped = true;
                }
                if point_at < 0 {
                    q = q + 1;
                }
            }
            digits = digits + 1;
            at = at + 1;
        } else if c == '.' && point_at < 0 {
            point_at = at;
            at = at + 1;
        } else {
            scanning = false;
        }
    }
    if digits == 0 {
        if is_word(data) {
            return (0, 10);
        }
        return (0, 9);
    }
    // the digits after the point, all of them (the exact reader takes the cell as text)
    var fraction = 0;
    if point_at >= 0 {
        fraction = at - point_at - 1;
    }
    var exponent = 0;
    if at < n {
        let c = int_of(data[at]);
        if c != 'e' && c != 'E' {
            return (0, 9);
        }
        at = at + 1;
        var exponent_negative = false;
        if at < n && (int_of(data[at]) == '-' || int_of(data[at]) == '+') {
            exponent_negative = int_of(data[at]) == '-';
            at = at + 1;
        }
        if at >= n {
            return (0, 9);
        }
        while at < n {
            let c2 = int_of(data[at]);
            if c2 < '0' || c2 > '9' {
                return (0, 9);
            }
            if exponent < 100000 {
                exponent = exponent * 10 + c2 - '0';
            }
            at = at + 1;
        }
        if exponent_negative {
            exponent = 0 - exponent;
        }
    }
    if !nonzero {
        return (0, 0);
    }
    let e10 = exponent + q;
    // the magnitude's bits (exponent field and fraction)
    var bits = 0 - 1;
    if !dropped && m >= 0 && m <= 9007199254740992 && e10 >= 0 - 22 && e10 <= 22 {
        var x = float_of(m);
        if e10 < 0 {
            x = x / pow10_float[0 - e10];
        } else {
            x = x * pow10_float[e10];
        }
        bits = bits_of(x);
    } else {
        bits = eisel_lemire(e10, m);
        if dropped && eisel_lemire(e10, wrapping_add(m, 1)) != bits {
            bits = 0 - 1;
        }
    }
    if bits < 0 {
        // undecided: more than 19 digits, and the truncated digits could change the rounding
        bits = exact_bits(data, fraction, exponent);
    }
    if bits >= 9218868437227405312 {
        return (0, 11);
    }
    if bits == 0 {
        return (0, 12);
    }
    if negative {
        return (0 - 1 - bits, 0);
    }
    return (bits, 0);
}

// The key as text: the shortest decimal that reads back to the same double, positional from 1e-6 up to 1e21 and always with a point (`0.1`, `100.0`,
// `12345.67`), scientific outside (`1e21`, `1.5e-7`), `0.0` for zero.
pub fn put_float[&h](heap: &!h Heap, out: buffer.Buffer, key: int) -> [heap] buffer.Buffer {
    if key == 0 {
        return buffer.append(heap, out, "0.0");
    }
    let x = float_of_key(key);
    var o = out;
    region r {
        let t = alloc_slice[r](32, byte_of(0));
        let d = alloc_slice[r](24, byte_of(0));
        let n = fmt.float_into(t, x);
        var i = 0;
        var negative = false;
        if int_of(t[0]) == '-' {
            negative = true;
            i = 1;
        }
        var count = 0;
        while i < n && int_of(t[i]) != 'e' {
            if int_of(t[i]) != '.' {
                d[count] = t[i];
                count = count + 1;
            }
            i = i + 1;
        }
        // the exponent of the first digit
        var k = 0;
        var k_negative = false;
        i = i + 1;
        if i < n && int_of(t[i]) == '-' {
            k_negative = true;
            i = i + 1;
        }
        while i < n {
            k = k * 10 + int_of(t[i]) - '0';
            i = i + 1;
        }
        if k_negative {
            k = 0 - k;
        }
        if k >= 21 || k < 0 - 6 {
            o = buffer.append(heap, o, t[0..n]);
        } else {
            if negative {
                o = buffer.push(heap, o, byte_of('-'));
            }
            let point = k + 1;
            if point <= 0 {
                o = buffer.append(heap, o, "0.");
                var z = 0;
                while z < 0 - point {
                    o = buffer.push(heap, o, byte_of('0'));
                    z = z + 1;
                }
                o = buffer.append(heap, o, d[0..count]);
            } else if point >= count {
                o = buffer.append(heap, o, d[0..count]);
                var z = 0;
                while z < point - count {
                    o = buffer.push(heap, o, byte_of('0'));
                    z = z + 1;
                }
                o = buffer.append(heap, o, ".0");
            } else {
                o = buffer.append(heap, o, d[0..point]);
                o = buffer.push(heap, o, byte_of('.'));
                o = buffer.append(heap, o, d[point..count]);
            }
        }
    }
    return o;
}
