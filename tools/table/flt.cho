edition 5;

module flt;

// `:float` (docs/numbers.md, section 4): a cell read as the nearest double, kept as an `int` whose order is the order of the doubles, and written back
// as the shortest decimal that reads back to the same double.
//
// **Reading.** `[+-]? digits? [. digits?] ([eE] [+-]? digits)?` with at least one digit in the mantissa, ASCII only, no space, no separator, no `inf`, no
// `nan`, at most 1,100 bytes (a decimal exactly halfway between two doubles has at most 767 significant digits). Two ways to the double, both correctly rounded:
// Clinger's fast path inline when the mantissa has at most 15 digits and the power of ten is within 10^-22..10^22 (both are doubles, so one multiplication or
// one division rounds once), and otherwise the exact reader of `std.json` (`to_float`: bignum arithmetic with the remainder as the sticky bit), fed the same number
// rewritten in the grammar of JSON (digits without leading zeros, `e`, the exponent): about a microsecond a cell, the cost of an exact answer until a reader that
// does not go through the tape exists (stage N3b, docs/numbers.md 4.2).
//
// **The key.** There is no negative zero (`-0` is `0`) and no NaN, so the doubles are totally ordered, and the 64 bits of a double, with the low 63 flipped when
// the sign bit is set, are an `int` whose signed order is the numeric order. min, max, the comparisons of `--where` and the distinct set all work on that `int`.
//
// **Writing.** `float_of_key` builds the double back (there is no `float_of_bits`: the mantissa times a power of two, which `std.math.ldexp` makes exactly), and
// `put_float` lays out the digits of `std.fmt.float_into` positionally from 1e-6 to 1e21 (always with a point: `3.0`) and leaves them scientific outside (`1e21`).

import std.buffer;
import std.fmt;
import std.json;
import std.math;
import dec;

static pow10_float: [float] {
    let t = alloc_slice[static](23, 1.0);
    var k = 1;
    while k < 23 {
        t[k] = t[k - 1] * 10.0;
        k = k + 1;
    }
    return t;
}

// The `int` that stands for the double `x` (finite): its bits with the low 63 flipped when negative; zero is 0 whichever zero it was.
pub fn key_of(x: float) -> [] int {
    if x == 0.0 {
        return 0;
    }
    let bits = bits_of(x);
    if bits < 0 {
        return bits ^ 0x7fffffffffffffff;
    }
    return bits;
}

// The double a key stands for.
pub fn float_of_key(key: int) -> [] float {
    var bits = key;
    if key < 0 {
        bits = key ^ 0x7fffffffffffffff;
    }
    let magnitude = bits & 0x7fffffffffffffff;
    let e = magnitude >> 52;
    let f = magnitude & 0xfffffffffffff;
    var x = 0.0;
    if e == 0 {
        x = math.ldexp(float_of(f), 0 - 1074);
    } else {
        x = math.ldexp(float_of(f | 0x10000000000000), e - 1075);
    }
    if bits < 0 {
        return 0.0 - x;
    }
    return x;
}

// Whether `data` is `inf`, `infinity` or `nan` in any case, with an optional sign: the words that are refused as not finite, not as not numbers.
fn is_word[&d](data: &d [byte]) -> [] bool {
    var at = 0;
    if len(data) > 0 && (int_of(data[0]) == '-' || int_of(data[0]) == '+') {
        at = 1;
    }
    let n = len(data) - at;
    if n != 3 && n != 8 {
        return false;
    }
    var word = 0;
    var i = 0;
    var ok = true;
    while i < n {
        var c = int_of(data[at + i]);
        if c >= 'A' && c <= 'Z' {
            c = c + 32;
        }
        word = word * 256 + c;
        i = i + 1;
    }
    if n == 3 {
        return word == 0x696e66 || word == 0x6e616e;
    }
    // "infinity"
    return word == 0x696e66696e697479;
}

// The cell as the exact reader of `std.json` reads it: the digits of the mantissa without leading zeros, `e`, and the decimal exponent that goes with them.
fn slow_reader[&d](data: &d [byte], negative: bool, point_fraction: int, exponent: int, nonzero: bool) -> [] float {
    var x = 0.0;
    region r {
        let text = alloc_slice[r](len(data) + 16, byte_of(0));
        let tape = alloc_slice[r](12, 0);
        var n = 0;
        var started = false;
        var i = 0;
        // the mantissa digits, skipping the sign and the point and the leading zeros, up to the exponent
        while i < len(data) && int_of(data[i]) != 'e' && int_of(data[i]) != 'E' {
            let c = int_of(data[i]);
            if c >= '0' && c <= '9' {
                if started || c != '0' {
                    started = true;
                    text[n] = data[i];
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        if !started {
            text[n] = byte_of('0');
            n = n + 1;
        }
        text[n] = byte_of('e');
        n = n + 1;
        var x10 = exponent - point_fraction;
        if x10 < 0 {
            text[n] = byte_of('-');
            n = n + 1;
            x10 = 0 - x10;
        }
        // the exponent's digits, most significant first
        var p = 1;
        while p * 10 <= x10 {
            p = p * 10;
        }
        while p > 0 {
            text[n] = byte_of('0' + x10 / p % 10);
            n = n + 1;
            p = p / 10;
        }
        let nodes = json.parse(text[0..n], tape);
        if nodes > 0 {
            x = json.to_float(text[0..n], tape, 0);
        }
    }
    if negative {
        return 0.0 - x;
    }
    return x;
}

// The exact way to a subnormal, for a number below the smallest normal double: the integer N = round(value * 2^1074), half to even, from the digits
// of the cell, in limbs of 32 bits (`dec.mul_small`, `dec.div_small`). 2 * D * 2^1074 is divided by 10^k in steps of at most 10^9, a flag remembering
// whether any step left a remainder; T = floor(2 * value * 2^1074), and its low bit says "half or more": more if something was left, exactly half if not
// (then to the even N). Answers N, or -1 when the number is not a subnormal after all. Why it exists: `std.json.to_float` rounds some subnormals the
// wrong way (about one in five of the cells that sit exactly on a midpoint, a hair above it or a hair below it, in the tests of this tool), so the answer
// for anything that small does not come from it.
fn subnormal_of[&d](data: &d [byte], point_fraction: int, exponent: int) -> [] int {
    var answer = 0 - 1;
    let k = point_fraction - exponent;
    if k <= 0 {
        return answer;
    }
    region r {
        let limbs = alloc_slice[r](160, 0);
        var i = 0;
        var started = false;
        while i < len(data) && int_of(data[i]) != 'e' && int_of(data[i]) != 'E' {
            let c = int_of(data[i]);
            if c >= '0' && c <= '9' {
                if started || c != '0' {
                    started = true;
                    let carry = dec.mul_small(limbs, 160, 10);
                    var j = 0;
                    var add = c - '0';
                    while add > 0 && j < 160 {
                        let v = limbs[j] + add;
                        limbs[j] = v & 0xffffffff;
                        add = v >> 32;
                        j = j + 1;
                    }
                }
            }
            i = i + 1;
        }
        // 2 * 2^1074 = 2^1075 = (2^30)^35 * 2^25
        var s = 0;
        while s < 35 {
            dec.mul_small(limbs, 160, 1073741824);
            s = s + 1;
        }
        dec.mul_small(limbs, 160, 33554432);
        var inexact = false;
        var left = k;
        while left > 0 {
            var step = left;
            if step > 9 {
                step = 9;
            }
            var p = 1;
            var q = 0;
            while q < step {
                p = p * 10;
                q = q + 1;
            }
            if dec.div_small(limbs, 160, p) != 0 {
                inexact = true;
            }
            left = left - step;
        }
        var high = false;
        var w = 2;
        while w < 160 {
            if limbs[w] != 0 {
                high = true;
            }
            w = w + 1;
        }
        if !high {
            let t = limbs[0] | limbs[1] << 32;
            var h = t >> 1;
            if t & 1 == 1 && (inexact || h & 1 == 1) {
                h = h + 1;
            }
            if h < 4503599627370496 {
                answer = h;
            }
        }
    }
    return answer;
}

// `data` as a float: (key, status). 0 it is; 9 not a number, 10 `inf` or `nan`, 11 past the range of a double, 12 a non-zero cell that is smaller than the
// smallest subnormal (it would read as zero), 13 longer than 1,100 bytes. The length is checked first, then the grammar of the whole cell.
pub fn parse_float[&d](data: &d [byte]) -> [] (int, int) {
    let n = len(data);
    if n > 1100 {
        return (0, 13);
    }
    var at = 0;
    var negative = false;
    if n > 0 && (int_of(data[0]) == '-' || int_of(data[0]) == '+') {
        negative = int_of(data[0]) == '-';
        at = 1;
    }
    var m = 0;
    var digits = 0;
    var fraction = 0;
    var seen_point = false;
    var inexact = false;
    var nonzero = false;
    var scanning = true;
    while at < n && scanning {
        let c = int_of(data[at]);
        if c >= '0' && c <= '9' {
            if c != '0' {
                nonzero = true;
            }
            if m < 900719925474099 {
                m = m * 10 + c - '0';
                if seen_point {
                    fraction = fraction + 1;
                }
            } else {
                inexact = true;
                if seen_point {
                    fraction = fraction + 1;
                }
            }
            digits = digits + 1;
            at = at + 1;
        } else if c == '.' && !seen_point {
            seen_point = true;
            at = at + 1;
        } else {
            scanning = false;
        }
    }
    if digits == 0 {
        if is_word(data) {
            return (0, 10);
        }
        return (0, 9);
    }
    var exponent = 0;
    if at < n {
        let c = int_of(data[at]);
        if c != 'e' && c != 'E' {
            return (0, 9);
        }
        at = at + 1;
        var exponent_negative = false;
        if at < n && (int_of(data[at]) == '-' || int_of(data[at]) == '+') {
            exponent_negative = int_of(data[at]) == '-';
            at = at + 1;
        }
        if at >= n {
            return (0, 9);
        }
        while at < n {
            let c2 = int_of(data[at]);
            if c2 < '0' || c2 > '9' {
                return (0, 9);
            }
            if exponent < 100000 {
                exponent = exponent * 10 + c2 - '0';
            }
            at = at + 1;
        }
        if exponent_negative {
            exponent = 0 - exponent;
        }
    }
    if !nonzero {
        return (0, 0);
    }
    var x = 0.0;
    let e10 = exponent - fraction;
    if !inexact && e10 >= 0 - 22 && e10 <= 22 {
        x = float_of(m);
        if e10 < 0 {
            x = x / pow10_float[0 - e10];
        } else {
            x = x * pow10_float[e10];
        }
        if negative {
            x = 0.0 - x;
        }
    } else {
        x = slow_reader(data, negative, fraction, exponent, nonzero);
        if x < 2.3e-308 && x > 0.0 - 2.3e-308 {
            let units = subnormal_of(data, fraction, exponent);
            if units >= 0 {
                x = math.ldexp(float_of(units), 0 - 1074);
                if negative {
                    x = 0.0 - x;
                }
            }
        }
    }
    if x > 1.7976931348623157e308 || x < 0.0 - 1.7976931348623157e308 {
        return (0, 11);
    }
    if x == 0.0 {
        return (0, 12);
    }
    return (key_of(x), 0);
}

// The key as text: the shortest decimal that reads back to the same double, positional from 1e-6 up to 1e21 and always with a point (`0.1`, `100.0`,
// `12345.67`), scientific outside (`1e21`, `1.5e-7`), `0.0` for zero.
pub fn put_float[&h](heap: &!h Heap, out: buffer.Buffer, key: int) -> [heap] buffer.Buffer {
    if key == 0 {
        return buffer.append(heap, out, "0.0");
    }
    let x = float_of_key(key);
    var o = out;
    region r {
        let t = alloc_slice[r](32, byte_of(0));
        let d = alloc_slice[r](24, byte_of(0));
        let n = fmt.float_into(t, x);
        var i = 0;
        var negative = false;
        if int_of(t[0]) == '-' {
            negative = true;
            i = 1;
        }
        var count = 0;
        while i < n && int_of(t[i]) != 'e' {
            if int_of(t[i]) != '.' {
                d[count] = t[i];
                count = count + 1;
            }
            i = i + 1;
        }
        // the exponent of the first digit
        var k = 0;
        var k_negative = false;
        i = i + 1;
        if i < n && int_of(t[i]) == '-' {
            k_negative = true;
            i = i + 1;
        }
        while i < n {
            k = k * 10 + int_of(t[i]) - '0';
            i = i + 1;
        }
        if k_negative {
            k = 0 - k;
        }
        if k >= 21 || k < 0 - 6 {
            o = buffer.append(heap, o, t[0..n]);
        } else {
            if negative {
                o = buffer.push(heap, o, byte_of('-'));
            }
            let point = k + 1;
            if point <= 0 {
                o = buffer.append(heap, o, "0.");
                var z = 0;
                while z < 0 - point {
                    o = buffer.push(heap, o, byte_of('0'));
                    z = z + 1;
                }
                o = buffer.append(heap, o, d[0..count]);
            } else if point >= count {
                o = buffer.append(heap, o, d[0..count]);
                var z = 0;
                while z < point - count {
                    o = buffer.push(heap, o, byte_of('0'));
                    z = z + 1;
                }
                o = buffer.append(heap, o, ".0");
            } else {
                o = buffer.append(heap, o, d[0..point]);
                o = buffer.push(heap, o, byte_of('.'));
                o = buffer.append(heap, o, d[point..count]);
            }
        }
    }
    return o;
}
