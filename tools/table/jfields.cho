edition 5;

module jfields;

// `--fields` (docs/readers.md section 12.3): the columns of a JSON-lines input, declared by path.
//
//     --fields id,status,user.name,items.0.sku,a\.b
//
// A list of paths separated by commas; a path is segments separated by dots; a backslash escapes the next byte, which is one of `,` `\` `#` `.`. The name of the
// column is the item as written (but for `\,`, written as a comma); the segments are the item cut at its unescaped dots and unescaped.
//
// What `parse` answers (`Fields`): the names as a header (their bytes and where each ends, what `frame.cho` resolves the plan against), the segments' bytes, and
// `table`, 2 ints a field (the first segment of the field, how many) followed by 3 ints a segment (where its bytes begin and end in `sbytes`, and the index
// it names in an array: -1 when it is not one, `0` or digits with no leading zero otherwise).

import std.buffer;
import std.vec;

// The ceilings of docs/readers.md section 12.3.
pub fn most_fields() -> [] int {
    return 4096;
}

pub fn most_segments() -> [] int {
    return 8;
}

pub res struct Fields {
    fnames: buffer.Buffer,
    fends: vec.Vec[int],
    fsbytes: buffer.Buffer,
    ftable: Box[[int]],
    // 0 every item is a path; else why not (`input.bad-fields`): 1 an empty item or segment, 2 an escape that is none of `,` `\` `#` `.`, 3 a path of more than 8
    // segments, 4 the same path twice, 5 more than 4096 paths
    fstatus: int,
    // the 0-based item it is about
    fat: int,
}

pub fn drop[&h](heap: &!h Heap, f: Fields) -> [heap] int {
    let Fields { fnames, fends, fsbytes, ftable, fstatus, fat } = f;
    buffer.drop(heap, fnames);
    vec.drop(heap, fends);
    buffer.drop(heap, fsbytes);
    unbox_slice(heap, ftable);
    return 0;
}

pub fn count[&f](f: &f Fields) -> [] int {
    return vec.size(f.fends);
}

// The reason `status` stands for, as the refusal says it.
pub fn reason_of(status: int) -> [] &static [byte] {
    if status == 1 {
        return "an empty path, or an empty segment (two dots, or a dot at an end)";
    }
    if status == 2 {
        return "a backslash escapes only a comma, a backslash, a # or a dot";
    }
    if status == 3 {
        return "a path has at most 8 segments";
    }
    if status == 4 {
        return "the same path is declared twice";
    }
    return "at most 4096 paths";
}

// The index a segment names in an array: -1 when it is not one.
fn index_of[&s](seg: &s [byte]) -> [] int {
    let n = len(seg);
    if n == 0 || n > 18 {
        return 0 - 1;
    }
    if int_of(seg[0]) == '0' {
        if n == 1 {
            return 0;
        }
        return 0 - 1;
    }
    var v = 0;
    var i = 0;
    while i < n {
        let c = int_of(seg[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        v = v * 10 + (c - '0');
        i = i + 1;
    }
    return v;
}

fn same[&a, &b](a: &a [byte], b: &b [byte]) -> [] bool {
    if len(a) != len(b) {
        return false;
    }
    var i = 0;
    while i < len(a) {
        if int_of(a[i]) != int_of(b[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn parse[&h, &g](heap: &!h Heap, given: &g [byte]) -> [heap] Fields {
    var names = buffer.empty(heap, len(given) + 1);
    var ends = vec.empty(heap, 8, 0);
    var sbytes = buffer.empty(heap, len(given) + 1);
    // per field: first segment, how many; then per segment: begin, end, index (collected apart, joined at the end)
    var fields = vec.empty(heap, 16, 0);
    var segs = vec.empty(heap, 24, 0);
    var status = 0;
    var at = 0;
    var item = 0;
    var seg_count = 0;
    var item_segs = 0;
    var i = 0;
    var n = len(given);
    var done = false;
    var sbegin = 0;
    var nbegin = 0;
    while !done && status == 0 {
        var c = 0 - 1;
        if i < n {
            c = int_of(given[i]);
        }
        if c == '\\' {
            if i + 1 < n {
                let d = int_of(given[i + 1]);
                if d == ',' {
                    names = buffer.push(heap, names, byte_of(','));
                    sbytes = buffer.push(heap, sbytes, byte_of(','));
                } else if d == '\\' || d == '#' || d == '.' {
                    names = buffer.push(heap, names, byte_of('\\'));
                    names = buffer.push(heap, names, byte_of(d));
                    sbytes = buffer.push(heap, sbytes, byte_of(d));
                } else {
                    status = 2;
                    at = item;
                }
            } else {
                status = 2;
                at = item;
            }
            if status == 0 {
                i = i + 2;
            }
        } else if c == '.' || c == ',' || c < 0 {
            // a segment ends
            var send = 0;
            borrow sbytes as &sr in {
                send = buffer.size(sr);
            }
            if send == sbegin {
                status = 1;
                at = item;
            } else {
                var ix = 0 - 1;
                borrow sbytes as &sr in {
                    ix = index_of(buffer.bytes(sr)[sbegin..send]);
                }
                segs = vec.push(heap, segs, sbegin);
                segs = vec.push(heap, segs, send);
                segs = vec.push(heap, segs, ix);
                item_segs = item_segs + 1;
                if item_segs > most_segments() {
                    status = 3;
                    at = item;
                }
                sbegin = send;
            }
            if status == 0 && c == '.' {
                names = buffer.push(heap, names, byte_of('.'));
                i = i + 1;
            } else if status == 0 {
                // an item ends
                var nend = 0;
                borrow names as &nr in {
                    nend = buffer.size(nr);
                }
                // the same name twice
                var k = 0;
                var from = 0;
                var twice = false;
                borrow names as &nr in {
                    borrow ends as &er in {
                        let mine = buffer.bytes(nr)[nbegin..nend];
                        while k < vec.size(er) && !twice {
                            let to = vec.get(er, k);
                            if same(buffer.bytes(nr)[from..to], mine) {
                                twice = true;
                            }
                            from = to;
                            k = k + 1;
                        }
                    }
                }
                if twice {
                    status = 4;
                    at = item;
                } else {
                    ends = vec.push(heap, ends, nend);
                    fields = vec.push(heap, fields, seg_count);
                    fields = vec.push(heap, fields, item_segs);
                    seg_count = seg_count + item_segs;
                    item_segs = 0;
                    nbegin = nend;
                    item = item + 1;
                    if item > most_fields() {
                        status = 5;
                        at = item - 1;
                    }
                    if c < 0 {
                        done = true;
                    }
                    i = i + 1;
                }
            }
        } else {
            names = buffer.push(heap, names, byte_of(c));
            sbytes = buffer.push(heap, sbytes, byte_of(c));
            i = i + 1;
        }
    }
    var nf = 0;
    borrow ends as &ner in {
        nf = vec.size(ner);
    }
    var table = box_slice(heap, 2 * nf + 3 * seg_count + 1, 0);
    borrow mut table as &!tw in {
        borrow fields as &fr in {
            borrow segs as &gr in {
                let t = contents(tw);
                var k = 0;
                while k < nf {
                    t[2 * k] = vec.get(fr, 2 * k);
                    t[2 * k + 1] = vec.get(fr, 2 * k + 1);
                    k = k + 1;
                }
                k = 0;
                while k < 3 * seg_count {
                    t[2 * nf + k] = vec.get(gr, k);
                    k = k + 1;
                }
            }
        }
    }
    vec.drop(heap, fields);
    vec.drop(heap, segs);
    return Fields { fnames: names, fends: ends, fsbytes: sbytes, ftable: table, fstatus: status, fat: at };
}
