edition 5;

module ctext;

// The text functions of `--compute` (docs/functions.md section 3.3): the evaluator of a text-valued definition. A text program is the same four ints an instruction as the number program
// (`op`, `a`, `b`, `c`), postfix: `op_col` loads a cell (a quoted cell with its doubled quotes undone), `op_lit` a string literal read from the text of the definitions (`a` and `b` are the
// offsets of what is between its quotes, its doubled quotes undone as it is loaded), `op_call` a function (`a` its id, `b` how many values it takes off the stack, `c` the `start` and
// `count` of a `substr`, packed). A value is a range of one buffer, the arena, which is emptied for each definition of each row: lower, upper, concat and replace append a new text to it,
// trim and substr only narrow a range. Nothing here is a float, and nothing is a locale: `lower` and `upper` change the 26 ASCII letters, `trim` removes the space and the tab.

import std.buffer;

pub fn op_col() -> [] int {
    return 16;
}

pub fn op_lit() -> [] int {
    return 17;
}

pub fn op_call() -> [] int {
    return 18;
}

// The two statuses of a row: a text longer than the line limit, and a cut inside a character.
pub fn s_too_long() -> [] int {
    return 17;
}

pub fn s_boundary() -> [] int {
    return 18;
}

// 0x80 to 0xBF: a byte that continues a character.
fn continuation(c: int) -> [] bool {
    return c >= 128 && c <= 191;
}

// `record[first..last]` appended to `arena`: as it is, or with each doubled quote one quote (a cell the reader read inside quotes, and a string literal).
fn load[&h, &r](heap: &!h Heap, arena: buffer.Buffer, record: &r [byte], first: int, last: int, doubled: int) -> [heap] buffer.Buffer {
    if doubled == 0 {
        return buffer.append(heap, arena, record[first..last]);
    }
    var a = arena;
    var i = first;
    while i < last {
        a = buffer.push(heap, a, record[i]);
        if int_of(record[i]) == 34 && i + 1 < last && int_of(record[i + 1]) == 34 {
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return a;
}

// The number of bytes of `record[first..last]` once its doubled quotes are undone: what `len` counts.
pub fn length[&r](record: &r [byte], first: int, last: int, doubled: int) -> [] int {
    if doubled == 0 {
        return last - first;
    }
    var n = 0;
    var i = first;
    while i < last {
        n = n + 1;
        if int_of(record[i]) == 34 && i + 1 < last && int_of(record[i + 1]) == 34 {
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return n;
}

fn is_blank(c: int) -> [] bool {
    return c == 32 || c == 9;
}

// Definition `d` against one row. Answers the arena (holding the value), the status, and the range of the value in the arena: status 0, 17 (a text longer than `cap` bytes) or 18 (`substr`
// would cut between a byte and a continuation byte). `t` is the text of the definitions, for the literals.
pub fn eval[&h, &p, &t, &r, &c](heap: &!h Heap, prog: &p [int], d: int, t: &t [byte], record: &r [byte], cells: &c [int], arena0: buffer.Buffer, cap: int) -> [heap] (buffer.Buffer, int, int, int) {
    var arena = arena0;
    borrow mut arena as &!aw in {
        buffer.clear(aw);
    }
    var stk = box_slice(heap, 64, 0);
    var sp = 0;
    var status = 0;
    var at = prog[1 + 5 * d];
    let end = prog[1 + 5 * d + 1];
    while at < end && status == 0 {
        let op = prog[at];
        if op == op_col() || op == op_lit() {
            var from = 0;
            var to = 0;
            var doubled = 1;
            if op == op_col() {
                from = cells[3 * prog[at + 1]];
                to = cells[3 * prog[at + 1] + 1];
                doubled = cells[3 * prog[at + 1] + 2];
            } else {
                from = prog[at + 1];
                to = prog[at + 2];
            }
            var s0 = 0;
            borrow arena as &ar in {
                s0 = buffer.size(ar);
            }
            if op == op_col() {
                arena = load(heap, arena, record, from, to, doubled);
            } else {
                arena = load(heap, arena, t, from, to, doubled);
            }
            var e0 = 0;
            borrow arena as &ar in {
                e0 = buffer.size(ar);
            }
            if e0 - s0 > cap {
                status = 17;
            }
            borrow mut stk as &!sw in {
                contents(sw)[2 * sp] = s0;
                contents(sw)[2 * sp + 1] = e0;
            }
            sp = sp + 1;
        } else {
            let id = prog[at + 1];
            let n = prog[at + 2];
            let base = sp - n;
            var s0 = 0;
            var e0 = 0;
            borrow stk as &sr in {
                s0 = contents(sr)[2 * base];
                e0 = contents(sr)[2 * base + 1];
            }
            var rs = s0;
            var re = e0;
            var made = false;
            var tmp = buffer.empty(heap, 64);
            if id == 11 || id == 12 {
                // lower, upper: the ASCII letters only
                borrow arena as &ar in {
                    let data = buffer.bytes(ar);
                    var k = s0;
                    while k < e0 {
                        var b = int_of(data[k]);
                        if id == 11 && b >= 65 && b <= 90 {
                            b = b + 32;
                        } else if id == 12 && b >= 97 && b <= 122 {
                            b = b - 32;
                        }
                        tmp = buffer.push(heap, tmp, byte_of(b));
                        k = k + 1;
                    }
                }
                made = true;
            } else if id >= 13 && id <= 15 {
                // trim, ltrim, rtrim: the range narrows
                borrow arena as &ar in {
                    let data = buffer.bytes(ar);
                    if id != 15 {
                        while rs < re && is_blank(int_of(data[rs])) {
                            rs = rs + 1;
                        }
                    }
                    if id != 14 {
                        while re > rs && is_blank(int_of(data[re - 1])) {
                            re = re - 1;
                        }
                    }
                }
            } else if id == 16 {
                // substr(s, start, count): bytes from start (1 is the first), clipped; no cut between a byte and a continuation byte
                let start = prog[at + 3] / 2147483648;
                let count = prog[at + 3] % 2147483648;
                let len = e0 - s0;
                let i = start - 1;
                if i >= len {
                    rs = s0;
                    re = s0;
                } else {
                    var stop = i + count;
                    if stop > len {
                        stop = len;
                    }
                    borrow arena as &ar in {
                        let data = buffer.bytes(ar);
                        if i > 0 && continuation(int_of(data[s0 + i])) {
                            status = 18;
                        }
                        if stop > 0 && stop < len && continuation(int_of(data[s0 + stop])) {
                            status = 18;
                        }
                    }
                    rs = s0 + i;
                    re = s0 + stop;
                }
            } else if id == 17 {
                // concat: the values one after the other
                borrow arena as &ar in {
                    let data = buffer.bytes(ar);
                    var j = 0;
                    while j < n {
                        var js = 0;
                        var je = 0;
                        borrow stk as &sr in {
                            js = contents(sr)[2 * (base + j)];
                            je = contents(sr)[2 * (base + j) + 1];
                        }
                        tmp = buffer.append(heap, tmp, data[js..je]);
                        j = j + 1;
                    }
                }
                made = true;
            } else {
                // replace(s, from, to): every non-overlapping `from`, left to right
                var fs = 0;
                var fe = 0;
                var ts = 0;
                var te = 0;
                borrow stk as &sr in {
                    fs = contents(sr)[2 * (base + 1)];
                    fe = contents(sr)[2 * (base + 1) + 1];
                    ts = contents(sr)[2 * (base + 2)];
                    te = contents(sr)[2 * (base + 2) + 1];
                }
                borrow arena as &ar in {
                    let data = buffer.bytes(ar);
                    let flen = fe - fs;
                    var k = s0;
                    while k < e0 {
                        var hit = k + flen <= e0;
                        var m = 0;
                        while hit && m < flen {
                            if int_of(data[k + m]) != int_of(data[fs + m]) {
                                hit = false;
                            }
                            m = m + 1;
                        }
                        if hit {
                            tmp = buffer.append(heap, tmp, data[ts..te]);
                            k = k + flen;
                        } else {
                            tmp = buffer.push(heap, tmp, data[k]);
                            k = k + 1;
                        }
                        var tsz = 0;
                        borrow tmp as &tr in {
                            tsz = buffer.size(tr);
                        }
                        if tsz > cap + 1 {
                            // a value past the limit is refused as soon as it is certain: the arena never holds more than a limit's worth for a value
                            k = e0;
                        }
                    }
                }
                made = true;
            }
            if made {
                var size = 0;
                borrow tmp as &tr in {
                    size = buffer.size(tr);
                }
                if size > cap {
                    status = 17;
                } else {
                    var s1 = 0;
                    borrow arena as &ar in {
                        s1 = buffer.size(ar);
                    }
                    borrow tmp as &tr in {
                        arena = buffer.append(heap, arena, buffer.bytes(tr));
                    }
                    rs = s1;
                    re = s1 + size;
                }
            }
            buffer.drop(heap, tmp);
            borrow mut stk as &!sw in {
                contents(sw)[2 * base] = rs;
                contents(sw)[2 * base + 1] = re;
            }
            sp = base + 1;
        }
        at = at + 4;
    }
    var vs = 0;
    var ve = 0;
    borrow stk as &sr in {
        vs = contents(sr)[0];
        ve = contents(sr)[1];
    }
    unbox_slice(heap, stk);
    return (arena, status, vs, ve);
}
