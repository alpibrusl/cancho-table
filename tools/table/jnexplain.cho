edition 5;

module jnexplain;

// `--explain` of a join (docs/joins.md section 8.4, docs/query.md section 15): the plan said and not run. Both files are opened and their headers read, as the run reads them
// (`jnhead`), and nothing after a header is read; the key columns, a name both files have and the plan are resolved as the run resolves them, so a plan the run would refuse before a
// row is refused here with the same error. The document is the one `explain.document` writes with a `join` member (`data.explain.join`). Standard input is not read: with a pipe for
// the probe its header is unknown, so the joined header is not either, and the document says so.

import std.buffer;
import std.bytes;
import std.vec;
import dtparse;
import explain;
import finish;
import frame;
import jnfail;
import jnflags;
import jnswap;
import jnfmt;
import jnhead;
import jnjson;
import jnwhere;
import jxsrc;
import orparse;
import qpath;
import query;
import spec;
import toolbox.cli;
import toolbox.fail;
import toolbox.place;
import toolbox.text;

// The most accounted bytes a build file of `size` bytes with `columns` columns and a header of `header` bytes can hold, from the size alone (docs/joins.md section 6.3): every non-blank record
// has at least `columns` bytes (and at least two), so there are at most (size - header) / that + 1 rows; the records hold at most size - header bytes and the distinct keys, which are
// inside them, no more; each row costs 16 and each distinct key 60. So accounted <= 2 * (size - header) + 76 * rows. Loose for a narrow file, and an upper bound only: no lower
// bound can be had from the size (blank lines), so it is never said that a file will pass the bound.
// J2: a key that is a typed pair is 8 bytes whatever its cell, and several pairs carry 4 bytes of length each, so a key can be longer than the cells it comes from, by at most 12 bytes for each
// pair (`extra`: 0 for one pair of text, else 12 for each); a semi or anti join holds no rows (`keys_only`): the keys, at 44 each, so accounted <= (size - header) + (44 + extra) * rows.
fn at_most(size: int, header: int, columns: int, extra: int, keys_only: bool) -> [] int {
    if size < 0 {
        return 0 - 1;
    }
    let body = size - header;
    if body <= 0 {
        return 0;
    }
    var least = columns;
    if least < 2 {
        least = 2;
    }
    let rows = body / least + 1;
    if keys_only {
        return body + (44 + extra) * rows;
    }
    return 2 * body + (76 + extra) * rows;
}

// The same for a build of JSON lines (docs/joins.md section 21): there is no header, a record is at least the two bytes `{}` and a line feed (three bytes, the last record having none), so there are at most
// size / 3 + 1 records; the csv record of a line is at most the line and `columns` more (the record of `{}` with every path absent is `columns - 1` delimiters, and a path present costs at most the
// bytes of its JSON text and two quotes against the four or more bytes of its `"k":`), so the records hold at most size + columns * rows; and the keys, which are inside them, no more. So
// accounted <= 2 * (size + columns * rows) + (76 + extra) * rows, and a keys-only build (size + columns * rows) + (44 + extra) * rows. Loose, and an upper bound only.
fn at_most_j(size: int, columns: int, extra: int, keys_only: bool) -> [] int {
    if size < 0 {
        return 0 - 1;
    }
    if size == 0 {
        return 0;
    }
    let rows = size / 3 + 1;
    let body = size + columns * rows;
    if keys_only {
        return body + (44 + extra) * rows;
    }
    return 2 * body + (76 + extra) * rows;
}

// The reader of a JSON-lines side as the document says it (`"probe_reader"` or `"build_reader"`): its declared columns, `--absent` and `--max-json-nodes`. A side that is csv with the probe's delimiter has no such
// member, and the document of a join of two such files is what it was.
fn jsonl_reader[&h, &n, &e](heap: &!h Heap, o: buffer.Buffer, key: &static [byte], names: &n buffer.Buffer, ends: &e vec.Vec[int], count: int, absent: int, nodes: int) -> [heap] buffer.Buffer {
    var out = buffer.append(heap, o, key);
    out = buffer.append(heap, out, "{\"format\":\"jsonl\",\"fields\":[");
    var k = 0;
    while k < count {
        if k > 0 {
            out = buffer.push(heap, out, byte_of(','));
        }
        out = text.append_json(heap, out, finish.name_of(names, ends, k));
        k = k + 1;
    }
    out = buffer.append(heap, out, "],\"absent\":\"");
    if absent == 1 {
        out = buffer.append(heap, out, "empty");
    } else {
        out = buffer.append(heap, out, "refuse");
    }
    out = buffer.append(heap, out, "\",\"max_json_nodes\":");
    out = buffer.push_nat(heap, out, nodes);
    return buffer.push(heap, out, byte_of('}'));
}

fn spelled[&h, &d](heap: &!h Heap, o: buffer.Buffer, name: &d [byte], kind: int) -> [heap] buffer.Buffer {
    if kind >= 1 {
        var s = buffer.empty(heap, 16);
        s = buffer.push(heap, s, byte_of('#'));
        s = buffer.push_nat(heap, s, kind);
        var out = o;
        borrow s as &sr in {
            out = text.append_json(heap, out, buffer.bytes(sr));
        }
        buffer.drop(heap, s);
        return out;
    }
    return text.append_json(heap, o, name);
}

// The type of a pair as the document spells it.
fn type_name[&h](heap: &!h Heap, o: buffer.Buffer, t: int) -> [heap] buffer.Buffer {
    if t == 0 {
        return buffer.append(heap, o, "\"text\"");
    }
    if t == 1 {
        return buffer.append(heap, o, "\"int\"");
    }
    if t == 21 {
        return buffer.append(heap, o, "\"float\"");
    }
    if t >= 22 {
        var d = buffer.push(heap, o, byte_of(34));
        d = buffer.append(heap, d, dtparse.type_text(t));
        return buffer.push(heap, d, byte_of(34));
    }
    var out = buffer.append(heap, o, "\"dec(");
    out = buffer.push_nat(heap, out, t - 2);
    return buffer.append(heap, out, ")\"");
}

// The text of the `join` member. `jtype`: 0 inner, 1 left, 2 semi, 3 anti.
fn join_doc[&h, &g, &p, &s, &t, &k, &w, &j, &x, &y, &z](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, jxs: &x [byte], stdin: bool, shown: &s [byte], shown_b: &t [byte], np: int, nk: int, keys: &k [int], pairs: int, bsize: int, bheader: int, known: bool, jtype: int, nb: int, where_json: &w [byte], jw_json: &j [byte], shared: &static [byte], reader_json: &y [byte], bjsonl: bool, swap_json: &z [byte]) -> [heap, args] buffer.Buffer {
    let table = spec.flag_table();
    let on = jnflags.on_of(heap, args, parsed, jxs);
    let budget = cli.nat(args, parsed, table, "max-state-bytes");
    // `--join-sorted` (docs/joins.md section 23): the files are merged, one key of the --join file held at a time
    let merging = cli.has(parsed, table, "join-sorted");
    var typed = false;
    var j = 0;
    while j < pairs {
        if keys[3 * j + 2] != 0 {
            typed = true;
        }
        j = j + 1;
    }
    var extra = 0;
    if pairs > 1 || typed {
        extra = 12 * pairs;
    }
    var most = at_most(bsize, bheader, nb, extra, jtype >= 2);
    if bjsonl {
        most = at_most_j(bsize, nb, extra, jtype >= 2);
    }
    var o = buffer.empty(heap, 1024);
    o = buffer.append(heap, o, "{\"type\":");
    if jtype == 1 {
        o = buffer.append(heap, o, "\"left\"");
    } else if jtype == 2 {
        o = buffer.append(heap, o, "\"semi\"");
    } else if jtype == 3 {
        o = buffer.append(heap, o, "\"anti\"");
    } else {
        o = buffer.append(heap, o, "\"inner\"");
    }
    o = buffer.append(heap, o, ",\"probe\":");
    if stdin {
        o = text.append_json(heap, o, "-");
    } else {
        o = text.append_json(heap, o, shown);
    }
    o = buffer.append(heap, o, ",\"build\":");
    o = text.append_json(heap, o, shown_b);
    o = buffer.append(heap, o, reader_json);
    if merging {
        o = buffer.append(heap, o, ",\"sorted\":true,\"role_choice\":\"the --join file is read in step with the operand or standard input, both declared sorted by the key: the rows of one key of the --join file are held at a time, and the operand is streamed\",\"keys\":[");
    } else {
        o = buffer.append(heap, o, ",\"role_choice\":\"the --join file is the build side: it is held whole in memory, and the operand or standard input is the probe side, streamed\",\"keys\":[");
    }
    borrow on as &onr in {
        j = 0;
        while j < pairs {
            if j > 0 {
                o = buffer.push(heap, o, byte_of(','));
            }
            o = buffer.append(heap, o, "{\"probe\":");
            o = spelled(heap, o, jnflags.name_at(onr, 2 * j), vec.get(onr.kinds, 2 * j));
            o = buffer.append(heap, o, ",\"build\":");
            o = spelled(heap, o, jnflags.name_at(onr, 2 * j + 1), vec.get(onr.kinds, 2 * j + 1));
            o = buffer.append(heap, o, ",\"type\":");
            o = type_name(heap, o, keys[3 * j + 2]);
            o = buffer.append(heap, o, ",\"probe_position\":");
            if known {
                o = buffer.push_nat(heap, o, keys[3 * j] + 1);
            } else {
                o = buffer.append(heap, o, "null");
            }
            o = buffer.append(heap, o, ",\"build_position\":");
            o = buffer.push_nat(heap, o, keys[3 * j + 1] + 1);
            o = buffer.push(heap, o, byte_of('}'));
            j = j + 1;
        }
    }
    o = buffer.append(heap, o, "],\"output_columns\":");
    if known {
        o = buffer.push_nat(heap, o, np + nk);
    } else {
        o = buffer.append(heap, o, "null");
    }
    o = buffer.append(heap, o, ",\"prefix\":");
    let prefixb = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_prefix(), "join-prefix");
    borrow prefixb as &pxr in {
        o = text.append_json(heap, o, buffer.bytes(pxr));
    }
    buffer.drop(heap, prefixb);
    o = buffer.append(heap, o, ",\"using\":[");
    var listed = 0;
    borrow on as &onr in {
        j = 0;
        while j < pairs {
            if vec.get(onr.using, j) == 1 && jtype <= 1 {
                if listed > 0 {
                    o = buffer.push(heap, o, byte_of(','));
                }
                o = spelled(heap, o, jnflags.name_at(onr, 2 * j), 0 - 1);
                listed = listed + 1;
            }
            j = j + 1;
        }
    }
    o = buffer.append(heap, o, "],\"build_state\":{\"file_bytes\":");
    if bsize < 0 {
        o = buffer.append(heap, o, "null");
    } else {
        o = buffer.push_nat(heap, o, bsize);
    }
    o = buffer.append(heap, o, ",\"header_bytes\":");
    o = buffer.push_nat(heap, o, bheader);
    o = buffer.append(heap, o, ",\"accounted_at_most\":");
    if most < 0 || merging {
        o = buffer.append(heap, o, "null");
    } else {
        o = buffer.push_nat(heap, o, most);
    }
    o = buffer.append(heap, o, ",\"budget\":");
    o = buffer.push_nat(heap, o, budget);
    o = buffer.append(heap, o, ",\"may_pass_bound\":");
    if most > budget || merging {
        o = buffer.append(heap, o, "true");
    } else {
        o = buffer.append(heap, o, "false");
    }
    if merging {
        o = buffer.append(heap, o, ",\"counted\":\"the rows of ONE key of the --join file at a time, the one a probe row meets: held record bytes + 16 for each row and key bytes + 60 for the key (a semi or anti join: key bytes + 44), not resident memory; a group of equal keys that passes the bound alone is limit.state-too-large with detail.holder join-group\"");
    } else if jtype >= 2 {
        o = buffer.append(heap, o, ",\"counted\":\"key bytes + 44 for each distinct key (a semi or anti join holds the keys only; a key is 8 bytes for a typed pair and 4 bytes of length more for each pair of several): not resident memory, which can be up to about three times that while the build grows (measured 1.5 to 2.8)\"");
    } else {
        o = buffer.append(heap, o, ",\"counted\":\"held record bytes + 16 for each row held (a record keeps the cells of the columns the plan names and holds the others empty), key bytes + 60 for each distinct key (a key is 8 bytes for a typed pair and 4 bytes of length more for each pair of several): not resident memory, which can be up to about three times that while the build grows (measured 1.5 to 2.8)\"");
    }
    o = buffer.append(heap, o, ",\"shared_with\":");
    if len(shared) == 0 {
        o = buffer.append(heap, o, "null");
    } else {
        o = text.append_json(heap, o, shared);
    }
    o = buffer.append(heap, o, ",\"swap\":");
    if merging {
        o = buffer.append(heap, o, "{\"offered\":false,\"reason\":\"--join-sorted does not hold the --join file, only the rows of one key of it\"}");
    } else {
        o = buffer.append(heap, o, swap_json);
    }
    o = buffer.append(heap, o, "},\"where\":");
    o = buffer.append(heap, o, where_json);
    o = buffer.append(heap, o, ",\"join_where\":");
    o = buffer.append(heap, o, jw_json);
    o = buffer.append(heap, o, ",\"max_join_rows\":");
    o = buffer.push_nat(heap, o, cli.nat(args, parsed, table, "max-join-rows"));
    if merging {
        o = buffer.append(heap, o, ",\"order\":\"key order (both files are declared sorted by the key, so it is the order of the operand, then the order of the --join file within a key)\",\"work\":{\"class\":\"join: merge of two sorted files\",\"first_output_after\":\"the first probe row and the group of its key in the --join file\",\"threads\":{\"requested\":");
    } else {
        o = buffer.append(heap, o, ",\"order\":\"probe order, then build order\",\"work\":{\"class\":\"join: build then stream\",\"first_output_after\":\"the whole build\",\"threads\":{\"requested\":");
    }
    o = buffer.push_nat(heap, o, cli.nat(args, parsed, table, "threads"));
    o = buffer.append(heap, o, ",\"effective\":1,\"reason\":\"the join is read on one core\"}}}");
    jnflags.drop_on(heap, on);
    return o;
}

fn size_of[&f](file: &!f File) -> [file_read] int {
    var size = 0 - 1;
    match file_size(file) {
        Done::Ok(n) => {
            size = n;
        }
        Done::Failed(reason) => {
            size = 0 - 1;
        }
    }
    return size;
}

pub fn settle[&h, &g, &p, &s, &rt, &fs, &x](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, jxs: &x [byte], fs: &fs Fs(""), root: &rt [byte], opened: File, stdin: bool, shown: &s [byte], delim: int, mode: int, as_csv: bool, from: int, limit: int, budget: int, top: int, tree0: query.Query, names_at: int, errs: fail.Errors, payload0: buffer.Buffer) -> [heap, args, fs_read(""), dir_read] (query.Query, fail.Errors, buffer.Buffer) {
    let table = spec.flag_table();
    var e = errs;
    var payload = payload0;
    let cap = cli.nat(args, parsed, table, "max-line-bytes");
    // the formats of the two files (docs/joins.md section 21): a JSON-lines side has no header to read, its declaration is the header
    let fmt = jnfmt.of(args, parsed);
    let bdelim = jnfmt.build_delim(fmt, delim);
    var absent = 0;
    var nodes = 4096;
    if fmt.p_jsonl || fmt.b_jsonl {
        if bytes.equal(cli.text(args, parsed, table, "absent"), "empty") {
            absent = 1;
        }
        nodes = cli.nat(args, parsed, table, "max-json-nodes");
    }
    // whether the probe's header is known: a file's is read, a pipe's is not, and a JSON-lines probe's is the declaration, from a file or a pipe
    let known = !stdin || fmt.p_jsonl;
    var hp = jnhead.no_head(heap);
    var psize = 0 - 1;
    var pfile = opened;
    if fmt.p_jsonl {
        let (pd, ph0) = jnjson.decl_of(heap, fmt.p_fields, absent, nodes);
        jnjson.drop_decl(heap, pd);
        jnhead.drop_head(heap, hp);
        hp = ph0;
        if !stdin {
            borrow mut pfile as &!ph in {
                psize = size_of(ph);
            }
        }
    } else if !stdin {
        borrow mut pfile as &!ph in {
            jnhead.drop_head(heap, hp);
            hp = explain.read_head(heap, ph, cap, delim, 0);
            psize = size_of(ph);
        }
    }
    file_close(pfile);
    var hb = jnhead.no_head(heap);
    var bsize = 0 - 1;
    var read_build = false;
    var full = buffer.empty(heap, 1);
    var shown_at = 0 - 1;
    let jpb = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_join(), "join");
    borrow jpb as &jpr in {
        buffer.drop(heap, full);
        let (full2, shown2, checked) = qpath.resolve(heap, root, buffer.bytes(jpr), e);
        full = full2;
        shown_at = shown2;
        e = checked;
    }
    buffer.drop(heap, jpb);
    var shown_b_copy = buffer.empty(heap, 1);
    borrow full as &fr in {
        if shown_at >= 0 {
            let whole = buffer.bytes(fr);
            let build = whole[shown_at..len(whole)];
            shown_b_copy = buffer.append(heap, shown_b_copy, build);
            match place.open_operand(fs, root, build, whole) {
                Opened::Failed(reason) => {
                    e = fail.io_error(heap, e, reason, false, build);
                }
                Opened::Ok(bopened) => {
                    var bf = bopened;
                    borrow mut bf as &!bh in {
                        jnhead.drop_head(heap, hb);
                        if fmt.b_jsonl {
                            let (bd, bh0) = jnjson.decl_of(heap, fmt.b_fields, absent, nodes);
                            jnjson.drop_decl(heap, bd);
                            hb = bh0;
                        } else {
                            hb = explain.read_head(heap, bh, cap, bdelim, 0);
                        }
                        bsize = size_of(bh);
                    }
                    file_close(bf);
                    read_build = true;
                }
            }
        }
    }
    buffer.drop(heap, full);
    var refused = !read_build;
    if read_build {
        borrow tree0 as &tq in {
            borrow shown_b_copy as &sb in {
                borrow hb as &hbr in {
                    let (e2, bad) = jnhead.head_refusal(heap, args, parsed, tq, hbr, buffer.bytes(sb), budget, e);
                    e = e2;
                    refused = bad;
                }
                if !refused && known {
                    borrow hp as &hpr in {
                        let (e2, bad) = jnhead.head_refusal(heap, args, parsed, tq, hpr, shown, budget, e);
                        e = e2;
                        refused = bad;
                    }
                }
            }
        }
    }
    if refused {
        buffer.drop(heap, shown_b_copy);
        jnhead.drop_head(heap, hb);
        jnhead.drop_head(heap, hp);
        return (tree0, e, payload);
    }
    var keys = box_slice(heap, 3, 0);
    var kmap = box_slice(heap, 1, 0);
    var pairs = 0;
    var np = 0;
    var nb = 0;
    var nk = 0;
    var jnames = buffer.empty(heap, 1);
    var jends = vec.empty(heap, 1, 0);
    var ok = false;
    var jtype = 0;
    let jw_on = jxsrc.has(parsed, jxs, jxsrc.s_join_where(), "join-where");
    var jwtree = query.empty(heap);
    let wordb = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_type(), "join-type");
    borrow wordb as &wdr in {
        let word = buffer.bytes(wdr);
        if bytes.equal(word, "left") {
            jtype = 1;
        } else if bytes.equal(word, "semi") {
            jtype = 2;
        } else if bytes.equal(word, "anti") {
            jtype = 3;
        }
    }
    buffer.drop(heap, wordb);
    borrow shown_b_copy as &sb in {
        borrow hp as &hpr in {
            borrow hb as &hbr in {
                let (u, e2) = jnhead.unite(heap, args, parsed, jxs, e, hpr.names, hpr.ends, hbr.names, hbr.ends, known, shown, buffer.bytes(sb), jtype);
                e = e2;
                borrow u as &ur in {
                    pairs = ur.pairs;
                    np = ur.np;
                    nb = ur.nb;
                    nk = ur.nk;
                    ok = ur.ok;
                }
                let (names, ends, k3, m3) = jnhead.take_header(u);
                buffer.drop(heap, jnames);
                vec.drop(heap, jends);
                unbox_slice(heap, keys);
                unbox_slice(heap, kmap);
                jnames = names;
                jends = ends;
                keys = k3;
                kmap = m3;
                if jw_on {
                    // `--join-where` against the build file's header, as the run reads it
                    query.drop(heap, jwtree);
                    let jwb = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_join_where(), "join-where");
                    borrow jwb as &jwr in {
                        let (t1, what, at) = orparse.parse(heap, query.empty(heap), buffer.bytes(jwr));
                        jwtree = t1;
                    }
                    buffer.drop(heap, jwb);
                    borrow jwtree as &jq in {
                        let (e3, c3, ok3) = jnwhere.resolve(heap, e, jq, hbr.names, hbr.ends, buffer.bytes(sb));
                        e = e3;
                        unbox_slice(heap, c3);
                    }
                }
            }
        }
    }
    query.drop(heap, jwtree);
    var failed = false;
    borrow e as &er0 in {
        failed = fail.count(er0) > 0;
    }
    if failed {
        unbox_slice(heap, keys);
        unbox_slice(heap, kmap);
        buffer.drop(heap, shown_b_copy);
        buffer.drop(heap, jnames);
        vec.drop(heap, jends);
        jnhead.drop_head(heap, hb);
        jnhead.drop_head(heap, hp);
        return (tree0, e, payload);
    }
    var bheader = 0;
    var pgot = false;
    var pconsumed = 0;
    var pread = 0;
    borrow hb as &hbr in {
        bheader = hbr.consumed;
    }
    borrow hp as &hpr in {
        pgot = hpr.got;
        pconsumed = hpr.consumed;
        pread = hpr.bytes_read;
    }
    // the split of `--where` (the conditions of the leading run, by side) and the units of `--join-where`, as the run applies them; unknown when the probe is standard input, whose header is not read
    var where_json = buffer.append(heap, buffer.empty(heap, 8), "null");
    var jw_json = buffer.append(heap, buffer.empty(heap, 8), "[]");
    if jw_on {
        let jtextb = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_join_where(), "join-where");
        borrow jtextb as &jtr in {
            let jtext = buffer.bytes(jtr);
            let ju = orparse.top_units(heap, jtext);
            buffer.drop(heap, jw_json);
            borrow ju as &jur in {
                jw_json = jnwhere.units_json(heap, jtext, jur);
            }
            vec.drop(heap, ju);
        }
        buffer.drop(heap, jtextb);
    }
    if known {
        let wtextb = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_where(), "where");
        var wu = vec.empty(heap, 1, 0);
        borrow wtextb as &wtr in {
            vec.drop(heap, wu);
            wu = orparse.top_units(heap, buffer.bytes(wtr));
        }
        var nw = 0;
        borrow tree0 as &t0 in {
            nw = query.count_of(t0, 1);
        }
        var cls = box_slice(heap, nw + 2, 0);
        var sortflag = "";
        if cli.has(parsed, table, "sort") {
            sortflag = cli.text(args, parsed, table, "sort");
        }
        if nw > 0 {
            var made = frame.none(heap);
            frame.drop(heap, made);
            borrow tree0 as &tq in {
                borrow jnames as &nr in {
                    borrow jends as &er in {
                        made = frame.prepare(heap, tq, nr, er, np + nk, mode, delim, sortflag);
                    }
                }
                let frame.Frame { fcols, fsel, fcells, fhead, flead, flabels, flends, fpicked, fabort, fbad, fsort_field, fsort_slot, fdesc } = made;
                if fabort == 0 {
                    unbox_slice(heap, cls);
                    borrow fcols as &fc in {
                        borrow wu as &wur in {
                            cls = jnwhere.classify(heap, tq, contents(fc), wur, np, jtype);
                        }
                    }
                }
                unbox_slice(heap, fcols);
                unbox_slice(heap, fsel);
                unbox_slice(heap, fcells);
                buffer.drop(heap, fhead);
                buffer.drop(heap, flead);
                buffer.drop(heap, flabels);
                vec.drop(heap, flends);
            }
        }
        buffer.drop(heap, where_json);
        borrow wtextb as &wtr3 in {
            borrow wu as &wur in {
                borrow cls as &clr in {
                    where_json = jnwhere.split_json(heap, buffer.bytes(wtr3), wur, contents(clr));
                }
            }
        }
        buffer.drop(heap, wtextb);
        unbox_slice(heap, cls);
        vec.drop(heap, wu);
    }
    var shared = "";
    var ordered = false;
    borrow tree0 as &t0 in {
        ordered = query.count_of(t0, 4) > 0;
    }
    if mode == 2 {
        shared = "groups";
    } else if ordered {
        shared = "sorted rows";
    }
    // the reader of the build, when it is not the probe's csv reader with the probe's delimiter (a join of two such files has no such member, and its document is what it was)
    var reader_json = buffer.empty(heap, 1);
    if fmt.p_jsonl {
        borrow hp as &hpr in {
            reader_json = jsonl_reader(heap, reader_json, ",\"probe_reader\":", hpr.names, hpr.ends, np, absent, nodes);
        }
    }
    if fmt.b_jsonl {
        borrow hb as &hbr in {
            reader_json = jsonl_reader(heap, reader_json, ",\"build_reader\":", hbr.names, hbr.ends, nb, absent, nodes);
        }
    } else if jnfmt.foreign(fmt, delim) {
        reader_json = buffer.append(heap, reader_json, ",\"build_reader\":{\"format\":\"csv\",\"delimiter\":");
        if bdelim == 9 {
            reader_json = buffer.append(heap, reader_json, "\"\\t\"}");
        } else {
            reader_json = buffer.append(heap, reader_json, "\"");
            reader_json = buffer.push(heap, reader_json, byte_of(bdelim));
            reader_json = buffer.append(heap, reader_json, "\"}");
        }
    }
    // the exchange of the two files (docs/joins.md section 22): said from what is known before any row is read; the refusal also reads the other file. The document of a join does not depend on how the join was
    // spelled (flags or `--query`, gate X1), so it does not say that the refusal of a `--query` cannot write the exchanged call (it does not rewrite a query's text)
    let (typed_using, usingv) = jnswap.on_facts(heap, args, parsed, jxs);
    unbox_slice(heap, usingv);
    var prefixed = false;
    if jxsrc.has(parsed, jxs, jxsrc.s_prefix(), "join-prefix") {
        let pxb = jxsrc.text(heap, args, parsed, jxs, jxsrc.s_prefix(), "join-prefix");
        borrow pxb as &pxr in {
            prefixed = buffer.size(pxr) > 0;
        }
        buffer.drop(heap, pxb);
    }
    var dup = false;
    var positions = false;
    borrow tree0 as &t0 in {
        positions = jnswap.has_positions(t0);
        if known && mode == 1 && query.count_of(t0, 0) == 0 {
            borrow jnames as &nr5 in {
                borrow jends as &er5 in {
                    dup = jnswap.header_dup(nr5, er5);
                }
            }
        }
    }
    let swap_facts = jnswap.Facts { jtype: jtype, stdin: stdin, psize: psize, bsize: bsize, queried: false, prefixed: prefixed, join_where: jw_on, positions: positions, typed_using: typed_using, paged: jnswap.is_paged(parsed, mode), dup: dup, dchange: as_csv && !fmt.b_jsonl && bdelim != delim };
    let swap_code = jnswap.code_of(swap_facts);
    var swap_json = buffer.append(heap, buffer.empty(heap, 160), "{\"offered\":");
    if swap_code == 0 {
        swap_json = buffer.append(heap, swap_json, "true");
    } else {
        swap_json = buffer.append(heap, swap_json, "false");
    }
    swap_json = buffer.append(heap, swap_json, ",\"reason\":");
    swap_json = text.append_json(heap, swap_json, jnswap.reason_of(swap_code, jtype));
    swap_json = buffer.push(heap, swap_json, byte_of('}'));
    var doc = buffer.empty(heap, 1);
    borrow shown_b_copy as &sb in {
        buffer.drop(heap, doc);
        borrow keys as &ky in {
            borrow where_json as &wjr in {
                borrow jw_json as &jjr in {
                    borrow reader_json as &rjr in {
                        borrow swap_json as &sjr in {
                            doc = join_doc(heap, args, parsed, jxs, stdin, shown, buffer.bytes(sb), np, nk, contents(ky), pairs, bsize, bheader, known, jtype, nb, buffer.bytes(wjr), buffer.bytes(jjr), shared, buffer.bytes(rjr), fmt.b_jsonl, buffer.bytes(sjr));
                        }
                    }
                }
            }
        }
    }
    buffer.drop(heap, reader_json);
    buffer.drop(heap, swap_json);
    buffer.drop(heap, where_json);
    buffer.drop(heap, jw_json);
    unbox_slice(heap, keys);
    unbox_slice(heap, kmap);
    buffer.drop(heap, shown_b_copy);
    jnhead.drop_head(heap, hb);
    jnhead.drop_head(heap, hp);
    var head = jnhead.no_head(heap);
    if !known {
        buffer.drop(heap, jnames);
        vec.drop(heap, jends);
    } else {
        jnhead.drop_head(heap, head);
        head = explain.Head { names: jnames, ends: jends, got: pgot, abort: 0, abort_line: 0, long_length: 0, errno: 0, consumed: pconsumed, bytes_read: pread };
    }
    var t_cur = tree0;
    var e_cur = e;
    var p_cur = payload;
    borrow doc as &dr in {
        let (t3, e3, p3) = explain.conclude(heap, args, parsed, head, psize, stdin, fmt.p_jsonl, shown, delim, mode, as_csv, from, limit, budget, top, t_cur, names_at, e_cur, p_cur, buffer.bytes(dr));
        t_cur = t3;
        e_cur = e3;
        p_cur = p3;
    }
    buffer.drop(heap, doc);
    return (t_cur, e_cur, p_cur);
}
