edition 5;

module inputs;

import std.bytes;
import qtrans;
import toolbox.cli;

// The plan's values as the flags give them (docs/query.md, Q0): the columns, the condition, the grouping, the aggregates, the sort, the order, the cut and the page,
// the rows to read and the source, which `body` reads through this one value and not flag by flag. A later `--query` fills the same value from a query's translation, so
// what `body` checks and builds from does not depend on where the values came from. The text fields are the flags' own (empty when the flag is not given), and `has_*` says
// whether it was given.
pub struct Inputs {
    has_select: bool,
    has_where: bool,
    has_group: bool,
    has_agg: bool,
    has_order: bool,
    has_report: bool,
    has_sort: bool,
    has_top: bool,
    has_limit: bool,
    has_from: bool,
    // `--query TEXT` was given, and its text (the query is translated, and `for_query` replaces the plan's values with the translation's); `--rows` was given
    has_query: bool,
    has_rows: bool,
    // `--explain`: the plan is described and not run (explain.cho)
    has_explain: bool,
    // a query's `from 'path'`: the source is a path that is not an operand
    src_file: bool,
    // `--input-format jsonl` (or ndjson): the input is JSON lines (docs/readers.md section 12); `jmention`: some argument could be a flag of the JSON-lines family (`--fields`,
    // `--absent`, `--max-json-nodes`, `--discover`...), so that a run with none of them looks up none of them; `discover`: `--discover`
    jsonl: bool,
    jmention: bool,
    discover: bool,
    // `--join` (docs/joins.md): a join with a second file; `join_mention`: some argument could be a flag of the family (`--join`, `--join-type`, `--join-prefix`, `--on`, `--max-join-rows`), so
    // that a run with none of them looks up none of them
    has_join: bool,
    join_mention: bool,
    // `--rename` (docs/or-and-columns.md section 8.2) was given, or the query has an `as`; its text is the flag's, or the query's translation (`plan_body` is given that one)
    has_rename: bool,
    select_text: &static [byte],
    where_text: &static [byte],
    group_text: &static [byte],
    agg_text: &static [byte],
    order_text: &static [byte],
    report_text: &static [byte],
    sort_text: &static [byte],
    format_text: &static [byte],
    query_text: &static [byte],
    rename_text: &static [byte],
    root_text: &static [byte],
    top_n: int,
    limit_n: int,
    from_n: int,
    rows_n: int,
    select_whole: bool,
    select_at: int,
    // where `--where`'s value is in the arguments and whether it is an argument of its own (`--where EXPR`, not `--where=EXPR`): what the repair of an `or` needs (-1 when not given)
    where_whole: bool,
    where_at: int,
    root_at: int,
    operands: int,
    source_at: int,
    stdin: bool,
}

pub fn from_flags[&g, &p](args: &g Args, parsed: &p cli.Parsed, table: &static [byte]) -> [args] Inputs {
    var source_at = -1;
    if cli.operand_count(parsed) > 0 {
        source_at = cli.operand_index(parsed, 0);
    }
    let has_select = cli.has(parsed, table, "select");
    var where_at = -1;
    var where_whole = false;
    if cli.has(parsed, table, "where") {
        where_at = cli.value_index(parsed, table, "where");
        where_whole = cli.value_is_whole(parsed, table, "where");
    }
    var select_at = -1;
    if has_select && cli.value_is_whole(parsed, table, "select") {
        select_at = cli.value_index(parsed, table, "select");
    }
    // Standard input is read when there is no operand or the operand is `-` (docs/readers.md section 3.1); a file called `-` is `./-`.
    var stdin = cli.operand_count(parsed) == 0;
    if source_at >= 0 && bytes.equal(arg(args, source_at), "-") {
        stdin = true;
    }
    // Each lookup of a flag by name reads the table up to it, so what only a query or a sort needs is looked up when it was given, and the flags of a query are the last of the table.
    // A lookup by name reads the table up to the flag, and the flags of a query are its last: they are looked up only when an argument could be one of them (it begins with their name).
    var mentioned = false;
    var explaining = false;
    var jmention = false;
    var join_mention = false;
    var rename_mention = false;
    var k = 1;
    while k < arg_count(args) {
        let a = arg(args, k);
        if bytes.starts_with(a, "--query") || bytes.starts_with(a, "--rows") {
            mentioned = true;
        } else if bytes.starts_with(a, "--explain") {
            explaining = true;
        } else if bytes.starts_with(a, "--input-format") || bytes.starts_with(a, "--fields") || bytes.starts_with(a, "--absent") || bytes.starts_with(a, "--max-json-nodes") || bytes.starts_with(a, "--discover") || bytes.starts_with(a, "--max-fields") {
            jmention = true;
        } else if bytes.starts_with(a, "--join") || bytes.starts_with(a, "--on") || bytes.starts_with(a, "--max-join-rows") {
            join_mention = true;
        } else if bytes.starts_with(a, "--rename") {
            rename_mention = true;
        }
        k = k + 1;
    }
    var query_text = "";
    if mentioned {
        query_text = cli.text(args, parsed, table, "query");
    }
    // (the flag takes a text that is not empty: an empty one is a refusal of the parse, and a query was given when there is a text)
    let has_query = len(query_text) > 0;
    var jsonl = false;
    var discover = false;
    if jmention {
        let form = cli.text(args, parsed, table, "input-format");
        jsonl = bytes.equal(form, "jsonl") || bytes.equal(form, "ndjson");
        discover = cli.has(parsed, table, "discover");
    }
    let has_join = join_mention && cli.has(parsed, table, "join");
    // (the last flag of the table, which a lookup reads the table up to: looked up once, and only when an argument could be it; the flag takes a text that is not empty, so a text is the flag given)
    var rename_text = "";
    if rename_mention {
        rename_text = cli.text(args, parsed, table, "rename");
    }
    let has_rename = len(rename_text) > 0;
    let has_sort = cli.has(parsed, table, "sort");
    var sort_text = "";
    if has_sort {
        sort_text = cli.text(args, parsed, table, "sort");
    }
    return Inputs { has_select: has_select, has_where: cli.has(parsed, table, "where"), has_group: cli.has(parsed, table, "group"), has_agg: cli.has(parsed, table, "agg"), has_order: cli.has(parsed, table, "order-by"), has_report: cli.has(parsed, table, "report"), has_sort: has_sort, has_top: cli.has(parsed, table, "top"), has_limit: cli.has(parsed, table, "limit"), has_from: cli.has(parsed, table, "from"), has_query: has_query, has_rows: mentioned && cli.has(parsed, table, "rows"), has_explain: explaining && cli.has(parsed, table, "explain"), src_file: false, jsonl: jsonl, jmention: jmention, discover: discover, has_join: has_join, join_mention: join_mention, has_rename: has_rename, select_text: cli.text(args, parsed, table, "select"), where_text: cli.text(args, parsed, table, "where"), group_text: cli.text(args, parsed, table, "group"), agg_text: cli.text(args, parsed, table, "agg"), order_text: cli.text(args, parsed, table, "order-by"), report_text: cli.text(args, parsed, table, "report"), sort_text: sort_text, format_text: cli.text(args, parsed, table, "format"), query_text: query_text, rename_text: rename_text, root_text: cli.text(args, parsed, table, "root"), top_n: cli.nat(args, parsed, table, "top"), limit_n: cli.nat(args, parsed, table, "limit"), from_n: cli.nat(args, parsed, table, "from"), rows_n: cli.nat(args, parsed, table, "max-rows"), select_whole: select_at >= 0, select_at: select_at, where_whole: where_whole, where_at: where_at, root_at: cli.value_index(parsed, table, "root"), operands: cli.operand_count(parsed), source_at: source_at, stdin: stdin };
}

// The plan's values as a query's translation gives them: what the query says replaces what the flags did not (a flag the query has no form for, `--top`, `--limit` or `--from` when the
// query has no page of its own, stays the flag's). The texts of the lists are the translation's (`plan_body` is given them); a source is a path, standard input, or nothing (the operand).
pub fn for_query[&t](inp: Inputs, t: &t qtrans.Translated) -> [] Inputs {
    var limit_n = inp.limit_n;
    var has_limit = inp.has_limit;
    if qtrans.info_at(t, qtrans.i_limit_given()) == 1 {
        has_limit = true;
        limit_n = qtrans.info_at(t, qtrans.i_limit());
    }
    var from_n = inp.from_n;
    var has_from = inp.has_from;
    if qtrans.info_at(t, qtrans.i_from_given()) == 1 {
        has_from = true;
        from_n = qtrans.info_at(t, qtrans.i_from());
    }
    var stdin = inp.stdin;
    if qtrans.info_at(t, qtrans.i_source()) == 2 {
        stdin = true;
    } else if qtrans.info_at(t, qtrans.i_source()) == 1 {
        stdin = false;
    }
    return Inputs { has_select: qtrans.info_at(t, qtrans.i_select()) == 1, has_where: qtrans.info_at(t, qtrans.i_where()) == 1, has_group: qtrans.info_at(t, qtrans.i_group()) == 1, has_agg: qtrans.info_at(t, qtrans.i_agg()) == 1, has_order: qtrans.info_at(t, qtrans.i_order()) == 1, has_report: false, has_sort: qtrans.info_at(t, qtrans.i_sort()) == 1, has_top: inp.has_top, has_limit: has_limit, has_from: has_from, has_query: inp.has_query, has_rows: qtrans.info_at(t, qtrans.i_rows()) == 1, has_explain: inp.has_explain, src_file: qtrans.info_at(t, qtrans.i_source()) == 1, jsonl: inp.jsonl, jmention: inp.jmention, discover: inp.discover, has_join: inp.has_join || qtrans.info_at(t, qtrans.i_join()) == 1, join_mention: inp.join_mention || qtrans.info_at(t, qtrans.i_join()) == 1, has_rename: qtrans.info_at(t, qtrans.i_rename()) == 1, select_text: inp.select_text, where_text: inp.where_text, group_text: inp.group_text, agg_text: inp.agg_text, order_text: inp.order_text, report_text: inp.report_text, sort_text: inp.sort_text, format_text: inp.format_text, query_text: inp.query_text, rename_text: inp.rename_text, root_text: inp.root_text, top_n: inp.top_n, limit_n: limit_n, from_n: from_n, rows_n: inp.rows_n, select_whole: false, select_at: 0 - 1, where_whole: false, where_at: 0 - 1, root_at: inp.root_at, operands: inp.operands, source_at: inp.source_at, stdin: stdin };
}

// Where the value of `--query` is in the arguments and whether it is an argument of its own (`--query TEXT`, not `--query=TEXT`): what a repair that offers the invocation back needs,
// asked for when a query is refused and not before.
pub fn query_place[&p](parsed: &p cli.Parsed, table: &static [byte]) -> [] (int, bool) {
    return (cli.value_index(parsed, table, "query"), cli.value_is_whole(parsed, table, "query"));
}
