edition 5;

module jtab;

// SPIKE (throwaway, docs/joins.md section 15): the build table of section 6.2 as the design describes it, on `tools/table/gmap.cho`:
// a `gmap.Tab` of the distinct keys, per key the first and last build row (`head`, `tail`), the held records concatenated in one
// buffer (`rows`), per row where its record starts (`start`) and the next row of the same key (`next`, -1 at the end). Every array
// grows by doubling, as `gmap` does, because a real build does not know its row count. `held` is the accounted bytes by the formula:
// sum over held rows (record bytes + 16) + sum over distinct keys (key bytes + 60).

import std.buffer;
import std.bytes;
import gmap;

pub res struct JTab {
    keys: gmap.Tab,
    head: Box[[int]],
    tail: Box[[int]],
    rows: buffer.Buffer,
    start: Box[[int]],
    next: Box[[int]],
    nrows: int,
    held: int,
}

pub fn empty[&h](heap: &!h Heap, capacity: int) -> [heap] JTab {
    return sized(heap, capacity, capacity, capacity * 64);
}

// A table with room for `keys` distinct keys, `rows` rows and `row_bytes` bytes of records (a pre-sized build: nothing grows if they hold).
pub fn sized[&h](heap: &!h Heap, keys: int, rows: int, row_bytes: int) -> [heap] JTab {
    var kc = keys;
    if kc < 8 {
        kc = 8;
    }
    var rc = rows;
    if rc < 8 {
        rc = 8;
    }
    return JTab { keys: gmap.empty(heap, kc), head: box_slice(heap, kc, 0), tail: box_slice(heap, kc, 0), rows: buffer.empty(heap, row_bytes + 64), start: box_slice(heap, rc, 0), next: box_slice(heap, rc, 0), nrows: 0, held: 0 };
}

fn cap_of[&b](b: &b Box[[int]]) -> [] int {
    return len(contents(b));
}

// The same ints in storage twice as large.
fn grow_ints[&h](heap: &!h Heap, b: Box[[int]]) -> [heap] Box[[int]] {
    var n = 0;
    borrow b as &br in {
        n = len(contents(br));
    }
    let out = box_slice(heap, n * 2, 0);
    var o = out;
    borrow mut o as &!ow in {
        borrow b as &br in {
            let to = contents(ow);
            let from = contents(br);
            var i = 0;
            while i < n {
                to[i] = from[i];
                i = i + 1;
            }
        }
    }
    unbox_slice(heap, b);
    return o;
}

pub fn add[&h, &k, &r](heap: &!h Heap, t: JTab, key: &k [byte], record: &r [byte]) -> [heap] JTab {
    let JTab { keys, head, tail, rows, start, next, nrows, held } = t;
    let hv = gmap.hash(key);
    var e = 0 - 1;
    borrow keys as &kr in {
        e = gmap.find_h(kr, key, hv);
    }
    var ks = keys;
    var hd = head;
    var tl = tail;
    var rw = rows;
    var st = start;
    var nx = next;
    var cost = len(record) + 16;
    let row = nrows;
    var fresh = false;
    if e < 0 {
        fresh = true;
        cost = cost + len(key) + 60;
        ks = gmap.put_new(heap, ks, key, hv);
        borrow ks as &kr in {
            e = gmap.size(kr) - 1;
        }
        var cap = 0;
        borrow hd as &hr in {
            cap = cap_of(hr);
        }
        if e >= cap {
            hd = grow_ints(heap, hd);
            tl = grow_ints(heap, tl);
        }
    }
    var rcap = 0;
    borrow st as &sr in {
        rcap = cap_of(sr);
    }
    if row >= rcap {
        st = grow_ints(heap, st);
        nx = grow_ints(heap, nx);
    }
    var at = 0;
    borrow rw as &rr in {
        at = buffer.size(rr);
    }
    rw = buffer.append(heap, rw, record);
    borrow mut st as &!sw in {
        contents(sw)[row] = at;
    }
    borrow mut nx as &!nw in {
        contents(nw)[row] = 0 - 1;
    }
    if fresh {
        borrow mut hd as &!hw in {
            contents(hw)[e] = row;
        }
        borrow mut tl as &!tw in {
            contents(tw)[e] = row;
        }
    } else {
        var last = 0;
        borrow tl as &tr in {
            last = contents(tr)[e];
        }
        borrow mut nx as &!nw in {
            contents(nw)[last] = row;
        }
        borrow mut tl as &!tw in {
            contents(tw)[e] = row;
        }
    }
    return JTab { keys: ks, head: hd, tail: tl, rows: rw, start: st, next: nx, nrows: row + 1, held: held + cost };
}

// The first build row of `key`, or -1.
pub fn first[&t, &k](t: &t JTab, key: &k [byte]) -> [] int {
    let e = gmap.find_h(t.keys, key, gmap.hash(key));
    if e < 0 {
        return 0 - 1;
    }
    return contents(t.head)[e];
}

pub fn next_row[&t](t: &t JTab, row: int) -> [] int {
    return contents(t.next)[row];
}

// The record of build row `row`.
pub fn record[&t](t: &t JTab, row: int) -> [] &t [byte] {
    let all = buffer.bytes(t.rows);
    let from = contents(t.start)[row];
    var to = len(all);
    if row + 1 < t.nrows {
        to = contents(t.start)[row + 1];
    }
    return all[from..to];
}

pub fn distinct[&t](t: &t JTab) -> [] int {
    return gmap.size(t.keys);
}

pub fn rows_of[&t](t: &t JTab) -> [] int {
    return t.nrows;
}

pub fn held_of[&t](t: &t JTab) -> [] int {
    return t.held;
}

// Probe: how many build rows have `key`, and the sum of their row numbers.
pub fn probe[&t, &k](t: &t JTab, key: &k [byte]) -> [] (int, int) {
    var r = first(t, key);
    var n = 0;
    var sum = 0;
    while r >= 0 {
        n = n + 1;
        sum = sum + r;
        r = contents(t.next)[r];
    }
    return (n, sum);
}

fn copy_ints[&h, &s](heap: &!h Heap, from: &s Box[[int]]) -> [heap] Box[[int]] {
    let n = len(contents(from));
    let out = box_slice(heap, n, 0);
    var o = out;
    borrow mut o as &!ow in {
        let to = contents(ow);
        let src = contents(from);
        var i = 0;
        while i < n {
            to[i] = src[i];
            i = i + 1;
        }
    }
    return o;
}

// A deep copy of the whole table (option (a) of docs/joins.md section 7.2): every array and both byte buffers.
pub fn clone[&h, &t](heap: &!h Heap, t: &t JTab) -> [heap] JTab {
    let slots = copy_ints(heap, t.keys.slots);
    let meta = copy_ints(heap, t.keys.meta);
    var kb = buffer.empty(heap, buffer.size(t.keys.keys) + 1);
    kb = buffer.append(heap, kb, buffer.bytes(t.keys.keys));
    var rb = buffer.empty(heap, buffer.size(t.rows) + 1);
    rb = buffer.append(heap, rb, buffer.bytes(t.rows));
    return JTab { keys: gmap.Tab { slots: slots, meta: meta, keys: kb, entries: t.keys.entries }, head: copy_ints(heap, t.head), tail: copy_ints(heap, t.tail), rows: rb, start: copy_ints(heap, t.start), next: copy_ints(heap, t.next), nrows: t.nrows, held: t.held };
}

pub fn drop[&h](heap: &!h Heap, t: JTab) -> [heap] int {
    let JTab { keys, head, tail, rows, start, next, nrows, held } = t;
    gmap.drop(heap, keys);
    unbox_slice(heap, head);
    unbox_slice(heap, tail);
    buffer.drop(heap, rows);
    unbox_slice(heap, start);
    unbox_slice(heap, next);
    return nrows;
}
