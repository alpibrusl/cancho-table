edition 5;

// SPIKE S8, negative (docs/joins.md section 24.2, reading 1): a worker that is lent a job by `&!` builds a table and puts it in the job, for the parent to use after the join.
// Must NOT compile with the Rust compiler (CANCHO_COMPILER=rust): the gate (tests/conformance/test_join_j8.py `Premise`) pins its first error,
//     the value overwritten here is `res` (`JTab`), so it cannot be discarded; name the function that consumes it
// [corrected 2026-11-07] The compiler written in cancho, the default of 119bcfe, ACCEPTS this program: it lacks that check (docs/join-redesign.md section 1). `main` spawns the worker so that
// the program is complete for either compiler: a `main` that declares [conc] and never performs it is refused first by the default one (`effect-declared-not-performed`).

import std.io;
import jtab;

res struct Job {
    heap: Heap,
    tab: jtab.JTab,
    n: int,
}

fn work[&r](w: &!r Job) -> [heap] int {
    var t = jtab.empty(w.heap);
    var i = 0;
    while i < w.n {
        let (t2, ok) = jtab.add(w.heap, t, "k", "rec", 1000000);
        t = t2;
        i = i + 1;
    }
    w.tab = t;
    return 0;
}

fn main(world: World) -> [conc] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(net);
    release(fs);
    release(args);
    release(clock);
    release(io);
    var hp = heap;
    borrow mut hp as &!h in {
        var job = Job { heap: fork_heap(h), tab: jtab.empty(h), n: 3 };
        borrow mut job as &!kj in {
            let body = work;
            let th = spawn(kj, body);
            let r = join(th);
        }
        let Job { heap, tab, n } = job;
        release(heap);
        jtab.drop(h, tab);
    }
    release(hp);
    return 0;
}
