edition 5;

// NEGATIVE (docs/joins.md section 15): a worker's job that holds the shared table by reference beside its own unique state. A type declaration with a region parameter.
import s0common;

res struct Job[&f] {
    sh: &f s0common.Shared,
    out: Box[[int]],
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(net);
    release(fs);
    release(args);
    release(clock);
    release(io);
    release(heap);
    return 0;
}

