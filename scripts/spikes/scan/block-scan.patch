+
+// One record, found with the structural mask (docs/gap-scan.md): the record that begins at the start of `data`, when
+// it is whole on one line inside `data` and well formed. Answers (k, n): `k` the index in `data` of the newline that
+// ends it and `n` its fields, with `cells` filled as `fields` fills them for the line (a CR before the newline is
+// not in the last field) and the first `room` fields stored; or (-1, 0) when the record is anything else (fewer
+// than 64 bytes are left, or the newline is not in the chunk, a quote is still open at the newline, a quoted field is
+// not followed by a delimiter or the end of the line, the line is longer than `cap`): the caller then reads the line
+// the way it always did, and names whatever is wrong with it. A quote not at the start of a field is text, as in
+// `fields`.
+//
+// `byte_mask64` answers, for 64 bytes, a bit for each delimiter, newline or quote; the record is the walk over
+// those bits, in order, by the grammar: outside quotes a delimiter or a newline ends a field, a quote at the start of
+// a field opens a quoted one; inside, a doubled quote is text, a single one closes it and must be followed by a
+// delimiter or the end of the line.
+pub fn record[&d, &c](data: &d [byte], delim: int, cells: &!c [int], room: int, cap: int) -> [] (int, int) {
+    let n = len(data);
+    var lim = wrapping_mul(room, 3);
+    if lim < 0 || lim + 3 > len(cells) {
+        return (0 - 1, 0);
+    }
+    let d = byte_of(delim);
+    var i = 0;
+    var fs = 0;
+    var mode = 0;
+    var qs = 0;
+    var qend = 0;
+    var skip = 0 - 1;
+    var nf = 0;
+    var cp = 0;
+    var k = 0 - 1;
+    var going = true;
+    while going && i + 64 <= n {
+        var z = byte_mask64(data, i, d, byte_of(10), byte_of(34));
+        while z != 0 && going {
+            let at = wrapping_add(i, trailing_zeros(z));
+            z = z & wrapping_sub(z, 1);
+            let c = int_of(data[at]);
+            if c == 34 {
+                if mode == 0 {
+                    if at == fs {
+                        mode = 1;
+                        qs = at + 1;
+                    }
+                } else if mode == 1 {
+                    if at == skip {
+                        skip = 0 - 1;
+                    } else if at + 1 < n && int_of(data[at + 1]) == 34 {
+                        skip = at + 1;
+                    } else {
+                        qend = at;
+                        mode = 2;
+                    }
+                } else {
+                    going = false;
+                }
+            } else if mode == 0 {
+                var e = at;
+                if c == 10 && at > fs && int_of(data[at - 1]) == 13 {
+                    e = at - 1;
+                }
+                if cp < lim {
+                    cells[cp] = fs;
+                    cells[cp + 1] = e;
+                    cells[cp + 2] = 0;
+                    cp = wrapping_add(cp, 3);
+                }
+                nf = wrapping_add(nf, 1);
+                fs = at + 1;
+                if c == 10 {
+                    k = at;
+                    going = false;
+                }
+            } else if mode == 1 {
+                if c == 10 {
+                    going = false;
+                }
+            } else {
+                let after = at == qend + 1;
+                let crnl = at == qend + 2 && c == 10 && int_of(data[qend + 1]) == 13;
+                if after || crnl {
+                    if cp < lim {
+                        cells[cp] = qs;
+                        cells[cp + 1] = qend;
+                        cells[cp + 2] = 1;
+                        cp = wrapping_add(cp, 3);
+                    }
+                    nf = wrapping_add(nf, 1);
+                    fs = at + 1;
+                    mode = 0;
+                    if c == 10 {
+                        k = at;
+                        going = false;
+                    }
+                } else {
+                    going = false;
+                }
+            }
+        }
+        if going {
+            i = i + 64;
+        }
+    }
+    if k < 0 || k > cap {
+        return (0 - 1, 0);
+    }
+    return (k, nf);
+}
