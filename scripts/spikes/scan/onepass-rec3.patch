+
+// One record, found in one pass over the bytes (no search for the end of the line first): the record that
+// begins at the start of `data`, when it is whole on one line inside `data` and well formed. Answers (k, n): `k` the
+// index in `data` of the newline that ends it and `n` its fields, with `cells` filled as `fields` fills them for
+// the line (a CR before the newline is not in the last field) and the first `room` fields stored; or (-1, 0)
+// when the record is anything else (the chunk ends before its newline, a quote is still open at the newline, a
+// quoted field is not followed by a delimiter or the end of the line, the line is longer than `cap`): the caller
+// then reads the line the way it always did, and names whatever is wrong with it. A quote not at the start of a
+// field is text, as in `fields`.
+//
+// Written for the instruction count (docs/gap-scan.md): a byte is tested against `hi`, the larger of the delimiter
+// and the newline, first, because the digits and letters that most fields are made of are above both and cost one
+// comparison; every index is advanced with `wrapping_add` and every store is guarded by one comparison against
+// `lim`, so that the compiler is left no overflow trap and no bounds check to keep in the loop.
+pub fn record[&d, &c](data: &d [byte], delim: int, cells: &!c [int], room: int, cap: int) -> [] (int, int) {
+    let n = len(data);
+    var hi = delim;
+    if hi < 10 {
+        hi = 10;
+    }
+    var lim = wrapping_mul(room, 3);
+    if lim < 0 || lim + 3 > len(cells) {
+        return (0 - 1, 0);
+    }
+    var p = 0;
+    var nf = 0;
+    var cp = 0;
+    var k = 0 - 1;
+    var going = true;
+    while going && p < n {
+        if int_of(data[p]) == 34 {
+            var q = wrapping_add(p, 1);
+            var closing = 0 - 1;
+            while closing < 0 && q < n {
+                let c = int_of(data[q]);
+                if c == 34 {
+                    if q + 1 < n && int_of(data[q + 1]) == 34 {
+                        q = q + 2;
+                    } else {
+                        closing = q;
+                    }
+                } else if c == 10 {
+                    q = n;
+                } else {
+                    q = wrapping_add(q, 1);
+                }
+            }
+            if closing < 0 || closing + 1 >= n {
+                going = false;
+            } else {
+                let d = int_of(data[closing + 1]);
+                if cp < lim {
+                    cells[cp] = p + 1;
+                    cells[cp + 1] = closing;
+                    cells[cp + 2] = 1;
+                    cp = wrapping_add(cp, 3);
+                }
+                nf = wrapping_add(nf, 1);
+                if d == delim {
+                    p = closing + 2;
+                } else if d == 10 {
+                    k = closing + 1;
+                    going = false;
+                } else if d == 13 && closing + 2 < n && int_of(data[closing + 2]) == 10 {
+                    k = closing + 2;
+                    going = false;
+                } else {
+                    going = false;
+                }
+            }
+        } else {
+            var i = p;
+            var c = 0;
+            var scanning = true;
+            while scanning {
+                while i < n && int_of(data[i]) > hi {
+                    i = wrapping_add(i, 1);
+                }
+                if i >= n {
+                    scanning = false;
+                    going = false;
+                } else {
+                    c = int_of(data[i]);
+                    if c == delim || c == 10 {
+                        scanning = false;
+                    } else {
+                        i = wrapping_add(i, 1);
+                    }
+                }
+            }
+            if going {
+                var e = i;
+                if c == 10 && i > p && int_of(data[i - 1]) == 13 {
+                    e = i - 1;
+                }
+                if cp < lim {
+                    cells[cp] = p;
+                    cells[cp + 1] = e;
+                    cells[cp + 2] = 0;
+                    cp = wrapping_add(cp, 3);
+                }
+                nf = wrapping_add(nf, 1);
+                if c == 10 {
+                    k = i;
+                    going = false;
+                } else {
+                    p = wrapping_add(i, 1);
+                }
+            }
+        }
+    }
+    if k < 0 || k > cap {
+        return (0 - 1, 0);
+    }
+    return (k, nf);
+}
