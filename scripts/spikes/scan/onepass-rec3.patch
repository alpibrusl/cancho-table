+// `next_fast` that also finds the fields: the next record when it is whole on one line inside the chunk, in one
+// pass over its bytes (`reader.record`), with `cells` filled and the number of its fields in `cells[3 * room]`.
+// Answers `lines.line()` with the reader as `next_fast` leaves it, or 9 and nothing changed (past what
+// `next_fast` clears first), when the line is anything `reader.record` does not take: then the caller asks
+// `next_fast`, and `lines.next`, as before.
+pub fn next_rec[&r, &c](r: &!r lines.Lines, delim: int, cells: &!c [int], room: int) -> [] int {
+    if r.ready {
+        buffer.clear(r.held);
+        r.over = 0;
+        r.begin = r.seen;
+        r.ready = false;
+    }
+    if r.over > 0 || buffer.size(r.held) > 0 {
+        return 9;
+    }
+    let whole = buffer.bytes(r.chunk);
+    let at = r.pos;
+    let (rel, n) = reader.record(whole[at..len(whole)], delim, cells, room, r.cap);
+    if rel < 0 {
+        return 9;
+    }
+    let k = at + rel;
+    cells[3 * room] = n;
+    r.viewing = true;
+    r.view_from = at;
+    r.view_to = k;
+    r.seen = r.seen + (k + 1 - at);
+    r.pos = k + 1;
+    r.newline = true;
+    r.count = r.count + 1;
+    r.ready = true;
+    return lines.line();
+}
