+    /// `byte_mask64(text, at, a, b, c)` (SPIKE, docs/gap-scan.md): `args` is the slice's pointer and length, `at`, then the
+    /// three bytes. Traps unless `0 <= at <= len - 64`. Four 16-byte loads, three compares each, one bit per byte.
+    pub(crate) fn byte_mask64(&mut self, args: &[LValue]) -> Result<Vec<LValue>, String> {
+        let (base, length, at) = (operand(&args[0]), operand(&args[1]), operand(&args[2]));
+        let room = self.fresh();
+        self.out.push_str(&format!("  {room} = sub i64 {length}, 64\n"));
+        let past = self.fresh();
+        self.out.push_str(&format!("  {past} = icmp ugt i64 {at}, {room}\n"));
+        // `at` unsigned above `len - 64` covers a negative `at`; `len < 64` makes `room` negative, which is huge unsigned only
+        // when `at` is not: so test `len < 64` too.
+        let short = self.fresh();
+        self.out.push_str(&format!("  {short} = icmp slt i64 {length}, 64\n"));
+        let failed = self.fresh();
+        self.out.push_str(&format!("  {failed} = or i1 {past}, {short}\n"));
+        self.trap_if(&failed)?;
+        let start = self.fresh();
+        self.out.push_str(&format!("  {start} = getelementptr i8, ptr {base}, i64 {at}\n"));
+        let mut acc = String::from("0");
+        for q in 0..4 {
+            let p = self.fresh();
+            self.out.push_str(&format!("  {p} = getelementptr i8, ptr {start}, i64 {}\n", 16 * q));
+            let v = self.fresh();
+            self.out.push_str(&format!("  {v} = load <16 x i8>, ptr {p}, align 1\n"));
+            let mut hit = String::new();
+            for (n, byte) in [&args[3], &args[4], &args[5]].iter().enumerate() {
+                let wanted = operand(byte);
+                let ins = self.fresh();
+                self.out.push_str(&format!("  {ins} = insertelement <16 x i8> poison, i8 {wanted}, i64 0\n"));
+                let splat = self.fresh();
+                self.out.push_str(&format!("  {splat} = shufflevector <16 x i8> {ins}, <16 x i8> poison, <16 x i32> zeroinitializer\n"));
+                let eq = self.fresh();
+                self.out.push_str(&format!("  {eq} = icmp eq <16 x i8> {v}, {splat}\n"));
+                if n == 0 {
+                    hit = eq;
+                } else {
+                    let joined = self.fresh();
+                    self.out.push_str(&format!("  {joined} = or <16 x i1> {hit}, {eq}\n"));
+                    hit = joined;
+                }
+            }
+            let bits = self.fresh();
+            self.out.push_str(&format!("  {bits} = bitcast <16 x i1> {hit} to i16\n"));
+            let wide = self.fresh();
+            self.out.push_str(&format!("  {wide} = zext i16 {bits} to i64\n"));
+            let shifted = self.fresh();
+            self.out.push_str(&format!("  {shifted} = shl i64 {wide}, {}\n", 16 * q));
+            if q == 0 {
+                acc = shifted;
+            } else {
+                let joined = self.fresh();
+                self.out.push_str(&format!("  {joined} = or i64 {acc}, {shifted}\n"));
+                acc = joined;
+            }
+        }
+        Ok(vec![LValue::Reg(acc)])
+    }
+
+    /// `trailing_zeros(x)` (SPIKE): `cttz`, 64 for zero.
+    pub(crate) fn trailing_zeros(&mut self, args: &[LValue]) -> Result<Vec<LValue>, String> {
