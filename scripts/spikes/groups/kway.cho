// SPIKE (docs/gap-groups.md): what the parent pays to merge P sorted runs of N keys in all (the k-way merge a hash-partitioned grouping needs, because
// the groups of one hash partition are not a range of the key order). The keys are `key0000000`... (10 bytes), run r holds the keys whose
// scrambled number falls in r, in increasing order; the merge appends each key and a newline to an output buffer that is cleared every 64 KiB.
//
//     kway MODE N P        MODE  gen  : build the runs only (the floor)
//                                scan : merge by taking the least of the P heads each time (P compares per key)
//                                heap : merge with a binary min-heap of the heads (about log2 P compares per key)
// Prints the checksum of the output.
edition 5;

import std.buffer;
import std.bytes;
import std.io;

fn digits[&o](v: int, out: &!o [byte], at: int) -> [] int {
    var x = v;
    var i = 6;
    while i >= 0 {
        out[at + i] = byte_of(48 + x % 10);
        x = x / 10;
        i = i - 1;
    }
    return at + 7;
}

fn scramble(v: int, p: int) -> [] int {
    var h = wrapping_mul(v + 12345, 0x9e3779b9 << 8 | 0x7f);
    h = h ^ (h >> 17 & 0x7fffffffffff);
    h = wrapping_mul(h, 0xff51afd7 << 8 | 0xed);
    h = h ^ (h >> 23 & 0x7fffffffffff);
    return (h & 0x7fffffffffff) % p;
}

// Run `r`: the keys v (0..n) whose scramble is r, in increasing order, as 10-byte keys back to back.
fn make_run[&h](heap: &!h Heap, n: int, p: int, r: int) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, n / p * 10 + 1024);
    var v = 0;
    var tmp = box_slice(heap, 16, byte_of(0));
    borrow mut tmp as &!tw in {
        let t = contents(tw);
        t[0] = byte_of('k');
        t[1] = byte_of('e');
        t[2] = byte_of('y');
        while v < n {
            if scramble(v, p) == r {
                digits(v, t, 3);
                b = buffer.append(heap, b, t[0..10]);
            }
            v = v + 1;
        }
    }
    unbox_slice(heap, tmp);
    return b;
}

fn less[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    return bytes.compare(x, y) < 0;
}

fn run[&h, &i](heap: &!h Heap, io: &!i Io, mode: int, n: int, p: int) -> [heap, io_write] int {
    // the runs: one buffer after another in one, with the start of each
    var all = buffer.empty(heap, n * 10 + 1024);
    var starts = box_slice(heap, p + 2, 0);
    var r = 0;
    while r < p {
        let run = make_run(heap, n, p, r);
        var sz = 0;
        borrow all as &ar0 in {
            sz = buffer.size(ar0);
        }
        borrow mut starts as &!sw in {
            contents(sw)[r] = sz;
        }
        borrow run as &rr in {
            all = buffer.append(heap, all, buffer.bytes(rr));
        }
        buffer.drop(heap, run);
        r = r + 1;
    }
    var sz2 = 0;
    borrow all as &ar1 in {
        sz2 = buffer.size(ar1);
    }
    borrow mut starts as &!sw in {
        contents(sw)[p] = sz2;
    }
    var sum = 0;
    var outn = 0;
    var out = buffer.empty(heap, 70000);
    if mode > 0 {
        borrow all as &ar in {
            let data = buffer.bytes(ar);
            var cur = box_slice(heap, p + 1, 0);
            var hp = box_slice(heap, p + 1, 0);
            var live = 0;
            borrow mut cur as &!cw in {
                borrow starts as &sr in {
                    var q = 0;
                    while q < p {
                        contents(cw)[q] = contents(sr)[q];
                        q = q + 1;
                    }
                }
                borrow starts as &sr in {
                    let st = contents(sr);
                    let c = contents(cw);
                    if mode == 1 {
                        var more = true;
                        while more {
                            var best = 0 - 1;
                            var q = 0;
                            while q < p {
                                if c[q] < st[q + 1] {
                                    if best < 0 || less(data[c[q]..c[q] + 10], data[c[best]..c[best] + 10]) {
                                        best = q;
                                    }
                                }
                                q = q + 1;
                            }
                            if best < 0 {
                                more = false;
                            } else {
                                out = buffer.append(heap, out, data[c[best]..c[best] + 10]);
                                out = buffer.push(heap, out, byte_of(10));
                                sum = sum + int_of(data[c[best] + 9]);
                                c[best] = c[best] + 10;
                                outn = outn + 11;
                                if outn >= 65536 {
                                    outn = 0;
                                    borrow mut out as &!ow in {
                                        buffer.clear(ow);
                                    }
                                }
                            }
                        }
                    } else {
                        borrow mut hp as &!hw in {
                            let h = contents(hw);
                            var m = 0;
                            var q = 0;
                            while q < p {
                                if c[q] < st[q + 1] {
                                    h[m] = q;
                                    m = m + 1;
                                    // sift up
                                    var j = m - 1;
                                    while j > 0 && less(data[c[h[j]]..c[h[j]] + 10], data[c[h[(j - 1) / 2]]..c[h[(j - 1) / 2]] + 10]) {
                                        let t = h[j];
                                        h[j] = h[(j - 1) / 2];
                                        h[(j - 1) / 2] = t;
                                        j = (j - 1) / 2;
                                    }
                                }
                                q = q + 1;
                            }
                            while m > 0 {
                                let best = h[0];
                                out = buffer.append(heap, out, data[c[best]..c[best] + 10]);
                                out = buffer.push(heap, out, byte_of(10));
                                sum = sum + int_of(data[c[best] + 9]);
                                c[best] = c[best] + 10;
                                outn = outn + 11;
                                if outn >= 65536 {
                                    outn = 0;
                                    borrow mut out as &!ow in {
                                        buffer.clear(ow);
                                    }
                                }
                                if c[best] >= st[best + 1] {
                                    m = m - 1;
                                    h[0] = h[m];
                                }
                                // sift down
                                var j = 0;
                                var going = true;
                                while going {
                                    let l = 2 * j + 1;
                                    let rr = l + 1;
                                    var s = j;
                                    if l < m && less(data[c[h[l]]..c[h[l]] + 10], data[c[h[s]]..c[h[s]] + 10]) {
                                        s = l;
                                    }
                                    if rr < m && less(data[c[h[rr]]..c[h[rr]] + 10], data[c[h[s]]..c[h[s]] + 10]) {
                                        s = rr;
                                    }
                                    if s == j {
                                        going = false;
                                    } else {
                                        let t = h[j];
                                        h[j] = h[s];
                                        h[s] = t;
                                        j = s;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            unbox_slice(heap, cur);
            unbox_slice(heap, hp);
        }
    }
    buffer.drop(heap, all);
    buffer.drop(heap, out);
    unbox_slice(heap, starts);
    putchar(io, 48 + sum % 10);
    putchar(io, 10);
    return sum;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(net);
    release(clock);
    var mode = 0;
    var n = 0;
    var p = 0;
    borrow args as &g in {
        let a1 = arg(g, 1);
        if int_of(a1[0]) == 's' {
            mode = 1;
        } else if int_of(a1[0]) == 'h' {
            mode = 2;
        }
        let a2 = arg(g, 2);
        var i = 0;
        while i < len(a2) {
            n = n * 10 + int_of(a2[i]) - 48;
            i = i + 1;
        }
        let a3 = arg(g, 3);
        i = 0;
        while i < len(a3) {
            p = p * 10 + int_of(a3[i]) - 48;
            i = i + 1;
        }
    }
    borrow mut heap as &!hh in {
        borrow mut io as &!ii in {
            run(hh, ii, mode, n, p);
        }
    }
    release(args);
    release(fs);
    release(heap);
    release(io);
    return 0;
}
