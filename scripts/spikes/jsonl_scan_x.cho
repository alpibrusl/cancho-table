// SPIKE (throwaway, docs/readers.md): jsonl_scan.cho plus the mode `jsonx`: `std.json.parse` with the two ints of state
// passed in by the caller (no `region` per call). Make jsonx.cho with `python3 make_jsonx.py PATH/TO/cancho/std/json.cho jsonx.cho`, then
// `cancho build jsonl_scan_x.cho jsonx.cho --std -o OUT`. The rest of this header is jsonl_scan.cho's.
// what reading one record costs for CSV (table's own `reader.fields`, copied),
// for JSON lines through `std.json` (a tape, reused or allocated per line), and for a hand-written flat-object
// scanner that falls back to `std.json` for anything it does not recognise. The same task for every mode: of each
// record take the cells `status` and `bytes`; count the records whose status is the text 404 and sum `bytes` as an
// exact integer (table's `parse_int`, copied). Prints "count sum fallbacks".
//
//     jsonl_scan MODE ROUNDS [THREADS] < file        MODE one of
//   ingest   read standard input only (the `getchar` loop): the cost of a pipe
//   lines    find the line ends and add their lengths (the floor every mode shares)
//   csv      reader.fields on every line (a CSV file: id,status,bytes,path,note), then the task
//   json     std.json.parse into ONE tape reused for every line, json.get for the two keys, then the task
//   jsona    the same with the tape allocated in a region per line (what a first implementation writes)
//   flat     the flat scanner (validates the line itself; any nested value, escape, byte >= 0x80, or oddity: std.json)
//   show     one verdict per line from std.json and from the flat scanner, for the differential (jsonl_check.py)
//   flatonly the flat scanner, never falling back (to see its floor; refusing nothing: not a proposal)
//   THREADS (default 1): the lines are cut in THREADS slices, each copied to a thread of its own that runs ROUNDS rounds
edition 5;

import std.buffer;
import std.bytes;
import std.io;
import std.json;
import jsonx;

fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, text: buffer.Buffer) -> [heap, io_read] buffer.Buffer {
    var out = text;
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

fn number_of[&s](text: &s [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(text) {
        n = n * 10 + (int_of(text[i]) - '0');
        i = i + 1;
    }
    return n;
}

fn int_min() -> [] int {
    return 0 - 9223372036854775807 - 1;
}

fn parse_int[&d](data: &d [byte]) -> [] (int, int) {
    var at = 0;
    var negative = false;
    if len(data) > 0 && (int_of(data[0]) == '-' || int_of(data[0]) == '+') {
        negative = int_of(data[0]) == '-';
        at = 1;
    }
    if at >= len(data) {
        return (0, 1);
    }
    if len(data) - at <= 18 {
        var plain = 0;
        while at < len(data) {
            let c = int_of(data[at]);
            if c < '0' || c > '9' {
                return (0, 1);
            }
            plain = plain * 10 + c - '0';
            at = at + 1;
        }
        if negative {
            return (0 - plain, 0);
        }
        return (plain, 0);
    }
    return (0, 2);
}

// ---- the task: out[0] count of status == "404", out[1] sum of bytes, out[2] bad cells --------------------------

fn task[&a, &b, &o](status: &a [byte], size: &b [byte], out: &!o [int]) -> [] int {
    if bytes.equal(status, "404") {
        out[0] = out[0] + 1;
    }
    let (v, st) = parse_int(size);
    if st == 0 {
        out[1] = out[1] + v;
    } else {
        out[2] = out[2] + 1;
    }
    return 0;
}

// ---- csv: columns 1 and 2 of id,status,bytes,path,note ----------------------------------------------------------

// Where the byte `b` first is in `line[from..end]` (an index into `line`), or -1. Short fields, most of
// them, are walked: a call to `memchr` costs more than the bytes it would skip. One that is still going
// after 24 bytes is left to `memchr`.
fn seek[&l](line: &l [byte], from: int, end: int, b: int) -> [] int {
    var q = from;
    var stop = end;
    if end - from > 24 {
        stop = from + 24;
    }
    while q < stop && int_of(line[q]) != b {
        q = q + 1;
    }
    if q < stop {
        return q;
    }
    if q == end {
        return 0 - 1;
    }
    let more = index_of_byte(line[q..end], byte_of(b));
    if more < 0 {
        return 0 - 1;
    }
    return q + more;
}

// The fields of the record `line`, found in one pass: for field `n` its
// `cells[3n]` start, `cells[3n + 1]` end and `cells[3n + 2]` 1 when it was
// quoted (start and end then exclude the quotes, and a doubled quote is still
// doubled in between). Only the first `room` fields are stored, all are
// counted. Answers (fields, a quote still open at the end, a bad quote), the
// same two refusals as `scan`.
//
// A field is found with one `memchr` for its delimiter, or for the quote that
// closes it, so a record costs a search per field and not a step per byte.
pub fn fields[&l, &c](line: &l [byte], delim: int, cells: &!c [int], room: int) -> [] (int, bool, bool) {
    let end = len(line);
    var p = 0;
    var n = 0;
    var inside = false;
    var bad = false;
    var going = true;
    while going {
        var first = p;
        var last = end;
        var quoted = 0;
        var next = end + 1;
        if p < end && int_of(line[p]) == 34 {
            var q = p + 1;
            var closed = false;
            while !closed && !inside {
                let at = seek(line, q, end, 34);
                if at < 0 {
                    inside = true;
                } else if at + 1 < end && int_of(line[at + 1]) == 34 {
                    q = at + 2;
                } else {
                    closed = true;
                    first = p + 1;
                    last = at;
                    quoted = 1;
                    if at + 1 == end {
                        next = end + 1;
                    } else if int_of(line[at + 1]) == delim {
                        next = at + 2;
                    } else {
                        bad = true;
                    }
                }
            }
        } else {
            let q = seek(line, p, end, delim);
            if q >= 0 {
                last = q;
                next = q + 1;
            }
        }
        if inside || bad {
            going = false;
        } else {
            if n < room {
                cells[3 * n] = first;
                cells[3 * n + 1] = last;
                cells[3 * n + 2] = quoted;
            }
            n = n + 1;
            if next > end {
                going = false;
            } else {
                p = next;
            }
        }
    }
    return (n, inside, bad);
}

fn rec_csv[&l, &c, &o](line: &l [byte], cells: &!c [int], out: &!o [int]) -> [] int {
    let (n, inside, bad) = fields(line, 44, cells, 8);
    if inside || bad || n < 3 {
        out[2] = out[2] + 1;
        return 1;
    }
    task(line[cells[3]..cells[4]], line[cells[6]..cells[7]], out);
    return 0;
}

// ---- json through std.json ----------------------------------------------------------------------------------

fn number_text[&l, &t](line: &l [byte], tape: &t [int], node: int) -> [] &l [byte] {
    if node < 0 || json.kind(tape, node) != 3 {
        return line[0..0];
    }
    return line[tape[3 * node + 1]..tape[3 * node + 2]];
}

fn rec_json[&l, &t, &o](line: &l [byte], tape: &!t [int], out: &!o [int]) -> [] int {
    let n = json.parse(line, tape);
    if n < 0 {
        out[2] = out[2] + 1;
        return 1;
    }
    let s = json.get(line, tape, 0, "status");
    let b = json.get(line, tape, 0, "bytes");
    task(number_text(line, tape, s), number_text(line, tape, b), out);
    return 0;
}

fn rec_jsonx[&l, &t, &q, &o](line: &l [byte], tape: &!t [int], st: &!q [int], out: &!o [int]) -> [] int {
    let n = jsonx.parse_with(line, tape, st);
    if n < 0 {
        out[2] = out[2] + 1;
        return 1;
    }
    let s = json.get(line, tape, 0, "status");
    let b = json.get(line, tape, 0, "bytes");
    task(number_text(line, tape, s), number_text(line, tape, b), out);
    return 0;
}

fn rec_json_alloc[&l, &o](line: &l [byte], out: &!o [int]) -> [] int {
    var r = 0;
    region a {
        let tape = alloc_slice[a](json.tape_len(line), 0);
        r = rec_json(line, tape, out);
    }
    return r;
}

// ---- the flat scanner -----------------------------------------------------------------------------------------
// One object of scalar values, written as RFC 8259 writes it. Answers 0 and the value ranges of `status` and
// `bytes` in `r` (r[0..2] and r[2..4], -1 when absent), or 1: this line is not for the scanner (a nested value,
// a backslash, a control byte or a byte >= 0x80 inside a string, a number that is not in the grammar, anything
// out of place): std.json decides it.

fn ws_at[&l](line: &l [byte], from: int) -> [] int {
    var p = from;
    while p < len(line) && (int_of(line[p]) == 32 || int_of(line[p]) == 9 || int_of(line[p]) == 10 || int_of(line[p]) == 13) {
        p = p + 1;
    }
    return p;
}

// The end (index of the closing quote) of the string whose first byte is at `from`, or -1 for "not plain".
fn plain_string_end[&l](line: &l [byte], from: int) -> [] int {
    var q = from;
    let n = len(line);
    while q < n {
        let c = int_of(line[q]);
        if c == 34 {
            return q;
        }
        if c < 32 || c == 92 || c >= 128 {
            return 0 - 1;
        }
        q = q + 1;
    }
    return 0 - 1;
}

fn digits_at[&l](line: &l [byte], from: int) -> [] int {
    var p = from;
    while p < len(line) && int_of(line[p]) >= '0' && int_of(line[p]) <= '9' {
        p = p + 1;
    }
    return p;
}

// The end of a number at `from` in the RFC 8259 grammar, or -1.
fn number_end[&l](line: &l [byte], from: int) -> [] int {
    var p = from;
    let n = len(line);
    if p < n && int_of(line[p]) == '-' {
        p = p + 1;
    }
    if p >= n {
        return 0 - 1;
    }
    if int_of(line[p]) == '0' {
        p = p + 1;
    } else if int_of(line[p]) >= '1' && int_of(line[p]) <= '9' {
        p = digits_at(line, p);
    } else {
        return 0 - 1;
    }
    if p < n && int_of(line[p]) == '.' {
        let q = digits_at(line, p + 1);
        if q == p + 1 {
            return 0 - 1;
        }
        p = q;
    }
    if p < n && (int_of(line[p]) == 'e' || int_of(line[p]) == 'E') {
        var q = p + 1;
        if q < n && (int_of(line[q]) == '+' || int_of(line[q]) == '-') {
            q = q + 1;
        }
        let r = digits_at(line, q);
        if r == q {
            return 0 - 1;
        }
        p = r;
    }
    return p;
}

fn literal_at[&l](line: &l [byte], p: int, word: &static [byte]) -> [] bool {
    return p + len(word) <= len(line) && bytes.equal(line[p..p + len(word)], word);
}

fn flat[&l, &r](line: &l [byte], r: &!r [int]) -> [] int {
    let n = len(line);
    r[0] = 0 - 1;
    r[1] = 0 - 1;
    r[2] = 0 - 1;
    r[3] = 0 - 1;
    var p = ws_at(line, 0);
    if p >= n || int_of(line[p]) != '{' {
        return 1;
    }
    p = ws_at(line, p + 1);
    if p < n && int_of(line[p]) == '}' {
        if ws_at(line, p + 1) == n {
            return 0;
        }
        return 1;
    }
    var going = true;
    while going {
        if p >= n || int_of(line[p]) != 34 {
            return 1;
        }
        let ke = plain_string_end(line, p + 1);
        if ke < 0 {
            return 1;
        }
        let k0 = p + 1;
        p = ws_at(line, ke + 1);
        if p >= n || int_of(line[p]) != 58 {
            return 1;
        }
        p = ws_at(line, p + 1);
        if p >= n {
            return 1;
        }
        var v0 = p;
        var v1 = p;
        let c = int_of(line[p]);
        if c == 34 {
            let ve = plain_string_end(line, p + 1);
            if ve < 0 {
                return 1;
            }
            v0 = p + 1;
            v1 = ve;
            p = ve + 1;
        } else if c == '-' || c >= '0' && c <= '9' {
            let ne = number_end(line, p);
            if ne < 0 {
                return 1;
            }
            v1 = ne;
            p = ne;
        } else if literal_at(line, p, "true") {
            p = p + 4;
            v1 = p;
        } else if literal_at(line, p, "false") {
            p = p + 5;
            v1 = p;
        } else if literal_at(line, p, "null") {
            p = p + 4;
            v1 = p;
        } else {
            return 1;
        }
        let klen = ke - k0;
        if klen == 6 && bytes.equal(line[k0..ke], "status") {
            if r[0] >= 0 {
                return 1;
            }
            r[0] = v0;
            r[1] = v1;
        } else if klen == 5 && bytes.equal(line[k0..ke], "bytes") {
            if r[2] >= 0 {
                return 1;
            }
            r[2] = v0;
            r[3] = v1;
        }
        p = ws_at(line, p);
        if p >= n {
            return 1;
        }
        if int_of(line[p]) == 44 {
            p = ws_at(line, p + 1);
        } else if int_of(line[p]) == 125 {
            if ws_at(line, p + 1) != n {
                return 1;
            }
            going = false;
        } else {
            return 1;
        }
    }
    return 0;
}

fn rec_flat[&l, &t, &o, &r](line: &l [byte], tape: &!t [int], out: &!o [int], r: &!r [int], fallback: bool) -> [] int {
    let s = flat(line, r);
    if s == 0 {
        task(line[r[0]..r[1]], line[r[2]..r[3]], out);
        return 0;
    }
    out[3] = out[3] + 1;
    if fallback {
        return rec_json(line, tape, out);
    }
    return 1;
}

// ---- the loop --------------------------------------------------------------------------------------------------

fn run[&d, &t, &c, &o, &r](data: &d [byte], mode: int, rounds: int, tape: &!t [int], cells: &!c [int], out: &!o [int], r: &!r [int]) -> [] int {
    var round = 0;
    var total = 0;
    let n = len(data);
    while round < rounds {
        var at = 0;
        while at < n {
            var end = n;
            let f = index_of_byte(data[at..n], byte_of(10));
            if f >= 0 {
                end = at + f;
            }
            var line = data[at..end];
            if len(line) > 0 && int_of(line[len(line) - 1]) == 13 {
                line = line[0..len(line) - 1];
            }
            if mode == 1 {
                total = total + len(line);
            } else if mode == 2 {
                rec_csv(line, cells, out);
            } else if mode == 3 {
                rec_json(line, tape, out);
            } else if mode == 4 {
                rec_json_alloc(line, out);
            } else if mode == 8 {
                rec_jsonx(line, tape, r, out);
            } else if mode == 5 {
                rec_flat(line, tape, out, r, true);
            } else if mode == 6 {
                rec_flat(line, tape, out, r, false);
            }
            at = end + 1;
        }
        round = round + 1;
    }
    return total;
}

res struct Job {
    heap: Heap,
    data: Box[[byte]],
    tape: Box[[int]],
    cells: Box[[int]],
    out: Box[[int]],
    r: Box[[int]],
    par: Box[[int]],
}

fn work[&w](j: &!w Job) -> [] int {
    let total = run(contents(j.data), contents(j.par)[0], contents(j.par)[1], contents(j.tape), contents(j.cells), contents(j.out), contents(j.r));
    contents(j.par)[2] = total;
    return 0;
}

fn fan[&p, &d, &b, &s](parent: &!p Heap, data: &d [byte], bounds: &b [int], k: int, n: int, mode: int, rounds: int, sums: &!s [int]) -> [heap, conc] int {
    if k >= n {
        return 0;
    }
    let lo = bounds[k];
    let hi = bounds[k + 1];
    let forked = fork_heap(parent);
    var job = Job { heap: forked, data: box_slice(parent, hi - lo, byte_of(0)), tape: box_slice(parent, 12288, 0), cells: box_slice(parent, 24, 0), out: box_slice(parent, 4, 0), r: box_slice(parent, 4, 0), par: box_slice(parent, 4, 0) };
    borrow mut job as &!kj in {
        copy_into(contents(kj.data)[0..hi - lo], data[lo..hi]);
        contents(kj.par)[0] = mode;
        contents(kj.par)[1] = rounds;
    }
    borrow mut job as &!kj in {
        let body = work;
        let thread = spawn(kj, body);
        fan(parent, data, bounds, k + 1, n, mode, rounds, sums);
        join(thread);
    }
    let Job { heap, data, tape, cells, out, r, par } = job;
    release(heap);
    borrow out as &ob in {
        sums[3 * k] = contents(ob)[0];
        sums[3 * k + 1] = contents(ob)[1];
        sums[3 * k + 2] = contents(ob)[3];
    }
    unbox_slice(parent, data);
    unbox_slice(parent, tape);
    unbox_slice(parent, cells);
    unbox_slice(parent, out);
    unbox_slice(parent, r);
    unbox_slice(parent, par);
    return 0;
}

fn cut[&d, &b](data: &d [byte], parts: int, bounds: &!b [int]) -> [] int {
    // `parts` slices whose ends are line ends: bounds[0..=parts]
    let n = len(data);
    var k = 0;
    bounds[0] = 0;
    while k < parts {
        var at = (n / parts) * (k + 1);
        if k + 1 == parts {
            at = n;
        } else {
            if at < bounds[k] {
                at = bounds[k];
            }
            let f = index_of_byte(data[at..n], byte_of(10));
            if f >= 0 {
                at = at + f + 1;
            } else {
                at = n;
            }
        }
        bounds[k + 1] = at;
        k = k + 1;
    }
    return 0;
}

// ---- differential: one verdict line per input line (mode `show`) ------------------------------------------------
// `J ok S B` or `J bad CODE`: std.json, S and B the texts of the `status` and `bytes` values (a string's raw bytes between
// its quotes, a number's token, true, false; empty when absent or another kind). `F ok S B` or `F fallback`: the flat scanner.

fn value_text[&l, &t](line: &l [byte], tape: &t [int], node: int) -> [] &l [byte] {
    if node < 0 {
        return line[0..0];
    }
    let k = json.kind(tape, node);
    if k == 3 || k == 4 {
        return line[tape[3 * node + 1]..tape[3 * node + 2]];
    }
    if k == 5 {
        return json.string_view(line, tape, node);
    }
    if k == 2 {
        return "true";
    }
    if k == 1 {
        return "false";
    }
    if k == 0 {
        return "null";
    }
    return line[0..0];
}

fn show_all[&i, &d, &t, &r](con: &!i Io, data: &d [byte], tape: &!t [int], r: &!r [int]) -> [io_write] int {
    let n = len(data);
    var at = 0;
    while at < n {
        var end = n;
        let f = index_of_byte(data[at..n], byte_of(10));
        if f >= 0 {
            end = at + f;
        }
        let line = data[at..end];
        let parsed = json.parse(line, tape);
        io.write_all(con, "J ");
        if parsed < 0 {
            io.write_all(con, "bad ");
            io.print_int(con, json.error_code(parsed));
        } else {
            io.write_all(con, "ok ");
            io.write_all(con, value_text(line, tape, json.get(line, tape, 0, "status")));
            io.write_all(con, " ");
            io.write_all(con, value_text(line, tape, json.get(line, tape, 0, "bytes")));
        }
        io.newline(con);
        io.write_all(con, "F ");
        if flat(line, r) == 0 {
            io.write_all(con, "ok ");
            if r[0] >= 0 {
                io.write_all(con, line[r[0]..r[1]]);
            }
            io.write_all(con, " ");
            if r[2] >= 0 {
                io.write_all(con, line[r[2]..r[3]]);
            }
        } else {
            io.write_all(con, "fallback");
        }
        io.newline(con);
        at = end + 1;
    }
    return 0;
}

fn main(world: World) -> [conc] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(fs);
    release(ffi);
    release(net);
    release(clock);
    var mode = 0;
    var rounds = 1;
    var threads = 1;
    borrow args as &g in {
        let a1 = arg(g, 1);
        if int_of(a1[0]) == 'i' {
            mode = 0;
        } else if int_of(a1[0]) == 'l' {
            mode = 1;
        } else if int_of(a1[0]) == 'c' {
            mode = 2;
        } else if bytes.equal(a1, "json") {
            mode = 3;
        } else if bytes.equal(a1, "jsona") {
            mode = 4;
        } else if bytes.equal(a1, "flat") {
            mode = 5;
        } else if bytes.equal(a1, "show") {
            mode = 7;
        } else if bytes.equal(a1, "jsonx") {
            mode = 8;
        } else {
            mode = 6;
        }
        rounds = number_of(arg(g, 2));
        if arg_count(g) > 3 {
            threads = number_of(arg(g, 3));
        }
    }
    release(args);
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            var text = buffer.empty(h, 1048576);
            text = read_stdin(h, i, text);
            borrow text as &b in {
                var tape = box_slice(h, 12288, 0);
                var cells = box_slice(h, 24, 0);
                var out = box_slice(h, 4, 0);
                var r = box_slice(h, 4, 0);
                if mode == 7 {
                    borrow mut tape as &!tw in {
                        borrow mut r as &!rw in {
                            show_all(i, buffer.bytes(b), contents(tw), contents(rw));
                        }
                    }
                } else if mode == 0 {
                    io.print_int(i, len(buffer.bytes(b)));
                    io.newline(i);
                } else if threads <= 1 {
                    var c0 = 0;
                    var s0 = 0;
                    var b0 = 0;
                    var f0 = 0;
                    borrow mut tape as &!tw in {
                        borrow mut cells as &!cw in {
                            borrow mut out as &!ow in {
                                borrow mut r as &!rw in {
                                    let t = run(buffer.bytes(b), mode, rounds, contents(tw), contents(cw), contents(ow), contents(rw));
                                    c0 = contents(ow)[0];
                                    s0 = contents(ow)[1];
                                    b0 = contents(ow)[2] + t;
                                    f0 = contents(ow)[3];
                                }
                            }
                        }
                    }
                    io.print_int(i, c0);
                    io.space(i);
                    io.print_int(i, s0);
                    io.space(i);
                    io.print_int(i, f0);
                    io.space(i);
                    io.print_int(i, b0);
                    io.newline(i);
                } else {
                    var bounds = box_slice(h, threads + 1, 0);
                    var sums = box_slice(h, 3 * threads, 0);
                    var c0 = 0;
                    var s0 = 0;
                    var f0 = 0;
                    borrow mut bounds as &!bw in {
                        borrow mut sums as &!sw in {
                            cut(buffer.bytes(b), threads, contents(bw));
                            fan(h, buffer.bytes(b), contents(bw), 0, threads, mode, rounds, contents(sw));
                            var k = 0;
                            while k < threads {
                                c0 = c0 + contents(sw)[3 * k];
                                s0 = s0 + contents(sw)[3 * k + 1];
                                f0 = f0 + contents(sw)[3 * k + 2];
                                k = k + 1;
                            }
                        }
                    }
                    io.print_int(i, c0);
                    io.space(i);
                    io.print_int(i, s0);
                    io.space(i);
                    io.print_int(i, f0);
                    io.newline(i);
                    unbox_slice(h, bounds);
                    unbox_slice(h, sums);
                }
                unbox_slice(h, tape);
                unbox_slice(h, cells);
                unbox_slice(h, out);
                unbox_slice(h, r);
            }
            buffer.drop(h, text);
        }
    }
    release(heap);
    release(io);
    return 0;
}
